---
interface Props {
  href: string;
  title: string;
  description: string;
  image: string;
  difficulty: string;
}

const { href, title, description, image, difficulty } = Astro.props;

// Definimos los colores según la dificultad para que la Card "brille" distinto
const diffStyles = {
  Iniciación:
    "text-emerald-400 border-emerald-500/30 bg-emerald-500/5 shadow-emerald-500/10",
  Intermedio:
    "text-cyan-400 border-cyan-500/30 bg-cyan-500/5 shadow-cyan-500/10",
  Avanzado: "text-rose-400 border-rose-500/30 bg-rose-500/5 shadow-rose-500/10",
};

const currentStyle =
  diffStyles[difficulty as keyof typeof diffStyles] || diffStyles["Intermedio"];
---

<a
  href={href}
  class="group relative flex flex-col bg-slate-900 border border-white/10 rounded-xl overflow-hidden hover:border-cyan-500/50 transition-all duration-500 hover:shadow-[0_0_30px_rgba(6,182,212,0.1)]"
>
  <div class="relative aspect-video overflow-hidden">
    <div
      class="absolute inset-0 bg-gradient-to-t from-slate-950 to-transparent z-10 opacity-60"
    >
    </div>
    <img
      src={image}
      alt={title}
      class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110 opacity-80 group-hover:opacity-100"
    />

    <div
      class={`absolute top-4 right-4 z-20 px-3 py-1 rounded-full border backdrop-blur-md text-[10px] font-black uppercase tracking-widest ${currentStyle}`}
    >
      {difficulty}
    </div>
  </div>

  <div class="p-6 flex-1 flex flex-col relative z-20">
    <div class="flex items-center gap-2 mb-3">
      <span class="w-2 h-2 rounded-full bg-cyan-500 animate-pulse"></span>
      <span
        class="text-[9px] font-mono text-slate-500 uppercase tracking-[0.2em]"
        >Mission_Status: Available</span
      >
    </div>

    <h3
      class="text-xl font-black italic tracking-tighter text-white group-hover:text-cyan-400 transition-colors duration-300 line-clamp-2 uppercase"
    >
      {title}
    </h3>

    <p
      class="mt-3 text-sm text-slate-400 leading-relaxed line-clamp-3 font-medium italic"
    >
      "{description}"
    </p>

    <div class="mt-auto pt-6 flex items-center justify-between">
      <div class="flex flex-col">
        <span
          class="text-[8px] font-mono text-slate-600 uppercase tracking-tighter"
          >Access_Level</span
        >
        <span class="text-[10px] font-bold text-slate-300">AUTHOR_VERIFIED</span
        >
      </div>

      <div
        class="flex items-center gap-2 text-cyan-500 group-hover:gap-4 transition-all duration-300"
      >
        <span class="text-[10px] font-black uppercase tracking-widest"
          >Resolver</span
        >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-4 w-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
        </svg>
      </div>
    </div>
  </div>

  <div
    class="absolute top-0 left-[-100%] w-1/2 h-full bg-gradient-to-r from-transparent via-white/5 to-transparent skew-x-[-25deg] group-hover:left-[150%] transition-all duration-1000 ease-in-out"
  >
  </div>
</a>
