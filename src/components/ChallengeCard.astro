---
const { href, title, description, image, difficulty } = Astro.props;
import { Image } from "astro:assets";
let imagenLimpia = image || "/img/default.jpg";
if (!imagenLimpia.startsWith("/") && !imagenLimpia.startsWith("http")) {
  imagenLimpia = `/${imagenLimpia}`;
}
// Definimos los colores según la dificultad
const diffStyles = {
  Iniciación: "text-white bg-emerald-500 shadow-emerald-500",
  Intermedio: "text-white bg-cyan-500 shadow-cyan-500",
  Avanzado: "text-white bg-rose-500 shadow-rose-500",
};

const currentStyle =
  diffStyles[difficulty as keyof typeof diffStyles] || diffStyles["Intermedio"];
---

<a
  href={href}
  class="group relative flex flex-col bg-white dark:bg-slate-950 overflow-hidden
 transition-all duration-500 hover:-translate-y-2
 hover:shadow-[0_20px_50px_rgba(6,182,212,0.15)] border border-slate-200 dark:border-transparent h-full"
>
  <!-- Contenedor de Imagen -->
  <div class="relative aspect-video overflow-hidden">
    <div
      class="absolute inset-0 from-slate-950 via-transparent to-transparent z-10 opacity-80"
    >
    </div>

    <img
      src={imagenLimpia}
      alt={title}
      class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110 opacity-60 group-hover:opacity-100"
    />

    <!-- Badge de Dificultad -->
    <div
      class={`absolute top-4 right-4 z-20 px-3 py-1 rounded-full text-xs sm:text-sm font-black uppercase tracking-[0.2em] ${currentStyle}`}
    >
      {difficulty}
    </div>
  </div>

  <!-- Contenido -->
  <div
    class="p-6 flex-1 flex flex-col relative z-20 bg-white dark:bg-slate-900"
  >
    <h3
      class="text-xl font-black italic tracking-tighter text-slate-900 dark:text-white group-hover:text-cyan-600 dark:group-hover:text-cyan-400 transition-colors duration-300 line-clamp-2 uppercase"
    >
      {title}
    </h3>

    <p
      class="mt-3 text-base text-slate-600 dark:text-slate-400 leading-relaxed line-clamp-3 font-medium italic opacity-80 group-hover:opacity-100 transition-opacity"
    >
      "{description}"
    </p>

    <!-- Footer de la Card -->
    <div class="mt-auto pt-8 flex items-center justify-between">
      <div
        class="flex items-center gap-2 text-cyan-600 dark:text-cyan-500 transition-all duration-300 group-hover:gap-4"
      >
        <span class="text-sm font-black uppercase tracking-[0.2em]"
          >Resolver</span
        >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-4 w-4 transition-transform group-hover:scale-110"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
        </svg>
      </div>
    </div>
  </div>
</a>
