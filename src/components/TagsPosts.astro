---
import tagsListation from "./tags.json";
let tags = tagsListation;
const { tagsList } = Astro.props;
let tagsLists = JSON.parse(tagsList);
tags = tagsLists.filter((tag) => {
  tags.includes(tag.toLowerCase().trim());
  return tag;
});

const {  url } = Astro.props.page;
console.log(url);
---

<ul class="flex flex-row flex-wrap justify-start space-x-2 w-full max-w-md">
  {
    tags.map((tag) => {
      return (
        <a
          class="uppercase my-2 px-4 py-2 rounded-full text-white bg-clip-border bg-gradient-to-r from-sky-800 to-cyan-500 font-semibold text-sm flex align-center w-max cursor-pointer transition duration-300 ease"
          href={"/tags/" + tag + "/1"}
        >
          {tag}
        </a>
      );
    })
  }
</ul>
