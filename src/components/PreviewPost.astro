---
import { formatDatePost } from "src/utils.js";

const { post } = Astro.props;
const postUrl = `/posts/${post.slug || post.id.replace(/\.[^/.]+$/, "")}`;
const tags = post.data.tags || [];
---

<li class="group list-none flex font-sans">
  <a
    href={postUrl}
    class="relative flex flex-col w-full h-[450px] overflow-hidden border border-slate-200 dark:border-white/5 bg-slate-950 transition-all duration-500 hover:border-cyan-500/50 shadow-2xl"
  >
    {/* Contenedor de Imagen con Overlay */}
    <div class="absolute inset-0 z-0 h-full w-full overflow-hidden">
      <img
        class="h-full w-full object-cover transition-transform duration-1000 group-hover:scale-105 opacity-60 group-hover:opacity-30 grayscale-[50%] group-hover:grayscale-0"
        src={post.data.image}
        alt={post.data.title}
      />
      {/* Gradiente más profundo para legibilidad */}
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/60 to-transparent"></div>
    </div>

    {/* Contenido */}
    <div class="relative z-10 flex flex-col h-full justify-end">
      <div class="p-8 transition-all duration-500 transform group-hover:-translate-y-2">
        
        {/* Fecha en Mono */}
        <div class="mb-4 flex items-center gap-3">
            <span class="h-[1px] w-8 bg-cyan-500/50"></span>
            <span class="text-[10px] font-bold tracking-[0.2em] text-cyan-400 font-mono">
              {formatDatePost(post.data.pubDate)}
            </span>
        </div>
        
        {/* Título: Sans-Serif Limpia y Potente */}
        <h3 class="mb-3 text-3xl font-black leading-[1.1] text-white tracking-tight group-hover:text-cyan-400 transition-colors duration-300">
          {post.data.title}
        </h3>
        
        {/* Descripción: Inter para máxima legibilidad */}
        <p class="mb-6 line-clamp-2 text-sm leading-relaxed text-slate-400 font-normal max-w-[90%]">
          {post.data.description}
        </p>

        {/* Tags Estilo "Label" */}
        {tags.length > 0 && (
          <div class="flex flex-wrap gap-2">
            {tags.slice(0, 3).map((tag) => (
              <span class="border border-white/10 bg-white/5 px-2 py-1 text-[9px] font-bold uppercase tracking-widest text-slate-300 font-mono group-hover:border-cyan-500/30 group-hover:text-cyan-300 transition-colors">
                {tag}
              </span>
            ))}
          </div>
        )}
      </div>
    </div>

    {/* Brillo decorativo en la esquina al hacer hover */}
    <div class="absolute top-0 right-0 w-24 h-24 bg-cyan-500/10 blur-[50px] opacity-0 group-hover:opacity-100 transition-opacity duration-700"></div>
  </a>
</li>