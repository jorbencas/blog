---
import { formatDatePost } from "src/utils.js";

const { post } = Astro.props;
const postUrl = `/posts/${post.data.slug || post.id.replace(/\.[^/.]+$/, "")}`;
const tags = post.data.tags || [];
---

<li class="group list-none flex">
  <a
    href={postUrl}
    class="relative flex flex-col w-full h-[500px] overflow-hidden border border-slate-200 dark:border-white/10 bg-slate-900 transition-all duration-500 hover:border-cyan-500"
  >
    <div class="absolute inset-0 z-0 h-full w-full">
      <img
        class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-110 opacity-70 group-hover:opacity-40"
        src={post.data.image}
        alt={post.data.title}
      />
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/20 to-transparent"></div>
    </div>

    <div class="relative z-10 flex flex-col h-full justify-end">
      <div class="bg-slate-950/80 backdrop-blur-md p-8 border-t border-white/5 transition-all duration-300 group-hover:bg-cyan-950/40">
        
        <span class="mb-3 block text-[10px] font-black uppercase tracking-[0.3em] text-cyan-400">
          {formatDatePost(post.data.pubDate)}
        </span>
        
        <h3 class="mb-3 text-2xl font-black leading-tight text-white uppercase italic tracking-tighter">
          {post.data.title}
        </h3>
        
        <p class="mb-6 line-clamp-2 text-sm leading-relaxed text-slate-400 font-medium">
          {post.data.description}
        </p>

        {tags.length > 0 && (
          <div class="flex flex-wrap gap-2">
            {tags.map((tag) => (
              <div class="bg-gradient-to-r from-sky-800 to-cyan-600 px-3 py-1 text-[9px] font-black uppercase tracking-wider text-white">
                {tag}
              </div>
            ))}
          </div>
        )}
      </div>
    </div>
  </a>
</li>