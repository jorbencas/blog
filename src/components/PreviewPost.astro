---
import { formatDatePost } from "src/utils.js";

export interface Props {
  post: any;
}

const { post } = Astro.props;
const postUrl = `/posts/${post.data.slug || post.id.replace(/\.[^/.]+$/, "")}`;
const tags = post.data.tags || [];
---

<li class="group list-none flex h-[400px]">
  <a
    href={postUrl}
    class="relative flex flex-col w-full overflow-hidden border border-slate-200 dark:border-white/10 bg-slate-900 transition-all duration-500 hover:border-cyan-500"
  >
    <div class="absolute inset-0 z-0">
      <img
        class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-110 opacity-60 group-hover:opacity-40"
        src={post.data.image}
        alt={post.data.title}
      />
      <div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-slate-900/20 to-transparent"></div>
    </div>

    <div class="relative z-10 flex flex-col h-full justify-end">
      <div class="bg-slate-900/60 backdrop-blur-sm p-6 border-t border-white/10 transition-colors group-hover:bg-slate-900/80">
        
        <span class="mb-2 block text-[10px] font-black uppercase tracking-[0.3em] text-cyan-400">
          {formatDatePost(post.data.pubDate)}
        </span>
        
        <h3 class="mb-2 text-2xl font-black leading-tight text-white">
          {post.data.title}
        </h3>
        
        <p class="mb-4 line-clamp-2 text-sm leading-relaxed text-slate-300">
          {post.data.description}
        </p>

        {tags.length > 0 && (
          <div class="flex flex-wrap gap-2">
            {tags.map((tag: string) => (
              <div
                class="bg-gradient-to-r from-sky-800 to-cyan-500 px-3 py-1 text-[9px] font-bold uppercase tracking-wider text-white"
              >
                {tag}
              </div>
            ))}
          </div>
        )}
      </div>
    </div>
  </a>
</li>