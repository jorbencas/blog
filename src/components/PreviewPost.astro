---
import mounths from "../layouts/months.json";
import days from "../layouts/days.json";
export interface Props {
  post: any;
}

const { post } = Astro.props;

const formatDatePost = (date) => {
  let fullDate = new Date(date);
  let day = days[fullDate.getDay()];
  let month = mounths[fullDate.getMonth()];
  let year = fullDate.getFullYear();
  let numday = fullDate.getUTCDate();
  return day + ", " + numday + " de " + month + " del " + year;
};
---

<li>
  <a
    href={post.url}
    class="flex items-center px-6 hover:bg-gray-200 dark:hover:bg-sky-800 py-6 sm:py-4"
  >
    <div class="flex-shrink-0">
      <img
        class="w-10 h-10 mr-2"
        src={post.frontmatter.image}
        alt={post.frontmatter.tittle}
      />
    </div>
    <div class="flex-1">
      <p class="text-lg font-medium text-gray-900 truncate dark:text-white">
        {post.frontmatter.tittle}
      </p>
      <p class="text-sm text-gray-500 truncate dark:text-gray-400">
        {post.frontmatter.description}
      </p>
      <p class="text-sm font-semibold text-cyan-600 dark:text-white">
        {formatDatePost(post.frontmatter.date)}
      </p>
    </div>
  </a>
</li>
