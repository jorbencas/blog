---
export interface Props {
  post: any;
}

const { post } = Astro.props;
---

<li class="">
  <a
    href={post.url}
    class="flex items-center px-6 hover:bg-gray-200 dark:hover:bg-sky-800 py-6 sm:py-4"
  >
    <div class="flex-shrink-0">
      <img
        class="w-8 h-8 mr-2"
        src={post.frontmatter.image}
        alt={post.frontmatter.tittle}
      />
    </div>
    <div class="flex-1 min-w-0">
      <p class="text-sm font-medium text-gray-900 truncate dark:text-white">
        {post.frontmatter.tittle}
      </p>
      <p class="text-sm text-gray-500 truncate dark:text-gray-400">
        {post.frontmatter.description}
      </p>
    </div>
    <div
      class="inline-flex items-center text-sm font-semibold text-cyan-600 dark:text-white"
    >
      {new Date(post.frontmatter.date).toLocaleDateString()}
    </div>
  </a>
</li>