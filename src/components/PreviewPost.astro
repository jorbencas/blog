---
const { post } = Astro.props;
const { title, description, pubDate, image } = post.data;

const date = new Date(pubDate).toLocaleDateString("es-ES", {
  year: "numeric",
  month: "short",
  day: "2-digit",
});
---

<a href={`/posts/${post.id}`} class="group block h-full">
  <div
    class="relative h-full bg-slate-900/40 overflow-hidden
 transition-all duration-500 hover:-translate-y-2 hover:
 hover:shadow-[0_20px_50px_rgba(6,182,212,0.15)] flex flex-col"
  >
    <!-- Imagen con Aspect Ratio controlado -->
    <div class="relative aspect-[16/9] overflow-hidden border-b">
      <div
        class="absolute inset-0 bg-gradient-to-t from-slate-950 via-transparent to-transparent z-10 opacity-70"
      >
      </div>

      {
        image ? (
          <img
            src={image}
            alt={title}
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110 opacity-80 group-hover:opacity-100"
          />
        ) : (
          <div class="w-full h-full bg-slate-800 flex items-center justify-center">
            <span class="text-slate-600 font-mono text-[10px]">
              NO_IMAGE_DATA
            </span>
          </div>
        )
      }

      <!-- Badge de Fecha flotante -->
      <div class="absolute bottom-3 left-4 z-20">
        <time
          class="text-[9px] font-mono text-cyan-400 uppercase tracking-[0.2em] font-black bg-slate-950 px-2 py-1 rounded-sm border border-cyan-500"
        >
          {date}
        </time>
      </div>
    </div>

    <!-- Contenido del Post -->
    <div class="p-5 flex-1 flex flex-col space-y-3">
      <div class="flex items-center gap-2">
        <span
          class="w-1.5 h-1.5 rounded-full bg-cyan-500 shadow-[0_0_8px_rgba(6,182,212,0.8)]"
        ></span>
        <span
          class="text-[8px] font-mono text-slate-500 uppercase tracking-widest"
          >Entry_Type: DevLog</span
        >
      </div>

      <h3
        class="text-lg font-black uppercase italic tracking-tighter text-white group-hover:text-cyan-400 transition-colors leading-tight"
      >
        {title}
      </h3>

      <p
        class="text-xs text-slate-400 line-clamp-2 leading-relaxed font-medium italic opacity-80"
      >
        "{description}"
      </p>

      <!-- Botón de lectura unificado -->
      <div class="mt-auto pt-4 flex items-center justify-between border-t">
        <div
          class="flex items-center gap-2 text-cyan-500 transition-all duration-300 group-hover:gap-4"
        >
          <span class="text-[9px] font-black uppercase tracking-[0.2em]"
            >Leer_Entrada</span
          >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-3.5 w-3.5 transition-transform group-hover:scale-110"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2.5"
              d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
          </svg>
        </div>

        <span
          class="text-[8px] font-mono text-slate-600 uppercase tracking-tighter italic"
          >Ref_0x{post.id.slice(0, 3)}</span
        >
      </div>
    </div>

    <!-- El mismo efecto Shimmer que los demás -->
    <div
      class="absolute top-0 left-[-100%] w-1/2 h-full bg-gradient-to-r from-transparent via-white/5 to-transparent skew-x-[-25deg] group-hover:left-[150%] transition-all duration-1000 pointer-events-none"
    >
    </div>
  </div>
</a>
