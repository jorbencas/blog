---
import ResponsiveImage from "@components/ResponsiveImage.astro";
import { resolveImagePath } from "src/utils.js";
const { post } = Astro.props;
const { title, description, pubDate, image } = post.data;

const date = new Date(pubDate).toLocaleDateString("es-ES", {
  year: "numeric",
  month: "short",
  day: "2-digit",
});

const tags = post.data.tags || [];
const imagenCard = resolveImagePath(image);
---

<a href={`/posts/${post.id}`} class="group block h-full">
  <div
    class="relative h-full bg-slate-50 dark:bg-slate-900 overflow-hidden
 transition-all duration-500 hover:border-cyan-500/50 flex flex-col border border-slate-200 dark:border-slate-800"
  >
    <!-- Imagen con Aspect Ratio controlado -->
    <div class="relative aspect-[16/9] overflow-hidden">
      <div
        class="absolute inset-0 from-slate-950 via-transparent to-transparent z-10 opacity-70 transition-opacity duration-500 group-hover:opacity-40"
      >
      </div>

      {
        imagenCard ? (
          <ResponsiveImage
            fallback={imagenCard}
            alt={title}
            imgClass="w-full h-full object-cover transition-all duration-700 group-hover:scale-110 opacity-80 group-hover:opacity-100"
          />
        ) : (
          <div class="w-full h-full bg-slate-200 dark:bg-slate-800 flex items-center justify-center">
            <span class="text-slate-500 dark:text-slate-600 text-xs sm:text-sm">
              SIN_IMAGEN
            </span>
          </div>
        )
      }

      <!-- Badge de Fecha flotante -->
      <div class="absolute bottom-3 left-4 z-20 bg-white dark:bg-slate-900">
        <time
          class="text-xs sm:text-sm text-cyan-500 dark:text-cyan-400 uppercase tracking-[0.2em] font-black bg-white dark:bg-slate-900 px-2 py-1 rounded-sm border border-cyan-500"
        >
          {date}
        </time>
      </div>
    </div>

    <!-- Contenido del Post -->
    <div class="p-4 sm:p-5 flex-1 flex flex-col space-y-3 dark:bg-slate-900">
      <h3
        class="text-base sm:text-lg font-black uppercase italic tracking-tighter text-slate-900 dark:text-white group-hover:text-cyan-500 dark:group-hover:text-cyan-400 transition-colors leading-tight"
      >
        {title}
      </h3>

      <p
        class="text-sm sm:text-base text-slate-500 dark:text-slate-400 line-clamp-2 leading-relaxed font-medium italic opacity-80"
      >
        "{description}"
      </p>

      <div class="mt-auto pt-4 flex items-center justify-between">
        {
          tags.length > 0 && (
            <div class="flex flex-wrap gap-2">
              {tags.map((tag: string) => (
                <div class="bg-gradient-to-r from-sky-800 to-cyan-500 px-3 py-1 text-xs sm:text-sm font-bold uppercase tracking-wider text-white">
                  {tag}
                </div>
              ))}
            </div>
          )
        }
      </div>
    </div>
  </div>
</a>
