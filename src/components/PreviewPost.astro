---
import { formatDatePost } from "src/utils.js";

export interface Props {
  post: any;
}

const { post } = Astro.props;
const postUrl = `/posts/${post.data.slug || post.id.replace(/\.[^/.]+$/, "")}`;
const tags = post.data.tags || [];
---

<li class="group list-none">
  <a
    href={postUrl}
    class="flex flex-col sm:flex-row items-start gap-6 p-4 sm:p-6 rounded-3xl transition-all duration-500 hover:bg-slate-50 dark:hover:bg-white/[0.03]"
  >
    <div class="relative flex-shrink-0 w-full sm:w-40 h-48 sm:h-40 overflow-hidden rounded-2xl bg-slate-100 dark:bg-slate-800 shadow-sm">
      <img
        class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
        src={post.data.image}
        alt={post.data.title}
        loading="lazy"
      />
    </div>

    <div class="flex flex-col min-w-0 flex-grow py-1">
      <span class="text-[10px] font-bold uppercase tracking-[0.2em] text-slate-400 mb-3">
        {formatDatePost(post.data.pubDate)}
      </span>
      
      <h3 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white leading-tight mb-2 group-hover:text-cyan-600 dark:group-hover:text-cyan-400 transition-colors">
        {post.data.title}
      </h3>
      
      <p class="text-sm sm:text-base text-slate-500 dark:text-slate-400 line-clamp-2 leading-relaxed mb-4">
        {post.data.description}
      </p>

      {tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mt-auto">
          {tags.map((tag: string) => (
            <div
              class="uppercase px-3 py-1 rounded-full text-white bg-gradient-to-r from-sky-800 to-cyan-500 font-bold text-[9px] tracking-wider w-max shadow-sm"
            >
              {tag}
            </div>
          ))}
        </div>
      )}
    </div>
  </a>
</li>