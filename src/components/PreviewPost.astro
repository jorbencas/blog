---
// import { Markdown } from 'astro/components';

export interface Props {
  post: any;
}

const { post } = Astro.props;
---

<li class="link-card">
    <a href={post.url}>
        <img src={post.frontmatter.image} alt={post.frontmatter.tittle} >
        <div class="info">
            <h3>{post.frontmatter.tittle}</h3>
            <p>{post.frontmatter.description}</p>
            <p class="date">{post.frontmatter.date}</p>
        </div>
    </a>
</li>


<style>
	.link-card {
		list-style: none;
		display: flex;
        max-width: 265px;
        max-height: 245px;
	}

    .link-card:is(:hover, :focus-within) {
        background-color: var(--opacity-color);
        color: var(--color-primary);
    }

    .link-card:is(:hover, :focus-within) .info .date {
        color: var(--color-primary);
    }

	.link-card > a {
		width: 100%;
		text-decoration: none;
		color: var(--eggshell);
		opacity: 0.8;
	}

    .link-card img {
        width: 100%;
        max-height: 225px;
        object-fit: cover;
        overflow: hidden;
        box-sizing: content-box;
        width: 100%;
        aspect-ratio: 15/7;
    }

    .link-card .info {
        display: block;
        font-size: 12px;
        padding: 5px;
    }

    .link-card .info * {
        overflow: hidden;
        box-sizing: content-box;
        padding: 2px;
        margin:0;
    }

    .link-card .info h3 {
        font-size: 1.2rem;
        font-weight: bold;
        margin: 0;
        padding: 0;
        color:var(--deep-champagne);
    }

    .link-card .info .date {
        color: var(--eggshell);
        background-color: var(--deep-champagne);
    }
</style>