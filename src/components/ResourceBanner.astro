---
interface Props {
  count: string;
  categories: string;
}

const { count, categories } = Astro.props;
---

<div class="not-prose relative overflow-hidden bg-gradient-to-br from-sky-100 to-cyan-100 dark:from-slate-800 dark:to-slate-700 border-2 border-cyan-300 dark:border-cyan-700/60 rounded-2xl p-6 sm:p-8 my-8 shadow-lg">
  <div class="absolute -top-6 -right-6 w-32 h-32 bg-cyan-400/20 rounded-full blur-2xl"></div>
  <div class="absolute -bottom-6 -left-6 w-40 h-40 bg-sky-400/20 rounded-full blur-2xl"></div>
  <p class="text-lg sm:text-xl font-black uppercase tracking-tight text-slate-900 dark:text-white m-0 relative z-10">📊 Más de <span class="text-cyan-600 dark:text-cyan-400">{count} recursos</span> en <span class="text-cyan-600 dark:text-cyan-400">{categories} categorías</span></p>
  <p class="text-sm font-semibold text-slate-600 dark:text-slate-300 mt-2 m-0 relative z-10">Usa la navegación de abajo para saltar directamente a la sección que te interese.</p>
</div>
