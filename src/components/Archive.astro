---
const currentYear = new Date().getFullYear();
const allPosts = await Astro.glob("../pages/posts/*.md");
const mounths =  ["Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio", "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre"]
let allYears = [];
allPosts
  .filter((f) => f.frontmatter.date != undefined)
  .forEach((p) => {
    let m = new Date(p.frontmatter.date).getMonth();
    let y = new Date(p.frontmatter.date).getFullYear();
    let t  = p.frontmatter.tittle;
   if(allYears.length == 0 || !allYears.includes(y) ) {
    allYears[y] = { 'month':mounths[m - 1], 'posts':[]}; 
   }

  if(allYears[y].month !== mounths[m - 1]) {
    allYears[y] = { 'month':mounths[m - 1], 'posts':[]}; 
  }

   if(allYears[y].posts.length == 0 || !allYears[y].posts.includes(t)) {
    allYears[y].posts.push(t);
   }    
});
