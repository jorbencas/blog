---
const allPosts = await Astro.glob("../pages/posts/*.md");
const mounths = [
  "Enero",
  "Febrero",
  "Marzo",
  "Abril",
  "Mayo",
  "Junio",
  "Julio",
  "Agosto",
  "Septiembre",
  "Octubre",
  "Noviembre",
  "Diciembre",
];
let allYears = [];
allPosts
  .filter((f) => f.frontmatter.date != undefined)
  .forEach((p) => {
    let { date, tittle } = p.frontmatter;
    let fullDate = new Date(date);
    let month = fullDate.getMonth();
    let y = fullDate.getFullYear();

    if (!allYears[y]) {
      allYears[y] = [];
    }

    if (!allYears[y][month]) {
      allYears[y][month] = [];
    }

    if (
      allYears[y][month].length == 0 ||
      !allYears[y][month].includes(tittle)
    ) {
      allYears[y][month].push({ url: p.url, tittle });
    }
  });
---

<div class="taglist w-full max-w-md">
  <h3 class="mb-2 text-xl font-bold leading-none text-gray-900 dark:text-white">
    Explorar articulos archivados
  </h3>
  <ul class="list-none block p-0 m-0 border-l-2 border-blue-600">
    {
      allYears.map((e, y) => {
        return (
          <li
            class="ml-10 accordion-item"
            data-bs-toggle="collapse"
            data-bs-target="#collapseOne"
            aria-expanded="false"
            aria-controls="collapseOne"
          >
            <span class="cursor-pointer before:mr-5 before:inline-block before:text-black before:content-['\25B6'] active:before:rotate-45 before:transform-none">
              {y}
            </span>
            <ul class="accordion m-2 border-l-2 border-blue-600">
              {e.map((el, yl) => {
                return (
                  <li class="ml-10 accordion-item">
                    <span class="caret">{mounths[yl]}</span>
                    <ul class="m-2 border-l-2 border-blue-600">
                      {el.map((eu) => {
                        return (
                          <li class="ml-10 accordion-item">
                            {" "}
                            <a class="no-underline text-sky-500" href={eu.url}>
                              {eu.tittle}
                            </a>
                          </li>
                        );
                      })}
                    </ul>
                  </li>
                );
              })}
            </ul>
          </li>
        );
      })
    }
  </ul>
</div>

<style>
  @import url("../styles/Archive.css");
</style>

<script>
  const toggler = document.getElementsByClassName("caret");
  for (let i = 0; i < toggler.length; i++) {
    toggler[i].addEventListener("click", function () {
      this.parentElement.querySelector(".nested").classList.toggle("active");
      this.classList.toggle("caret-down");
    });
  }
</script>
