---
import months from "../layouts/months.json";
const allPosts = await Astro.glob("../pages/posts/*.md");

let allYears = [];
allPosts.forEach((p) => {
  let { pubDate, title, draft } = p.frontmatter;
  let fullDate = new Date(pubDate);
  let month = fullDate.getMonth();
  let y = fullDate.getFullYear();
  if (!allYears[y]) {
    allYears[y] = [];
  }

  if (!allYears[y][month]) {
    allYears[y][month] = [];
  }

  if (allYears[y][month].length == 0 || !allYears[y][month].includes(title)) {
    allYears[y][month].push({ url: p.url, title });
  }
});
---

