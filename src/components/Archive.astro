---

<div class="taglist">
  <h3>Explorar posts archivados</h3>
  <ul class="myUL">
    {
      
      allYears.map((element , y) => {
        return <li><span class="caret"> {element.month + ' ' + y}</span>
          <ul class="nested">{
            element.posts.map( (e) => {
              return  <li>{e}</li>
            })
          } </ul>
          </li>
      })
    }
  </ul>
  <ul class="myUL">
    <li><span class="caret">Beverages</span>
      <ul class="nested">
        <li>Water</li>
        <li>Coffee</li>
        <li><span class="caret">Tea</span>
          <ul class="nested">
            <li>Black Tea</li>
            <li>White Tea</li>
            <li><span class="caret">Green Tea</span>
              <ul class="nested">
                <li>Sencha</li>
                <li>Gyokuro</li>
                <li>Matcha</li>
                <li>Pi Lo Chun</li>
              </ul>
            </li>
          </ul>
        </li>  
      </ul>
    </li>
  </ul>
</div>

<style>
  @import url('Archive.css');
</style> 




<script> 

const toggler = document.getElementsByClassName("caret");
for (let i = 0; i < toggler.length; i++) {
  toggler[i].addEventListener("click", function() {
    this.parentElement.querySelector(".nested").classList.toggle("active");
    this.classList.toggle("caret-down");
  });
}

</script>