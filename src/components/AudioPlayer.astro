---
// src/components/AudioPlayer.astro
interface Props {
  src: string;
}

const { src } = Astro.props;
---

<div class="audio-player-container">
  <p><strong>🎧 ¿Prefieres escuchar este artículo?</strong></p>
  <audio controls src={src} class="w-full">
    Tu navegador no soporta el elemento de audio.
  </audio>
</div>

<style>
  .audio-player-container {
    background-color: #f3f4f6;
    padding: 1rem;
    border-radius: 8px;
    margin-bottom: 2rem;
  }
  audio {
    width: 100%;
    margin-top: 0.5rem;
  }
</style>