---
// src/components/AudioPlayer.astro
interface Props {
  src: string;
}

const { src } = Astro.props;
if (!src) return;
const id = Math.random().toString(36).substring(2, 9);
---

<div
  class="bg-gray-100 dark:bg-zinc-800/50 p-4 rounded-lg mb-8 transition-colors audio-player"
  data-id={id}
>
  <p
    id={`statusText-${id}`}
    class="text-gray-800 dark:text-gray-200 font-semibold mb-3 flex items-center gap-2"
  >
    <span id={`statusIcon-${id}`}>🎧</span>
    <span id={`statusLabel-${id}`}>¿Prefieres escuchar este artículo?</span>
  </p>

  <audio src={src} id={`audio-${id}`} preload="metadata" class="hidden"></audio>

  <div class="flex items-center gap-4">
    <button
      id={`playBtn-${id}`}
      aria-label="Reproducir o pausar audio"
      class="flex-shrink-0 w-10 h-10 flex items-center justify-center bg-blue-600 hover:bg-blue-700 text-white rounded-full transition-colors focus:outline-none focus:ring-2 focus:ring-blue-400"
    >
      <svg
        id={`iconPlay-${id}`}
        class="w-5 h-5 ml-1"
        fill="currentColor"
        viewBox="0 0 24 24"><path d="M8 5v14l11-7z"></path></svg
      >
      <svg
        id={`iconPause-${id}`}
        class="w-5 h-5 hidden"
        fill="currentColor"
        viewBox="0 0 24 24"
        ><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"></path></svg
      >
    </button>

    <input
      type="range"
      id={`progressBar-${id}`}
      value="0"
      max="100"
      class="w-full h-2 bg-gray-300 dark:bg-zinc-600 rounded-lg appearance-none cursor-pointer focus:outline-none focus:ring-2 focus:ring-blue-400"
    />

    <div
      class="text-xs text-gray-600 dark:text-gray-400 whitespace-nowrap min-w-[70px] text-right"
    >
      <span id={`currentTime-${id}`}>0:00</span> / <span
        id={`durationTime-${id}`}>0:00</span
      >
    </div>
  </div>
</div>

<script>
  // Esta función encapsula toda tu lógica original
  function initAudioPlayers() {
    document.querySelectorAll(".audio-player").forEach((player) => {
      const id = player.getAttribute("data-id");
      console.log(id);
      const audio = document.getElementById(`audio-${id}`) as HTMLAudioElement;
      const playBtn = document.getElementById(`playBtn-${id}`);
      const iconPlay = document.getElementById(`iconPlay-${id}`);
      const iconPause = document.getElementById(`iconPause-${id}`);
      const progressBar = document.getElementById(
        `progressBar-${id}`
      ) as HTMLInputElement;
      const currentTimeText = document.getElementById(`currentTime-${id}`);
      const durationTime = document.getElementById(`durationTime-${id}`);
      const statusIcon = document.getElementById(`statusIcon-${id}`);
      const statusLabel = document.getElementById(`statusLabel-${id}`);

      // Evitamos errores si por alguna razón el elemento no existe en la página actual
      if (
        !audio ||
        !playBtn ||
        !progressBar ||
        !currentTimeText ||
        !durationTime
      )
        return;

      const formatTime = (time: number) => {
        if (isNaN(time) || !isFinite(time)) return "0:00";
        const min = Math.floor(time / 60);
        const sec = Math.floor(time % 60)
          .toString()
          .padStart(2, "0");
        return `${min}:${sec}`;
      };

      // SOLUCIÓN AL PROBLEMA DE DURACIÓN CONGELADA:
      // Si el navegador ya cargó los metadatos antes de que se ejecute el script:
      if (audio.readyState >= 1) {
        durationTime.innerText = formatTime(audio.duration);
      }

      // El evento por si acaso aún no se han cargado
      audio.addEventListener("loadedmetadata", () => {
        durationTime.innerText = formatTime(audio.duration);
      });

      // También escuchamos 'durationchange' por si el navegador actualiza el dato tarde
      audio.addEventListener("durationchange", () => {
        durationTime.innerText = formatTime(audio.duration);
      });

      playBtn.addEventListener("click", () => {
        if (audio.paused) {
          audio.play();
          iconPlay.classList.add("hidden");
          iconPause.classList.remove("hidden");
          statusIcon.textContent = "🔊";
          statusLabel.textContent = "Reproduciendo...";
        } else {
          audio.pause();
          iconPlay.classList.remove("colors-changed", "hidden"); // Asegurar reset
          iconPlay.classList.remove("hidden");
          iconPause.classList.add("hidden");
          statusIcon.textContent = "🎧";
          statusLabel.textContent = "¿Prefieres escuchar este artículo?";
        }
      });

      audio.addEventListener("timeupdate", () => {
        currentTimeText.innerText = formatTime(audio.currentTime);
        if (audio.duration) {
          progressBar.value = (
            (audio.currentTime / audio.duration) *
            100
          ).toString();
        }
      });

      progressBar.addEventListener("input", () => {
        if (audio.duration) {
          audio.currentTime =
            (parseFloat(progressBar.value) / 100) * audio.duration;
        }
      });

      audio.addEventListener("ended", () => {
        iconPlay.classList.remove("hidden");
        iconPause.classList.add("hidden");
        progressBar.value = "0";
        currentTimeText.innerText = "0:00";
        statusIcon.textContent = "🎧";
        statusLabel.textContent = "¿Prefieres escuchar este artículo?";
      });
    });
  }

  // SOLUCIÓN AL NAVEGAR ENTRE PÁGINAS (ClientRouter / ViewTransitions):
  // Se ejecuta en la primera carga y en cada transición de página exitosa.
  document.addEventListener("astro:page-load", initAudioPlayers);
</script>

<style>
  input[type="range"]::-webkit-slider-thumb {
    appearance: none;
    width: 14px;
    height: 14px;
    background: #2563eb;
    border-radius: 50%;
    cursor: pointer;
  }
  input[type="range"]::-moz-range-thumb {
    width: 14px;
    height: 14px;
    background: #2563eb;
    border-radius: 50%;
    cursor: pointer;
    border: none;
  }
</style>
