---
// src/components/AudioPlayer.astro
interface Props {
  src: string;
}

const { src } = Astro.props;
const id = src ? `ap-${src.replace(/[^a-zA-Z0-9]/g, "-")}` : "";
---

{
  src && (
    <div
      class="bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 p-5 rounded-xl mb-8 transition-all duration-300 shadow-sm audio-player hover:shadow-md mt-2"
      data-id={id}
      data-src={src}
    >
      <p
        id={`statusText-${id}`}
        class="text-sm text-slate-700 dark:text-slate-300 font-medium mb-4 flex items-center gap-2 select-none"
      >
        <span
          id={`statusIcon-${id}`}
          class="flex items-center justify-center w-5 h-5 text-base"
          aria-hidden="true"
        >
          🎧
        </span>
        <span id={`statusLabel-${id}`}>¿Prefieres escuchar este artículo?</span>
      </p>

      <div class="flex items-center gap-4">
        <button
          id={`playBtn-${id}`}
          aria-label="Reproducir o pausar audio"
          class="flex-shrink-0 w-11 h-11 flex items-center justify-center bg-cyan-600 hover:bg-cyan-700 active:scale-95 text-white rounded-full transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-cyan-400 focus:ring-offset-2 dark:focus:ring-offset-slate-950 shadow-md shadow-cyan-500/10 play-btn"
        >
          <svg
            id={`iconPlay-${id}`}
            class="w-5 h-5 ml-0.5 transition-transform duration-200"
            fill="currentColor"
            viewBox="0 0 24 24"
          >
            <path d="M8 5v14l11-7z" />
          </svg>
          <svg
            id={`iconPause-${id}`}
            class="w-5 h-5 hidden transition-transform duration-200"
            fill="currentColor"
            viewBox="0 0 24 24"
          >
            <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z" />
          </svg>
        </button>

        <div class="flex-1 transition-transform duration-200 ease-out hover:scale-y-105 py-1">
          <div id={`waveform-${id}`} class="w-full" />
        </div>

        <div class="text-xs font-mono text-slate-500 dark:text-slate-400 whitespace-nowrap min-w-[75px] text-right tabular-nums select-none">
          <span id={`currentTime-${id}`}>0:00</span>
          <span class="mx-0.5 text-slate-400">/</span>
          <span id={`durationTime-${id}`}>0:00</span>
        </div>
      </div>
    </div>
  )
}

<script>
  function initPlayer(player) {
    const id = player.getAttribute("data-id");
    const src = player.getAttribute("data-src");
    if (!id || !src) return;

    if (player.classList.contains("wavesurfer-initialized")) return;
    player.classList.add("wavesurfer-initialized");

    import(
      "https://cdn.jsdelivr.net/npm/wavesurfer.js@7/dist/wavesurfer.esm.js"
    ).then(({ default: WaveSurfer }) => {
      const playBtn = document.getElementById(`playBtn-${id}`);
      const iconPlay = document.getElementById(`iconPlay-${id}`);
      const iconPause = document.getElementById(`iconPause-${id}`);
      const currentTimeText = document.getElementById(`currentTime-${id}`);
      const durationTime = document.getElementById(`durationTime-${id}`);
      const statusIcon = document.getElementById(`statusIcon-${id}`);
      const statusLabel = document.getElementById(`statusLabel-${id}`);

      if (!playBtn || !currentTimeText || !durationTime) return;

      const isDark = document.documentElement.classList.contains("dark");

      const wavesurfer = WaveSurfer.create({
        container: `#waveform-${id}`,
        waveColor: isDark ? "#475569" : "#e2e8f0",
        progressColor: "#06b6d4",
        url: src,
        height: 40,
        barWidth: 3,
        barGap: 2,
        barRadius: 4,
        cursorWidth: 0,
        responsive: true,
      });

      const formatTime = (time) => {
        if (isNaN(time) || !isFinite(time)) return "0:00";
        const min = Math.floor(time / 60);
        const sec = Math.floor(time % 60)
          .toString()
          .padStart(2, "0");
        return `${min}:${sec}`;
      };

      wavesurfer.on("ready", () => {
        durationTime.innerText = formatTime(wavesurfer.getDuration());
      });

      wavesurfer.on("audioprocess", () => {
        currentTimeText.innerText = formatTime(wavesurfer.getCurrentTime());
      });

      wavesurfer.on("interaction", () => {
        currentTimeText.innerText = formatTime(wavesurfer.getCurrentTime());
      });

      playBtn.addEventListener("click", () => {
        wavesurfer.playPause();
      });

      wavesurfer.on("play", () => {
        iconPlay.classList.add("hidden");
        iconPause.classList.remove("hidden");
        playBtn.classList.add("is-playing");
        statusIcon.textContent = "🔊";
        statusIcon.setAttribute("aria-label", "reproduciendo");
        statusLabel.textContent = "Reproduciendo...";
      });

      wavesurfer.on("pause", () => {
        iconPlay.classList.remove("hidden");
        iconPause.classList.add("hidden");
        playBtn.classList.remove("is-playing");
        statusIcon.textContent = "🎧";
        statusIcon.setAttribute("aria-label", "audio disponible");
        statusLabel.textContent = "¿Prefieres escuchar este artículo?";
      });

      wavesurfer.on("finish", () => {
        iconPlay.classList.remove("hidden");
        iconPause.classList.add("hidden");
        currentTimeText.innerText = "0:00";
        playBtn.classList.remove("is-playing");
        statusIcon.textContent = "🎧";
        statusIcon.setAttribute("aria-label", "audio disponible");
        statusLabel.textContent = "¿Prefieres escuchar este artículo?";
      });
    });
  }

  function setupAudioPlayers() {
    document.querySelectorAll(".audio-player:not(.wavesurfer-initialized)").forEach((player) => {
      if ("IntersectionObserver" in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                observer.unobserve(entry.target);
                initPlayer(entry.target);
              }
            });
          },
          { rootMargin: "200px" }
        );
        observer.observe(player);
      } else {
        initPlayer(player);
      }
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupAudioPlayers);
  } else {
    setupAudioPlayers();
  }

  window.addEventListener("popstate", () => {
    setTimeout(setupAudioPlayers, 50);
  });
</script>

<style>
  /* Animación de pulso estético para el botón activo */
  @keyframes audio-pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(6, 182, 212, 0.4);
    }
    70% {
      box-shadow: 0 0 0 8px rgba(6, 182, 212, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(6, 182, 212, 0);
    }
  }

  .play-btn.is-playing {
    animation: audio-pulse 2s infinite;
  }
</style>
