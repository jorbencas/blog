---
// src/components/AudioPlayer.astro
interface Props {
  src: string;
}

const { src } = Astro.props;
const id = src ? Math.random().toString(36).substring(2, 9) : "";
---

{
  src && (
    <div
      class="bg-gray-50 dark:bg-zinc-900 border border-gray-200 dark:border-zinc-800 p-5 rounded-xl mb-8 transition-all duration-300 shadow-sm audio-player hover:shadow-md"
      data-id={id}
      data-src={src}
    >
      <p
        id={`statusText-${id}`}
        class="text-sm text-gray-700 dark:text-zinc-300 font-medium mb-4 flex items-center gap-2 select-none"
      >
        <span
          id={`statusIcon-${id}`}
          class="flex items-center justify-center w-5 h-5 text-base"
        >
          🎧
        </span>
        <span id={`statusLabel-${id}`}>¿Prefieres escuchar este artículo?</span>
      </p>

      <div class="flex items-center gap-4">
        <button
          id={`playBtn-${id}`}
          aria-label="Reproducir o pausar audio"
          class="flex-shrink-0 w-11 h-11 flex items-center justify-center bg-blue-600 hover:bg-blue-700 active:scale-95 text-white rounded-full transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-blue-400 focus:ring-offset-2 dark:focus:ring-offset-zinc-950 shadow-md shadow-blue-500/10 play-btn"
        >
          <svg
            id={`iconPlay-${id}`}
            class="w-5 h-5 ml-0.5 transition-transform duration-200"
            fill="currentColor"
            viewBox="0 0 24 24"
          >
            <path d="M8 5v14l11-7z" />
          </svg>
          <svg
            id={`iconPause-${id}`}
            class="w-5 h-5 hidden transition-transform duration-200"
            fill="currentColor"
            viewBox="0 0 24 24"
          >
            <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z" />
          </svg>
        </button>

        <div class="flex-1 wrapper-progress py-1">
          <div id={`waveform-${id}`} class="w-full" />
        </div>

        <div class="text-xs font-mono text-gray-500 dark:text-zinc-400 whitespace-nowrap min-w-[75px] text-right tabular-nums select-none">
          <span id={`currentTime-${id}`}>0:00</span>
          <span class="mx-0.5 text-gray-400">/</span>
          <span id={`durationTime-${id}`}>0:00</span>
        </div>
      </div>
    </div>
  )
}

<script>
  const { default: WaveSurfer } = await import(
    "https://unpkg.com/wavesurfer.js@7/dist/wavesurfer.esm.js"
  );

  function initAudioPlayers() {
    document.querySelectorAll(".audio-player").forEach((player) => {
      const id = player.getAttribute("data-id");
      const src = player.getAttribute("data-src");
      if (!id || !src) return;

      if (player.classList.contains("wavesurfer-initialized")) return;
      player.classList.add("wavesurfer-initialized");

      const playBtn = document.getElementById(`playBtn-${id}`);
      const iconPlay = document.getElementById(`iconPlay-${id}`);
      const iconPause = document.getElementById(`iconPause-${id}`);
      const currentTimeText = document.getElementById(`currentTime-${id}`);
      const durationTime = document.getElementById(`durationTime-${id}`);

      if (!playBtn || !currentTimeText || !durationTime) return;

      const isDark = document.documentElement.classList.contains("dark");

      const wavesurfer = WaveSurfer.create({
        container: `#waveform-${id}`,
        waveColor: isDark ? "#3f3f46" : "#e5e7eb",
        progressColor: "#2563eb",
        url: src,
        height: 40,
        barWidth: 3,
        barGap: 2,
        barRadius: 4,
        cursorWidth: 0,
        responsive: true,
      });

      const formatTime = (time: number) => {
        if (isNaN(time) || !isFinite(time)) return "0:00";
        const min = Math.floor(time / 60);
        const sec = Math.floor(time % 60)
          .toString()
          .padStart(2, "0");
        return `${min}:${sec}`;
      };

      wavesurfer.on("ready", () => {
        durationTime.innerText = formatTime(wavesurfer.getDuration());
      });

      wavesurfer.on("audioprocess", () => {
        currentTimeText.innerText = formatTime(wavesurfer.getCurrentTime());
      });

      wavesurfer.on("interaction", () => {
        currentTimeText.innerText = formatTime(wavesurfer.getCurrentTime());
      });

      playBtn.addEventListener("click", () => {
        wavesurfer.playPause();
      });

      wavesurfer.on("play", () => {
        iconPlay.classList.add("hidden");
        iconPause.classList.remove("hidden");
        playBtn.classList.add("is-playing");
      });

      wavesurfer.on("pause", () => {
        iconPlay.classList.remove("hidden");
        iconPause.classList.add("hidden");
        playBtn.classList.remove("is-playing");
      });

      wavesurfer.on("finish", () => {
        currentTimeText.innerText = "0:00";
      });
    });
  }

  document.addEventListener("audio-player", initAudioPlayers);
</script>

<style>
  /* Animación de pulso estético para el botón activo */
  @keyframes audio-pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(37, 99, 235, 0.4);
    }
    70% {
      box-shadow: 0 0 0 8px rgba(37, 99, 235, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(37, 99, 235, 0);
    }
  }

  .play-btn.is-playing {
    animation: audio-pulse 2s infinite;
  }

  /* Un ligero efecto de escalado en la onda al pasar el ratón por encima */
  .wrapper-progress {
    transition: transform 0.2s ease;
  }
  .wrapper-progress:hover {
    transform: scaleY(1.05);
  }
</style>
