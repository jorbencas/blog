---
import ResponsiveImage from "@components/ResponsiveImage.astro";
import { resolveImagePath } from "src/utils.js";
interface Props {
  title: string;
  description: string;
  image: string;
  tags: string[];
  id: string;
  repository?: string;
  pubDate?: string;
}

const { title, description, image, tags, id, repository, pubDate } = Astro.props;

const imagenLimpia = resolveImagePath(image);

const date = pubDate
  ? new Date(pubDate).toLocaleDateString("es-ES", {
      year: "numeric",
      month: "short",
      day: "2-digit",
    })
  : null;
---

<div
  class="group relative bg-white dark:bg-slate-900/50 overflow-hidden hover:border-purple-500/50 border border-slate-200 dark:border-transparent h-full flex flex-col"
>
  <div class="relative aspect-video overflow-hidden">
    <div
      class="absolute inset-0 from-white dark:from-slate-950 via-transparent to-transparent z-10 opacity-80 transition-opacity group-hover:opacity-40"
    >
    </div>
    {
      imagenLimpia ? (
        <ResponsiveImage
          fallback={imagenLimpia}
          alt={title}
          imgClass="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110 opacity-70 group-hover:opacity-100"
        />
      ) : (
        <div class="w-full h-full bg-slate-200 dark:bg-slate-800 flex items-center justify-center">
          <span class="text-slate-500 dark:text-slate-600 text-xs sm:text-sm">
            SIN_IMAGEN
          </span>
        </div>
      )
    }

    {
      date && (
        <div class="absolute bottom-3 left-4 z-20 bg-white dark:bg-slate-900">
          <time
            class="text-xs sm:text-sm text-purple-500 dark:text-purple-400 uppercase tracking-[0.2em] font-black bg-white dark:bg-slate-950 px-2 py-1 rounded-sm border border-purple-500"
          >
            {date}
          </time>
        </div>
      )
    }
  </div>

  <div class="p-5 flex-1 flex flex-col space-y-3 bg-white dark:bg-slate-900">
    <div class="flex gap-2 flex-wrap">
      {
        tags?.length > 0 &&
          tags.map((tag) => (
            <div class="bg-gradient-to-r from-purple-800 to-purple-500 px-3 py-1 text-xs sm:text-sm font-bold uppercase tracking-wider text-white">
              {tag}
            </div>
          ))
      }
    </div>

    <div class="flex-1">
      <h3
        class="text-lg font-black uppercase italic tracking-tighter text-slate-900 dark:text-white group-hover:text-purple-600 dark:group-hover:text-purple-400 transition-colors leading-tight"
      >
        {title}
      </h3>
      <p
        class="text-sm sm:text-base text-slate-500 dark:text-slate-400 line-clamp-2 mt-2 leading-relaxed font-medium italic opacity-80"
      >
        "{description}"
      </p>
    </div>

    <div class="flex items-center justify-between pt-4 mt-auto">
      <a
        href={`/proyectos/${id}`}
        class="group/link relative text-xs sm:text-sm font-black uppercase text-slate-900 dark:text-white overflow-hidden pb-1 transition-colors hover:text-purple-600 dark:hover:text-purple-400"
      >
        Detalles_ <span
          class="inline-block transition-transform group-hover/link:translate-x-1"
          >→</span
        >
        <span
          class="absolute bottom-0 left-0 w-0 h-[1px] bg-purple-500 transition-all duration-300 group-hover/link:w-full"
        ></span>
      </a>

      {
        repository && (
          <a
            href={repository}
            target="_blank"
            aria-label="Ver Repositorio"
            class="p-2 bg-slate-100 dark:bg-white/5 rounded-lg text-slate-500 dark:hover:text-white"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="group-hover/git:scale-110 transition-transform"
            >
              <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.28 1.15-.28 2.35 0 3.5-.73 1.02-1.08 2.25-1 3.5 0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
              <path d="M9 18c-4.51 2-4.51-2-7-2" />
            </svg>
          </a>
        )
      }
    </div>
  </div>
</div>
