---
interface Props {
  title: string;
  description: string;
  image: string;
  tags: string[];
  id: string;
  repository?: string;
}

const { title, description, image, tags, id, repository } = Astro.props;
---

<div
  class="group relative bg-slate-900/50 overflow-hidden
 transition-all duration-500 hover:-translate-y-2 hover:border-purple-500/50
 hover:shadow-[0_20px_50px_rgba(168,85,247,0.15)] h-full flex flex-col"
>
  <!-- Imagen con Overlay Dinámico -->
  <div class="relative aspect-video overflow-hidden border-b">
    <div
      class="absolute inset-0 bg-gradient-to-t from-slate-950 via-transparent to-transparent z-10 opacity-80 transition-opacity group-hover:opacity-40"
    >
    </div>
    <img
      src={image}
      alt={title}
      class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110 opacity-70 group-hover:opacity-100"
    />

    <!-- Badge de Categoría (Opcional decorativo) -->
    <div class="absolute top-4 left-4 z-20">
      <span
        class="text-[8px] font-black uppercase tracking-[0.3em] bg-purple-500 text-white px-2 py-0.5 rounded-sm shadow-lg shadow-purple-500/20"
      >
        Project_File
      </span>
    </div>
  </div>

  <div class="p-6 space-y-5 flex-1 flex flex-col">
    <!-- Tags Estilo Consola -->
    <div class="flex gap-2 flex-wrap">
      {
        tags.map((tag) => (
          <span class="text-[9px] font-black px-2 py-0.5 bg-purple-500/5 text-purple-400 border border-purple-500/20 uppercase tracking-widest rounded-sm transition-colors group-hover:bg-purple-500/10">
            {tag}
          </span>
        ))
      }
    </div>

    <div class="flex-1">
      <h3
        class="text-xl font-black italic uppercase tracking-tighter text-white group-hover:text-purple-400 transition-colors duration-300"
      >
        {title}
      </h3>
      <p
        class="text-sm text-slate-400 line-clamp-2 mt-2 leading-relaxed font-medium italic opacity-80"
      >
        "{description}"
      </p>
    </div>

    <!-- Enlaces de Acción -->
    <div class="flex items-center justify-between pt-4 border-t mt-auto">
      <a
        href={`/proyectos/${id}`}
        class="group/link relative text-[10px] font-black uppercase tracking-[0.2em] text-white overflow-hidden pb-1 transition-colors hover:text-purple-400"
      >
        Detalles_ <span
          class="inline-block transition-transform group-hover/link:translate-x-1"
          >→</span
        >
        <span
          class="absolute bottom-0 left-0 w-0 h-[1px] bg-purple-500 transition-all duration-300 group-hover/link:w-full"
        ></span>
      </a>

      {
        repository && (
          <a
            href={repository}
            target="_blank"
            aria-label="Ver Repositorio"
            class="p-2 bg-white/5 rounded-lg text-slate-500 hover:text-white hover:bg-purple-500/20 transition-all duration-300 group/git"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="group-hover/git:scale-110 transition-transform"
            >
              <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.28 1.15-.28 2.35 0 3.5-.73 1.02-1.08 2.25-1 3.5 0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
              <path d="M9 18c-4.51 2-4.51-2-7-2" />
            </svg>
          </a>
        )
      }
    </div>
  </div>

  <!-- Efecto Shimmer (Brillo metálico al pasar el ratón) -->
  <div
    class="absolute top-0 left-[-100%] w-1/2 h-full bg-gradient-to-r from-transparent via-white/5 to-transparent skew-x-[-25deg] group-hover:left-[150%] transition-all duration-1000 ease-in-out pointer-events-none"
  >
  </div>
</div>
