---
interface Props {
  title: string;
  description: string;
  image: string;
  tags: string[];
  id: string;
  repository?: string;
}

const { title, description, image, tags, id, repository } = Astro.props;
---

<div class="group relative bg-slate-900/50 border border-white/5 rounded-2xl overflow-hidden hover:border-purple-500/50 transition-all duration-500">
  <!-- Imagen con Overlay -->
  <div class="aspect-video overflow-hidden">
    <img 
      src={image} 
      alt={title} 
      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110 opacity-80 group-hover:opacity-100"
    />
  </div>

  <div class="p-6 space-y-4">
    <div class="flex gap-2 flex-wrap">
      {tags.map((tag) => (
        <span class="text-[9px] font-mono px-2 py-0.5 bg-purple-500/10 text-purple-400 border border-purple-500/20 rounded">
          {tag}
        </span>
      ))}
    </div>

    <div>
      <h3 class="text-xl font-black italic uppercase text-white group-hover:text-purple-400 transition-colors">
        {title}
      </h3>
      <p class="text-sm text-slate-400 line-clamp-2 mt-2">
        {description}
      </p>
    </div>

    <div class="flex items-center justify-between pt-2">
      <a href={`/proyectos/${id}`} class="text-xs font-bold uppercase tracking-widest text-white hover:underline underline-offset-4">
        Detalles_
      </a>
      {repository && (
        <a href={repository} target="_blank" class="text-slate-500 hover:text-white transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.28 1.15-.28 2.35 0 3.5-.73 1.02-1.08 2.25-1 3.5 0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path><path d="M9 18c-4.51 2-4.51-2-7-2"></path></svg>
        </a>
      )}
    </div>
  </div>
</div>