---
const { next, prev } = Astro.params;
let urlNext = next ? new URL("" + next, Astro.site) : '';
let urlPreview = prev ? new URL("" + prev, Astro.site) : '';
---

<ul class="flex justify-between items-center mb-4">
  {
    next && (
      <li class="mx-2">
        <a
          class="text-sm font-medium text-cyan-400 hover:underline dark:text-cyan-500"
          href={urlNext}
        >
          Posteriores
        </a>
      </li>
    )
  }
  {
    prev && (
      <li class="mx-2">
        <a
          class="text-sm font-medium text-cyan-400 hover:underline dark:text-cyan-500"
          href={urlPreview}
        >
          Ateriores
        </a>
      </li>
    )
  }
</ul>
