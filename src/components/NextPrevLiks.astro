---
import { makeUrl } from "src/utils";
const { nextURL, prevURL, textNext, textPrev } = Astro.props;
---

<ul class="flex justify-between items-center mb-4">
  {
    nextURL && (
      <li class="mx-2">
        <a
          class="text-sm font-medium text-cyan-400 hover:underline dark:text-cyan-500"
          href={makeUrl(nextURL, Astro)}
        >
          {textNext}
        </a>
      </li>
    )
  }
  {
    prevURL && (
      <li class="mx-2">
        <a
          class="text-sm font-medium text-cyan-400 hover:underline dark:text-cyan-500"
          href={makeUrl(prevURL, Astro)}
        >
          {textPrev}
        </a>
      </li>
    )
  }
</ul>
