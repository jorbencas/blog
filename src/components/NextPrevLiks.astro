---
import PaginationLinks from "./PaginationLinks.astro";
const { nextURL, prevURL, textNext, textPrev, imageNext, imagePrev } =
  Astro.props;
---

<ul class="flex justify-center items-center">
  {
    nextURL && (
      <PaginationLinks url={nextURL} image={imageNext} text={textNext} />
    )
  }
  {
    prevURL && (
      <PaginationLinks url={prevURL} image={imagePrev} text={textPrev} />
    )
  }
</ul>
