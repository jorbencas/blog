---
const { nextURL, prevURL, textNext, textPrev } = Astro.props;

let urlNext =
  nextURL !== undefined
    ? new URL("" + nextURL, Astro.request.url)
    : new URL("", Astro.request.url);
let urlPreview =
  prevURL !== undefined
    ? new URL("" + prevURL, Astro.request.url)
    : new URL("", Astro.request.url);
---

<ul class="flex justify-between items-center mb-4">
  {
    nextURL && (
      <li class="mx-2">
        <a
          class="text-sm font-medium text-cyan-400 hover:underline dark:text-cyan-500"
          href={urlNext}
        >
          {textNext}
        </a>
      </li>
    )
  }
  {
    prevURL && (
      <li class="mx-2">
        <a
          class="text-sm font-medium text-cyan-400 hover:underline dark:text-cyan-500"
          href={urlPreview}
        >
          {textPrev}
        </a>
      </li>
    )
  }
</ul>
