<div class="relative w-full max-w-2xl mx-auto px-2 sm:px-0">
  <div class="relative group">
    <svg
      class="absolute left-3 sm:left-4 top-1/2 -translate-y-1/2 w-4 h-4 sm:w-5 sm:h-5 text-slate-400 transition-colors group-focus-within:text-cyan-500"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
    </svg>

    <input
      id="search-input"
      type="text"
      placeholder="BUSCAR EN LA BITÁCORA..."
      aria-label="Buscar en el blog"
      aria-controls="search-results"
      autocomplete="off"
      class="w-full p-3 sm:p-4 pl-10 sm:pl-12 pr-10 sm:pr-20 transition-all duration-300
 bg-white dark:bg-slate-900 text-slate-900 dark:text-slate-100
 placeholder-slate-500 dark:placeholder-slate-400
 focus:outline-none
 font-black uppercase tracking-widest text-xs sm:text-xs"
    />
  </div>

  <div
    id="search-results"
    class="absolute w-full left-0 mt-1 overflow-y-auto max-h-[60vh] sm:max-h-[450px] hidden
  bg-white dark:bg-slate-900 z-50 rounded-b-xl border border-slate-200 dark:border-slate-800 shadow-xl"
  >
  </div>
</div>

<style is:global>
  /* Personalización del resaltado (Highlight) de Pagefind */
  mark {
    background-color: rgba(6, 182, 212, 0.15) !important;
    color: #06b6d4 !important;
    font-weight: 800;
    padding: 0 1px;
  }
  html.dark mark {
    background-color: rgba(34, 211, 238, 0.2) !important;
    color: #22d3ee !important;
  }

  /* Scrollbar personalizado para los resultados */
  #search-results::-webkit-scrollbar {
    width: 4px;
  }
  #search-results::-webkit-scrollbar-track {
    background: transparent;
  }
  #search-results::-webkit-scrollbar-thumb {
    background: #06b6d4;
  }
</style>

<script>
const initSearch = async () => {
  const input = document.querySelector("#search-input");
  const container = document.querySelector("#search-results");
  let pagefind;
  let loading = false;

  const showLoading = () => {
    container.innerHTML = `
<div class="p-6 text-center">
<p class="text-xs font-black uppercase tracking-[0.3em] text-cyan-500 dark:text-cyan-400">
Buscando...
</p>
</div>`;
    container.classList.remove("hidden");
  };

  const showEmpty = () => {
    container.innerHTML = `
<div class="p-10 text-center">
<p class="text-xs font-black uppercase tracking-[0.3em] text-slate-500">
0 resultados encontrados
</p>
</div>`;
    container.classList.remove("hidden");
  };

  try {
    pagefind = await import("/pagefind/pagefind.js");
    await pagefind.options({ highlightParam: "highlight" });
  } catch (e) {
    container.innerHTML = `
<div class="p-6 text-center">
<p class="text-xs font-black uppercase tracking-[0.3em] text-amber-500">
El índice de búsqueda solo está disponible tras <code class="font-mono">npm run build &amp;&amp; npm run preview</code>
</p>
</div>`;
    container.classList.remove("hidden");
    console.error("Pagefind no encontrado. Haz 'npm run build' para generarlo.");
  }

  let debounceTimer;
  input?.addEventListener("input", (e) => {
    clearTimeout(debounceTimer);
    const query = e.target.value;
    if (query.length > 2) {
      if (!pagefind) return;
      showLoading();
      debounceTimer = setTimeout(async () => {
        loading = true;
        const search = await pagefind.search(query);
        const results = await Promise.all(
          search.results.slice(0, 6).map((r) => r.data())
        );
        loading = false;

        container.innerHTML = "";

        if (results.length === 0) {
          showEmpty();
        } else {
          container.setAttribute("role", "listbox");
          results.forEach((item, index) => {
            const div = document.createElement("div");
            div.className = "group transition-all hover:bg-slate-100 dark:hover:bg-cyan-500/5";
            div.setAttribute("role", "option");
            div.setAttribute("id", `search-result-${index}`);

            const urlType =
              item.url.includes("/proyectos/") ? "proyecto" :
              item.url.includes("/herramientas/") ? "herramienta" :
              item.url.includes("/retos/") ? "reto" : "post";

            const typeConfig = {
              proyecto: { label: "PROYECTO", color: "text-purple-500" },
              herramienta: { label: "HERRAMIENTA", color: "text-emerald-500" },
              reto: { label: "CHALLENGE", color: "text-cyan-500" },
              post: { label: "BLOG_POST", color: "text-slate-500 dark:text-slate-400" },
            };

            const { label, color: labelColor } = typeConfig[urlType];

            div.innerHTML = `
<a href="${item.url}" class="block p-5 sm:p-6">
<div class="flex items-center gap-2 mb-2">
<span class="text-xs px-1.5 py-0.5 ${labelColor} opacity-70">
${label}
</span>
</div>
<h3 class="font-black text-sm sm:text-base text-slate-900 dark:text-white uppercase italic tracking-tighter group-hover:text-cyan-600 dark:group-hover:text-cyan-500 transition-colors">
${item.meta.title}
</h3>
<p class="text-slate-500 dark:text-slate-400 text-xs mt-2 line-clamp-2 leading-relaxed font-medium">
${item.excerpt}
</p>
</a>`;
            container.appendChild(div);
          });
        }
        container.classList.remove("hidden");
      }, 300);
    } else {
      container.classList.add("hidden");
    }
  });

  document.addEventListener("click", (e) => {
    if (!input.contains(e.target) && !container.contains(e.target)) {
      container.classList.add("hidden");
    }
  });

  document.addEventListener("keydown", (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === "k") {
      e.preventDefault();
      input?.focus();
    }
    if (e.key === "Escape") {
      container.classList.add("hidden");
      input?.blur();
    }
  });

  let activeIndex = -1;
  input?.addEventListener("keydown", (e) => {
    const items = container.querySelectorAll("[role='option']");
    if (!container.classList.contains("hidden") && items.length > 0) {
      if (e.key === "ArrowDown") {
        e.preventDefault();
        activeIndex = Math.min(activeIndex + 1, items.length - 1);
        items.forEach((el, i) => el.classList.toggle("bg-slate-100 dark:bg-cyan-500/5", i === activeIndex));
        items[activeIndex]?.querySelector("a")?.focus();
      } else if (e.key === "ArrowUp") {
        e.preventDefault();
        activeIndex = Math.max(activeIndex - 1, 0);
        items.forEach((el, i) => el.classList.toggle("bg-slate-100 dark:bg-cyan-500/5", i === activeIndex));
        items[activeIndex]?.querySelector("a")?.focus();
      }
    }
  });
};

initSearch();
document.addEventListener("astro:page-load", initSearch);
</script>
