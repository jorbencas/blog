<div class="relative w-full">
  <div class="relative group">
    <input
      id="search-input"
      type="text"
      placeholder="BUSCAR EN LA BITÁCORA..."
      aria-label="Buscar en el blog"
      aria-controls="search-results"
      autocomplete="off"
      class="w-full p-3 sm:p-4 lg:p-5 pr-10 sm:pr-20 transition-all duration-300
 bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-slate-100
 placeholder-slate-500 dark:placeholder-slate-400
 focus:outline-none
 font-black uppercase tracking-widest text-xs sm:text-sm lg:text-base"
    />
  </div>

  <div
    id="search-results"
    class="absolute w-full left-0 mt-1 overflow-y-auto max-h-[60vh] sm:max-h-[450px] hidden
  bg-white dark:bg-slate-900 z-50 rounded-b-xl border border-slate-200 dark:border-slate-800 shadow-xl"
  >
  </div>
</div>

<style is:global>
  /* Personalización del resaltado (Highlight) de Pagefind */
  mark {
    background-color: rgba(6, 182, 212, 0.15) !important;
    color: #06b6d4 !important;
    font-weight: 800;
    padding: 0 1px;
  }
  html.dark mark {
    background-color: rgba(34, 211, 238, 0.2) !important;
    color: #22d3ee !important;
  }

  /* Scrollbar personalizado para los resultados */
  #search-results::-webkit-scrollbar {
    width: 4px;
  }
  #search-results::-webkit-scrollbar-track {
    background: transparent;
  }
  #search-results::-webkit-scrollbar-thumb {
    background: #06b6d4;
  }
</style>

<script>
  let searchAbort = null;

  const initSearch = async () => {
    if (searchAbort) searchAbort.abort();
    searchAbort = new AbortController();
    const signal = searchAbort.signal;

    const input = document.querySelector("#search-input");
    const container = document.querySelector("#search-results");
    if (!input || !container) return;

    let pagefind;

    try {
      if (import.meta.env.PROD) {
        const mod = "/pagefind/pagefind.js";
        pagefind = await import(/* @vite-ignore */ mod);
        await pagefind.options({ highlightParam: "highlight" });
      }
    } catch (e) {
      container.innerHTML = `
<div class="p-6 text-center">
<p class="text-xs font-black uppercase tracking-[0.3em] text-amber-500">
El índice de búsqueda solo está disponible tras <code class="font-mono">npm run build &amp;&amp; npm run preview</code>
</p>
</div>`;
      container.classList.remove("hidden");
    }

    let debounceTimer;
    let searchGeneration = 0;

    input.addEventListener("input", (e) => {
      clearTimeout(debounceTimer);
      const query = e.target.value;
      if (query.length > 2) {
        if (!pagefind) return;
        container.innerHTML = `
<div class="p-6 text-center">
<p class="text-xs font-black uppercase tracking-[0.3em] text-cyan-500 dark:text-cyan-400">
Buscando...
</p>
</div>`;
        container.classList.remove("hidden");
        const gen = ++searchGeneration;
        debounceTimer = setTimeout(async () => {
          const search = await pagefind.search(query);
          if (gen !== searchGeneration) return;
          const items = await Promise.all(
            search.results.slice(0, 6).map((r) => r.data())
          );
          if (gen !== searchGeneration) return;

          container.innerHTML = "";
          if (items.length === 0) {
            container.innerHTML = `
<div class="p-10 text-center">
<p class="text-xs font-black uppercase tracking-[0.3em] text-slate-500">
0 resultados encontrados
</p>
</div>`;
          } else {
            container.setAttribute("role", "listbox");
            items.forEach((item, index) => {
              const urlType = item.url.includes("/proyectos/") ? "proyecto" : "post";
              const typeConfig = {
                proyecto: { label: "PROYECTO", color: "text-purple-500" },
                post: { label: "BLOG_POST", color: "text-slate-500 dark:text-slate-400" },
              };
              const { label, color: labelColor } = typeConfig[urlType];

              const div = document.createElement("div");
              div.className = "group transition-all hover:bg-slate-100 dark:hover:bg-cyan-500/5";
              div.setAttribute("role", "option");
              div.setAttribute("id", `search-result-${index}`);

              const a = document.createElement("a");
              a.href = item.url;
              a.className = "block p-5 sm:p-6";
              a.innerHTML = `
                <div class="flex items-center gap-2 mb-2">
                  <span class="text-xs px-1.5 py-0.5 ${labelColor} opacity-70">${label}</span>
                </div>
                <h3 class="font-black text-sm sm:text-base text-slate-900 dark:text-white uppercase italic tracking-tighter group-hover:text-cyan-600 dark:group-hover:text-cyan-500 transition-colors">${item.meta.title}</h3>
                <p class="text-slate-500 dark:text-slate-400 text-xs mt-2 line-clamp-2 leading-relaxed font-medium">${item.excerpt}</p>`;
              div.appendChild(a);
              container.appendChild(div);
            });
          }
          container.classList.remove("hidden");
        }, 300);
      } else {
        container.classList.add("hidden");
      }
    }, { signal });

    document.addEventListener("click", (e) => {
      if (!input.contains(e.target) && !container.contains(e.target)) {
        container.classList.add("hidden");
      }
    }, { signal });

    let activeIndex = -1;
    input.addEventListener("keydown", (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key === "k") {
        e.preventDefault();
        input.focus();
      }
      if (e.key === "Escape") {
        container.classList.add("hidden");
        input.blur();
      }
      const items = container.querySelectorAll("[role='option']");
      if (!container.classList.contains("hidden") && items.length > 0) {
        if (e.key === "ArrowDown") {
          e.preventDefault();
          activeIndex = Math.min(activeIndex + 1, items.length - 1);
          items.forEach((el, i) => el.classList.toggle("bg-slate-100 dark:bg-cyan-500/5", i === activeIndex));
          items[activeIndex]?.querySelector("a")?.focus();
        } else if (e.key === "ArrowUp") {
          e.preventDefault();
          activeIndex = Math.max(activeIndex - 1, 0);
          items.forEach((el, i) => el.classList.toggle("bg-slate-100 dark:bg-cyan-500/5", i === activeIndex));
          items[activeIndex]?.querySelector("a")?.focus();
        }
      }
    }, { signal });
  };

  document.addEventListener("astro:page-load", initSearch);
</script>
