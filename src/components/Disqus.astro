---
interface Props {
  url: string;
  identifier: string;
  title: string;
}

const { url, identifier, title } = Astro.props;
---

<div id="disqus_thread" class="mt-16 pt-12 border-t border-slate-200 dark:border-slate-800">
  <span class="text-base font-bold uppercase tracking-[0.3em] text-slate-500 dark:text-slate-400 block pb-6 w-fit">
    COMENTARIOS:
  </span>
</div>

<script is:inline define:vars={{ url, identifier, title }}>
  var disqus_config = function () {
    this.page.url = url;
    this.page.identifier = identifier;
    this.page.title = title;
    this.page.remote_auth_s3 = undefined;
    this.page.api_key = undefined;
  };

  function getDisqusTheme() {
    return document.documentElement.classList.contains('dark') ? 'dark' : 'light';
  }

  function loadDisqus() {
    var d = document, s = d.createElement('script');
    s.src = 'https://jorbencas.disqus.com/embed.js';
    s.setAttribute('data-timestamp', +new Date());
    s.setAttribute('data-disqus-embed', getDisqusTheme());
    (d.head || d.body).appendChild(s);
  }

  loadDisqus();

  var observer = new MutationObserver(function () {
    var frame = document.querySelector('#disqus_thread iframe');
    if (frame && frame.contentDocument) {
      var html = frame.contentDocument.documentElement;
      if (html) {
        var isDark = document.documentElement.classList.contains('dark');
        if (isDark) {
          html.classList.add('dark');
          html.classList.remove('light');
        } else {
          html.classList.add('light');
          html.classList.remove('dark');
        }
      }
    }
  });

  observer.observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['class'],
    subtree: false
  });
</script>

<noscript>
  <p class="text-sm text-slate-500 dark:text-slate-400">
    Habilita JavaScript para ver los <a href="https://disqus.com/?ref_noscript" class="text-cyan-600 dark:text-cyan-400">comentarios de Disqus</a>.
  </p>
</noscript>
