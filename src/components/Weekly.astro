---
import { formatDatePost } from "src/utils.js";

const { post } = Astro.props;
const tags = post.data.tags || [];
const postUrl = `/weekly/${post.id}`;
const isWeekly = tags.some(tag => tag.toLowerCase() === 'weekly' || tag.toLowerCase() === 'recap');
---

<li class={`group list-none flex font-sans h-[480px] ${isWeekly ? 'relative p-[2px] bg-gradient-to-br from-cyan-500 via-purple-500 to-blue-500 rounded-lg' : ''}`}>
  
  {isWeekly && (
    <div class="absolute -top-3 -right-3 z-20 bg-yellow-400 text-black font-black px-3 py-1 text-[10px] uppercase italic shadow-lg rotate-12 border-2 border-black">
      RECAP_SEMANAL
    </div>
  )}

  <a
    href={postUrl}
    class={`relative w-full h-full overflow-hidden flex flex-col justify-end transition-all duration-500 ${isWeekly ? 'bg-slate-950 rounded-md' : 'border border-slate-200 border-white/5 bg-white bg-slate-950 shadow-xl'}`}
  >
    <div class="absolute inset-0 z-0">
      <img
        class="h-full w-full object-cover transition-transform duration-1000 group-hover:scale-110 opacity-80 opacity-40"
        src={post.data.image}
        alt={post.data.title}
      />
      <div class="absolute inset-0 bg-gradient-to-t from-white via-white/90 from-slate-950 via-slate-950/90 to-transparent"></div>
    </div>

    <div class="relative z-10 p-8">
      <div class="mb-4 flex items-center gap-3">
        <span class={`h-[2px] transition-all group-hover:w-16 ${isWeekly ? 'w-12 bg-yellow-400' : 'w-8 bg-cyan-500'}`}></span>
        <span class="text-[10px] font-black tracking-[0.2em] text-cyan-400 font-mono uppercase">
          {formatDatePost(post.data.pubDate)}
        </span>
      </div>
      
      <h3 class="mb-3 text-2xl md:text-3xl font-black leading-tight text-slate-900 text-white uppercase italic group-hover:text-cyan-400">
        {post.data.title}
      </h3>
      
      <p class="mb-6 line-clamp-2 text-sm text-slate-600 text-slate-400 font-medium">
        {post.data.description}
      </p>

      <div class="flex flex-wrap gap-2">
        {tags.slice(0, 3).map((tag) => (
          <div class="bg-gradient-to-r from-slate-800 to-slate-900 border border-white/10 px-3 py-1 text-[9px] font-black uppercase text-cyan-400">
            {tag}
          </div>
        ))}
      </div>
    </div>
  </a>
</li>