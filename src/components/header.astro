---
import Buscador from "./Buscador.astro";
import Navbar from "./Navbar.astro";
import ToggleButton from "./ToggleButton.astro";
---

<header
  class="sticky top-0 w-full min-h-[80px] lg:min-h-0 bg-white dark:bg-slate-900/80 transition-colors duration-500 z-50 border-b border-slate-100 dark:border-slate-800/50"
>
  <div class="max-w-screen-xl mx-auto px-4 sm:px-6">
    <div
      class="flex flex-col lg:flex-row items-center justify-between gap-y-4 py-4 md:py-6"
    >
      <a
        href="/"
        class="flex items-center group transition-transform active:scale-95 w-full lg:w-auto justify-center lg:justify-start pr-14 lg:pr-0"
      >
        <h2
          class="text-sm sm:text-lg md:text-xl xl:text-2xl font-black uppercase tracking-tighter italic leading-tight text-center lg:text-left"
        >
          <span
            class="bg-clip-text text-transparent bg-gradient-to-r from-sky-800 to-cyan-500 dark:from-sky-400 dark:to-cyan-300"
          >
            Problemas de un desarrollador
          </span>
          <span class="text-slate-900 dark:text-white ml-1">Web</span>
        </h2>
      </a>

      <div class="w-full lg:w-auto flex justify-center order-3 lg:order-2">
        <Navbar />
      </div>

      <div
        class="flex items-center justify-center gap-2 w-full lg:w-auto order-2 lg:order-3"
      >
        <div class="flex items-center gap-1 p-1 px-3 w-full lg:w-auto">
          <Buscador />
          <div class="w-[1px] h-4 bg-slate-300 dark:bg-white/20 mx-1"></div>
          <ToggleButton />
        </div>
      </div>
    </div>
  </div>
</header>