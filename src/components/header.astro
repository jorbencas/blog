---
import Buscador from "./Buscador.astro";
import Navbar from "./Navbar.astro";
import ToggleButton from "./ToggleButton.astro";
import SearchOverlay from "./SearchOverlay.astro";
---

<header
  id="site-header"
  class="sticky top-0 w-full bg-slate-50 dark:bg-slate-900/80 transition-all duration-300 z-50 border-b border-slate-200 dark:border-slate-800/50"
>
  <div class="max-w-screen-xl mx-auto px-4 sm:px-6">
    <div class="flex items-center justify-between h-16 md:h-20">
      <a
        href="/"
        class="flex items-center group transition-transform active:scale-95 shrink-0"
      >
        <h2
          class="text-sm sm:text-base md:text-xl xl:text-2xl font-black uppercase tracking-tighter italic leading-tight"
        >
          <span
            class="hidden sm:inline bg-clip-text text-transparent bg-gradient-to-r from-sky-800 to-cyan-500 dark:from-sky-400 dark:to-cyan-300"
          >
            Problemas de un desarrollador
          </span>
          <span
            class="sm:hidden bg-clip-text text-transparent bg-gradient-to-r from-sky-800 to-cyan-500 dark:from-sky-400 dark:to-cyan-300"
          >
            jorbencas
          </span>
          <span class="text-slate-900 dark:text-white ml-1">Web</span>
        </h2>
      </a>

      <div class="flex items-center gap-0.5 sm:gap-1">
        <div class="lg:block lg:flex-1 lg:min-w-0">
          <Buscador />
        </div>
        <div class="lg:block w-[1px] h-4 bg-slate-300 dark:bg-white/20 mx-1">
        </div>

        <button
          id="search-toggle"
          class="lg:hidden flex items-center justify-center h-9 w-9 rounded-lg text-slate-500 dark:text-slate-400 hover:text-cyan-600 dark:hover:text-cyan-400 hover:bg-slate-100 dark:hover:bg-slate-800 transition-all duration-200"
          aria-label="Abrir búsqueda"
        >
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        </button>

        <ToggleButton />
        <Navbar />
      </div>
    </div>
  </div>
</header>

<div
  id="menu-backdrop"
  class="fixed inset-0 z-30 bg-black/40 opacity-0 pointer-events-none transition-opacity duration-300 ease-out lg:hidden"
>
</div>

<SearchOverlay />

<style>
  #menu-backdrop.open {
    opacity: 1;
    pointer-events: auto;
  }
</style>
