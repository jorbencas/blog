---
import ToogleBotton from "./ToogleBotton.astro";
import Buscador from "./buscador.astro";

// Lógica para detectar la página activa
const pathname = new URL(Astro.url).pathname;
---

<header
  class="relative w-full border-b border-slate-200 dark:border-white/10 bg-white dark:bg-slate-900 transition-colors duration-500 z-50"
>
  <div
    class="max-w-screen-xl mx-auto flex flex-col md:flex-row items-center justify-between gap-4 py-4 px-6 md:py-6"
  >
    <a
      href="/"
      class="flex items-center group transition-transform active:scale-95 w-full md:w-auto justify-center md:justify-start"
    >
      <h2
        class="text-lg md:text-2xl font-black uppercase tracking-tighter italic leading-tight text-center md:text-left"
      >
        <span
          class="bg-clip-text text-transparent bg-gradient-to-r from-sky-800 to-cyan-500"
        >
          Problemas de un desarrollador
        </span>
        <span class="text-slate-900 dark:text-white ml-1">Web</span>
      </h2>
    </a>

    <nav class="flex items-center gap-6 md:gap-8 order-3 md:order-2">
      <a
        href="/posts"
        class={`relative text-[11px] md:text-xs font-black uppercase tracking-[0.2em] italic transition-colors ${
          pathname.includes("/posts")
            ? "text-cyan-500"
            : "text-slate-500 dark:text-slate-400 hover:text-cyan-500"
        }`}
      >
        Bitácora
        {
          pathname.includes("/posts") && (
            <span class="absolute -bottom-1 left-0 w-full h-0.5 bg-cyan-500 animate-in fade-in zoom-in duration-300" />
          )
        }
      </a>

      <a
        href="/retos"
        class={`relative text-[11px] md:text-xs font-black uppercase tracking-[0.2em] italic transition-colors ${
          pathname.includes("/retos")
            ? "text-cyan-500"
            : "text-slate-500 dark:text-slate-400 hover:text-cyan-500"
        }`}
      >
        Retos
        {
          pathname.includes("/retos") && (
            <span class="absolute -bottom-1 left-0 w-full h-0.5 bg-cyan-500 animate-in fade-in zoom-in duration-300" />
          )
        }
      </a>
    </nav>

    <div
      class="flex items-center justify-center gap-4 w-full md:w-auto border-t md:border-t-0 border-slate-100 dark:border-white/5 pt-4 md:pt-0 order-2 md:order-3"
    >
      <div
        class="flex items-center gap-1 bg-slate-50 dark:bg-white/5 p-1 md:bg-transparent md:dark:bg-transparent rounded-lg"
      >
        <Buscador />
        <div class="w-[1px] h-4 bg-slate-300 dark:bg-white/20 mx-2"></div>
        <ToogleBotton />
      </div>
    </div>
  </div>
</header>
