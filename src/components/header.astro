---
import ToogleBotton from "./ToogleBotton.astro";
import Buscador from "./buscador.astro";
---

<header
  class="relative w-full border-b border-slate-200 dark:border-white/10 bg-white dark:bg-slate-900 transition-colors duration-500"
>
  <div class="max-w-screen-xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4 py-4 px-6 md:py-6">
    
    <a
      href="/"
      class="flex items-center group transition-transform active:scale-95 w-full sm:w-auto justify-center sm:justify-start"
    >
      <h2
        class="text-lg md:text-2xl font-black uppercase tracking-tighter italic leading-tight text-center sm:text-left"
      >
        <span class="bg-clip-text text-transparent bg-gradient-to-r from-sky-800 to-cyan-500">
          Problemas de un desarrollador
        </span>
        <span class="text-slate-900 dark:text-white ml-1">Web</span>
      </h2>
    </a>

    <div class="flex items-center justify-center gap-4 w-full sm:w-auto border-t sm:border-t-0 border-slate-100 dark:border-white/5 pt-4 sm:pt-0">
      <div class="flex items-center gap-1 bg-slate-50 dark:bg-white/5 p-1 sm:bg-transparent sm:dark:bg-transparent">
        <Buscador />
        <div class="w-[1px] h-4 bg-slate-300 dark:bg-white/20 mx-2"></div>
        <ToogleBotton />
      </div>
    </div>
  </div>
</header>