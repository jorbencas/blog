---
import ToogleBotton from "./ToogleBotton.astro";
import Buscador from "./buscador.astro";
---

<header
  class="relative w-full flex flex-wrap items-center justify-between py-4 bg-gray-550 shadow-lg navbar navbar-expand-lg navbar-light"
>
  <a
    href="/"
    class="container-fluid flex flex-wrap items-center justify-between px-6 text-xl font-extrabold"
  >
    <h2
      class="uppercase bg-clip-text text-transparent bg-gradient-to-r from-sky-700 to-cyan-500"
    >
      Problemas de un desarollador <span class="text-gradient"> Web</span>
    </h2>
  </a>
  <div class="flex items-center gap-4">
    <Buscador />
    <ToogleBotton />
  </div>
</header>
