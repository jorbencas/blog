---
const { headings = [] } = Astro.props;
const hasContent = headings?.length > 2;
---

{
  hasContent && (
    <div id="toc-container" class="relative">
      <div class="toc-wrapper">
        {/* Botón Móvil Estilo "Floating Action" */}
        <button
          id="toc-mobile-toggle"
          class="fixed bottom-8 right-8 z-[100] flex items-center justify-center w-14 h-14 bg-cyan-600 dark:bg-cyan-500 text-white rounded-2xl shadow-[0_20px_50px_rgba(8,145,178,0.3)] md:hidden transition-transform active:scale-90"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
          </svg>
        </button>

        <aside
          id="toc-menu"
          class="relative w-72 transform translate-x-[150%] md:translate-x-0 transition-all duration-500 ease-out"
        >
          <div class="sticky top-24 p-1 rounded-[2.5rem] bg-gradient-to-b from-gray-200/50 to-white/50 dark:from-slate-700/50 dark:to-slate-900/50 backdrop-blur-xl border border-white/20 shadow-2xl">
            <div class="bg-white/80 dark:bg-slate-900/80 rounded-[2.3rem] p-7">
              <div class="flex items-center gap-3 mb-6">
                <div class="w-1.5 h-6 bg-cyan-500 rounded-full shadow-[0_0_10px_rgba(6,182,212,0.5)]"></div>
                <h2 class="text-xs font-black uppercase tracking-[0.3em] text-slate-500 dark:text-slate-400">
                  Contenido
                </h2>
              </div>

              <nav class="max-h-[60vh] overflow-y-auto pr-2 custom-scrollbar">
                <ul class="relative space-y-1">
                  {headings.map((h) => (
                    <li>
                      <a
                        href={`#${h.slug}`}
                        data-toc-link={h.slug}
                        class:list={[
                          "toc-link block transition-all duration-300 rounded-xl px-4 py-2",
                          h.depth === 2 
                            ? "text-[13px] font-bold text-slate-600 dark:text-slate-300" 
                            : "ml-4 text-[11px] font-medium text-slate-400 dark:text-slate-500 italic",
                        ]}
                      >
                        <span class="relative z-10">{h.text}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </nav>
            </div>
          </div>
        </aside>
      </div>
    </div>
  )
}

<style is:global>
  html { scroll-behavior: smooth; }

  /* Ajuste de scroll para encabezados */
  #contenido h2, #contenido h3 { scroll-margin-top: 100px; }

  /* --- ESTADO ACTIVO ELEGANTE --- */
  .toc-link-active {
    @apply text-cyan-600 dark:text-cyan-400 translate-x-1 !important;
    background: rgba(6, 182, 212, 0.08);
    box-shadow: inset 4px 0 0 #06b6d4;
  }

  /* Scrollbar Minimalista */
  .custom-scrollbar::-webkit-scrollbar { width: 2px; }
  .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: rgba(6, 182, 212, 0.2);
    border-radius: 10px;
  }
  .custom-scrollbar:hover::-webkit-scrollbar-thumb { background: #06b6d4; }
</style>