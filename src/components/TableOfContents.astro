---
const { headings = [], section = "blog" } = Astro.props;
const hasServerHeadings = headings?.length > 1;

const tocColors = {
  blog: {
    hover: "group-hover:text-cyan-500 dark:group-hover:text-cyan-400",
    underline: "bg-cyan-500/30",
    active: "!text-cyan-500",
    parent: "!text-cyan-500/60",
  },
  weekly: {
    hover: "group-hover:text-yellow-500 dark:group-hover:text-yellow-400",
    underline: "bg-yellow-500/30",
    active: "!text-yellow-500",
    parent: "!text-yellow-500/60",
  },
};
const tc = tocColors[section] || tocColors.blog;

const tocConfig = {
  linkClass: `toc-link group block text-[13px] font-bold text-slate-600 dark:text-slate-400 ${tc.hover} transition-colors line-clamp-2 italic uppercase tracking-tight`,
  underlineClass: `h-[1px] w-0 group-hover:w-full ${tc.underline} transition-all duration-500 mt-1.5`,
  activeClasses: [tc.active, "!font-black"],
  parentClass: tc.parent,
};
const tocConfigJSON = JSON.stringify(tocConfig);

const escapeHtml = (s) =>
  String(s)
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;");

function buildTree(items) {
  const tree = [];
  const stack = [{ level: -1, children: tree }];
  for (const h of items) {
    const level = Math.min(h.depth, 4) - 2;
    if (level < 0 || level > 2) continue;
    while (stack.length > 1 && stack[stack.length - 1].level >= level) stack.pop();
    const node = { level, slug: h.slug, text: h.text, children: [] };
    stack[stack.length - 1].children.push(node);
    stack.push(node);
  }
  return tree;
}

function tocLink(node) {
  return `<a href="#${node.slug}" class="${tocConfig.linkClass}" data-level="${node.level}">
      <p class="toc-text">${escapeHtml(node.text)}</p>
      <div class="${tocConfig.underlineClass}"></div>
    </a>`;
}

function tocItem(node) {
  const kids = node.children.length
    ? `<ul class="toc-sublist mt-2 space-y-2 pl-3.5 ml-1.5 border-l border-slate-200 dark:border-slate-700">${node.children
        .map(tocItem)
        .join("")}</ul>`
    : "";
  return `<li class="toc-item" data-level="${node.level}">${tocLink(node)}${kids}</li>`;
}

const tocTree = hasServerHeadings ? buildTree(headings) : [];
const tocHtml = `<ul class="space-y-3">${tocTree.map(tocItem).join("")}</ul>`;
---

{
  hasServerHeadings && (
    <details
      id="toc-mobile"
      class="lg:hidden group mb-6 bg-slate-100/80 dark:bg-slate-900/50 backdrop-blur-md rounded-lg"
      data-toc-config={tocConfigJSON}
    >
      <summary class="flex items-center gap-2 cursor-pointer list-none p-6 pb-0">
        <h2 class="text-xs font-black uppercase tracking-[0.3em] text-slate-600 dark:text-slate-500">
          📋 Contenido
        </h2>
        <svg class="h-4 w-4 ml-auto transition-transform duration-300 group-open:rotate-180 text-slate-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 9l-7 7-7-7" />
        </svg>
      </summary>
      <div class="p-6 pt-4 overflow-y-auto max-h-[50vh]">
        <nav class="space-y-3" data-toc-target="true" set:html={tocHtml} />
      </div>
    </details>
  )
}

<aside
  id="toc-desktop"
  class="lg:col-span-5 hidden lg:block"
  data-toc-config={tocConfigJSON}
>
  <div class="sticky top-24 p-7 bg-slate-100/80 dark:bg-slate-900/50 backdrop-blur-md rounded-lg overflow-y-auto max-h-[calc(100vh-8rem)]">
    <h2 class="text-xs font-black uppercase tracking-[0.3em] text-slate-600 dark:text-slate-500 mb-6 pb-2">
      Contenido
    </h2>
    <nav id="toc-list" class="space-y-3" data-toc-target="true" set:html={tocHtml} />
  </div>
</aside>

<style is:global>
  h1[id],
  h2[id],
  h3[id],
  h4[id] {
    scroll-margin-top: 120px;
  }
  html {
    scroll-behavior: smooth;
  }
  #toc-mobile summary::-webkit-details-marker {
    display: none;
  }
  #toc-mobile summary {
    list-style: none;
  }
  #toc-list .toc-item[data-level="1"] > .toc-link .toc-text,
  #toc-mobile .toc-item[data-level="1"] > .toc-link .toc-text {
    letter-spacing: 0.05em;
  }
  #toc-list .toc-sublist .toc-link .toc-text,
  #toc-mobile .toc-sublist .toc-link .toc-text {
    text-transform: none;
    letter-spacing: 0;
    font-size: 12px;
  }
  #toc-list .toc-sublist .toc-sublist .toc-link .toc-text,
  #toc-mobile .toc-sublist .toc-sublist .toc-link .toc-text {
    font-size: 11px;
  }
  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
</style>

<script is:inline>
  (function() {
    let lastActive = "";
    let rafId = null;

    function getTOCConfig(container) {
      const json = container
        ?.closest("[data-toc-config]")
        ?.getAttribute("data-toc-config");
      if (json) {
        try { return JSON.parse(json); } catch(e) {}
      }
      return {
        linkClass: "toc-link group block text-[13px] font-bold text-slate-600 dark:text-slate-400 group-hover:text-cyan-500 dark:group-hover:text-cyan-400 transition-colors line-clamp-2 italic uppercase tracking-tight",
        underlineClass: "h-[1px] w-0 group-hover:w-full bg-cyan-500/30 transition-all duration-500 mt-1.5",
        activeClasses: ["!text-cyan-500", "!font-black"],
        parentClass: "!text-cyan-500/60",
      };
    }

    function buildTreeFromDOM() {
      const els = Array.from(
        document.querySelectorAll("article h2[id], article h3[id], article h4[id]")
      );
      const headings = els.map((el) => ({
        el,
        level: Math.min(parseInt(el.tagName[1], 10), 4) - 2,
      })).filter((h) => h.level >= 0 && h.level <= 2);
      const tree = [];
      const stack = [{ level: -1, children: tree }];
      for (const h of headings) {
        while (stack.length > 1 && stack[stack.length - 1].level >= h.level) stack.pop();
        const node = { level: h.level, el: h.el, children: [] };
        stack[stack.length - 1].children.push(node);
        stack.push(node);
      }
      return { headings, tree };
    }

    function makeLink(node, config) {
      const a = document.createElement("a");
      a.href = `#${node.el.id}`;
      a.className = `${config.linkClass} toc-link`;
      a.dataset.level = node.level;
      const p = document.createElement("p");
      p.className = "toc-text";
      p.textContent = node.el.textContent;
      const div = document.createElement("div");
      div.className = config.underlineClass;
      a.appendChild(p);
      a.appendChild(div);
      return a;
    }

    function renderSub(items, config) {
      const ul = document.createElement("ul");
      ul.className = "toc-sublist mt-2 space-y-2 pl-3.5 ml-1.5 border-l border-slate-200 dark:border-slate-700";
      for (const node of items) {
        const li = document.createElement("li");
        li.className = "toc-item";
        li.dataset.level = node.level;
        li.appendChild(makeLink(node, config));
        if (node.children.length) li.appendChild(renderSub(node.children, config));
        ul.appendChild(li);
      }
      return ul;
    }

    function renderTreeInto(container, tree, config) {
      const ul = document.createElement("ul");
      ul.className = "space-y-3";
      for (const node of tree) {
        const li = document.createElement("li");
        li.className = "toc-item";
        li.dataset.level = node.level;
        li.appendChild(makeLink(node, config));
        if (node.children.length) li.appendChild(renderSub(node.children, config));
        ul.appendChild(li);
      }
      container.replaceChildren(ul);
    }

    let headings = [];
    let links = [];
    let ancestorsMap = {};
    let containers = [];

    function buildAncestorsMap(tree) {
      ancestorsMap = {};
      const walk = (nodes, chain) => {
        for (const node of nodes) {
          const href = `#${node.el.id}`;
          ancestorsMap[href] = chain.slice();
          walk(node.children, chain.concat(href));
        }
      };
      walk(tree, []);
    }

    function renderAll() {
      containers = [
        document.getElementById("toc-list"),
        document.querySelector("#toc-mobile nav[data-toc-target]"),
      ].filter(Boolean);
      if (containers.length === 0) return false;

      const { headings: hs, tree } = buildTreeFromDOM();
      headings = hs.map((h) => h.el);

      if (headings.length === 0) {
        for (const c of containers) {
          const box = c.closest("#toc-desktop, #toc-mobile");
          if (box) box.style.display = "none";
        }
        return false;
      }

      const config = getTOCConfig(containers[0]);
      buildAncestorsMap(tree);
      for (const c of containers) renderTreeInto(c, tree, config);
      links = containers.flatMap((c) => Array.from(c.querySelectorAll("a.toc-link")));
      for (const c of containers) {
        const box = c.closest("#toc-desktop, #toc-mobile");
        if (box) box.style.display = "";
      }
      return true;
    }

    function activate(id) {
      if (!id) return;
      const config = getTOCConfig(containers[0] || links[0]);
      for (const el of links) {
        el.classList.remove(...config.activeClasses);
        el.classList.remove(config.parentClass);
      }
      const href = `#${id}`;
      const activeLink = links.find((l) => l.getAttribute("href") === href);
      if (!activeLink) return;
      activeLink.classList.add(...config.activeClasses);
      const ancestors = ancestorsMap[href] || [];
      for (const ah of ancestors) {
        const anc = links.find((l) => l.getAttribute("href") === ah);
        if (anc && anc !== activeLink) anc.classList.add(config.parentClass);
      }
      const container = activeLink.closest("#toc-desktop, #toc-mobile");
      const scroller = container
        ? container.querySelector(".overflow-y-auto") || container
        : container;
      if (scroller) {
        const cr = scroller.getBoundingClientRect();
        const lr = activeLink.getBoundingClientRect();
        if (lr.top < cr.top + 12) scroller.scrollBy({ top: lr.top - cr.top - 12, behavior: "smooth" });
        else if (lr.bottom > cr.bottom - 12) scroller.scrollBy({ top: lr.bottom - cr.bottom + 12, behavior: "smooth" });
      }
    }

    function currentHeadingId() {
      if (headings.length === 0) return null;
      const doc = document.documentElement;
      const atBottom = doc.scrollHeight - (window.scrollY + window.innerHeight) < 60;
      if (atBottom) return headings[headings.length - 1].id;
      let id = null;
      for (const h of headings) {
        if (h.getBoundingClientRect().top <= 150) id = h.id;
        else break;
      }
      return id || headings[0].id;
    }

    function onScroll() {
      if (rafId) return;
      rafId = requestAnimationFrame(() => {
        rafId = null;
        const id = currentHeadingId();
        if (id && id !== lastActive) {
          lastActive = id;
          activate(id);
        }
      });
    }

    function initTOC() {
      lastActive = "";
      if (rafId) { cancelAnimationFrame(rafId); rafId = null; }
      if (headings.length) {
        window.removeEventListener("scroll", onScroll, { passive: true });
        window.removeEventListener("resize", onScroll, { passive: true });
      }
      if (!renderAll()) return;
      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", onScroll, { passive: true });
      const first = currentHeadingId();
      lastActive = first || "";
      activate(first);
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initTOC);
    } else {
      initTOC();
    }
    document.addEventListener("astro:page-load", initTOC);
  })();
</script>