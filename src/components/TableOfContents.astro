---
// Astro inyecta automáticamente 'headings' si este componente 
// recibe las props del layout de Markdown.
const { headings } = Astro.props;

// Filtramos en el servidor (esto sí se pinta al cargar)
const toc = (headings || [])
  .filter((h) => h.depth > 1 && h.depth < 4)
  .map((h) => ({
    ...h,
    text: h.text.replace(/<[^>]*>?/gm, '')
  }));

const hasContent = toc.length > 2;
---

{hasContent && (
  <>
    <div class="fixed top-0 left-0 w-full h-1 z-[100] bg-transparent">
      <div id="reading-progress-bar" class="h-full bg-gradient-to-r from-cyan-500 to-blue-600 w-0 transition-all duration-150 ease-out"></div>
    </div>

    <div class="toc-wrapper">
      <button id="toc-mobile-toggle" class="fixed bottom-6 right-6 z-50 p-4 bg-cyan-600 text-white rounded-full shadow-2xl md:hidden">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path d="M4 6h16M4 12h16m-7 6h7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>

      <aside id="toc-menu" class="fixed inset-y-0 right-0 z-[60] w-72 bg-white dark:bg-slate-900 shadow-2xl transform translate-x-full transition-transform duration-300 md:relative md:translate-x-0 md:shadow-none md:bg-transparent md:w-full md:block">
        <div class="h-full p-8 md:p-0 md:sticky md:top-24">
          <h2 class="text-xs font-bold uppercase tracking-widest text-gray-400 dark:text-cyan-500 mb-6">Contenido</h2>
          <nav>
            <ul class="space-y-1 border-l border-gray-200 dark:border-slate-800">
              {toc.map((h) => (
                <li>
                  <a href={`#${h.slug}`} data-toc-link={h.slug} class:list={[
                    "block py-2 pl-4 -ml-[2px] border-l-2 border-transparent transition-all duration-300 text-gray-500 dark:text-gray-400 hover:text-cyan-500",
                    { "text-[15px]": h.depth === 2 },
                    { "ml-4 text-[13px]": h.depth === 3 },
                  ]}>
                    {h.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </div>
      </aside>
      <div id="toc-blur" class="fixed inset-0 bg-slate-950/40 backdrop-blur-sm z-50 hidden md:hidden"></div>
    </div>
  </>
)}

<style is:global>
  html { scroll-behavior: smooth; }
  #contenido h2, #contenido h3 { scroll-margin-top: 100px; }
  .toc-link-active { @apply border-cyan-500 text-cyan-600 dark:text-cyan-400 font-bold bg-cyan-50/50 dark:bg-cyan-900/20 !important; }
</style>

<script>
  function initTOC() {
    const progress = document.getElementById('reading-progress-bar');
    const content = document.getElementById('contenido');
    const links = document.querySelectorAll('[data-toc-link]');
    const headings = document.querySelectorAll('#contenido h2, #contenido h3');
    
    // Solo lógica de scroll e interactividad (el HTML ya existe)
    if (!content) return;

    const handleScroll = () => {
      const rect = content.getBoundingClientRect();
      const scrolled = (Math.abs(rect.top) / (rect.height - window.innerHeight)) * 100;
      if (progress) progress.style.width = rect.top > 0 ? '0%' : `${Math.min(100, scrolled)}%`;
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          links.forEach(l => l.classList.remove('toc-link-active'));
          document.querySelector(`[data-toc-link="${entry.target.id}"]`)?.classList.add('toc-link-active');
        }
      });
    }, { rootMargin: '-5% 0px -85% 0px' });

    window.addEventListener('scroll', handleScroll);
    headings.forEach(h => observer.observe(h));
  }
  document.addEventListener('astro:page-load', initTOC);
</script>