---
const { headings = [] } = Astro.props;
const hasContent = headings?.length > 2;
---

{
  hasContent && (
    /* h-full aquí asegura que el contenedor principal use todo el alto del padre */
    <div id="toc-container" class="relative h-full">
      <div class="toc-wrapper h-full">
        {/* Botón Móvil */}
        <button
          id="toc-mobile-toggle"
          class="fixed bottom-8 right-8 z-[100] flex items-center justify-center w-12 h-12 bg-slate-900 dark:bg-white text-white dark:text-slate-900 rounded-full shadow-xl md:hidden transition-transform active:scale-90"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8h16M4 16h16" />
          </svg>
        </button>

        <aside
          id="toc-menu"
          class="relative w-80 h-full transform translate-x-[150%] md:translate-x-0 transition-all duration-500 ease-in-out"
        >
          {/* sticky top permite que el índice te siga mientras haces scroll dentro del padre */}
          <div class="sticky top-24 h-[calc(100vh-120px)] flex flex-col py-4 px-2">
            
            {/* Título minimalista */}
            <div class="flex items-center gap-2 mb-8 opacity-50 shrink-0">
              <span class="text-[10px] font-bold uppercase tracking-[0.4em] text-slate-900 dark:text-white">
                Índice
              </span>
              <div class="h-[1px] flex-grow bg-slate-200 dark:bg-slate-800"></div>
            </div>

            {/* nav flex-grow hace que el área de navegación ocupe el resto del alto */}
            <nav class="flex-grow overflow-y-auto pr-4 custom-scrollbar">
              <ul class="relative space-y-4">
                {/* Línea vertical de fondo */}
                <div class="absolute left-0 top-0 h-full w-[1px] bg-slate-100 dark:bg-slate-800/50"></div>
                
                {headings.map((h) => (
                  <li class="relative">
                    <a
                      href={`#${h.slug}`}
                      data-toc-link={h.slug}
                      class:list={[
                        "toc-link block transition-all duration-300 border-l-2 border-transparent pl-6",
                        h.depth === 2 
                          ? "text-sm font-medium text-slate-500 dark:text-slate-400" 
                          : "text-xs text-slate-400 dark:text-slate-500 ml-2",
                      ]}
                    >
                      {h.text}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          </div>
        </aside>
      </div>
    </div>
  )
}

<style is:global>
  /* Mantenemos tus estilos de estado activo y scrollbar */
  html { scroll-behavior: smooth; }
  #contenido h2, #contenido h3 { scroll-margin-top: 100px; }

  .toc-link-active {
    @apply text-cyan-600 dark:text-cyan-400 !important;
    border-left-color: currentColor !important;
  }

  .custom-scrollbar::-webkit-scrollbar { width: 2px; }
  .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
  .custom-scrollbar::-webkit-scrollbar-thumb { background: transparent; }
  .custom-scrollbar:hover::-webkit-scrollbar-thumb { 
    background: rgba(6, 182, 212, 0.3); 
  }
</style>