---
const { headings = [] } = Astro.props;
const hasContent = headings?.length > 1;
---

{
  hasContent && (
    <nav id="toc-container" class="relative h-full font-sans">
      <div class="sticky top-32 h-fit flex flex-col py-4 px-2">
        {/* Header del Índice */}
        <div class="flex items-center gap-2 mb-6 opacity-40">
          <span class="text-sm font-bold uppercase tracking-[0.2em] text-slate-900 dark:text-white">
            Contenido
          </span>
          <div class="h-[1px] flex-grow bg-slate-200" />
        </div>

        <ul class="space-y-1">
          {headings.map((h) => (
            <li>
              <a
                href={`#${h.slug}`}
                class:list={[
                  "toc-link block py-2 pl-4 -ml-[1px] border-l-2 border-l-transparent transition-all duration-300",
                  "text-sm font-medium hover:text-cyan-500",
                  h.depth === 2
                    ? "text-slate-600 dark:text-slate-400"
                    : "text-slate-500 dark:text-slate-400 text-xs ml-2",
                ]}
              >
                {h.text}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </nav>
  )
}

<style is:global>
  h1[id],
  h2[id],
  h3[id] {
    scroll-margin-top: 120px;
  }
</style>

<script>
  function initTOC() {
    const links = document.querySelectorAll(".toc-link");
    // Buscamos los encabezados dentro del artículo principal
    const headings = Array.from(
      document.querySelectorAll("article h2[id], article h3[id]")
    );

    if (links.length === 0 || headings.length === 0) return;

    const activeClasses = [
      "!text-cyan-500", "!border-l-cyan-500",
      "bg-gradient-to-r", "from-cyan-500/10", "to-transparent",
      "!font-bold", "text-[15px]",
    ];

    const removeAllActive = () => {
      links.forEach((link) => link.classList.remove(...activeClasses));
    };

    const activateFirst = () => {
      removeAllActive();
      links[0].classList.add(...activeClasses);
    };

    const observerOptions = {
      root: null,
      rootMargin: "-100px 0px -70% 0px", // Detecta cuando están en la parte superior
      threshold: 0,
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const id = entry.target.getAttribute("id");
          const activeLink = document.querySelector(`.toc-link[href="#${id}"]`);

          if (activeLink) {
            removeAllActive();
            activeLink.classList.add(...activeClasses);
          }
        }
      });
    }, observerOptions);

    headings.forEach((h) => observer.observe(h));

    // Si estamos al inicio de la página, activar el primero
    if (window.scrollY < 100) {
      activateFirst();
    }
  }

  // Ejecutar en carga inicial y en cambios de página de Astro
  document.addEventListener("astro:page-load", initTOC);
  // Por si acaso no usas View Transitions, ejecutar también en DOMContentLoaded
  document.addEventListener("DOMContentLoaded", initTOC);
</script>
