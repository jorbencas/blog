---
const { headings = [] } = Astro.props;
const hasContent = headings?.length > 2;
---

{
  hasContent && (
    <div id="toc-container">
      <div class="toc-wrapper">
        <button
          id="toc-mobile-toggle"
          class="fixed bottom-6 right-6 z-[100] p-4 bg-cyan-600 text-white rounded-full shadow-2xl md:hidden"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-6 w-6"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              d="M4 6h16M4 12h16m-7 6h7"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </button>

        <aside
          id="toc-menu"
          class="relative h-full w-full w-72 transform translate-x-[150%] md:translate-x-0 transition-all duration-300"
        >
          <div class="h-full p-6 rounded-3xl border border-slate-200 dark:border-slate-800 bg-white/90 dark:bg-slate-900/90 backdrop-blur-xl shadow-2xl">
            <div class="flex items-center justify-between mb-2">
              <h2 class="text-3xl font-black tracking-tighter text-slate-900 dark:text-white">
                Contenido
              </h2>
            </div>
            <nav class="max-h-[50vh] overflow-y-auto pr-2 custom-scrollbar">
              <ul class="relative space-y-2 border-l-2 border-slate-100 dark:border-slate-800">
                {headings.flatMap((h) => (
                  <li>
                    <a
                      href={`#${h.slug}`}
                      data-toc-link={h.slug}
                      class:list={[
                        "toc-link block py-2 pl-4 -ml-[2px] border-l-2 border-transparent transition-all duration-200 text-slate-400 dark:text-slate-500 hover:text-slate-900 dark:hover:text-slate-100",
                        { "text-sm font-bold": h.depth === 2 },
                        { "ml-4 text-xs font-medium": h.depth === 3 },
                      ]}
                    >
                      {h.text}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          </div>
        </aside>
      </div>
    </div>
  )
}

<style is:global>
  html {
    scroll-behavior: smooth;
  }

  /* Ajuste para que el scroll no tape el encabezado */
  #contenido h2,
  #contenido h3 {
    scroll-margin-top: 120px;
  }

  /* --- ESTADO ACTIVO DINÁMICO --- */
  .toc-link-active {
    @apply text-cyan-600 dark:text-cyan-400 font-black !important;
    border-left-color: #0891b2 !important; /* Color Cian 600 */
    background: linear-gradient(to right, rgba(8, 145, 178, 0.1), transparent);
  }

  .custom-scrollbar::-webkit-scrollbar {
    width: 3px;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: #0891b2;
    border-radius: 10px;
  }
</style>

<script>
  function initTOC() {
    const circle = document.getElementById("progress-circle");
    const content = document.getElementById("contenido");
    const links = document.querySelectorAll(".toc-link");
    const headings = Array.from(
      document.querySelectorAll("#contenido h2, #contenido h3")
    );

    if (!content || !circle) return;

    const circumference = 100.5;

    // 1. BARRA DE PROGRESO CIRCULAR
    const updateProgress = () => {
      const rect = content.getBoundingClientRect();
      const scrolled = Math.max(
        0,
        Math.min(1, Math.abs(rect.top) / (rect.height - window.innerHeight))
      );
      circle.style.strokeDashoffset =
        rect.top > 0 ? circumference : circumference - scrolled * circumference;
    };

    // 2. ACTUALIZACIÓN DEL LINK ACTIVO (SCROLL SPY)
    const updateActiveLink = () => {
      let currentId = "";

      // Buscamos cuál es el encabezado que está más cerca de la parte superior
      headings.forEach((heading) => {
        const top = heading.getBoundingClientRect().top;
        if (top < 150) {
          // Margen de 150px desde el top
          currentId = heading.id;
        }
      });

      if (currentId) {
        links.forEach((link) => {
          link.classList.remove("toc-link-active");
          if (link.getAttribute("href") === `#${currentId}`) {
            link.classList.add("toc-link-active");
          }
        });
      }
    };

    window.addEventListener("scroll", () => {
      updateProgress();
      updateActiveLink();
    });

    // Ejecutar una vez al cargar por si el usuario ya está a mitad de página
    updateActiveLink();
  }

  document.addEventListener("astro:page-load", initTOC);
</script>
