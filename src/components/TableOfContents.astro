---
const { headings = [], section = "blog" } = Astro.props;
const hasServerHeadings = headings?.length > 1;

const tocColors = {
  blog: {
    hover: "group-hover:text-cyan-500 dark:group-hover:text-cyan-400",
    underline: "bg-cyan-500/30",
    active: "!text-cyan-500",
  },
  weekly: {
    hover: "group-hover:text-yellow-500 dark:group-hover:text-yellow-400",
    underline: "bg-yellow-500/30",
    active: "!text-yellow-500",
  },
};
const tc = tocColors[section] || tocColors.blog;

const tocConfig = {
  linkClass: `toc-link group block text-sm font-bold text-slate-700 dark:text-slate-300 ${tc.hover} transition-colors line-clamp-2 italic uppercase tracking-tighter`,
  underlineClass: `h-[1px] w-0 group-hover:w-full ${tc.underline} transition-all duration-500 mt-2`,
  activeClasses: [tc.active, "!font-black"],
};
const tocConfigJSON = JSON.stringify(tocConfig);
---

{
  hasServerHeadings && (
    <details
      id="toc-mobile"
      class="lg:hidden group mb-6 bg-slate-100 dark:bg-slate-900/50 rounded-lg"
      data-toc-config={tocConfigJSON}
    >
      <summary class="flex items-center gap-2 cursor-pointer list-none p-6 pb-0">
        <h2 class="text-xs font-black uppercase tracking-[0.3em] text-slate-600 dark:text-slate-500">
          📋 Contenido
        </h2>
        <svg class="h-4 w-4 ml-auto transition-transform duration-300 group-open:rotate-180 text-slate-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 9l-7 7-7-7" />
        </svg>
      </summary>
      <div class="p-6 pt-4 overflow-y-auto max-h-[50vh]">
        <nav class="space-y-4">
          {headings.map((h) => (
            <a
              href={`#${h.slug}`}
              class={tocConfig.linkClass}
            >
              <p class={`text-sm font-bold text-slate-700 dark:text-slate-300 ${tc.hover} transition-colors line-clamp-2 italic uppercase tracking-tighter`}>
                {h.text}
              </p>
              <div class={`h-[1px] w-0 group-hover:w-full ${tc.underline} transition-all duration-500 mt-2`} />
            </a>
          ))}
        </nav>
      </div>
    </details>
  )
}

<aside
  id="toc-desktop"
  class="lg:col-span-4 space-y-8 hidden lg:block"
  data-toc-config={tocConfigJSON}
>
  <div class="sticky top-24 p-6 bg-slate-100 dark:bg-slate-900/50 rounded-lg overflow-y-auto max-h-[calc(100vh-8rem)]">
    <h2 class="text-xs font-black uppercase tracking-[0.3em] text-slate-600 dark:text-slate-500 mb-6 pb-2">
      Contenido
    </h2>
    <nav id="toc-list" class="space-y-4">
      {hasServerHeadings && headings.map((h) => (
        <a
          href={`#${h.slug}`}
          class={tocConfig.linkClass}
        >
          <p class={`text-sm font-bold text-slate-700 dark:text-slate-300 ${tc.hover} transition-colors line-clamp-2 italic uppercase tracking-tighter`}>
            {h.text}
          </p>
          <div class={`h-[1px] w-0 group-hover:w-full ${tc.underline} transition-all duration-500 mt-2`} />
        </a>
      ))}
    </nav>
  </div>
</aside>

<style is:global>
  h1[id],
  h2[id],
  h3[id] {
    scroll-margin-top: 120px;
  }
  #toc-mobile summary::-webkit-details-marker {
    display: none;
  }
  #toc-mobile summary {
    list-style: none;
  }
  #toc-mobile .toc-link-wrapper:not(:last-child) {
    margin-bottom: 1rem;
  }
  #toc-list .toc-link-wrapper:not(:last-child) {
    margin-bottom: 1rem;
  }
</style>

<script is:inline>
  (function() {
    let observer = null;

    function getTOCConfig(el) {
      const json = el?.closest("[data-toc-config]")?.getAttribute("data-toc-config");
      if (json) {
        try { return JSON.parse(json); } catch(e) {}
      }
      return {
        linkClass: "toc-link group block text-sm font-bold text-slate-700 dark:text-slate-300 group-hover:text-cyan-500 dark:group-hover:text-cyan-400 transition-colors line-clamp-2 italic uppercase tracking-tighter",
        underlineClass: "h-[1px] w-0 group-hover:w-full bg-cyan-500/30 transition-all duration-500 mt-2",
        activeClasses: ["!text-cyan-500", "!font-black"],
      };
    }

    function buildTOCFromDOM() {
      const list = document.getElementById("toc-list");
      const mobileList = document.querySelector("#toc-mobile nav");
      if (!list && !mobileList) return;
      const headingElements = document.querySelectorAll("article h2[id], article h3[id]");
      if (headingElements.length === 0) {
        const container = document.getElementById("toc-desktop");
        if (container) container.style.display = "none";
        const mobile = document.getElementById("toc-mobile");
        if (mobile) mobile.style.display = "none";
        return;
      }

      const config = getTOCConfig(list || mobileList);

      const renderLinks = (parent) => {
        headingElements.forEach((h) => {
          const a = document.createElement("a");
          a.href = `#${h.id}`;
          a.className = config.linkClass;
          a.textContent = h.textContent;
          const div = document.createElement("div");
          div.className = config.underlineClass;
          const wrapper = document.createElement("div");
          wrapper.className = "toc-link-wrapper";
          wrapper.appendChild(a);
          wrapper.appendChild(div);
          parent.appendChild(wrapper);
        });
      };
      if (list) {
        list.innerHTML = "";
        renderLinks(list);
      }
      if (mobileList) {
        mobileList.innerHTML = "";
        renderLinks(mobileList);
      }
    }

    function initTOC() {
      if (observer) observer.disconnect();

      let links = document.querySelectorAll(".toc-link");
      const headingElements = Array.from(
        document.querySelectorAll("article h2[id], article h3[id]")
      );

      if (headingElements.length === 0) return;

      if (links.length === 0) {
        buildTOCFromDOM();
        links = document.querySelectorAll(".toc-link");
        if (links.length === 0) return;
      }

      const firstLink = links[0];
      const config = getTOCConfig(firstLink);
      const activeClasses = config.activeClasses;

      const removeAllActive = () => {
        links.forEach((link) => link.classList.remove(...activeClasses));
      };

      const activateLink = (id) => {
        for (const link of links) {
          if (link.getAttribute("href") === `#${id}`) {
            removeAllActive();
            link.classList.add(...activeClasses);
            return true;
          }
        }
        return false;
      };

      observer = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            activateLink(entry.target.getAttribute("id"));
          }
        }
      }, {
        root: null,
        rootMargin: "-120px 0px -60% 0px",
        threshold: 0,
      });

      headingElements.forEach((h) => observer.observe(h));

      if (links.length > 0) {
        removeAllActive();
        links[0].classList.add(...activeClasses);
      }
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initTOC);
    } else {
      initTOC();
    }
    document.addEventListener("astro:page-load", initTOC);
  })();
</script>
