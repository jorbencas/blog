---
const { content } = Astro.props;
---

<div class="font-sans">
  <!-- Contenedor del índice -->
  <section id="indice" class="shadow-md rounded-lg p-4">
    <h2 class="text-2xl font-bold mb-4 text-black dark:text-cyan-600">
      Contenido del artículo
    </h2>
    <ul class="space-y-2" id="indice-lista">
      <!-- El índice se generará dinámicamente aquí con JavaScript -->
    </ul>
  </section>

  <!-- Script para generar el índice dinámicamente -->
  <script>
    document.addEventListener("DOMContentLoaded", function () {
      // Obtener el contenido de los encabezados (h2, h3, h4, etc.) dentro del artículo
      const encabezados = document.querySelectorAll(
        "#contenido h2, #contenido h3, #contenido h4"
      );

      // Seleccionar la lista del índice
      const indiceLista = document.getElementById("indice-lista");

      // Recorremos los encabezados y generamos los enlaces del índice
      encabezados.forEach((encabezado) => {
        // Crear un id único para cada encabezado si no lo tiene
        const id =
          encabezado.id ||
          encabezado.textContent.toLowerCase().replace(/\s+/g, "-");

        // Crear el enlace para el índice
        const li = document.createElement("li");
        const a = document.createElement("a");
        a.href = `#${id}`;
        a.textContent = encabezado.textContent;
        a.classList.add(
          "text-blue-500",
          "hover:text-blue-700",
          "transition-colors",
          "duration-200"
        );

        // Añadir el enlace dentro de un <li> y luego al índice
        li.appendChild(a);
        indiceLista.appendChild(li);
      });
    });
  </script>
</div>
