---
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
---

<div class="not-prose mt-12 mb-6">
  <h2
    class="inline-flex items-center gap-2 bg-gradient-to-r from-sky-800 to-cyan-500 dark:from-sky-600 dark:to-cyan-400 px-5 py-2.5 text-xs sm:text-sm font-black uppercase tracking-[0.25em] text-white dark:text-slate-900 shadow-[4px_4px_0px_0px_rgba(6,182,212,0.3)]"
    id={id}
  >{title}</h2>
</div>
<div class="not-prose grid grid-cols-1 md:grid-cols-2 gap-4 my-6">
  <slot />
</div>
