---
interface Props {
  href: string;
  title: string;
  description: string;
  favicon?: string;
}

const { href, title, description, favicon } = Astro.props;
const domain = favicon || new URL(href).hostname;
const faviconUrl = `https://www.google.com/s2/favicons?domain=${domain}&sz=32`;
---

<a
  href={href}
  class="flex items-start gap-4 p-4 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 hover:border-cyan-400 dark:hover:border-cyan-400 hover:shadow-xl hover:-translate-y-1 transition-all no-underline group"
  target="_blank"
  rel="noopener noreferrer"
>
  <img
    src={faviconUrl}
    width="20"
    height="20"
    class="mt-1 shrink-0 rounded bg-slate-100 dark:bg-slate-800 p-0.5"
    alt={title}
    loading="lazy"
  />
  <div>
    <span class="font-bold text-slate-900 dark:text-white group-hover:text-cyan-600 dark:group-hover:text-cyan-400 transition-colors">{title}</span>
    <p class="text-sm text-slate-500 dark:text-slate-400 mt-0.5 leading-snug">{description}</p>
  </div>
</a>
