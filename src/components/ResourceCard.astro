---
interface Props {
  href: string;
  title: string;
  description: string;
  category?: string;
  headline?: string;
  features?: string[];
  platform?: string;
  favicon?: string;
  pricing?: "free" | "freemium" | "paid";
  useCases?: string;
  rating?: string;
}

const { href, title, description, category, headline, features, platform, favicon, pricing, useCases, rating } = Astro.props;
const domain = favicon || new URL(href).hostname;
const faviconUrl = `https://www.google.com/s2/favicons?domain=${domain}&sz=32`;
const hasNewFormat = headline || (features && features.length > 0) || platform;

const pricingConfig = {
  free: { label: "Gratis", class: "bg-gradient-to-r from-emerald-800 to-emerald-500 text-white" },
  freemium: { label: "Plan gratuito", class: "bg-gradient-to-r from-amber-800 to-amber-500 text-white" },
  paid: { label: "De pago", class: "bg-gradient-to-r from-orange-800 to-orange-500 text-white" },
};

const badge = pricing ? pricingConfig[pricing] : null;
---

<a
  href={href}
  class="flex flex-col h-full gap-4 p-4 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 hover:border-cyan-400 dark:hover:border-cyan-400 hover:shadow-xl hover:-translate-y-1 transition-all no-underline group"
  target="_blank"
  rel="noopener noreferrer"
>
  <img
    src={faviconUrl}
    width="20"
    height="20"
    class="mt-1 shrink-0 rounded bg-slate-100 dark:bg-slate-800 p-0.5"
    alt={title}
    loading="lazy"
  />
  <div class="flex-1 min-w-0">
    <div class="flex items-center gap-2 flex-wrap">
      <span class="font-bold text-slate-900 dark:text-white group-hover:text-cyan-600 dark:group-hover:text-cyan-400 transition-colors">{title}</span>
      {category && (
        <span class="bg-gradient-to-r from-sky-800 to-cyan-500 px-2 py-0.5 text-[10px] sm:text-xs font-bold uppercase tracking-wider text-white">
          {category}
        </span>
      )}
      {badge && (
        <span class={`bg-gradient-to-r px-2 py-0.5 text-[10px] sm:text-xs font-bold uppercase tracking-wider text-white ${badge.class}`}>
          {badge.label}
        </span>
      )}
    </div>
    {rating && (
      <p class="text-xs text-amber-500 dark:text-amber-400 mt-1 font-semibold">{rating}</p>
    )}
    {hasNewFormat ? (
      <div class="mt-1">
        {headline && (
          <p class="text-sm font-medium text-slate-700 dark:text-slate-300 leading-snug">{headline}</p>
        )}
        {features && features.length > 0 && (
          <ul class="mt-1 space-y-0.5">
            {features.map((feature) => (
              <li class="text-sm text-cyan-600 dark:text-cyan-400 flex items-center gap-1.5">
                <span class="text-xs">✓</span>
                <span>{feature}</span>
              </li>
            ))}
          </ul>
        )}
        {platform && (
          <p class="text-xs text-slate-400 dark:text-slate-500 mt-1.5">{platform}</p>
        )}
      </div>
    ) : (
      <p class="text-sm text-slate-500 dark:text-slate-400 mt-0.5 leading-snug">{description}</p>
    )}
    {useCases && (
      <p class="text-xs text-slate-400 dark:text-slate-500 mt-1 italic">{useCases}</p>
    )}
  </div>
</a>
