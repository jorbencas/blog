---
const { url, text, isNext } = Astro.props;

// Usamos EXACTAMENTE tus clases de referencia
const baseClasses =
  "group flex items-center gap-2 sm:gap-3 border border-cyan-500 dark:border-cyan-400 px-5 sm:px-8 py-3 sm:py-3 text-xs font-black uppercase tracking-[0.2em] text-cyan-500 dark:text-cyan-400 transition-all hover:bg-cyan-500 hover:text-white dark:hover:bg-cyan-400 dark:hover:text-gray-900 active:scale-95";
---

{
  url && (
    <a class={baseClasses} href={new URL(url, Astro.site)}>
      {!isNext && (
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-5 w-5 sm:h-6 sm:w-6 transition-transform group-hover:-translate-x-1"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M15 19l-7-7 7-7" />
        </svg>
      )}

      <span class="text-[11px] sm:text-xs">{text}</span>

      {isNext && (
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-5 w-5 sm:h-6 sm:w-6 transition-transform group-hover:translate-x-1"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      )}
    </a>
  )
}
