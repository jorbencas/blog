---
import { makeUrl } from "src/utils";
const { url, text, image } = Astro.props;
---

{
  url && (
    <li
      class={
        url && image
          ? "flex items-center mx-4 justify-center h-36 w-64 p-4 border-double border-4 dark:border-gray-50 border-black "
          : "flex items-center border-cyan-500 hover:text-white dark:hover:text-dark "
      }
    >
      <a
        class="text-sm text-center font-medium dark:text-cyan-400  // Color de texto en modo oscuro (dark mode) cyan
    dark:hover:text-white  // Color de texto en modo oscuro (dark mode) blanco al pasar el ratón por encima
    text-black         // Color de texto en tema claro
    hover:text-white    // Color de texto blanco al pasar el ratón por encima en tema claro flex flex-col justify-center items-center touch-pinch-zoom"
        href={makeUrl(url, Astro)}
      >
        {image && <img class="w-10 h-10 mr-2" src={image} alt={text} />}
        {text && <p class="mt-2">{text}</p>}
      </a>
    </li>
  )
}
