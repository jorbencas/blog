---
import { makeUrl } from "src/utils";
const { url, text, image } = Astro.props;

const linkClasses = image
  ? `group relative flex flex-col items-center justify-center w-64 h-36 rounded-2xl 
     border border-white/20 dark:border-white/10 
     bg-white/10 dark:bg-white/5 
     backdrop-blur-md shadow-xl 
     transition-all duration-500 hover:scale-105 hover:bg-white/20 dark:hover:bg-white/10 
     overflow-hidden`
  : "inline-flex items-center rounded-lg border border-cyan-500 px-5 py-2 text-sm font-medium text-cyan-500 transition-all hover:bg-cyan-500 hover:text-white active:scale-95";
---

{
  url && (
    <li class="flex items-center justify-center p-4">
      <a class={linkClasses} href={makeUrl(url, Astro)}>
        {/* Destello de luz decorativo al pasar el ratón */}
        <div class="absolute -inset-full top-0 block h-full w-1/2 z-5 transform -skew-x-12 bg-gradient-to-r from-transparent via-white/10 to-transparent group-hover:animate-[shine_1s_ease-in-out]" />
        
        {image && (
          <img 
            class="w-14 h-14 mb-3 object-contain drop-shadow-md group-hover:drop-shadow-[0_0_15px_rgba(6,182,212,0.5)] transition-all duration-300" 
            src={image} 
            alt={text} 
          />
        )}
        
        {text && (
          <span class="text-[10px] font-black uppercase tracking-[0.2em] text-gray-800 dark:text-gray-200 group-hover:text-cyan-500 transition-colors">
            {text}
          </span>
        )}
      </a>
    </li>
  )
}

<style>
  @keyframes shine {
    100% {
      left: 125%;
    }
  }
</style>