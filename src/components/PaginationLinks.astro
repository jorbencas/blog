---
import { makeUrl } from "src/utils";
const { url, text, isNext } = Astro.props;

// Usamos EXACTAMENTE tus clases de referencia
const baseClasses =
  "group flex items-center gap-2 border border-cyan-500 px-8 py-3 text-xs font-black uppercase tracking-[0.2em] text-cyan-500 transition-all hover:bg-cyan-500 hover:text-white active:scale-95 dark:border-cyan-400 dark:text-cyan-400 dark:hover:bg-cyan-400 dark:hover:text-gray-900";
---

{
  url && (
    <a class={baseClasses} href={makeUrl(url, Astro)}>
      {!isNext && (
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-4 w-4 transition-transform group-hover:-translate-x-1"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M15 19l-7-7 7-7"
          />
        </svg>
      )}

      {text}

      {isNext && (
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-4 w-4 transition-transform group-hover:translate-x-1"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M17 8l4 4m0 0l-4 4m4-4H3"
          />
        </svg>
      )}
    </a>
  )
}
