---
import { makeUrl } from "src/utils";
const { url, text, image } = Astro.props;

// Eliminamos redondeados, sombras y blur. Pasamos a bordes sólidos y rectos.
const linkClasses = image
  ? `group relative flex flex-col items-center justify-center w-full sm:w-72 h-44 
     border border-slate-200 dark:border-white/10 
     bg-white dark:bg-slate-900 
     transition-all duration-300 hover:border-cyan-500 
     overflow-hidden`
  : `inline-flex items-center border border-cyan-500 px-8 py-3 
     text-xs font-black uppercase tracking-[0.2em] text-cyan-500 
     transition-all hover:bg-cyan-500 hover:text-white active:scale-95`;
---

{
  url && (
    <li class="flex items-center justify-center p-0">
      <a class={linkClasses} href={makeUrl(url, Astro)}>
        
        {image && (
          <div class="relative mb-4">
            <img 
              class="w-16 h-16 object-contain grayscale group-hover:grayscale-0 transition-all duration-500 group-hover:scale-110" 
              src={image} 
              alt={text} 
            />
          </div>
        )}
        
        {text && (
          <span class="text-[11px] font-black uppercase tracking-[0.3em] text-slate-500 dark:text-slate-400 group-hover:text-cyan-500 transition-colors">
            {text}
          </span>
        )}

        {/* Decoración: Pequeño indicador de dirección en el hover */}
        {image && (
           <div class="absolute bottom-0 left-0 h-1 w-0 bg-cyan-500 transition-all duration-300 group-hover:w-full"></div>
        )}
      </a>
    </li>
  )
}