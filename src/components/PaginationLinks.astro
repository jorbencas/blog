---
import { makeUrl } from "src/utils";
const { url, text, image } = Astro.props;

let classHover = url
  ? "flex items-center mx-4 justify-center h-36 w-64 p-4 border border-cyan-500"
  : "flex items-center ";
---

{
  url && (
    <li class={classHover}>
      <a
        class="text-sm text-center font-medium text-cyan-400 hover:underline hover:cyan-500 hover:text-white flex flex-col justify-center items-center touch-pinch-zoom"
        href={makeUrl(url, Astro)}
      >
        {image && <img class="w-10 h-10 mr-2" src={image} alt={text} />}
        {text && <p class="mt-2">{text}</p>}
      </a>
    </li>
  )
}
