---
const { url, text, isNext } = Astro.props;

// Usamos EXACTAMENTE tus clases de referencia
const baseClasses =
  "group w-fit inline-flex items-center gap-3 border-2 border-slate-900 dark:border-white bg-white dark:bg-slate-900 px-6 sm:px-8 py-3 text-xs sm:text-sm font-black uppercase tracking-widest text-slate-900 dark:text-white transition-all hover:bg-cyan-500 hover:border-cyan-500 hover:text-white active:bg-cyan-500 active:border-cyan-500 active:text-white active:translate-y-1 active:shadow-none";
---

{
  url && (
    <a class={baseClasses} href={new URL(url, Astro.site)}>
      {!isNext && (
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-5 w-5 sm:h-6 sm:w-6 transition-transform group-hover:-translate-x-1"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M7 8l-4 4m0 0l4 4m-4-4h18" />
        </svg>
      )}

      <span class="text-[11px] sm:text-xs">{text}</span>

      {isNext && (
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-5 w-5 sm:h-6 sm:w-6 transition-transform group-hover:translate-x-1"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      )}
    </a>
  )
}
