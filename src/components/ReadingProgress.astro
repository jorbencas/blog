---
// ReadingProgress.astro
---

<div class="fixed top-0 left-0 w-full h-1 bg-transparent z-[100] pointer-events-none">
  <div id="progress-bar" class="h-full bg-gradient-to-r from-cyan-600 to-cyan-400 shadow-[0_0_12px_rgba(6,182,212,0.6)] dark:shadow-[0_0_20px_rgba(6,182,212,0.8)] transition-[width] duration-100 ease-out" style="width:0%" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100" aria-label="Progreso de lectura"></div>
</div>

<script>
  const updateProgressBar = () => {
    const progressBar = document.getElementById('progress-bar');
    if (!progressBar) return;

    const winScroll = document.documentElement.scrollTop || document.body.scrollTop;
    const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
    const scrolled = Math.round((winScroll / height) * 100);
    
    progressBar.style.width = scrolled + "%";
    progressBar.setAttribute("aria-valuenow", scrolled.toString());
  };

  window.addEventListener('scroll', updateProgressBar, { passive: true });
  document.addEventListener('astro:page-load', updateProgressBar);
</script>
