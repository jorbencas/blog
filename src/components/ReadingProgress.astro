---
// ReadingProgress.astro
---

<div class="reading-progress-container">
  <div id="progress-bar" class="progress-bar"></div>
</div>

<script>
  const updateProgressBar = () => {
    const progressBar = document.getElementById('progress-bar');
    if (!progressBar) return;

    const winScroll = document.documentElement.scrollTop || document.body.scrollTop;
    const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
    const scrolled = (winScroll / height) * 100;
    
    progressBar.style.width = scrolled + "%";
  };

  // Listeners para que funcione con las transiciones de Astro (View Transitions)
  window.addEventListener('scroll', updateProgressBar);
  document.addEventListener('astro:page-load', updateProgressBar);
</script>

<style>
  .reading-progress-container {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 4px;
    background: transparent;
    z-index: 100;
    pointer-events: none;
  }

  .progress-bar {
    height: 100%;
    background: linear-gradient(to right, #0891b2, #22d3ee); /* De cyan-600 a cyan-400 */
    width: 0%;
    box-shadow: 0 0 12px rgba(6, 182, 212, 0.6);
    transition: width 0.1s ease-out;
  }

  /* Ajuste para que se vea mejor en modo oscuro */
  :global(.dark) .progress-bar {
    box-shadow: 0 0 20px rgba(6, 182, 212, 0.8);
  }
</style>