<div class="relative max-w-xl mx-auto mt-10">
  <!-- Caja de búsqueda -->
  <input
    id="search-input"
    type="text"
    placeholder="Buscar..."
    class="w-full p-3 pl-4 rounded-xl shadow-lg bg-white/90 focus:outline-none focus:ring-2 focus:ring-indigo-500 placeholder-gray-400"
  />

  <!-- Contenedor de resultados -->
  <div
    id="search-results"
    class="absolute w-full mt-2 bg-white rounded-xl shadow-lg overflow-y-auto max-h-96 hidden"
  >
    <!-- Resultados se inyectan aquí -->
  </div>
</div>
<!-- <script src="/pagefind/pagefind-ui.js"></script> -->
<script>
  // Importamos la librería de búsqueda que Pagefind genera automáticamente DESPUÉS del build
  window.addEventListener("DOMContentLoaded", async () => {
    // @ts-ignore
    const pagefind = await import("/pagefind/pagefind.js");

    const input = document.querySelector("#search-input");
    const container = document.querySelector("#search-results");

    input?.addEventListener("input", async (e) => {
      const query = e.target.value;
      if (query.length > 2) {
        const search = await pagefind.search(query);
        const results = await Promise.all(search.results.map((r) => r.data()));

        container.innerHTML = "";
        if (results.length === 0) {
          container.innerHTML =
            '<p class="p-4 text-gray-500">No se encontraron resultados</p>';
        } else {
          results.forEach((item) => {
            const div = document.createElement("div");
            div.className = "p-4 border-b hover:bg-indigo-50 cursor-pointer";
            div.innerHTML = `
              <a href="${item.url}" class="block">
                <h3 class="font-semibold text-indigo-700">${item.meta.title}</h3>
                <p class="text-gray-600 text-sm">${item.excerpt}</p>
              </a>`;
            container.appendChild(div);
          });
        }
        container.classList.remove("hidden");
      } else {
        container.classList.add("hidden");
      }
    });
  });
</script>
