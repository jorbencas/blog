<div class="relative w-full max-w-xl mx-auto px-2 sm:px-0">
  <div class="relative group">
    <!-- Icono buscador -->
    <svg
      class="absolute left-3 sm:left-4 top-1/2 -translate-y-1/2 w-4 h-4 sm:w-5 sm:h-5 text-slate-400 transition-colors group-focus-within:text-cyan-500"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
    </svg>

    <!-- Input Principal -->
    <input
      id="search-input"
      type="text"
      placeholder="BUSCAR EN LA BITÁCORA..."
      class="w-full p-3 sm:p-4 pl-10 sm:pl-12 pr-10 sm:pr-20 transition-all duration-300
 bg-white dark:bg-slate-900 text-slate-900 dark:text-slate-100
 placeholder-slate-500
 focus:outline-none
 font-black uppercase tracking-widest text-[10px] sm:text-xs"
    />
  </div>

  <!-- Contenedor de Resultados -->
  <div
    id="search-results"
    class="absolute w-full left-0 mt-1 overflow-y-auto max-h-[60vh] sm:max-h-[450px] hidden
  bg-white dark:bg-slate-900 z-50 rounded-b-xl border border-slate-200 dark:border-slate-800 shadow-xl"
  >
  </div>
</div>

<style is:global>
  /* Personalización del resaltado (Highlight) de Pagefind */
  mark {
    background-color: rgba(6, 182, 212, 0.15) !important; /* Fondo cian suave */
    color: #06b6d4 !important; /* Texto cian fuerte */
    font-weight: 800;
    padding: 0 1px;
  }
  .dark mark {
    background-color: rgba(34, 211, 238, 0.2) !important;
    color: #22d3ee !important;
  }

  /* Scrollbar personalizado para los resultados */
  #search-results::-webkit-scrollbar {
    width: 4px;
  }
  #search-results::-webkit-scrollbar-track {
    background: transparent;
  }
  #search-results::-webkit-scrollbar-thumb {
    background: #06b6d4;
  }
</style>

<script is-inline>
  window.addEventListener("DOMContentLoaded", async () => {
    const input = document.querySelector("#search-input");
    const container = document.querySelector("#search-results");

    // Carga dinámica de Pagefind
    let pagefind;
    try {
      pagefind = await import("/pagefind/pagefind.js");
      await pagefind.options({
        highlightParam: "highlight",
      });
    } catch (e) {
      console.error(
        "Pagefind no encontrado. Ejecuta 'npm run build' para generarlo.",
      );
    }

    input?.addEventListener("input", async (e) => {
      const query = e.target.value;

      if (query.length > 2) {
        if (!pagefind) return;

        const search = await pagefind.search(query);
        const results = await Promise.all(
          search.results.slice(0, 6).map((r) => r.data()),
        );

        container.innerHTML = "";

        if (results.length === 0) {
          container.innerHTML = `
 <div class="p-10 text-center">
 <p class="text-[10px] font-black uppercase tracking-[0.3em] text-slate-500">
 0_COINCIDENCIAS_EN_SISTEMA
 </p>
 </div>`;
        } else {
          results.forEach((item) => {
            const div = document.createElement("div");
            div.className =
              " group transition-all hover:bg-slate-100 dark:hover:bg-cyan-500/5";

            // Detectar si es un reto o un post por la URL (opcional)
            const isChallenge = item.url.includes("/retos/");
            const label = isChallenge ? "CHALLENGE_FILE" : "BLOG_POST";
            const labelColor = isChallenge ? "text-cyan-600 dark:text-cyan-500" : "text-slate-500 dark:text-slate-400";

            div.innerHTML = `
 <a href="${item.url}" class="block p-5 sm:p-6">
 <div class="flex items-center gap-2 mb-2">
 <span class="text-[8px] font-mono px-1.5 py-0.5 ${labelColor} opacity-70">
 ${label}
 </span>
 </div>
 <h3 class="font-black text-sm sm:text-base text-slate-900 dark:text-white uppercase italic tracking-tighter group-hover:text-cyan-600 dark:group-hover:text-cyan-500 transition-colors">
 ${item.meta.title}
 </h3>
 <p class="text-slate-500 dark:text-slate-400 text-xs mt-2 line-clamp-2 leading-relaxed font-medium">
 ${item.excerpt}
 </p>
 </a>`;
            container.appendChild(div);
          });
        }
        container.classList.remove("hidden");
      } else {
        container.classList.add("hidden");
      }
    });

    // Cerrar al hacer clic fuera del buscador
    document.addEventListener("click", (e) => {
      if (!input.contains(e.target) && !container.contains(e.target)) {
        container.classList.add("hidden");
      }
    });
  });
</script>
