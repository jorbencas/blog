<div class="relative w-full max-w-xl mx-auto px-4 sm:px-0">
  <div class="relative group">
    <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-slate-400 transition-colors group-focus-within:text-cyan-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
    </svg>

    <input
      id="search-input"
      type="text"
      placeholder="BUSCAR ARTÍCULOS..."
      class="w-full p-4 pl-12 pr-20 transition-all duration-300
             bg-white dark:bg-slate-900 text-slate-900 dark:text-slate-100 
             placeholder-slate-400 border border-slate-200 dark:border-white/10
             focus:outline-none focus:border-cyan-500 dark:focus:border-cyan-400
             font-bold uppercase tracking-widest text-xs"
    />

    <div class="absolute right-4 top-1/2 -translate-y-1/2 hidden sm:flex items-center gap-1 pointer-events-none">
      <kbd class="px-2 py-1 text-[10px] font-black text-slate-500 bg-slate-100 border border-slate-200 dark:bg-slate-800 dark:text-slate-400 dark:border-white/10">
        CTRL
      </kbd>
      <span class="text-slate-400 font-bold">K</span>
    </div>
  </div>

  <div
    id="search-results"
    class="absolute w-full left-0 mt-0 overflow-y-auto max-h-[500px] hidden
           bg-white dark:bg-slate-900 border-x border-b border-slate-200 dark:border-white/10 
           divide-y divide-slate-100 dark:divide-white/5 z-50"
  >
  </div>
</div>

<script is-inline>
window.addEventListener("DOMContentLoaded", async () => {
  const input = document.querySelector("#search-input");
  const container = document.querySelector("#search-results");

  document.addEventListener("keydown", (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key === "k") {
      e.preventDefault();
      input?.focus();
    }
  });

  const pagefind = await import("/pagefind/pagefind.js");

  input?.addEventListener("input", async (e) => {
    const query = e.target.value;
    if (query.length > 2) {
      const search = await pagefind.search(query);
      const results = await Promise.all(
        search.results.slice(0, 8).map((r) => r.data())
      );

      container.innerHTML = "";
      if (results.length === 0) {
        container.innerHTML = `<div class="p-8 text-center text-xs font-bold uppercase tracking-widest text-slate-500">Sin resultados</div>`;
      } else {
        results.forEach((item) => {
          const div = document.createElement("div");
          // Cambiamos Indigo por Cyan y quitamos redondeados
          div.className = "group transition-colors hover:bg-slate-50 dark:hover:bg-white/5";
          div.innerHTML = `
              <a href="${item.url}" class="block p-6">
                <h3 class="font-black text-slate-900 dark:text-white uppercase italic tracking-tighter group-hover:text-cyan-500 transition-colors">
                  ${item.meta.title}
                </h3>
                <p class="text-slate-500 dark:text-slate-400 text-sm mt-2 line-clamp-2">
                  ${item.excerpt}
                </p>
              </a>`;
          container.appendChild(div);
        });
      }
      container.classList.remove("hidden");
    } else {
      container.classList.add("hidden");
    }
  });

  document.addEventListener("click", (e) => {
    if (!input.contains(e.target) && !container.contains(e.target)) {
      container.classList.add("hidden");
    }
  });
});
</script>