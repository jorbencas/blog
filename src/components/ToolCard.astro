---
import ResponsiveImage from "@components/ResponsiveImage.astro";
import { resolveImagePath } from "src/utils.js";
interface Props {
  title: string;
  description: string;
  image: string;
  tags: string[];
  id: string;
  pubDate?: string;
}

const { title, description, image, tags, id, pubDate } = Astro.props;

const imagenLimpia = resolveImagePath(image);

const date = pubDate
  ? new Date(pubDate).toLocaleDateString("es-ES", {
      year: "numeric",
      month: "short",
      day: "2-digit",
    })
  : null;
---

<div
  class="group relative bg-slate-50 dark:bg-slate-900 overflow-hidden hover:border-emerald-500/50 border border-slate-200 dark:border-slate-800 h-full flex flex-col"
>
  <div class="relative aspect-video overflow-hidden">
    <div
      class="absolute inset-0 from-white dark:from-slate-950 via-transparent to-transparent z-10 opacity-80 transition-opacity group-hover:opacity-40"
    >
    </div>
    {
      imagenLimpia ? (
        <ResponsiveImage
          fallback={imagenLimpia}
          alt={title}
          imgClass="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110 opacity-70 group-hover:opacity-100"
        />
      ) : (
        <div class="w-full h-full bg-slate-200 dark:bg-slate-800 flex items-center justify-center">
          <span class="text-slate-500 dark:text-slate-600 text-xs sm:text-sm">
            SIN_IMAGEN
          </span>
        </div>
      )
    }

    {
      date && (
        <div class="absolute bottom-3 left-4 z-20 bg-white dark:bg-slate-900">
          <time
            class="text-xs sm:text-sm text-emerald-500 dark:text-emerald-400 uppercase tracking-[0.2em] font-black bg-white dark:bg-slate-900 px-2 py-1 rounded-sm border border-emerald-500"
          >
            {date}
          </time>
        </div>
      )
    }
  </div>

  <div class="p-4 sm:p-5 flex-1 flex flex-col space-y-3 dark:bg-slate-900">
    <div class="flex gap-2 flex-wrap">
      {
        tags?.length > 0 &&
          tags.map((tag) => (
            <div class="bg-gradient-to-r from-emerald-800 to-emerald-500 px-3 py-1 text-xs sm:text-sm font-bold uppercase tracking-wider text-white">
              {tag}
            </div>
          ))
      }
    </div>

    <div class="flex-1">
      <h3
        class="text-base sm:text-lg font-black uppercase italic tracking-tighter text-slate-900 dark:text-white group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors leading-tight"
      >
        {title}
      </h3>
      <p
        class="text-sm sm:text-base text-slate-500 dark:text-slate-400 line-clamp-2 mt-2 leading-relaxed font-medium"
      >
        {description}
      </p>
    </div>

    <div class="flex items-center justify-between pt-4 mt-auto">
      <a
        href={`/herramientas/${id}`}
        class="group/link relative text-xs sm:text-sm font-black uppercase text-slate-900 dark:text-white overflow-hidden pb-1 transition-colors hover:text-emerald-600 dark:hover:text-emerald-400"
      >
        Detalles_ <span
          class="inline-block transition-transform group-hover/link:translate-x-1"
          >→</span
        >
        <span
          class="absolute bottom-0 left-0 w-0 h-[1px] bg-emerald-500 transition-all duration-300 group-hover/link:w-full"
        ></span>
      </a>
    </div>
  </div>
</div>
