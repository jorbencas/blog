---
/* Asegúrate de que Tailwind esté configurado en tu proyecto Astro */
---

<div class="font-san">
  <!-- Contenedor del índice -->
  <section id="indice" class="shadow-md rounded-lg p-4">
    <h2 class="text-2xl font-bold mb-4 text-black dark:text-cyan-600">
      Contenido del articulo
    </h2>
    <ul class="space-y-2">
      <!-- Aquí se insertarán los elementos del índice -->
    </ul>
  </section>
  <!-- Script para generar el índice dinámicamente -->
  <script>
    document.addEventListener("DOMContentLoaded", function () {
      // Selecciona la lista dentro de la sección del índice
      const indiceList = document.querySelector("#indice ul");

      // Encuentra todos los encabezados h2 en el contenido
      const headers = document.querySelectorAll("#contenido h3");

      // Recorre cada encabezado y genera un enlace
      headers.forEach((header) => {
        // Crea un id único para cada encabezado basado en su texto
        const id = header.innerText.toLowerCase().replace(/ /g, "-");
        header.id = id;

        // Crea un elemento <li> y un enlace <a> estilizado con Tailwind
        const li = document.createElement("li");
        const a = document.createElement("a");
        a.href = `#${id}`;
        a.innerText = header.innerText;
        a.classList.add(
          "text-blue-500",
          "hover:text-blue-700",
          "transition-colors",
          "duration-200"
        );

        // Añade el enlace dentro del <li> y el <li> dentro de la lista
        li.appendChild(a);
        indiceList.appendChild(li);
      });
    });
  </script>
</div>
