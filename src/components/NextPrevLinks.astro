---
import PaginationLinks from "./PaginationLinks.astro";
const { nextURL, prevURL, textNext, textPrev } = Astro.props;
---

<div
  class="flex flex-col sm:flex-row justify-between items-center gap-6 w-full py-8"
>
  <div class="w-full sm:w-auto flex justify-start">
    {
      prevURL && (
        <PaginationLinks url={prevURL} text={textPrev} isNext={false} />
      )
    }
  </div>

  <div class="w-full sm:w-auto flex justify-end">
    {nextURL && <PaginationLinks url={nextURL} text={textNext} isNext={true} />}
  </div>
</div>
