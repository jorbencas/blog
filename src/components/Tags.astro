---
import tags from "./tags.json";
---

<p class="mb-2 text-xl font-bold text-gray-900 dark:text-white">Etiquetas</p>
<ul class="flex flex-wrap justify-center space-x-2 w-full max-w-md">
  {
    tags.map((tag) => {
      return (
        <a
          class="uppercase my-2 px-4 py-2 rounded-full text-white bg-clip-border bg-gradient-to-r from-sky-800 to-cyan-500 font-semibold text-sm flex align-center w-max cursor-pointer transition duration-300 ease"
          href={"/tags/" + tag + "/1"}
        >
          {tag}
        </a>
      );
    })
  }
</ul>
