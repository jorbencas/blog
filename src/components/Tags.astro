---
import tags from "./tags.json";
---

<p class="mb-2 text-xl font-bold leading-none text-gray-900 dark:text-white">Etiquetas</p>
<ul class="flex flex-wrap justify-center space-x-2 w-full max-w-md">
  {
    tags.map((tag) => {
      return (
        <a
          class="my-2 space-y-2 px-4 py-2 rounded-full text-gray-500 bg-gray-200 font-semibold text-sm flex align-center w-max cursor-pointer active:bg-gray-300 transition duration-300 ease"
          href={"/tags/" + tag + "/1"}
        >
          {tag}
        </a>
      );
    })
  }
</ul>
