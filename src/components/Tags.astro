---
import tags from './tags.json';
---
<h3>Etiquetas</h3>
<ul class="flex flex-wrap justify-center space-x-2">
    {tags.map((tag) => {
        return <a  class=" space-y-2 px-4 py-2 rounded-full text-gray-500 bg-gray-200 font-semibold text-sm flex align-center w-max cursor-pointer active:bg-gray-300 transition duration-300 ease" href={"/tags/"+tag+"/1"}>{tag}</a>
    })}
</ul>