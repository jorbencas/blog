---
import tags from "./tags.json";
const { tag: currentTag } = Astro.params;
---

<p class="mb-2 text-xl font-bold text-gray-900 dark:text-white">Etiquetas</p>
<ul class="flex flex-wrap justify-center space-x-2 w-full max-w-md">
  {
    tags.map((tag) => {
      // Verificar si el tag actual en el bucle es igual al tag en la URL
      return (
        <a
          class={`uppercase my-2 px-4 py-2 rounded-full text-white font-semibold text-sm flex align-center w-max bg-clip-border bg-gradient-to-r from-sky-800 to-cyan-500 ${
            currentTag === tag
              ? "border-double border-4 dark:border-gray-50 border-black"
              : ""
          }`}
          href={"/tags/" + tag + "/1"}
        >
          {tag}
        </a>
      );
    })
  }
</ul>
