---
const yearCreation = new Date().getFullYear();
---

<footer>
    <div class="text">
        <p>
            Creado por Jorge Beneyto Castelló {yearCreation}
        </p>
    </div>
    <div class="links">
     <a rel="license" href="http://creativecommons.org/licenses/by-nc/4.0/"><img alt="Licencia de Creative Commons" style="border-width:0;" src="https://i.creativecommons.org/l/by-nc/4.0/88x31.png" /></a>Este obra está bajo una <a rel="license" href="http://creativecommons.org/licenses/by-nc/4.0/">licencia de Creative Commons Reconocimiento-NoComercial 4.0 Internacional.</a>
    </div>
</footer>

<style>
    footer {
		background-color: var(--terra-cotta);
		color: var(--eggshell);
        border-top: 1px solid var(--color-primary);
        min-height: 15px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    footer .links {
        max-width: 300px;
        padding: 10px 0px;
        font-size: 12px;
		border-radius: 0.4rem;
	}

    footer .links a {
        text-decoration: none;
        display: block;
        text-decoration: none;
    }

    footer .text {
        padding: 0 10px;
    }
</style>