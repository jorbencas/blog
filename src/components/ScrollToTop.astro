<button
  id="scroll-top"
  type="button"
  aria-label="Volver arriba"
  class="fixed bottom-8 right-8 z-50
    bg-gradient-to-r from-sky-800 to-cyan-600
    p-3.5 rounded-sm
    shadow-[4px_4px_0px_0px_rgba(0,0,0,0.1)]
    text-white
    transition-all duration-300 ease-out
    hover:shadow-[0_0_20px_rgba(6,182,212,0.4)] hover:-translate-y-1 hover:scale-105 active:scale-95
    cursor-pointer
    opacity-0 translate-y-4 pointer-events-none"
>
  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
    <path d="M18 15l-6-6-6 6"/>
  </svg>
</button>

<script>
  const btn = document.getElementById("scroll-top");
  if (btn) {
    let ticking = false;
    window.addEventListener("scroll", () => {
      if (!ticking) {
        requestAnimationFrame(() => {
          const visible = window.scrollY > 400;
          btn.classList.toggle("opacity-100", visible);
          btn.classList.toggle("translate-y-0", visible);
          btn.classList.toggle("pointer-events-auto", visible);
          btn.classList.toggle("opacity-0", !visible);
          btn.classList.toggle("translate-y-4", !visible);
          btn.classList.toggle("pointer-events-none", !visible);
          ticking = false;
        });
        ticking = true;
      }
    });
    btn.addEventListener("click", () => {
      window.scrollTo({ top: 0, behavior: "smooth" });
    });
  }
</script>
