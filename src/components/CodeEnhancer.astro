---
// src/components/CodeEnhancer.astro
---

<script is-inline>
  const setupCodeBlocks = () => {
    const langConfig = {
      js: { label: 'JAVASCRIPT', color: 'text-yellow-400', icon: 'javascript' },
      ts: { label: 'TYPESCRIPT', color: 'text-blue-400', icon: 'typescript' },
      py: { label: 'PYTHON', color: 'text-blue-500', icon: 'python' },
      bash: { label: 'TERMINAL', color: 'text-slate-400', icon: 'gnubash' },
      sh: { label: 'SHELL', color: 'text-slate-400', icon: 'gnubash' },
      jsx: { label: 'REACT_JSX', color: 'text-cyan-400', icon: 'react' },
      tsx: { label: 'REACT_TSX', color: 'text-cyan-400', icon: 'react' },
      vue: { label: 'VUE_JS', color: 'text-emerald-400', icon: 'vuedotjs' },
      html: { label: 'HTML_5', color: 'text-orange-400', icon: 'html5' },
      css: { label: 'CSS_3', color: 'text-blue-300', icon: 'css3' },
      astro: { label: 'ASTRO', color: 'text-orange-500', icon: 'astro' },
    };

    const codeBlocks = document.querySelectorAll('pre');

    codeBlocks.forEach((pre) => {
      if (pre.parentElement?.classList.contains('code-content')) return;

      const langClass = Array.from(pre.classList).find(c => c.startsWith('language-')) || 'language-txt';
      const langKey = langClass.replace('language-', '').toLowerCase();
      const config = langConfig[langKey] || { label: langKey.toUpperCase(), color: 'text-slate-400', icon: 'code' };

      // Contenedor principal: BORDES RECTOS Y SOMBRA SÓLIDA
      const wrapper = document.createElement('div');
      wrapper.className = 'code-wrapper group relative my-10 border border-slate-200 dark:border-white/10 bg-slate-50 dark:bg-slate-900 shadow-[4px_4px_0px_0px_rgba(0,0,0,0.1)] dark:shadow-[4px_4px_0px_0px_rgba(6,182,212,0.2)] transition-all';

      // Cabecera Estilo Terminal
      const header = document.createElement('div');
      header.className = 'flex items-center justify-between border-b border-slate-200 dark:border-white/5 bg-slate-100 dark:bg-white/[0.02] px-4 py-2 font-mono';
      
      header.innerHTML = `
        <div class="flex items-center gap-3">
          <img 
            src="https://cdn.simpleicons.org/${config.icon}/${config.color.replace('text-', '')}" 
            alt="${config.label}"
            class="w-3.5 h-3.5 opacity-70 grayscale group-hover:grayscale-0 transition-all"
          />
          <span class="text-[10px] font-bold tracking-[0.2em] ${config.color}">
            ${config.label}
          </span>
        </div>
        <button class="copy-button relative overflow-hidden border border-slate-300 dark:border-white/10 bg-white dark:bg-slate-800 px-3 py-1 text-[9px] font-bold uppercase tracking-widest text-slate-600 dark:text-slate-400 hover:border-cyan-500 hover:text-cyan-500 transition-all active:translate-y-[1px]">
          <span class="copy-text">COPY_DATA</span>
          <span class="check-icon hidden text-cyan-500">DONE_</span>
        </button>
      `;

      const content = document.createElement('div');
      content.className = 'code-content overflow-x-auto p-5 text-sm leading-relaxed font-mono';

      pre.parentNode?.insertBefore(wrapper, pre);
      wrapper.appendChild(header);
      wrapper.appendChild(content);
      content.appendChild(pre);

      // Lógica de Copiado
      const copyBtn = header.querySelector('.copy-button');
      copyBtn?.addEventListener('click', async () => {
        const codeText = pre.innerText;
        await navigator.clipboard.writeText(codeText);

        const text = copyBtn.querySelector('.copy-text');
        const check = copyBtn.querySelector('.check-icon');

        text?.classList.add('hidden');
        check?.classList.remove('hidden');
        copyBtn.classList.add('border-cyan-500');

        setTimeout(() => {
          text?.classList.remove('hidden');
          check?.classList.add('hidden');
          copyBtn.classList.remove('border-cyan-500');
        }, 2000);
      });
    });
  };

  setupCodeBlocks();
  document.addEventListener('astro:page-load', setupCodeBlocks);
</script>

<style is:global>
  /* Reset de pre-estilos de Astro/Markdown */
  .code-wrapper pre {
    margin: 0 !important;
    background-color: transparent !important;
    padding: 0 !important;
    font-family: 'Space Mono', monospace !important;
  }

  /* Scrollbar brutalista (Cian en Dark) */
  .code-content::-webkit-scrollbar { height: 4px; }
  .code-content::-webkit-scrollbar-track { @apply bg-transparent; }
  .code-content::-webkit-scrollbar-thumb { 
    @apply bg-slate-300 dark:bg-cyan-500/30;
  }

  /* Código Inline (Texto dentro de párrafos) */
  :not(pre) > code {
    @apply font-mono font-bold text-cyan-600 dark:text-cyan-400 bg-cyan-500/5 dark:bg-cyan-500/10 px-1.5 py-0.5 border border-cyan-500/20;
    font-size: 0.9em;
    word-break: break-word;
  }

  /* Ajuste para que el código dentro de bloques NO sea cyan */
  pre code {
    @apply text-inherit bg-transparent border-none p-0 font-normal;
    font-size: inherit !important;
  }
</style>