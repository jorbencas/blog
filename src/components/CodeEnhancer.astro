---
// src/components/CodeEnhancer.astro
---

<script is:inline>
  // Usamos una función autoejecutable para evitar conflictos
  const initCodeEnhancer = () => {
    console.log("Iniciando CodeEnhancer..."); // Para debug en consola
    
    const langConfig = {
      js: { label: 'JAVASCRIPT', color: 'text-yellow-400', icon: 'javascript' },
      ts: { label: 'TYPESCRIPT', color: 'text-blue-400', icon: 'typescript' },
      py: { label: 'PYTHON', color: 'text-blue-500', icon: 'python' },
      bash: { label: 'CONSOLA', color: 'text-slate-400', icon: 'gnubash' },
      jsx: { label: 'REACT_JSX', color: 'text-cyan-400', icon: 'react' },
      tsx: { label: 'REACT_TSX', color: 'text-cyan-400', icon: 'react' },
      html: { label: 'HTML_5', color: 'text-orange-400', icon: 'html5' },
      astro: { label: 'ASTRO', color: 'text-orange-500', icon: 'astro' },
    };

    // Seleccionamos todos los bloques pre que no hayan sido procesados
    const codeBlocks = document.querySelectorAll('pre:not(.enhanced)');

    codeBlocks.forEach((pre) => {
      pre.classList.add('enhanced'); // Marcamos para no repetir el proceso
      
      const langClass = Array.from(pre.classList).find(c => c.startsWith('language-')) || 'language-txt';
      const langKey = langClass.replace('language-', '').toLowerCase();
      const config = langConfig[langKey] || { label: langKey.toUpperCase(), color: 'text-slate-400', icon: 'code' };

      // 1. Crear Wrapper
      const wrapper = document.createElement('div');
      wrapper.className = 'code-wrapper relative my-8 border border-slate-200 dark:border-white/10 bg-slate-950 shadow-[4px_4px_0px_0px_rgba(6,182,212,0.2)]';

      // 2. Crear Cabecera
      const header = document.createElement('div');
      header.className = 'flex items-center justify-between border-b border-white/5 bg-white/5 px-4 py-2 font-mono';
      header.innerHTML = `
        <div class="flex items-center gap-2">
          <span class="text-[10px] font-bold tracking-widest ${config.color}">${config.label}</span>
        </div>
        <button class="copy-btn text-[9px] font-bold uppercase tracking-tighter text-slate-400 hover:text-cyan-400 transition-colors">
          [ COPIAR ]
        </button>
      `;

      // 3. Re-estructurar DOM
      const content = document.createElement('div');
      content.className = 'p-4 overflow-x-auto text-sm';
      
      pre.parentNode.insertBefore(wrapper, pre);
      wrapper.appendChild(header);
      wrapper.appendChild(content);
      content.appendChild(pre);

      // 4. Lógica de copia
      const btn = header.querySelector('.copy-btn');
      btn.addEventListener('click', () => {
        navigator.clipboard.writeText(pre.innerText);
        btn.innerText = '¡COPIADO!';
        setTimeout(() => btn.innerText = '[ COPIAR ]', 2000);
      });
    });
  };

  // ESTO ES CLAVE: Se ejecuta en cada carga de página de Astro
  document.addEventListener('astro:page-load', initCodeEnhancer);
  // Y como fallback por si no usas View Transitions
  document.addEventListener('DOMContentLoaded', initCodeEnhancer);
</script>

<style is:global>
  .code-wrapper pre {
    margin: 0 !important;
    background: transparent !important;
    padding: 0 !important;
    font-family: 'JetBrains Mono', monospace !important;
  }
  /* Estilo para los tags dentro del texto (inline) */
  :not(pre) > code {
    @apply bg-cyan-500/10 text-cyan-500 px-1.5 py-0.5 font-mono font-bold text-sm;
  }
</style>