---
// src/components/CodeEnhancer.astro
---

<script is-inline>
  const setupCodeBlocks = () => {
    // Configuración de Lenguajes: Etiqueta, Color y Slug de SimpleIcons
    const langConfig: Record<string, { label: string; color: string; icon: string }> = {
      js: { label: 'JavaScript', color: 'text-yellow-400 bg-yellow-400/10', icon: 'javascript' },
      ts: { label: 'TypeScript', color: 'text-blue-400 bg-blue-400/10', icon: 'typescript' },
      py: { label: 'Python', color: 'text-blue-500 bg-blue-500/10', icon: 'python' },
      bash: { label: 'Terminal', color: 'text-slate-400 bg-slate-400/10', icon: 'gnubash' },
      sh: { label: 'Shell', color: 'text-slate-400 bg-slate-400/10', icon: 'gnubash' },
      jsx: { label: 'React', color: 'text-cyan-400 bg-cyan-400/10', icon: 'react' },
      tsx: { label: 'React', color: 'text-cyan-400 bg-cyan-400/10', icon: 'react' },
      redux: { label: 'Redux', color: 'text-purple-400 bg-purple-400/10', icon: 'redux' },
      vue: { label: 'Vue.js', color: 'text-emerald-400 bg-emerald-400/10', icon: 'vuedotjs' },
      html: { label: 'HTML5', color: 'text-orange-400 bg-orange-400/10', icon: 'html5' },
      css: { label: 'CSS3', color: 'text-blue-300 bg-blue-300/10', icon: 'css3' },
      git: { label: 'Git', color: 'text-orange-600 bg-orange-600/10', icon: 'git' },
      txt: { label: 'Texto', color: 'text-gray-400 bg-gray-400/10', icon: 'git' }, // Icono genérico
    };

    const codeBlocks = document.querySelectorAll('pre');

    codeBlocks.forEach((pre) => {
      if (pre.parentElement?.classList.contains('code-content')) return;

      const langClass = Array.from(pre.classList).find(c => c.startsWith('language-')) || 'language-txt';
      const langKey = langClass.replace('language-', '').toLowerCase();
      const config = langConfig[langKey] || { label: langKey.toUpperCase(), color: 'text-slate-400 bg-slate-400/10', icon: 'code' };

      // Contenedor principal
      const wrapper = document.createElement('div');
      wrapper.className = 'code-wrapper group relative my-8 overflow-hidden rounded-xl border border-white/10 bg-[#0d1117] shadow-2xl';

      // Cabecera con Icono
      const header = document.createElement('div');
      header.className = 'flex items-center justify-between border-b border-white/5 bg-white/[0.03] px-4 py-2';
      
      // Construimos el HTML de la cabecera inyectando el SVG del icono
      header.innerHTML = `
        <div class="flex items-center gap-3">
          <img 
            src="https://cdn.simpleicons.org/${config.icon}/${config.color.split(' ')[0].replace('text-', '')}" 
            alt="${config.label}"
            class="w-4 h-4 opacity-80"
          />
          <span class="text-[10px] font-bold tracking-widest uppercase ${config.color.split(' ')[0]}">
            ${config.label}
          </span>
        </div>
        <button class="copy-button flex items-center gap-2 rounded-md border border-white/10 bg-white/5 px-3 py-1 text-xs font-medium text-slate-300 transition-all hover:bg-white/10 active:scale-95">
          <span class="copy-text text-[11px]">Copiar</span>
          <span class="check-icon hidden text-green-400 text-[11px]">¡Copiado!</span>
        </button>
      `;

      const content = document.createElement('div');
      content.className = 'code-content overflow-x-auto p-4 text-sm leading-relaxed';

      pre.parentNode?.insertBefore(wrapper, pre);
      wrapper.appendChild(header);
      wrapper.appendChild(content);
      content.appendChild(pre);

      // Lógica de Copiado
      const copyBtn = header.querySelector('.copy-button');
      copyBtn?.addEventListener('click', async () => {
        const codeText = pre.innerText;
        await navigator.clipboard.writeText(codeText);

        const text = copyBtn.querySelector('.copy-text');
        const check = copyBtn.querySelector('.check-icon');

        text?.classList.add('hidden');
        check?.classList.remove('hidden');
        copyBtn.classList.add('border-green-500/40', 'bg-green-500/10');

        setTimeout(() => {
          text?.classList.remove('hidden');
          check?.classList.add('hidden');
          copyBtn.classList.remove('border-green-500/40', 'bg-green-500/10');
        }, 2000);
      });
    });
  };

  setupCodeBlocks();
  document.addEventListener('astro:after-swap', setupCodeBlocks);
</script>

<style is:global>
  .code-wrapper pre {
    margin: 0 !important;
    background-color: transparent !important;
    padding: 0 !important;
  }
  /* Scrollbar estético */
  .code-content::-webkit-scrollbar { height: 5px; }
  .code-content::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.1); border-radius: 10px; }

  /* Código Inline (el que no está dentro de un <pre>) */
  :not(pre) > code {
    background-color: rgba(51, 65, 85, 0.4); /* slate-700 con opacidad */
    color: #f1f5f9; /* slate-100 */
    padding: 0.2rem 0.4rem;
    border-radius: 0.375rem;
    font-size: 0.875em;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
    border: 1px solid rgba(255, 255, 255, 0.1);
    word-break: break-word;
  }

  /* Ajuste para que el código dentro de bloques NO herede el estilo inline */
  pre code {
    background-color: transparent !important;
    padding: 0 !important;
    border: none !important;
    font-size: inherit !important;
    color: inherit !important;
  }
</style>