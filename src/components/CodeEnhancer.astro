---
// src/components/CodeEnhancer.astro
---

<script>
  function mejorarBloquesCodigo() {
    const bloques = document.querySelectorAll("pre:not(.mejorado)");

    // Mapeo de iconos y colores oficiales
    const configLang = {
      js: { icon: "javascript", color: "F7DF1E" },
      javascript: { icon: "javascript", color: "F7DF1E" },
      ts: { icon: "typescript", color: "3178C6" },
      typescript: { icon: "typescript", color: "3178C6" },
      astro: { icon: "astro", color: "FF5D01" },
      vue: { icon: "vuedotjs", color: "4FC08D" },
      svelte: { icon: "svelte", color: "FF3E00" },
      angular: { icon: "angular", color: "DD0031" },
      react: { icon: "react", color: "61DAFB" },
      jsx: { icon: "react", color: "61DAFB" },
      tsx: { icon: "react", color: "61DAFB" },
      html: { icon: "html5", color: "E34F26" },
      html5: { icon: "html5", color: "E34F26" },
      css: { icon: "css3", color: "1572B6" },

      // Programación General
      py: { icon: "python", color: "3776AB" },
      python: { icon: "python", color: "3776AB" },
      java: { icon: "openjdk", color: "007396" },
      csharp: { icon: "csharp", color: "239120" },
      "c#": { icon: "csharp", color: "239120" },
      cpp: { icon: "cplusplus", color: "00599C" },
      "c++": { icon: "cplusplus", color: "00599C" },
      c: { icon: "c", color: "A8B9CC" },
      rust: { icon: "rust", color: "000000" },
      php: { icon: "php", color: "777BB4" },
      go: { icon: "go", color: "00ADD8" },
      kotlin: { icon: "kotlin", color: "7F52FF" },
      swift: { icon: "swift", color: "F05138" },
      visualbasic: { icon: "visualbasic", color: "512BD4" },
      vb: { icon: "visualbasic", color: "512BD4" },
      dart: { icon: "dart", color: "0175C2" },
      ruby: { icon: "ruby", color: "CC342D" },

      // Bases de Datos (SQL & NoSQL)
      sql: { icon: "sqlite", color: "003B57" },
      sqlite: { icon: "sqlite", color: "003B57" },
      mysql: { icon: "mysql", color: "4479A1" },
      postgresql: { icon: "postgresql", color: "4169E1" },
      postgres: { icon: "postgresql", color: "4169E1" },
      mongodb: { icon: "mongodb", color: "47A248" },
      redis: { icon: "redis", color: "DC382D" },
      prisma: { icon: "prisma", color: "2D3748" },

      // Configuración, Devops & Terminal
      bash: { icon: "gnubash", color: "4EAA25" },
      sh: { icon: "gnubash", color: "4EAA25" },
      shell: { icon: "gnubash", color: "4EAA25" },
      powershell: { icon: "powershell", color: "5391FE" },
      docker: { icon: "docker", color: "2496ED" },
      dockerfile: { icon: "docker", color: "2496ED" },
      yaml: { icon: "yaml", color: "CB171E" },
      yml: { icon: "yaml", color: "CB171E" },
      toml: { icon: "toml", color: "9C4221" },
      json: { icon: "json", color: "000000" },
      markdown: { icon: "markdown", color: "000000" },
      md: { icon: "markdown", color: "000000" },
      git: { icon: "git", color: "F05032" },
      npm: { icon: "npm", color: "CB3837" },
      terminal: { icon: "gnubash", color: "4EAA25" },
    };

    bloques.forEach((pre) => {
      pre.classList.add("mejorado");

      const codeElement = pre.querySelector("code");
      const clasesCombinadas = [
        ...Array.from(pre.classList),
        ...(codeElement ? Array.from(codeElement.classList) : []),
      ];

      const claseLang = clasesCombinadas.find((c) => c.startsWith("language-"));
      const dataLang =
        pre.getAttribute("data-language") || pre.getAttribute("data-lang");

      let rawLang =
        dataLang ||
        (claseLang ? claseLang.replace("language-", "") : "terminal");
      const langKey = rawLang.toLowerCase();

      const info = configLang[langKey] || { icon: "code", color: "64748b" };

      // Icono: CDN simpleicons + fallback SVG si falla la red
      const createIcon = () => {
        if (info.icon === "code") return null;
        const img = document.createElement("img");
        img.src = `https://cdn.simpleicons.org/${info.icon}/${info.color}`;
        img.className = "w-5 h-5 shrink-0";
        img.alt = langKey;
        img.onerror = function () {
          const svg = document.createElementNS("http://www.w3.org/2000/svg", "svg");
          svg.setAttribute("width", "20");
          svg.setAttribute("height", "20");
          svg.setAttribute("viewBox", "0 0 20 20");
          svg.classList.add("w-5", "h-5", "shrink-0");
          const r = document.createElementNS("http://www.w3.org/2000/svg", "rect");
          r.setAttribute("width", "20");
          r.setAttribute("height", "20");
          r.setAttribute("rx", "4");
          r.setAttribute("fill", `#${info.color}`);
          r.setAttribute("opacity", "0.8");
          svg.appendChild(r);
          this.replaceWith(svg);
        };
        return img;
      };

      // 1. Crear el Wrapper
      const wrapper = document.createElement("div");
      wrapper.className =
        "bloque-codigo-wrapper my-6 bg-white dark:bg-slate-900 shadow-sm border-2 border-slate-200 dark:border-slate-800 overflow-hidden transition-all rounded-xl";

      // 2. Cabecera con Icono Dinámico
      const header = document.createElement("div");
      header.className =
        "flex justify-between items-center px-4 py-2 bg-slate-50 dark:bg-slate-800/40 border-b-2 border-slate-200 dark:border-slate-800";

      header.innerHTML = `
        <div class="flex items-center gap-2 icon-area">
          <span class="text-xs font-black uppercase tracking-wider text-slate-500 dark:text-slate-400">${langKey}</span>
        </div>
        <button class="boton-copiar flex items-center gap-1.5 text-slate-400 hover:text-cyan-600 dark:hover:text-cyan-400 transition-all text-xs font-black uppercase tracking-wider">
          <span class="copy-text">[ COPIAR ]</span>
        </button>
      `;

      const iconEl = createIcon();
      const iconArea = header.querySelector(".icon-area");
      if (iconEl) {
        iconArea.insertBefore(iconEl, iconArea.firstChild);
      } else {
        const fallback = document.createElement("span");
        fallback.className = "text-slate-400";
        fallback.textContent = "⚡";
        iconArea.insertBefore(fallback, iconArea.firstChild);
      }

      // 3. Estructura de contenido
      const divContenido = document.createElement("div");
      divContenido.className =
        "overflow-x-auto selection:bg-cyan-500/30 text-sm leading-[1.7]";

      pre.classList.add("!m-0", "!text-sm", "!leading-[1.7]");
      const codeEl = pre.querySelector("code");
      if (codeEl) {
        codeEl.classList.add("!m-0", "!text-sm", "!leading-[1.7]");
      }

      pre.querySelectorAll(".comment").forEach((el) => {
        el.classList.add("italic", "opacity-70");
      });

      // Eliminar estilos del .astro-code original (los provee el wrapper)
      if (pre.classList.contains("astro-code")) {
        pre.style.setProperty("border", "none", "important");
        pre.style.setProperty("padding", "0", "important");
        pre.style.setProperty("margin", "0", "important");
        pre.style.setProperty("background", "transparent", "important");
        pre.style.setProperty("background-color", "transparent", "important");
        pre.style.setProperty("border-radius", "0", "important");
        pre.style.removeProperty("box-shadow");
      }

      pre.parentNode.insertBefore(wrapper, pre);
      wrapper.appendChild(header);
      wrapper.appendChild(divContenido);
      divContenido.appendChild(pre);

      // 4. Lógica de copia
      const btn = header.querySelector(".boton-copiar");
      btn.addEventListener("click", async () => {
        await navigator.clipboard.writeText(pre.innerText);
        btn.innerHTML = `
          <svg class="w-3.5 h-3.5 text-cyan-600 dark:text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
          <span class="text-cyan-600 dark:text-cyan-400 font-bold">LISTO</span>
        `;
        btn.classList.add("scale-105");
        setTimeout(() => {
          btn.innerHTML = `<span class="copy-text">[ COPIAR ]</span>`;
          btn.classList.remove("scale-105", "text-cyan-600", "dark:text-cyan-400");
        }, 2000);
      });
    });
  }

  document.addEventListener("astro:page-load", mejorarBloquesCodigo);
  document.addEventListener("DOMContentLoaded", mejorarBloquesCodigo);
</script>

