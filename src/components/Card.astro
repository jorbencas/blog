---
import ResponsiveImage from "@components/ResponsiveImage.astro";
import { resolveImagePath } from "src/utils.js";

interface Props {
  href: string;
  title: string;
  description: string;
  image?: string;
  pubDate?: Date | string;
  tags?: string[];
  accent: "cyan" | "emerald" | "purple" | "amber";
  aspectRatio?: "16/9" | "video";
  overlay?: "slate" | "white";
  difficulty?: string;
  repository?: string;
}

const {
  href,
  title,
  description,
  image,
  pubDate,
  tags = [],
  accent,
  aspectRatio = "16/9",
  overlay = "slate",
  difficulty,
  repository,
} = Astro.props as Props;

const imagenCard = resolveImagePath(image);

const date = pubDate
  ? new Date(pubDate).toLocaleDateString("es-ES", {
      year: "numeric",
      month: "short",
      day: "2-digit",
    })
  : null;

const accentColors = {
  cyan: {
    borderHover: "hover:border-cyan-500/50",
    dateText: "text-cyan-500 dark:text-cyan-400",
    dateBorder: "border-cyan-500",
    titleHover: "group-hover:text-cyan-500 dark:group-hover:text-cyan-400",
    tagFrom: "from-sky-800",
    tagTo: "to-cyan-500",
  },
  amber: {
    borderHover: "hover:border-amber-500/50",
    dateText: "text-amber-500 dark:text-amber-400",
    dateBorder: "border-amber-500",
    titleHover: "group-hover:text-amber-600 dark:group-hover:text-amber-400",
    tagFrom: "from-amber-800",
    tagTo: "to-amber-500",
  },
  emerald: {
    borderHover: "hover:border-emerald-500/50",
    dateText: "text-emerald-500 dark:text-emerald-400",
    dateBorder: "border-emerald-500",
    titleHover: "group-hover:text-emerald-600 dark:group-hover:text-emerald-400",
    tagFrom: "from-emerald-800",
    tagTo: "to-emerald-500",
  },
  purple: {
    borderHover: "hover:border-purple-500/50",
    dateText: "text-purple-500 dark:text-purple-400",
    dateBorder: "border-purple-500",
    titleHover: "group-hover:text-purple-600 dark:group-hover:text-purple-400",
    tagFrom: "from-purple-800",
    tagTo: "to-purple-500",
  },
};

const c = accentColors[accent];

const diffStyles: Record<string, string> = {
  Iniciación: "bg-emerald-500 shadow-emerald-500",
  Intermedio: "bg-amber-500 shadow-amber-500",
  Avanzado: "bg-rose-500 shadow-rose-500",
};

const diffClass = difficulty
  ? diffStyles[difficulty] || diffStyles["Intermedio"]
  : null;

const overlaySlate = overlay === "slate";
const aspectClass = aspectRatio === "video" ? "aspect-video" : "aspect-[16/9]";

const overlayGradient = overlaySlate
  ? "from-slate-950 via-transparent to-transparent"
  : "from-white dark:from-slate-950 via-transparent to-transparent";

const overlayOpacity = overlaySlate ? "opacity-70" : "opacity-80";
const imageOpacity = overlaySlate ? "opacity-80" : "opacity-70";
---

<div
  class:list={["relative h-full bg-slate-50 dark:bg-slate-900 overflow-hidden border border-slate-200 dark:border-slate-800 flex flex-col", c.borderHover]}
>
  <a href={href} class="group block h-full">
    <div class:list={["relative overflow-hidden", aspectClass]}>
      <div
        class:list={["absolute inset-0 z-10 transition-opacity duration-500 group-hover:opacity-40", overlayGradient, overlayOpacity]}
      >
      </div>

      {
        imagenCard ? (
          <ResponsiveImage
            fallback={imagenCard}
            alt={title}
            imgClass={`w-full h-full object-cover transition-transform duration-700 group-hover:scale-110 ${imageOpacity} group-hover:opacity-100`}
          />
        ) : (
          <div class="w-full h-full bg-slate-200 dark:bg-slate-800 flex items-center justify-center">
            <span class="text-slate-500 dark:text-slate-600 text-xs sm:text-sm">
              SIN_IMAGEN
            </span>
          </div>
        )
      }

      {
        date && (
          <div class="absolute bottom-3 left-4 z-20 bg-white dark:bg-slate-900">
            <time
              class:list={["text-xs sm:text-sm uppercase tracking-[0.2em] font-black bg-white dark:bg-slate-900 px-2 py-1 rounded-sm border", c.dateText, c.dateBorder]}
            >
              {date}
            </time>
          </div>
        )
      }

      {
        diffClass && (
          <div
            class:list={["absolute top-4 right-4 z-20 px-3 py-1 rounded-full text-xs sm:text-xs font-black uppercase tracking-[0.2em] text-white", diffClass]}
          >
            {difficulty}
          </div>
        )
      }
    </div>

    <div class="p-4 sm:p-5 flex-1 flex flex-col space-y-3 dark:bg-slate-900">
      <h3
        class:list={["text-base sm:text-lg font-black uppercase italic tracking-tighter text-slate-900 dark:text-white transition-colors leading-tight", c.titleHover]}
      >
        {title}
      </h3>

      <p
        class="text-sm sm:text-base text-slate-500 dark:text-slate-400 line-clamp-2 leading-relaxed font-medium"
      >
        {description}
      </p>

      <div class="mt-auto pt-4 flex items-center justify-between">
        {
          tags.length > 0 && (
            <div class="flex flex-wrap gap-2">
              {tags.slice(0, 6).map((tag: string) => (
                <div class:list={["bg-gradient-to-r px-3 py-1 text-xs sm:text-sm font-bold uppercase tracking-wider text-white", c.tagFrom, c.tagTo]}>
                  {tag}
                </div>
              ))}
            </div>
          )
        }

        {
          repository && (
            <a
              href={repository}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Ver Repositorio"
              class="p-2 bg-slate-100 dark:bg-white/5 rounded-lg text-slate-500 dark:hover:text-white"
              onclick={(e: MouseEvent) => e.stopPropagation()}
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="group-hover:scale-110 transition-transform"
              >
                <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.28 1.15-.28 2.35 0 3.5-.73 1.02-1.08 2.25-1 3.5 0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
                <path d="M9 18c-4.51 2-4.51-2-7-2" />
              </svg>
            </a>
          )
        }
      </div>
    </div>
  </a>
</div>
