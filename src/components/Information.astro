---
import { getCollection } from "astro:content";

type Section = "posts" | "retos" | "proyectos" | "weekly";

const { section = "posts" as Section, hideButtons = false } = Astro.props;

const config: Record<Section, { icon: string; title: string; subtitle: string }> = {
  posts: { icon: "📡", title: "Señal perdida", subtitle: "No hay más artículos en esta frecuencia" },
  retos: { icon: "⚡", title: "Misión completada", subtitle: "Todos los desafíos han sido superados" },
  proyectos: { icon: "🚀", title: "Órbita despejada", subtitle: "No hay más proyectos en el horizonte" },
  weekly: { icon: "📻", title: "Transmisión finalizada", subtitle: "No hay más resúmenes semanales" },
};

const collectionMap: Record<Section, string> = {
  posts: "posts",
  retos: "auto-challenges",
  proyectos: "myprojects",
  weekly: "weeklyPosts",
};

const allItems = await getCollection(collectionMap[section]);
const activeItems = allItems.filter((item) => !item.data.draft);
const randomItem = activeItems.length > 0
  ? activeItems[Math.floor(Math.random() * activeItems.length)]
  : null;

const allTags = activeItems.flatMap((item) => item.data.tags ?? []);
const tagFreq: Record<string, number> = {};
for (const tag of allTags) {
  tagFreq[tag] = (tagFreq[tag] || 0) + 1;
}
const topTags = Object.entries(tagFreq)
  .sort(([, a], [, b]) => b - a)
  .slice(0, 6)
  .map(([tag]) => tag);

const { icon, title, subtitle } = config[section];
const sectionPath = section === "weekly" ? "weekly" : section;
const randomSlug = randomItem
  ? `/${sectionPath}/${randomItem.id.replace(/\.[^/.]+$/, "")}`
  : null;
---

<div
  class="col-span-full my-8 w-full py-16 px-8 border-2 border-dashed border-slate-300 dark:border-slate-700 bg-slate-50/80 dark:bg-slate-900/40 rounded-2xl transition-all duration-500 animate-fade-in-up"
>
  <div class="flex flex-col items-center text-center space-y-6 max-w-lg mx-auto">
    <div class="flex gap-1.5">
      <div class="w-10 h-1 bg-sky-800 dark:bg-sky-600 rounded-full animate-bar-pulse" style="animation-delay: 0s"></div>
      <div class="w-6 h-1 bg-cyan-500 dark:bg-cyan-400 rounded-full animate-bar-pulse" style="animation-delay: 0.15s"></div>
      <div class="w-4 h-1 bg-cyan-400 dark:bg-cyan-300 rounded-full animate-bar-pulse" style="animation-delay: 0.3s"></div>
      <div class="w-6 h-1 bg-cyan-500 dark:bg-cyan-400 rounded-full animate-bar-pulse" style="animation-delay: 0.15s"></div>
      <div class="w-10 h-1 bg-sky-800 dark:bg-sky-600 rounded-full animate-bar-pulse" style="animation-delay: 0s"></div>
    </div>

    <div class="space-y-3">
      <span class="text-4xl sm:text-5xl block animate-icon-float">{icon}</span>
      <h2
        class="text-2xl sm:text-3xl md:text-4xl font-black uppercase tracking-tighter text-slate-900 dark:text-white italic"
      >
        {title}
      </h2>
      <p
        class="text-sm text-slate-500 dark:text-slate-400 font-bold uppercase tracking-[0.3em]"
      >
        {subtitle}
      </p>
    </div>

    {!hideButtons && (
      <div class="flex flex-wrap justify-center gap-3 pt-4">
        <a
          href="/"
          class="px-5 py-2.5 text-xs font-black uppercase tracking-[0.2em] bg-gradient-to-r from-sky-800 to-cyan-600 dark:from-sky-600 dark:to-cyan-500 text-white dark:text-slate-900 rounded-lg hover:shadow-lg hover:-translate-y-0.5 active:scale-95 transition-all"
        >
          ← Volver al inicio
        </a>
        <a
          href={`/${sectionPath}/1`}
          class="px-5 py-2.5 text-xs font-black uppercase tracking-[0.2em] border-2 border-slate-300 dark:border-slate-600 text-slate-700 dark:text-slate-300 rounded-lg hover:border-cyan-500 hover:text-cyan-600 dark:hover:text-cyan-400 hover:-translate-y-0.5 active:scale-95 transition-all"
        >
          Primera página →
        </a>
      </div>
    )}

    {
      randomItem && (
        <div class="pt-6 w-full border-t border-slate-200 dark:border-slate-800">
          <p class="text-[10px] font-black uppercase tracking-[0.3em] text-slate-400 dark:text-slate-500 mb-3">
            Mientras tanto, te puede interesar...
          </p>
          <a
            href={randomSlug}
            class="block p-4 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 hover:border-cyan-500 dark:hover:border-cyan-400 hover:-translate-y-1 transition-all text-left group"
          >
            <h3 class="font-black text-sm uppercase italic tracking-tighter text-slate-900 dark:text-white group-hover:text-cyan-600 dark:group-hover:text-cyan-400 transition-colors">
              {randomItem.data.title}
            </h3>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1 line-clamp-2 leading-relaxed font-medium">
              {randomItem.data.description}
            </p>
          </a>
        </div>
      )
    }

    {
      topTags.length > 0 && (
        <div class="pt-4">
          <p class="text-[10px] font-black uppercase tracking-[0.3em] text-slate-400 dark:text-slate-500 mb-3">
            Explora por etiquetas
          </p>
          <div class="flex flex-wrap justify-center gap-2">
            {topTags.map((tag) => (
              <a
                href={`/tags/${tag}/1`}
                class="px-3 py-1.5 text-[10px] font-black uppercase tracking-widest rounded-lg bg-slate-200/70 dark:bg-slate-800/70 text-slate-600 dark:text-slate-400 hover:bg-cyan-500 hover:text-white dark:hover:bg-cyan-500 dark:hover:text-white transition-all hover:-translate-y-0.5 active:scale-95"
              >
                #{tag}
              </a>
            ))}
          </div>
        </div>
      )
    }
  </div>
</div>

<style>
  .animate-bar-pulse {
    animation: bar-pulse 2s ease-in-out infinite;
  }

  @keyframes bar-pulse {
    0%, 100% { opacity: 0.4; transform: scaleY(1); }
    50% { opacity: 1; transform: scaleY(1.3); }
  }

  .animate-icon-float {
    animation: icon-float 3s ease-in-out infinite;
  }

  @keyframes icon-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-6px); }
  }

  .animate-fade-in-up {
    animation: fade-in-up 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes fade-in-up {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
