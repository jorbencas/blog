---
interface Props {
  rawContent: string;
  title: string;
  description: string;
  pubDate: string;
  author: string;
}

const { rawContent, title, description, pubDate, author } = Astro.props;
---

<div class="copy-post relative inline-block" data-payload={JSON.stringify({ rawContent, title, description, pubDate, author })}>
  <button
    class="copy-trigger inline-flex items-center gap-2 border-2 border-sky-500 bg-sky-500 px-6 py-3 text-xs font-black uppercase tracking-widest text-white transition-all hover:bg-white hover:text-sky-500 active:translate-y-0.5 cursor-pointer"
    aria-haspopup="true"
    aria-expanded="false"
  >
    <svg class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
    </svg>
    <span class="copy-label">COPIAR</span>
    <svg class="h-3 w-3 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
    </svg>
  </button>

  <div
    class="copy-menu absolute left-0 sm:left-auto sm:right-0 top-full mt-2 w-64 bg-white dark:bg-slate-900 border-2 border-slate-200 dark:border-slate-700 shadow-xl z-50 hidden"
    role="menu"
    aria-label="Opciones de copiado"
  >
    <button
      data-copy="markdown"
      class="flex flex-col items-start w-full px-5 py-3.5 text-left hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors border-b border-slate-200 dark:border-slate-700 cursor-pointer"
      role="menuitem"
    >
      <span class="text-xs font-black uppercase tracking-widest text-slate-900 dark:text-white">Markdown</span>
      <span class="text-[10px] font-normal text-slate-500 dark:text-slate-400 mt-0.5 leading-tight">Código fuente del artículo</span>
    </button>
    <button
      data-copy="text"
      class="flex flex-col items-start w-full px-5 py-3.5 text-left hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors border-b border-slate-200 dark:border-slate-700 cursor-pointer"
      role="menuitem"
    >
      <span class="text-xs font-black uppercase tracking-widest text-slate-900 dark:text-white">Texto plano</span>
      <span class="text-[10px] font-normal text-slate-500 dark:text-slate-400 mt-0.5 leading-tight">Solo texto sin formato</span>
    </button>
    <button
      data-copy="ai"
      class="flex flex-col items-start w-full px-5 py-3.5 text-left hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors cursor-pointer"
      role="menuitem"
    >
      <span class="text-xs font-black uppercase tracking-widest text-sky-600 dark:text-sky-400">Para IA</span>
      <span class="text-[10px] font-normal text-slate-500 dark:text-slate-400 mt-0.5 leading-tight">Optimizado para LLMs</span>
    </button>
  </div>
</div>

<script is:inline>
  (() => {
    const container = document.querySelector(".copy-post");
    if (!container) return;
    const data = JSON.parse(container.dataset.payload);
    if (!data) return;

    const trigger = container.querySelector(".copy-trigger");
    const menu = container.querySelector(".copy-menu");
    const label = container.querySelector(".copy-label");

    function open() {
      menu.classList.remove("hidden");
      trigger.setAttribute("aria-expanded", "true");
    }

    function close() {
      menu.classList.add("hidden");
      trigger.setAttribute("aria-expanded", "false");
    }

    trigger.addEventListener("click", (e) => {
      e.stopPropagation();
      menu.classList.contains("hidden") ? open() : close();
    });

    document.addEventListener("click", (e) => {
      if (!container.contains(e.target)) close();
    });

    function stripMarkdown(md) {
      return md
        .replace(/^#{1,6}\s+/gm, "")
        .replace(/\*\*(.+?)\*\*/g, "$1")
        .replace(/\*(.+?)\*/g, "$1")
        .replace(/`{1,3}.+?`{1,3}/gs, "")
        .replace(/\[([^\]]+)\]\([^)]+\)/g, "$1")
        .replace(/!\[([^\]]*)\]\([^)]+\)/g, "$1")
        .replace(/^[-*+]\s+/gm, "")
        .replace(/^\d+\.\s+/gm, "")
        .replace(/^>\s+/gm, "")
        .replace(/^---$/gm, "")
        .replace(/\n{3,}/g, "\n\n")
        .trim();
    }

    menu.querySelectorAll("[data-copy]").forEach((btn) => {
      btn.addEventListener("click", async (e) => {
        e.stopPropagation();
        const type = btn.dataset.copy;
        let text;

        if (type === "markdown") {
          text = data.rawContent;
        } else if (type === "text") {
          text = stripMarkdown(data.rawContent);
        } else if (type === "ai") {
          const header = [
            `Título: ${data.title}`,
            `Descripción: ${data.description}`,
            `Fecha: ${data.pubDate}`,
            `Autor: ${data.author}`,
            "",
            "---",
            "",
          ].join("\n");
          text = header + data.rawContent;
        }

        try {
          await navigator.clipboard.writeText(text);
          const original = label.textContent;
          label.textContent = "¡COPIADO!";
          setTimeout(() => {
            label.textContent = original;
          }, 2000);
        } catch {
          const original = label.textContent;
          label.textContent = "ERROR";
          setTimeout(() => {
            label.textContent = original;
          }, 2000);
        }

        close();
      });
    });
  })();
</script>
