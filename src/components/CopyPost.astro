---
interface Props {
  rawContent: string;
  title: string;
  description: string;
  pubDate: string;
  author: string;
  url: string;
  tags: string[];
}

const { rawContent, title, description, pubDate, author, url, tags } = Astro.props;
---

<div
  class="copy-post"
  data-payload={JSON.stringify({ rawContent, title, description, pubDate, author, url, tags })}
>
  <div class="flex flex-wrap gap-2">
    <button data-copy="markdown"
      class="inline-flex items-center gap-1.5 border border-sky-500/40 hover:border-sky-500 bg-sky-500/5 hover:bg-sky-500/10 px-3 py-2 text-[11px] font-black uppercase tracking-widest text-sky-700 dark:text-sky-400 hover:text-sky-600 dark:hover:text-sky-300 transition-all rounded-lg active:scale-95 cursor-pointer"
    >
      <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
      </svg>
      <span class="copy-label">MD</span>
    </button>
    <button data-copy="text"
      class="inline-flex items-center gap-1.5 border border-slate-300 dark:border-slate-600 hover:border-slate-500 dark:hover:border-slate-400 bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 px-3 py-2 text-[11px] font-black uppercase tracking-widest text-slate-600 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200 transition-all rounded-lg active:scale-95 cursor-pointer"
    >
      <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
      </svg>
      <span class="copy-label">TXT</span>
    </button>
    <button data-copy="ai"
      class="inline-flex items-center gap-1.5 border border-purple-500/40 hover:border-purple-500 bg-purple-500/5 hover:bg-purple-500/10 px-3 py-2 text-[11px] font-black uppercase tracking-widest text-purple-700 dark:text-purple-400 hover:text-purple-600 dark:hover:text-purple-300 transition-all rounded-lg active:scale-95 cursor-pointer"
    >
      <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 00-2.455 2.456zM16.894 20.567L16.5 21.75l-.394-1.183a2.25 2.25 0 00-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 001.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 001.423 1.423l1.183.394-1.183.394a2.25 2.25 0 00-1.423 1.423z"/>
      </svg>
      <span class="copy-label">IA</span>
    </button>
  </div>
</div>

<script is:inline>
  (() => {
    const container = document.querySelector(".copy-post");
    if (!container) return;
    const data = JSON.parse(container.dataset.payload);
    if (!data) return;

    function stripMarkdown(md) {
      return md
        .replace(/^#{1,6}\s+/gm, "")
        .replace(/\*\*(.+?)\*\*/g, "$1")
        .replace(/\*(.+?)\*/g, "$1")
        .replace(/`{1,3}.+?`{1,3}/gs, "")
        .replace(/\[([^\]]+)\]\([^)]+\)/g, "$1")
        .replace(/!\[([^\]]*)\]\([^)]+\)/g, "$1")
        .replace(/^[-*+]\s+/gm, "")
        .replace(/^\d+\.\s+/gm, "")
        .replace(/^>\s+/gm, "")
        .replace(/^---$/gm, "")
        .replace(/\n{3,}/g, "\n\n")
        .trim();
    }

    container.querySelectorAll("[data-copy]").forEach((btn) => {
      const label = btn.querySelector(".copy-label");

      btn.addEventListener("click", async () => {
        const type = btn.dataset.copy;
        let text;

        if (type === "markdown") {
          text = data.rawContent;
        } else if (type === "text") {
          text = stripMarkdown(data.rawContent);
        } else if (type === "ai") {
          const meta = [
            `Título: ${data.title}`,
            `Descripción: ${data.description}`,
            `Fecha: ${data.pubDate}`,
            `Autor: ${data.author}`,
            `URL: ${data.url}`,
          ];
          if (data.tags?.length) {
            meta.push(`Etiquetas: ${data.tags.join(", ")}`);
          }
          text = meta.join("\n") + "\n\n" + data.rawContent;
        }

        try {
          await navigator.clipboard.writeText(text);
          const original = label.textContent;
          label.textContent = "OK";
          btn.classList.add("scale-105");
          setTimeout(() => {
            label.textContent = original;
            btn.classList.remove("scale-105");
          }, 2000);
        } catch {
          const original = label.textContent;
          label.textContent = "ERR";
          setTimeout(() => {
            label.textContent = original;
          }, 2000);
        }
      });
    });
  })();
</script>
