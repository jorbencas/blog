---
interface Props {
  items: Array<{ title: string; href: string }>;
  accentColor?: "purple" | "cyan";
}

const { items, accentColor = "amber" } = Astro.props;

const colors = {
  purple: {
    hover: "hover:border-purple-500/50",
    text: "group-hover:text-purple-600 dark:group-hover:text-purple-400",
  },
  cyan: {
    hover: "hover:border-cyan-500/50",
    text: "group-hover:text-cyan-600 dark:group-hover:text-cyan-400",
  },
  amber: {
    hover: "hover:border-amber-500/50",
    text: "group-hover:text-amber-600 dark:group-hover:text-amber-400",
  },
};
const c = colors[accentColor];
---

{
  items.length > 0 && (
    <div class="space-y-3 mt-4">
      <span class="text-base font-bold uppercase tracking-[0.3em] text-slate-500 dark:text-slate-400 block pb-2 w-fit">
        Retos Relacionados
      </span>
      <div class="space-y-3">
        {items.map((item) => (
          <a
            href={item.href}
            class:list={[
              "block p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 transition-colors no-underline group",
              c.hover,
            ]}
          >
            <p
              class:list={[
                "text-sm font-black uppercase tracking-wider text-slate-900 dark:text-white transition-colors line-clamp-2 leading-tight",
                c.text,
              ]}
            >
              {item.title}
            </p>
          </a>
        ))}
      </div>
    </div>
  )
}
