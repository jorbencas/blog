---
const pathname = new URL(Astro.url).pathname;
const currentPath = pathname.slice(1); // Elimina la barra inicial
---

<nav
  class="relative flex flex-col md:flex-row md:items-center md:gap-8 py-6 w-full"
>
  <input type="checkbox" id="menu-toggle" class="peer hidden" />

  <label
    for="menu-toggle"
    class="flex flex-col justify-center h-8 w-8 gap-1.5 cursor-pointer z-50 select-none md:hidden self-start"
  >
    <span
      class="w-6 h-0.5 bg-slate-900 dark:bg-slate-200 transition-all duration-300 origin-center peer-checked:rotate-45 peer-checked:translate-y-[8px]"
    ></span>

    <span
      class="w-6 h-0.5 bg-slate-900 dark:bg-slate-200 transition-all duration-300 origin-center peer-checked:opacity-0 peer-checked:scale-x-0"
    ></span>

    <span
      class="w-6 h-0.5 bg-slate-900 dark:bg-slate-200 transition-all duration-300 origin-center peer-checked:-rotate-45 peer-checked:-translate-y-[8px]"
    ></span>
  </label>

  <div
    id="menu-items"
    class="hidden peer-checked:flex md:flex flex-col md:flex-row gap-6 md:gap-8 w-full md:w-auto pt-6 md:pt-0"
  >
    <a
      href="/proyectos/1"
      class={`group relative text-sm font-black uppercase tracking-[0.2em] italic transition-colors w-full md:w-fit ${
        currentPath.startsWith("proyectos")
          ? "text-purple-500"
          : "text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white"
      }`}
    >
      Proyectos
      <span
        class={`absolute -bottom-1 left-0 h-0.5 bg-purple-500 transition-all duration-300 ${
          currentPath.startsWith("proyectos")
            ? "w-full"
            : "w-0 group-hover:w-full"
        }`}></span>
    </a>

    <a
      href="/retos/1"
      class={`group relative text-sm font-black uppercase tracking-[0.2em] italic transition-colors w-full md:w-fit ${
        currentPath.startsWith("retos")
          ? "text-cyan-600 dark:text-cyan-500"
          : "text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white"
      }`}
    >
      Retos
      <span
        class={`absolute -bottom-1 left-0 h-0.5 bg-cyan-500 transition-all duration-300 ${
          currentPath.startsWith("retos") ? "w-full" : "w-0 group-hover:w-full"
        }`}></span>
    </a>

    <a
      href="/posts/1"
      class={`group relative text-sm font-black uppercase tracking-[0.2em] italic transition-colors w-full md:w-fit ${
        currentPath.startsWith("posts")
          ? "text-slate-900 dark:text-slate-200"
          : "text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white"
      }`}
    >
      Blog
      <span
        class={`absolute -bottom-1 left-0 h-0.5 bg-slate-900 dark:bg-slate-200 transition-all duration-300 ${
          currentPath.startsWith("posts") ? "w-full" : "w-0 group-hover:w-full"
        }`}></span>
    </a>
  </div>
</nav>
