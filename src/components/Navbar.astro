---
const pathname = new URL(Astro.url).pathname;
const currentPath = pathname.slice(1);
---

<nav class="w-full lg:w-auto">
  <input type="checkbox" id="menu-toggle" class="peer hidden" />

  <label
    for="menu-toggle"
    class="flex flex-col justify-center h-8 w-8 gap-1.5 cursor-pointer z-50 select-none lg:hidden absolute left-4 top-4 md:top-6
    peer-checked:[&>span:nth-child(1)]:rotate-45 peer-checked:[&>span:nth-child(1)]:translate-y-[8px]
    peer-checked:[&>span:nth-child(2)]:opacity-0 peer-checked:[&>span:nth-child(2)]:scale-x-0
    peer-checked:[&>span:nth-child(3)]:-rotate-45 peer-checked:[&>span:nth-child(3)]:-translate-y-[8px]"
  >
    <span
      class="w-6 h-0.5 bg-slate-900 dark:bg-slate-200 transition-all duration-300 origin-center"
    ></span>
    <span
      class="w-6 h-0.5 bg-slate-900 dark:bg-slate-200 transition-all duration-300 origin-center"
    ></span>
    <span
      class="w-6 h-0.5 bg-slate-900 dark:bg-slate-200 transition-all duration-300 origin-center"
    ></span>
  </label>

  <div
    id="menu-items"
    class="hidden peer-checked:flex lg:flex flex-col lg:flex-row gap-6 lg:gap-8 w-full lg:w-auto pt-6 lg:pt-0 items-center justify-center"
  >
    <a
      href="/proyectos/1"
      class={`group relative text-sm font-black uppercase tracking-[0.2em] italic transition-colors w-full lg:w-fit text-center lg:text-left ${
        currentPath.startsWith("proyectos")
          ? "text-purple-500"
          : "text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white"
      }`}
    >
      Proyectos
      <span
        class={`absolute -bottom-1 left-0 h-0.5 bg-purple-500 transition-all duration-300 ${
          currentPath.startsWith("proyectos")
            ? "w-full"
            : "w-0 group-hover:w-full"
        }`}></span>
    </a>

    <a
      href="/retos/1"
      class={`group relative text-sm font-black uppercase tracking-[0.2em] italic transition-colors w-full lg:w-fit text-center lg:text-left ${
        currentPath.startsWith("retos")
          ? "text-cyan-600 dark:text-cyan-500"
          : "text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white"
      }`}
    >
      Retos
      <span
        class={`absolute -bottom-1 left-0 h-0.5 bg-cyan-500 transition-all duration-300 ${
          currentPath.startsWith("retos") ? "w-full" : "w-0 group-hover:w-full"
        }`}></span>
    </a>

    <a
      href="/posts/1"
      class={`group relative text-sm font-black uppercase tracking-[0.2em] italic transition-colors w-full lg:w-fit text-center lg:text-left ${
        currentPath.startsWith("posts")
          ? "text-slate-900 dark:text-slate-200"
          : "text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white"
      }`}
    >
      Blog
      <span
        class={`absolute -bottom-1 left-0 h-0.5 bg-slate-900 dark:bg-slate-200 transition-all duration-300 ${
          currentPath.startsWith("posts") ? "w-full" : "w-0 group-hover:w-full"
        }`}></span>
    </a>
  </div>
</nav>
