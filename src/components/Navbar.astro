---
const pathname = new URL(Astro.url).pathname;
const currentPath = pathname.slice(1);
---

<nav class="relative flex items-center">
  <button
    id="menu-toggle"
    aria-label="Abrir menú de navegación"
    class="flex flex-col items-center justify-center h-9 w-9 gap-[4.5px] cursor-pointer select-none lg:hidden rounded-lg transition-all duration-200 hover:bg-slate-100 dark:hover:bg-slate-800"
  >
    <span class="w-4 h-[2.5px] bg-slate-900 dark:bg-slate-200 transition-all duration-300 origin-center rounded-full"></span>
    <span class="w-4 h-[2.5px] bg-slate-900 dark:bg-slate-200 transition-all duration-300 origin-center rounded-full"></span>
    <span class="w-4 h-[2.5px] bg-slate-900 dark:bg-slate-200 transition-all duration-300 origin-center rounded-full"></span>
  </button>

  <div
    id="menu-backdrop"
    class="fixed inset-0 z-30 bg-black/40 opacity-0 pointer-events-none transition-opacity duration-300 ease-out lg:hidden"
  />

  <div
    id="menu-items"
    class="fixed top-0 right-0 z-40 h-full w-72 max-w-[85vw] bg-white dark:bg-slate-900 shadow-2xl border-l border-slate-200 dark:border-slate-800
      flex flex-col justify-center gap-8 px-10
      transition-transform duration-300 ease-out
      lg:static lg:shadow-none lg:border-none lg:flex-row lg:items-center lg:w-auto lg:h-auto lg:p-0 lg:gap-8 lg:bg-transparent lg:dark:bg-transparent"
  >
    <a
      href="/proyectos/1"
      aria-current={currentPath.startsWith("proyectos") ? "page" : undefined}
      class={`nav-link group relative text-sm font-black uppercase tracking-[0.2em] italic transition-colors text-left ${
        currentPath.startsWith("proyectos")
          ? "text-purple-500"
          : "text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white"
      }`}
    >
      Proyectos
      <span
        class={`nav-underline absolute -bottom-1 left-0 h-0.5 bg-purple-500 transition-all duration-300 ${
          currentPath.startsWith("proyectos") ? "w-full" : "w-0"
        }`}></span>
    </a>

    <a
      href="/retos/1"
      aria-current={currentPath.startsWith("retos") ? "page" : undefined}
      class={`nav-link group relative text-sm font-black uppercase tracking-[0.2em] italic transition-colors text-left ${
        currentPath.startsWith("retos")
          ? "text-cyan-600 dark:text-cyan-500"
          : "text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white"
      }`}
    >
      Retos
      <span
        class={`nav-underline absolute -bottom-1 left-0 h-0.5 bg-cyan-500 transition-all duration-300 ${
          currentPath.startsWith("retos") ? "w-full" : "w-0"
        }`}></span>
    </a>

    <a
      href="/posts/1"
      aria-current={currentPath.startsWith("posts") ? "page" : undefined}
      class={`nav-link group relative text-sm font-black uppercase tracking-[0.2em] italic transition-colors text-left ${
        currentPath.startsWith("posts")
          ? "text-slate-900 dark:text-slate-200"
          : "text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white"
      }`}
    >
      Blog
      <span
        class={`nav-underline absolute -bottom-1 left-0 h-0.5 bg-slate-900 dark:bg-slate-200 transition-all duration-300 ${
          currentPath.startsWith("posts") ? "w-full" : "w-0"
        }`}></span>
    </a>

    <a
      href="/herramientas/1"
      aria-current={currentPath.startsWith("herramientas") ? "page" : undefined}
      class={`nav-link group relative text-sm font-black uppercase tracking-[0.2em] italic transition-colors text-left ${
        currentPath.startsWith("herramientas")
          ? "text-emerald-500"
          : "text-slate-600 dark:text-slate-400 hover:text-emerald-500 dark:hover:text-emerald-400"
      }`}
    >
      Mini Herramientas
      <span
        class={`nav-underline absolute -bottom-1 left-0 h-0.5 bg-emerald-500 transition-all duration-300 ${
          currentPath.startsWith("herramientas") ? "w-full" : "w-0"
        }`}></span>
    </a>

    <a
      href="https://github.com/jorbencas/blog/issues/new/choose"
      target="_blank"
      rel="noopener noreferrer"
      class="nav-link group relative text-sm font-black uppercase tracking-[0.2em] italic transition-colors text-left text-slate-600 dark:text-slate-400 hover:text-amber-500 dark:hover:text-amber-400"
    >
      Bugs
      <span
        class="nav-underline absolute -bottom-1 left-0 h-0.5 bg-amber-500 transition-all duration-300 w-0"
      ></span>
    </a>
  </div>
</nav>

<style>
  .nav-link:hover .nav-underline {
    width: 100% !important;
  }

  #menu-backdrop.open {
    opacity: 1;
    pointer-events: auto;
  }

  #menu-items {
    transform: translateX(100%);
  }

  #menu-items.open {
    transform: translateX(0);
  }

  @media (min-width: 1024px) {
    #menu-items {
      transform: none;
    }
  }
</style>

<script>
  const btn = document.getElementById("menu-toggle");
  const backdrop = document.getElementById("menu-backdrop");
  const menuItems = document.getElementById("menu-items");
  const lines = btn?.querySelectorAll("span");

  let isOpen = false;

  function openMenu() {
    isOpen = true;
    backdrop?.classList.add("open");
    menuItems?.classList.add("open");
    lines?.[0]?.classList.add("rotate-45", "translate-y-[6.5px]");
    lines?.[1]?.classList.add("opacity-0");
    lines?.[2]?.classList.add("-rotate-45", "-translate-y-[6.5px]");

    const scrollY = window.scrollY;
    document.body.dataset.scrollY = String(scrollY);
    document.body.style.position = "fixed";
    document.body.style.top = `-${scrollY}px`;
    document.body.style.left = "0";
    document.body.style.right = "0";
  }

  function closeMenu() {
    isOpen = false;
    backdrop?.classList.remove("open");
    menuItems?.classList.remove("open");
    lines?.[0]?.classList.remove("rotate-45", "translate-y-[6.5px]");
    lines?.[1]?.classList.remove("opacity-0");
    lines?.[2]?.classList.remove("-rotate-45", "-translate-y-[6.5px]");

    const scrollY = parseInt(document.body.dataset.scrollY || "0", 10);
    document.body.style.position = "";
    document.body.style.top = "";
    document.body.style.left = "";
    document.body.style.right = "";
    window.scrollTo(0, scrollY);
  }

  function toggleMenu() {
    if (isOpen) closeMenu();
    else openMenu();
  }

  if (btn) {
    btn.addEventListener("click", toggleMenu);

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && isOpen) closeMenu();
    });

    window.addEventListener("resize", () => {
      if (window.innerWidth >= 1024 && isOpen) closeMenu();
    });

    if (backdrop) {
      backdrop.addEventListener("click", closeMenu);
    }
  }
</script>
