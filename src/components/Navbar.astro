---
const pathname = new URL(Astro.url).pathname;
const currentPath = pathname.slice(1);
---

<nav class="relative w-full lg:w-auto">
  <input type="checkbox" id="menu-toggle" class="peer hidden" aria-label="Abrir menú de navegación" />

  <label
    for="menu-toggle"
    aria-label="Abrir menú"
    class="relative z-50 flex items-center justify-center h-10 w-10 gap-[5px] cursor-pointer select-none lg:hidden mx-auto rounded-lg border border-slate-200 dark:border-slate-700 bg-white/80 dark:bg-slate-800/80 backdrop-blur-sm
    peer-checked:[&>span:nth-child(1)]:rotate-45 peer-checked:[&>span:nth-child(1)]:translate-y-[8.5px]
    peer-checked:[&>span:nth-child(2)]:opacity-0 peer-checked:[&>span:nth-child(2)]:scale-x-0
    peer-checked:[&>span:nth-child(3)]:-rotate-45 peer-checked:[&>span:nth-child(3)]:-translate-y-[8.5px]"
  >
    <span
      class="w-5 h-[2.5px] bg-slate-900 dark:bg-slate-200 transition-all duration-300 origin-center rounded-full"
    ></span>
    <span
      class="w-5 h-[2.5px] bg-slate-900 dark:bg-slate-200 transition-all duration-300 origin-center rounded-full"
    ></span>
    <span
      class="w-5 h-[2.5px] bg-slate-900 dark:bg-slate-200 transition-all duration-300 origin-center rounded-full"
    ></span>
  </label>

  <div
    id="menu-items"
    class="flex-col lg:flex-row gap-6 lg:gap-8 w-full lg:w-auto pt-6 lg:pt-0 items-center justify-center
    fixed lg:static inset-x-0 top-0 bottom-0 lg:inset-auto bg-white/95 dark:bg-slate-900/95 lg:bg-transparent lg:dark:bg-transparent z-40 overflow-y-auto
    transition-all duration-300 ease-out
    peer-checked:opacity-100 peer-checked:pointer-events-auto peer-checked:translate-y-0
    opacity-0 pointer-events-none -translate-y-2
    lg:opacity-100 lg:pointer-events-auto lg:translate-y-0"
  >
    <div class="flex flex-col lg:flex-row gap-6 lg:gap-8 items-center justify-center pt-16 lg:pt-0">
      <a
        href="/proyectos/1"
        aria-current={currentPath.startsWith("proyectos") ? "page" : undefined}
        class={`group relative text-sm font-black uppercase tracking-[0.2em] italic transition-colors w-full lg:w-fit text-center lg:text-left ${
          currentPath.startsWith("proyectos")
            ? "text-purple-500"
            : "text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white"
        }`}
      >
        Proyectos
        <span
          class={`absolute -bottom-1 left-0 h-0.5 bg-purple-500 transition-all duration-300 ${
            currentPath.startsWith("proyectos")
              ? "w-full"
              : "w-0 group-hover:w-full"
          }`}></span>
      </a>

      <a
        href="/retos/1"
        aria-current={currentPath.startsWith("retos") ? "page" : undefined}
        class={`group relative text-sm font-black uppercase tracking-[0.2em] italic transition-colors w-full lg:w-fit text-center lg:text-left ${
          currentPath.startsWith("retos")
            ? "text-cyan-600 dark:text-cyan-500"
            : "text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white"
        }`}
      >
        Retos
        <span
          class={`absolute -bottom-1 left-0 h-0.5 bg-cyan-500 transition-all duration-300 ${
            currentPath.startsWith("retos") ? "w-full" : "w-0 group-hover:w-full"
          }`}></span>
      </a>

      <a
        href="/posts/1"
        aria-current={currentPath.startsWith("posts") ? "page" : undefined}
        class={`group relative text-sm font-black uppercase tracking-[0.2em] italic transition-colors w-full lg:w-fit text-center lg:text-left ${
          currentPath.startsWith("posts")
            ? "text-slate-900 dark:text-slate-200"
            : "text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white"
        }`}
      >
        Blog
        <span
          class={`absolute -bottom-1 left-0 h-0.5 bg-slate-900 dark:bg-slate-200 transition-all duration-300 ${
            currentPath.startsWith("posts") ? "w-full" : "w-0 group-hover:w-full"
          }`}></span>
      </a>
      <a
        href="/herramientas/1"
        aria-current={currentPath.startsWith("herramientas") ? "page" : undefined}
        class={`group relative text-sm font-black uppercase tracking-[0.2em] italic transition-colors w-full lg:w-fit text-center lg:text-left ${
          currentPath.startsWith("herramientas")
            ? "text-emerald-500"
            : "text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white"
        }`}
      >
        Mini Herramientas
        <span
          class={`absolute -bottom-1 left-0 h-0.5 bg-emerald-500 transition-all duration-300 ${
            currentPath.startsWith("herramientas")
              ? "w-full"
              : "w-0 group-hover:w-full"
          }`}></span>
      </a>
    </div>
  </div>
</nav>

<script>
  const toggle = document.getElementById("menu-toggle");
  if (toggle) {
    toggle.addEventListener("change", () => {
      document.body.style.overflow = toggle.checked ? "hidden" : "";
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && toggle.checked) {
        toggle.checked = false;
        document.body.style.overflow = "";
      }
    });

    window.addEventListener("resize", () => {
      if (window.innerWidth >= 1024 && toggle.checked) {
        toggle.checked = false;
        document.body.style.overflow = "";
      }
    });
  }
</script>
