---
const pathname = new URL(Astro.url).pathname;
const currentPath = pathname.slice(1);
---

<nav class="relative flex items-center">
  <button
    id="menu-toggle"
    aria-label="Abrir menú de navegación"
    class="flex flex-col items-center justify-center h-9 w-9 gap-[4.5px] cursor-pointer select-none lg:hidden rounded-lg transition-all duration-200 hover:bg-slate-100 dark:hover:bg-slate-800"
  >
    <span class="w-4 h-[2.5px] bg-slate-900 dark:bg-slate-200 transition-all duration-300 origin-center rounded-full"></span>
    <span class="w-4 h-[2.5px] bg-slate-900 dark:bg-slate-200 transition-all duration-300 origin-center rounded-full"></span>
    <span class="w-4 h-[2.5px] bg-slate-900 dark:bg-slate-200 transition-all duration-300 origin-center rounded-full"></span>
  </button>

  <div
    id="menu-items"
    class="fixed top-0 right-0 z-40 h-dvh w-72 max-w-[85vw] bg-slate-50 dark:bg-slate-900 shadow-2xl border-l border-slate-200 dark:border-slate-800
      flex flex-col gap-8 px-10 pt-16
      transition-transform duration-300 ease-out
      lg:static lg:shadow-none lg:border-none lg:flex-row lg:items-center lg:w-auto lg:h-auto lg:p-0 lg:gap-5 lg:bg-transparent lg:dark:bg-transparent"
  >
    <button
      id="menu-close"
      aria-label="Cerrar menú de navegación"
      class="absolute top-4 right-4 flex items-center justify-center h-9 w-9 rounded-lg text-slate-500 dark:text-slate-400 hover:text-cyan-600 dark:hover:text-cyan-400 hover:bg-slate-100 dark:hover:bg-slate-800 transition-all duration-200 lg:hidden"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M18 6L6 18M6 6l12 12"/>
      </svg>
    </button>

    <a
      href="/proyectos"
      aria-current={currentPath.startsWith("proyectos") ? "page" : undefined}
      class={`nav-link group relative text-sm lg:text-[11px] font-black uppercase tracking-[0.1em] transition-colors text-left ${
        currentPath.startsWith("proyectos")
          ? "text-purple-500"
          : "text-slate-600 dark:text-slate-400 hover:text-purple-500 dark:hover:text-purple-400"
      }`}
    >
      Proyectos
      <span
        class={`nav-underline absolute -bottom-1 left-0 h-0.5 bg-purple-500 transition-all duration-300 ${
          currentPath.startsWith("proyectos") ? "w-full" : "w-0"
        }`}></span>
    </a>

    <a
      href="/retos"
      aria-current={currentPath.startsWith("retos") ? "page" : undefined}
      class={`nav-link group relative text-sm lg:text-[11px] font-black uppercase tracking-[0.1em] transition-colors text-left ${
        currentPath.startsWith("retos")
          ? "text-amber-500"
          : "text-slate-600 dark:text-slate-400 hover:text-amber-500"
      }`}
    >
      Retos
      <span
        class={`nav-underline absolute -bottom-1 left-0 h-0.5 bg-amber-500 transition-all duration-300 ${
          currentPath.startsWith("retos") ? "w-full" : "w-0"
        }`}></span>
    </a>

    <a
      href="/posts"
      aria-current={currentPath.startsWith("posts") ? "page" : undefined}
      class={`nav-link group relative text-sm lg:text-[11px] font-black uppercase tracking-[0.1em] transition-colors text-left ${
        currentPath.startsWith("posts")
          ? "text-cyan-500"
          : "text-slate-600 dark:text-slate-400 hover:text-cyan-500"
      }`}
    >
      Blog
      <span
        class={`nav-underline absolute -bottom-1 left-0 h-0.5 bg-cyan-500 transition-all duration-300 ${
          currentPath.startsWith("posts") ? "w-full" : "w-0"
        }`}></span>
    </a>

    <a
      href="/herramientas"
      aria-current={currentPath.startsWith("herramientas") ? "page" : undefined}
      class={`nav-link group relative text-sm lg:text-[11px] font-black uppercase tracking-[0.1em] transition-colors text-left ${
        currentPath.startsWith("herramientas")
          ? "text-emerald-500"
          : "text-slate-600 dark:text-slate-400 hover:text-emerald-500 dark:hover:text-emerald-400"
      }`}
    >
      Mini Herramientas
      <span
        class={`nav-underline absolute -bottom-1 left-0 h-0.5 bg-emerald-500 transition-all duration-300 ${
          currentPath.startsWith("herramientas") ? "w-full" : "w-0"
        }`}></span>
    </a>

    <a
      href="/weekly"
      aria-current={currentPath.startsWith("weekly") ? "page" : undefined}
      class={`nav-link group relative text-sm lg:text-[11px] font-black uppercase tracking-[0.1em] transition-colors text-left ${
        currentPath.startsWith("weekly")
          ? "text-yellow-500"
          : "text-slate-600 dark:text-slate-400 hover:text-yellow-500 dark:hover:text-yellow-400"
      }`}
    >
      Weekly
      <span
        class={`nav-underline absolute -bottom-1 left-0 h-0.5 bg-yellow-500 transition-all duration-300 ${
          currentPath.startsWith("weekly") ? "w-full" : "w-0"
        }`}></span>
    </a>

    <a
      href="/tags"
      aria-current={currentPath.startsWith("tags") ? "page" : undefined}
      class={`nav-link group relative text-sm lg:text-[11px] font-black uppercase tracking-[0.1em] transition-colors text-left ${
        currentPath.startsWith("tags")
          ? "text-cyan-500"
          : "text-slate-600 dark:text-slate-400 hover:text-cyan-500 dark:hover:text-cyan-400"
      }`}
    >
      Tags
      <span
        class={`nav-underline absolute -bottom-1 left-0 h-0.5 bg-cyan-500 transition-all duration-300 ${
          currentPath.startsWith("tags") ? "w-full" : "w-0"
        }`}></span>
    </a>

    <a
      href="/about"
      aria-current={currentPath.startsWith("about") ? "page" : undefined}
      class={`nav-link group relative text-sm lg:text-[11px] font-black uppercase tracking-[0.1em] transition-colors text-left ${
        currentPath.startsWith("about")
          ? "text-sky-500"
          : "text-slate-600 dark:text-slate-400 hover:text-sky-500 dark:hover:text-sky-400"
      }`}
    >
      Sobre Mí
      <span
        class={`nav-underline absolute -bottom-1 left-0 h-0.5 bg-sky-500 transition-all duration-300 ${
          currentPath.startsWith("about") ? "w-full" : "w-0"
        }`}></span>
    </a>
  </div>
</nav>

<style>
  .nav-link:hover .nav-underline {
    width: 100% !important;
  }

  #menu-items {
    transform: translateX(100%);
  }

  #menu-items.open {
    transform: translateX(0);
  }

  @media (min-width: 1024px) {
    #menu-items {
      transform: none;
    }
  }
</style>

<script>
  const btn = document.getElementById("menu-toggle");
  const closeBtn = document.getElementById("menu-close");
  const backdrop = document.getElementById("menu-backdrop");
  const menuItems = document.getElementById("menu-items");

  function openMenu() {
    backdrop?.classList.add("open");
    menuItems?.classList.add("open");

    const scrollY = window.scrollY;
    document.body.dataset.scrollY = String(scrollY);
    document.body.style.position = "fixed";
    document.body.style.top = `-${scrollY}px`;
    document.body.style.left = "0";
    document.body.style.right = "0";
  }

  function closeMenu() {
    backdrop?.classList.remove("open");
    menuItems?.classList.remove("open");

    const scrollY = parseInt(document.body.dataset.scrollY || "0", 10);
    document.body.style.position = "";
    document.body.style.top = "";
    document.body.style.left = "";
    document.body.style.right = "";
    window.scrollTo(0, scrollY);
  }

  btn?.addEventListener("click", openMenu);
  closeBtn?.addEventListener("click", closeMenu);
</script>
