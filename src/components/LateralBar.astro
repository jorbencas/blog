---
import Tags from "./Tags.astro";
// import Archive from "./Archive.astro";;
---

<div class="container-fluid flex flex-wrap items-center justify-between px-6">
  <a
    href="https://twitter.com/jorgevenkas"
    target="_blanck"
    aria-label="twitter"
  >
    <img src="/icons/twitter.svg" />
  </a>
  <a href="https://github.com/jorbencas" target="_blanck" aria-label="github">
    <img src="/icons/github.svg" />
  </a>
  <a href="https://gitlab.com/jorbencas" target="_blanck" aria-label="gitlab">
    <img src="/icons/gitlab.svg" />
  </a>
  <a
    href="https://jorgeblogbeneyto.wordpress.com/"
    target="_blanck"
    aria-label="wordpress"
  >
    <img src="/icons/wordpress.svg" />
  </a>
  <a
    href="https://cosasdejorget.blogspot.com/"
    target="_blanck"
    aria-label="Blogger"
  >
    <img src="/icons/blogger.svg" />
  </a>
  <a
    href="https://sites.google.com/site/saplicacioneswebjorge2smx/"
    target="_blanck"
    aria-label="Google Sites"
  >
    <img src="/icons/googleSites.svg" />
  </a>
  <a
    href="mailto:jorgebeneytocastello@gmail.com"
    rel="noopener nofollow"
    aria-label="Contacto"
  >
    <img src="/icons/email.svg" />
  </a>
</div>

<Tags />
<!-- <Archive /> -->
<div class="min-h-10 max-w-xs overflow-hidden">
  <a
    class="twitter-timeline"
    data-dnt="true"
    data-theme="dark"
    href="https://twitter.com/jorgevenkas?ref_src=twsrc%5Etfw"
    >Tweets por @jorgevenkas</a
  >
  <script async src="https://platform.twitter.com/widgets.js" charset="utf-8"
  ></script>
</div>
