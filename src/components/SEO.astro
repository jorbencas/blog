---
// seo.astro
import { SITE_NAME, AUTHOR_NAME } from "src/consts.js";

interface Props {
  title: string;
  description: string;
  tags?: string[];
  section?: string;
  pubDate?: string | Date;
  dateModified?: string | Date;
  author?: string;
  pageType?: "blog" | "tool";
}

const { title, description, tags = [], section, pubDate, dateModified, author, pageType = "blog" } = Astro.props;

const truncateAtWord = (text, maxLen) => {
  if (text.length <= maxLen) return text;
  const truncated = text.substring(0, maxLen);
  const lastSpace = truncated.lastIndexOf(" ");
  return `${truncated.substring(0, lastSpace > 0 ? lastSpace : maxLen)}...`;
};

const cleanTitle = truncateAtWord(title, 60);
const cleanDescription = truncateAtWord(description, 155);

const titleEncoded = encodeURIComponent(title);
const tagsEncoded = encodeURIComponent(
  tags.length > 0 ? tags.join(",") : "default"
);
const sectionEncoded = section ? encodeURIComponent(section) : "";
const descEncoded = description ? encodeURIComponent(cleanDescription) : "";

const ogImageURLObj = new URL(
  `/api/og/og.png?title=${titleEncoded}&tags=${tagsEncoded}${sectionEncoded ? `&section=${sectionEncoded}` : ""}${descEncoded ? `&desc=${descEncoded}` : ""}`,
  Astro.site
);
const ogImageUrl = ogImageURLObj.toString();

const canonicalObj = new URL(Astro.url.pathname, Astro.site);
const canonicalURL =
  canonicalObj.toString().endsWith("/") && canonicalObj.pathname !== "/"
    ? canonicalObj.toString().slice(0, -1)
    : canonicalObj.toString();
const pubDateISO = pubDate ? new Date(pubDate).toISOString() : undefined;
const modDateISO = dateModified ? new Date(dateModified).toISOString() : pubDateISO;

const cleanAltText = title
  .replace(/\s*[-—–]\s*/g, " ")
  .replace(/\s+/g, " ")
  .trim();

const breadcrumbItems = [
  { name: "Inicio", url: Astro.site?.toString() || "/" },
];
if (section === "posts") {
  breadcrumbItems.push({ name: "Bitácora", url: `${Astro.site}posts` });
} else if (section === "retos") {
  breadcrumbItems.push({ name: "Retos", url: `${Astro.site}retos/1` });
} else if (section === "proyectos") {
  breadcrumbItems.push({ name: "Proyectos", url: `${Astro.site}proyectos` });
}
breadcrumbItems.push({ name: title, url: canonicalURL });

let jsonLD;
if (pageType === "tool") {
  jsonLD = [
    {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      name: title,
      description: description,
      url: canonicalURL.toString(),
      image: ogImageUrl,
      applicationCategory: "GameApplication",
      operatingSystem: "Any",
      offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "USD",
      },
      ...(author && {
        author: {
          "@type": "Person",
          name: author,
        },
      }),
      publisher: {
        "@type": "Person",
        name: AUTHOR_NAME,
      },
      ...(pubDateISO && { datePublished: pubDateISO }),
      ...(modDateISO && { dateModified: modDateISO }),
    },
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: breadcrumbItems.map((item, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: item.name,
        item: item.url,
      })),
    },
  ];
} else {
  jsonLD = [
    {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      headline: title,
      description: description,
      keywords: tags.join(", "),
      url: canonicalURL.toString(),
      mainEntityOfPage: canonicalURL.toString(),
      image: ogImageUrl,
      ...(pubDateISO && { datePublished: pubDateISO, dateModified: modDateISO }),
      ...(author && {
        author: {
          "@type": "Person",
          name: author,
        },
      }),
      publisher: {
        "@type": "Person",
        name: AUTHOR_NAME,
      },
    },
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: breadcrumbItems.map((item, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: item.name,
        item: item.url,
      })),
    },
  ];
}
---

<!-- SEO Estándar -->
<title>{cleanTitle}</title>
<meta name="description" content={cleanDescription} />
<link rel="canonical" href={canonicalURL.toString()} />
{
  pubDate && (
    <meta
      property="article:published_time"
      content={new Date(pubDate).toISOString()}
    />
  )
}
{author && <meta property="article:author" content={author} />}

<!-- [TIP] Metas de personalización móvil y branding añadidos -->
<meta name="theme-color" content="#06b6d4" />

<!-- Open Graph / Facebook / LinkedIn -->
<meta property="og:type" content={pageType === "tool" ? "website" : "article"} />
<meta property="og:url" content={canonicalURL.toString()} />
<meta property="og:title" content={cleanTitle} />
<meta property="og:description" content={cleanDescription} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:alt" content={`${cleanAltText} — ${SITE_NAME}`} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:locale" content="es_ES" />

{tags.map((tag) => <meta property="article:tag" content={tag} />)}

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@jorbencas" />
<meta name="twitter:creator" content="@jorbencas" />
<meta property="twitter:url" content={canonicalURL.toString()} />
<meta property="twitter:title" content={cleanTitle} />
<meta property="twitter:description" content={cleanDescription} />
<meta property="twitter:image" content={ogImageUrl} />
<meta name="twitter:image:alt" content={`${cleanAltText} — ${SITE_NAME}`} />

<script type="application/ld+json" set:html={JSON.stringify(jsonLD)} />
