---
// seo.astro
interface Props {
  title: string;
  description: string;
  tags?: string[];
  pubDate?: string | Date;
  author?: string;
}

const { title, description, tags = [], pubDate, author } = Astro.props;

// 1. SOLUCIÓN WARNINGS: Evitamos que textos muy largos trunquen las tarjetas en redes
const cleanTitle = title.length > 60 ? `${title.substring(0, 57)}...` : title;
const cleanDescription =
  description.length > 155
    ? `${description.substring(0, 152)}...`
    : description;

const titleEncoded = encodeURIComponent(title);
const tagsEncoded = encodeURIComponent(
  tags.length > 0 ? tags.join(",") : "default"
);

const ogImageURLObj = new URL(
  `/api/og/og.png?title=${titleEncoded}&tags=${tagsEncoded}`,
  Astro.site
);
const ogImageUrl = ogImageURLObj.toString();

const canonicalObj = new URL(Astro.url.pathname, Astro.site);
const canonicalURL =
  canonicalObj.toString().endsWith("/") && canonicalObj.pathname !== "/"
    ? canonicalObj.toString().slice(0, -1)
    : canonicalObj.toString();
const pubDateISO = pubDate ? new Date(pubDate).toISOString() : undefined;

const jsonLD = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description: description,
  keywords: tags.join(", "),
  url: canonicalURL.toString(),
  mainEntityOfPage: canonicalURL.toString(),
  image: ogImageUrl,
  ...(pubDateISO && { datePublished: pubDateISO, dateModified: pubDateISO }),
  ...(author && {
    author: {
      "@type": "Person",
      name: author,
    },
  }),
  publisher: {
    "@type": "Person",
    name: "Jorge Beneyto Castelló",
  },
};
---

<!-- SEO Estándar -->
<title>{cleanTitle}</title>
<meta name="description" content={cleanDescription} />
<link rel="canonical" href={canonicalURL.toString()} />
{
  pubDate && (
    <meta
      property="article:published_time"
      content={new Date(pubDate).toISOString()}
    />
  )
}
{pubDate && (
  <meta
    property="article:modified_time"
    content={new Date(pubDate).toISOString()}
  />
)}
{author && <meta property="article:author" content={author} />}

<!-- [TIP] Metas de personalización móvil y branding añadidos -->
<meta name="theme-color" content="#06b6d4" />

<!-- Open Graph / Facebook / LinkedIn -->
<meta property="og:type" content="article" />
<meta property="og:url" content={canonicalURL.toString()} />
<meta property="og:title" content={cleanTitle} />
<meta property="og:description" content={cleanDescription} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:alt" content={`Portada del artículo: ${title}`} />
<meta property="og:site_name" content="Problemas de un desarrollador Web" />
<meta property="og:locale" content="es_ES" />
<meta
  property="og:image:alt"
  content={`Imagen de portada para el artículo: ${title}`}
/>

{tags.map((tag) => <meta property="article:tag" content={tag} />)}

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@jorbencas" />
<meta name="twitter:creator" content="@jorbencas" />
<meta property="twitter:url" content={canonicalURL.toString()} />
<meta property="twitter:title" content={cleanTitle} />
<meta property="twitter:description" content={cleanDescription} />
<meta property="twitter:image" content={ogImageUrl} />

<script type="application/ld+json" set:html={JSON.stringify(jsonLD)} />
