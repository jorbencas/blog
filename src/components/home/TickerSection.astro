---
interface TickerItem {
  type: string;
  title: string;
  href: string;
  icon: string;
  color: string;
}

interface Props {
  items: TickerItem[];
}

const { items } = Astro.props;
---

<div class="mb-16 md:mb-32 overflow-hidden rounded-xl border border-slate-200/60 dark:border-slate-800 bg-white/80 dark:bg-slate-900 backdrop-blur-md shadow-sm">
  <div class="flex items-center gap-3 px-4 py-2.5 border-b border-slate-200/60 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-800/50 backdrop-blur-sm">
    <span class="relative flex h-2.5 w-2.5">
      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-cyan-400 opacity-75"></span>
      <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-cyan-500"></span>
    </span>
    <span class="text-[11px] font-black uppercase tracking-[0.2em] text-slate-400 dark:text-slate-500">Actividad reciente</span>
  </div>
  <div class="relative overflow-hidden py-3 mask-ticker">
    <div class="ticker-track flex items-center gap-4 sm:gap-8 whitespace-nowrap w-max">
      {[...items, ...items].map((item) => (
        <a
          href={item.href}
          class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-slate-200/50 dark:border-slate-800 bg-white/60 dark:bg-slate-800/50 backdrop-blur-sm hover:border-slate-300 dark:hover:border-slate-700 transition-colors no-underline group"
        >
          <span class="text-sm">{item.icon}</span>
          <span class="text-xs font-bold text-slate-600 dark:text-slate-300 group-hover:text-cyan-600 dark:group-hover:text-cyan-400 transition-colors truncate max-w-[200px]">{item.title}</span>
        </a>
      ))}
    </div>
  </div>
</div>
