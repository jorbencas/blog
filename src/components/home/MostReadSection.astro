---
const linkBase = "group relative text-xs font-black uppercase tracking-[0.2em] italic transition-colors w-fit";
const badgeAmber = "inline-flex items-center gap-2 bg-gradient-to-r from-amber-800 to-amber-500 dark:from-amber-600 dark:to-amber-400 px-5 py-2.5 text-xs sm:text-sm font-black uppercase tracking-[0.25em] text-white dark:text-slate-900 shadow-[4px_4px_0px_0px_rgba(245,158,11,0.3)]";
---

<section class="mb-16 md:mb-32" id="most-read-section">
  <div class="flex flex-col sm:flex-row items-start sm:items-end justify-between gap-3 sm:gap-0 mb-10">
    <h2 class={badgeAmber}>🔥 Lo más leído</h2>
    <a href="/posts" class={`${linkBase} text-slate-400 hover:text-amber-500`}>
      Ver todos <span class="inline-block transition-transform group-hover:translate-x-1">→</span>
      <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-amber-500 transition-all duration-300 group-hover:w-full"></span>
    </a>
  </div>
  <div id="most-read-list" class="space-y-3">
    <div class="flex items-center gap-4 p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 animate-pulse">
      <div class="w-8 h-8 rounded-lg bg-slate-200 dark:bg-slate-800"></div>
      <div class="flex-1 space-y-2">
        <div class="h-4 bg-slate-200 dark:bg-slate-800 rounded w-3/4"></div>
        <div class="h-3 bg-slate-200 dark:bg-slate-800 rounded w-1/2"></div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
(() => {
  const container = document.getElementById("most-read-list");
  if (!container) return;

  const slugs = [
    "guia-0-100-astro.mdx",
    "tech-pulse-dashboard.mdx",
    "guia-0-100-csharp.mdx",
    "docker-instalacion-primeros-pasos.mdx",
    "creacion-porfolio-optimizado.mdx",
  ];

  const labels = {
    "guia-0-100-astro.mdx": "Guía 0 a 100: Astro",
    "tech-pulse-dashboard.mdx": "Tech Pulse Dashboard",
    "guia-0-100-csharp.mdx": "Guía 0 a 100: C#",
    "docker-instalacion-primeros-pasos.mdx": "Docker: Instalación y primeros pasos",
    "creacion-porfolio-optimizado.mdx": "Creación de portafolio optimizado",
  };

  const accents = ["text-amber-500", "text-slate-400", "text-amber-700", "text-slate-400", "text-slate-400"];
  const medals = ["🥇", "🥈", "🥉", "4", "5"];

  const renderFallback = () => {
    container.innerHTML = slugs.map((slug, i) =>
      `<a href="/posts/${slug.replace(".mdx", "")}" class="flex items-center gap-4 p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 hover:border-amber-500/50 transition-colors no-underline group">
        <span class="flex items-center justify-center w-8 h-8 rounded-lg bg-amber-100 dark:bg-amber-900/30 text-lg font-black ${accents[i]}">${medals[i]}</span>
        <div class="flex-1 min-w-0">
          <p class="text-sm font-bold text-slate-700 dark:text-slate-200 group-hover:text-amber-600 dark:group-hover:text-amber-400 transition-colors truncate">${labels[slug] || slug}</p>
        </div>
      </a>`
    ).join("");
  };

  fetch("/api/views")
    .then((r) => r.json())
    .then((data) => {
      if (!Array.isArray(data) || data.length === 0) { renderFallback(); return; }
      container.innerHTML = data.map((item, i) =>
        `<a href="/posts/${item.slug.replace(".mdx", "")}" class="flex items-center gap-4 p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 hover:border-amber-500/50 transition-colors no-underline group">
          <span class="flex items-center justify-center w-8 h-8 rounded-lg bg-amber-100 dark:bg-amber-900/30 text-lg font-black ${accents[i] || "text-slate-400"}">${medals[i] || i + 1}</span>
          <div class="flex-1 min-w-0">
            <p class="text-sm font-bold text-slate-700 dark:text-slate-200 group-hover:text-amber-600 dark:group-hover:text-amber-400 transition-colors truncate">${labels[item.slug] || item.slug}</p>
            <p class="text-xs text-slate-400 dark:text-slate-500">${item.views} vistas</p>
          </div>
        </a>`
      ).join("");
    })
    .catch(renderFallback);
})();
</script>
