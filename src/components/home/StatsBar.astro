---
interface Props {
  stats: { label: string; count: number; accent: string }[];
}

const { stats } = Astro.props;
---

<div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4 mb-10">
  {stats.map((stat) => (
    <div class="flex flex-col items-center justify-center p-6 rounded-xl border border-slate-200/60 dark:border-slate-800 bg-white/80 dark:bg-slate-900 backdrop-blur-md shadow-sm">
      <span class={`text-3xl sm:text-4xl font-black ${stat.accent}`}>{stat.count}</span>
      <span class="text-xs font-black uppercase tracking-widest text-slate-400 dark:text-slate-500 mt-1">{stat.label}</span>
    </div>
  ))}
</div>
