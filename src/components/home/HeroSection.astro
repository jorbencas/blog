---
import { SITE_DESCRIPTION, SOCIAL_LINKS } from "src/consts";

interface Props {
  daysSinceFirstPost: number;
}

const { daysSinceFirstPost } = Astro.props;

const stickers = [
  { name: "html", pos: "top: 0%; right: 10px;", rot: "5deg", c: "#06b6d4", d: "0s" },
  { name: "python", pos: "top: 8%; right: 120px;", rot: "-4deg", c: "#10b981", d: "0.3s" },
  { name: "js", pos: "top: 22%; right: 55px;", rot: "-6deg", c: "#f59e0b", d: "0.6s" },
  { name: "git", pos: "top: 34%; right: 150px;", rot: "3deg", c: "#a855f7", d: "0.9s" },
  { name: "ts", pos: "top: 44%; right: 20px;", rot: "7deg", c: "#22d3ee", d: "1.2s" },
  { name: "docker", pos: "top: 56%; right: 75px;", rot: "-2deg", c: "#34d399", d: "1.5s" },
];
---

<section class="relative mb-20 md:mb-32">
  <div class="absolute inset-0 z-0 pointer-events-none select-none circuit-bg" aria-hidden="true">
    <div class="absolute inset-0" style="background: radial-gradient(ellipse at 20% 30%, rgba(6,182,212,0.18) 0%, transparent 50%), radial-gradient(ellipse at 75% 25%, rgba(168,85,247,0.12) 0%, transparent 45%), radial-gradient(ellipse at 55% 80%, rgba(245,158,11,0.08) 0%, transparent 40%);"></div>
  </div>
  <div class="hidden md:block absolute inset-0 pointer-events-none select-none z-10">
    {stickers.map((s) => (
      <div
        class="sticker-float absolute flex items-center justify-center w-[88px] h-[88px] xl:w-[100px] xl:h-[100px] rounded-2xl bg-white dark:bg-slate-900 border-2 shadow-lg"
        style={`${s.pos} border-color: ${s.c}; --r: ${s.rot}; --gc: ${s.c}40; animation: float 4s ease-in-out ${s.d} infinite;`}
      >
        <img src={`/icons/${s.name}.svg`} alt={s.name} class="w-10 h-10 xl:w-12 xl:h-12" />
      </div>
    ))}
  </div>

  <div class="flex flex-col gap-6 relative z-10 lg:max-w-xl xl:max-w-2xl">
    <h1 class="text-3xl sm:text-5xl md:text-5xl font-black uppercase italic tracking-tighter leading-[1.1]">
      <span class="bg-clip-text text-transparent bg-gradient-to-r from-sky-800 to-cyan-500 dark:from-sky-400 dark:to-cyan-300">
        Problemas de un<br />desarrollador Web
      </span>
    </h1>
    <p class="text-lg sm:text-xl text-slate-500 dark:text-slate-400 max-w-2xl leading-relaxed font-medium">
      {SITE_DESCRIPTION}
    </p>
    <p class="flex items-center gap-1.5 text-sm text-slate-400 dark:text-slate-500 font-medium">
      Llevo <strong class="streak-number text-slate-600 dark:text-slate-300 tabular-nums">{daysSinceFirstPost}</strong> días escribiendo
    </p>
    <div class="flex flex-wrap gap-3 items-center mt-2">
      {SOCIAL_LINKS.slice(0, 5).map((link) => (
        <a
          href={link.href}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 px-4 py-2 rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-xs font-black uppercase tracking-wider text-slate-600 dark:text-slate-400 hover:border-[var(--brand)] hover:text-[var(--brand)] dark:hover:text-[var(--brand)] transition-all no-underline"
          style={`--brand: ${link.color}`}
        >
          <img src={link.icon} alt="" class="w-4 h-4" />
          {link.label}
        </a>
      ))}
    </div>
  </div>
</section>
