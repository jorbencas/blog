---
import { SOCIAL_LINKS, SITE_DESCRIPTION, SITE_NAME } from "src/consts.js";
import { getCollection } from "astro:content";
import { getSortedPosts } from "src/utils";

const yearCreation = new Date().getFullYear();

const allPosts = await getCollection("posts");
const sortedPosts = await getSortedPosts(allPosts);
const allChallenges = await getCollection("auto-challenges");
const sortedChallenges = await getSortedPosts(allChallenges);
const allTools = await getCollection("tools");
const sortedTools = await getSortedPosts(allTools);
const allWeekly = await getCollection("weeklyPosts");
const sortedWeekly = await getSortedPosts(allWeekly);

const navLinks = [
  { href: "/", label: "Inicio" },
  { href: "/posts/", label: "Blog" },
  { href: "/retos/", label: "Retos" },
  { href: "/herramientas/", label: "Herramientas" },
  { href: "/proyectos/", label: "Proyectos" },
  { href: "/weekly/", label: "Weekly" },
];

const navLinkClass =
  "text-xs font-black uppercase tracking-wider text-slate-500 dark:text-slate-400 hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors no-underline";
---

<footer
  class="w-full mt-20 bg-slate-50 dark:bg-slate-900/80 transition-colors duration-500"
>
  <!-- Gradient top bar -->
  <div
    class="h-1.5 bg-gradient-to-r from-sky-800 to-cyan-500 dark:from-sky-600 dark:to-cyan-400"
  >
  </div>

  <div class="max-w-screen-xl mx-auto px-6 py-16 space-y-14">
    <!-- 4-COLUMN GRID -->
    <div
      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-12"
    >
      <!-- COL 1: Brand + RSS -->
      <div class="space-y-5">
        <h3
          class="inline-flex items-center gap-2 bg-gradient-to-r from-sky-800 to-cyan-500 dark:from-sky-600 dark:to-cyan-400 px-4 py-2 text-[11px] sm:text-xs font-black uppercase tracking-[0.25em] text-white dark:text-slate-900 shadow-[4px_4px_0px_0px_rgba(6,182,212,0.3)]"
        >
          {SITE_NAME.replace(/^Problemas de un /, "Problemas\nde un ")}
        </h3>
        <p class="text-sm leading-relaxed text-slate-500 dark:text-slate-400">
          {SITE_DESCRIPTION}
        </p>
        <a
          href="/rss.xml"
          class="w-fit inline-flex items-center gap-2.5 border-2 border-slate-900 dark:border-white bg-white dark:bg-slate-900 px-5 py-2.5 text-[11px] font-black uppercase tracking-widest text-slate-900 dark:text-white transition-all hover:bg-cyan-500 hover:border-cyan-500 hover:text-white active:translate-y-1 active:shadow-none"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-4 w-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M4 11a9 9 0 0 1 9 9"></path>
            <path d="M4 4a16 16 0 0 1 16 16"></path>
            <circle cx="5" cy="19" r="1"></circle>
          </svg>
          RSS Feed
        </a>
      </div>

      <!-- COL 2: Navegación -->
      <div class="space-y-5">
        <h4
          class="text-[11px] font-black uppercase tracking-[0.3em] text-slate-400"
        >
          Navegación
        </h4>
        <ul class="space-y-3">
          {
            navLinks.map((link) => (
              <li>
                <a href={link.href} class={navLinkClass}>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- COL 3: Conecta -->
      <div class="space-y-5">
        <h4
          class="text-[11px] font-black uppercase tracking-[0.3em] text-slate-400"
        >
          Conecta
        </h4>
        <div class="flex flex-wrap gap-3">
          {
            SOCIAL_LINKS.map((social) => (
              <a
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={social.label}
                class="group flex flex-col items-center gap-1.5 p-3 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 transition-all hover:border-[var(--brand)] hover:text-[var(--brand)] dark:hover:text-[var(--brand)] no-underline"
                style={`--brand: ${social.color}`}
              >
                <img
                  src={social.icon}
                  alt=""
                  class="w-5 h-5"
                />
                <span class="text-[10px] font-black uppercase tracking-wider text-slate-600 dark:text-slate-400 group-hover:text-[var(--brand)] dark:group-hover:text-[var(--brand)] transition-colors">
                  {social.label}
                </span>
              </a>
            ))
          }
        </div>
      </div>

      <!-- COL 4: Bitácora / Stats -->
      <div class="space-y-5">
        <h4
          class="text-[11px] font-black uppercase tracking-[0.3em] text-slate-400"
        >
          Bitácora
        </h4>
        <div class="grid grid-cols-2 gap-3">
          {
            [
              {
                label: "Artículos",
                count: sortedPosts.length,
                accent: "text-cyan-600 dark:text-cyan-500",
              },
              {
                label: "Retos",
                count: sortedChallenges.length,
                accent: "text-amber-600 dark:text-amber-500",
              },
              {
                label: "Herramientas",
                count: sortedTools.length,
                accent: "text-emerald-500",
              },
              {
                label: "Semanales",
                count: sortedWeekly.length,
                accent: "text-yellow-600 dark:text-yellow-500",
              },
            ].map((stat) => (
              <div class="flex flex-col items-center justify-center p-3 rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900">
                <span class={`text-lg font-black ${stat.accent}`}>{stat.count}</span>
                <span class="text-[10px] font-black uppercase tracking-widest text-slate-400 dark:text-slate-500">
                  {stat.label}
                </span>
              </div>
            ))
          }
        </div>
        <a
          href="#"
          class="w-fit inline-flex items-center gap-2 text-[11px] font-black uppercase tracking-widest text-slate-400 hover:text-cyan-500 transition-colors no-underline"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-3.5 w-3.5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="3"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M5 15l7-7 7 7"></path>
          </svg>
          Volver arriba
        </a>
      </div>
    </div>

    <!-- DIVIDER -->
    <div class="border-t border-slate-200 dark:border-white/5"></div>

    <!-- BOTTOM BAR -->
    <div
      class="flex flex-col sm:flex-row items-center justify-between gap-4 text-[11px] text-slate-400"
    >
      <div class="flex items-center gap-3">
        <span
          class="inline-flex items-center gap-1 px-2 py-0.5 bg-slate-100 dark:bg-white/5 text-[10px] font-bold uppercase tracking-wider rounded"
        >
          CC BY-NC 4.0
        </span>
        <span>
          © {yearCreation} Jorge Beneyto Castelló
        </span>
      </div>
      <p class="text-center sm:text-right leading-relaxed">
        Comparte y adapta citando la autoría original.
      </p>
    </div>
  </div>
</footer>
