---
import { SOCIAL_LINKS } from "src/consts.js";
const yearCreation = new Date().getFullYear();
---

<footer
  class="w-full mt-20 border-t border-slate-200 dark:border-white/5 bg-white dark:bg-slate-900/80 transition-colors duration-500"
>
  <!-- Sección de Redes -->
  <div>
    <div
      class="max-w-screen-xl mx-auto flex flex-col sm:flex-row justify-center sm:justify-between items-center px-6 py-10 gap-8"
    >
      <span
        class="text-xs md:text-sm font-black tracking-[0.5em] text-slate-400 uppercase"
      >
        Conecta conmigo_
      </span>

      <div class="flex flex-wrap justify-center items-center gap-x-12 gap-y-6">
        {
          SOCIAL_LINKS.map((social) => (
            <a
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={social.label}
              class="group transition-all duration-300"
            >
              <img
                src={social.icon}
                alt={social.label}
                class={`w-7 h-7 transition-all duration-300 opacity-60 grayscale group-hover:opacity-100 group-hover:grayscale-0 group-hover:scale-125 dark:invert ${social.color}`}
              />
            </a>
          ))
        }
      </div>
    </div>
  </div>

  <!-- Sección de Copyright y RSS -->
  <div
    class="max-w-screen-xl mx-auto px-6 py-12 grid grid-cols-1 md:grid-cols-2 gap-12 items-start"
  >
    <div class="space-y-6">
      <div class="flex items-center gap-3">
        <div class="w-8 h-[2px] bg-cyan-500"></div>
        <p
          class="text-base font-black uppercase tracking-tighter text-slate-900 dark:text-white italic"
        >
          Jorge Beneyto Castelló
          <span class="text-cyan-500 dark:text-cyan-400 not-italic ml-2">© {yearCreation}</span>
        </p>
      </div>

      <a
        href="/rss.xml"
        class="inline-flex items-center border border-slate-200 dark:border-white/10 px-4 py-2 text-xs font-bold uppercase tracking-widest text-slate-500 hover:border-cyan-500 hover:text-cyan-500 dark:hover:border-cyan-400 dark:hover:text-cyan-400 transition-all hover:-translate-y-0.5"
      >
        <span class="mr-2">Suscripción RSS</span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-3 w-3"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="3"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><path d="M4 11a9 9 0 0 1 9 9"></path><path d="M4 4a16 16 0 0 1 16 16"
          ></path><circle cx="5" cy="19" r="1"></circle></svg
        >
      </a>
    </div>

    <div
      class="text-xs leading-relaxed text-slate-400 uppercase tracking-wide md:border-l border-slate-200 dark:border-white/10 md:pl-8"
    >
      <a
        rel="license"
        href="http://creativecommons.org/licenses/by-nc/4.0/"
        class="text-slate-900 dark:text-white font-black hover:text-cyan-500 dark:hover:text-cyan-400 transition-colors block mb-2"
      >
        Creative Commons BY-NC 4.0
      </a>
      <p>
        Esta obra está bajo una licencia de Reconocimiento-NoComercial 4.0
        Internacional. Puedes compartir y adaptar el contenido citando la
        autoría original.
      </p>
    </div>
  </div>
</footer>
