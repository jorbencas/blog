---
const { title, section = "posts" } = Astro.props;

const sectionConfig = {
  posts: {
    label: "Bitácora",
    path: "/posts",
    color: "text-slate-900 dark:text-white hover:text-cyan-500",
  },
  retos: { label: "Retos", path: "/retos/1", color: "text-amber-500" },
  proyectos: {
    label: "Proyectos",
    path: "/proyectos",
    color: "text-purple-500",
  },
  herramientas: {
    label: "Mini Herramientas",
    path: "/herramientas",
    color: "text-emerald-500",
  },
  weekly: {
    label: "Noticias Semanales",
    path: "/weekly",
    color: "text-slate-900 dark:text-white hover:text-cyan-500",
  },
};
const current = sectionConfig[section] || sectionConfig.posts;
---

<nav aria-label="Breadcrumb" class="mb-6">
  <a
    href="/"
    class="text-xs font-black uppercase tracking-[0.2em] text-slate-400 hover:text-cyan-500 transition-colors"
  >
    Inicio
  </a>
  <span class="text-slate-400 mx-2 text-xs">/</span>
  <a
    href={current.path}
    class:list={[
      "text-xs font-black uppercase tracking-[0.2em] transition-colors",
      current.color,
    ]}
  >
    {current.label}
  </a>
  {
    title && (
      <>
        <span class="text-slate-400 mx-2 text-xs">/</span>
        <span class="text-xs font-black uppercase tracking-[0.2em] text-slate-500 dark:text-slate-600 truncate max-w-[200px] inline-block align-bottom">
          {title}
        </span>
      </>
    )
  }
</nav>
