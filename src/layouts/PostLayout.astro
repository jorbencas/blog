---
import { formatDatePost, getSortedPosts } from "src/utils.js";
import TagsPosts from "@components/TagsPosts.astro";
import Layout from "./Layout.astro";
import NextPrevLiks from "@components/NextPrevLiks.astro";
import TableOfContents from "@components/TableOfContents.astro";
import CodeEnhancer from "@components/CodeEnhancer.astro";
import { getCollection } from 'astro:content'; // NUEVO IMPORT
import type { MarkdownHeading } from 'astro';

let bar = {
  prevElement: { url: undefined, title: undefined, image: "prev.svg" },
  nextElement: { url: undefined, title: undefined, image: "next.svg" },
};

interface Props {
  slug:string;
  title: string;
  description: string;
  tags: string;
  author: string;
  image: string;
  pubDate: string;
  headings?: MarkdownHeading[];
  remarkPluginFrontmatter?: Record<string, any>;
}
const {slug, title, description, tags, author, image, pubDate, headings = [], remarkPluginFrontmatter } = Astro.props;

const allPosts = await getCollection('posts');
const sortedPosts = await getSortedPosts(allPosts);
const currentIndex = sortedPosts.findIndex(p => p.slug === slug);

if (currentIndex > -1) {
  // Post Anterior
  if (currentIndex > 0) {
    const prev = sortedPosts[currentIndex - 1];
    const prevSlug = prev.id || prev.slug;
    bar.prevElement = {
      url: `/posts/${prevSlug}/`,
      title: prev.data.title,
      image: prev.data.image || "prev.svg",
    };
  }

  // Post Siguiente
  if (currentIndex < sortedPosts.length - 1) {
    const next = sortedPosts[currentIndex + 1];
    const nextSlug = next.id || next.slug;
    bar.nextElement = {
      url: `/posts/${nextSlug}/`,
      title: next.data.title,
      image: next.data.image || "next.svg",
    };
  }
}

// Variables para tu HTML (con valores por defecto para evitar errores de undefined)
let imagePrev = bar.prevElement?.image;
let urlPrev = bar.prevElement?.url;
let textPrev = bar.prevElement?.title;

let imageNext = bar.nextElement?.image;
let urlNext = bar.nextElement?.url;
let textNext = bar.nextElement?.title

const minutesRead = remarkPluginFrontmatter?.minutesRead;


---

<Layout title={title} description={description}, tags={tags}>
  <!-- <Archive /> -->
  <div class="max-w-10xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12">
    <main class="lg:col-span-9 ml-3">
      <div class="my-5 flex w-auto">
        <img
          class="inline-block w-14 h-14 align-middle items-center"
          aria-label={title}
          src={image}
        />

        <div class="block ml-4">
          <h1 class="text-4xl font-sans text-gray-900 dark:text-white">
            {title}
          </h1>
          <p class="text-sm">{description}</p>
          <p>
            <strong class="text-base font-extrabold text-cyan-400">
              {formatDatePost(pubDate)}
            </strong>
             Por: <strong class="dark:text-white">{author}</strong>
          </p>
          {minutesRead && (
          <p
            class="flex items-center gap-2 text-sm font-medium
         text-gray-300 dark:text-gray-100
         transition-colors duration-200"
          >
            <!-- Icono de reloj -->
            <svg
              class="w-5 h-5 text-gray-400 dark:text-gray-300"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 6v6l4 2"></path>
            </svg>

            {minutesRead}
          </p>
          )}
        </div>
      </div>
      <div
        id="contenido"
        class="prose-xl my-5 dark:text-white dark:prose-pre:text-white prose-a:text-cyan-400 dark:prose-h2:text-white dark:prose-ul:text-white dark:prose-ol:text-white dark:prose-li:text-white dark:prose-h1:text-white dark:prose-code:text-white dark:prose-strong:text-white dark:prose-h3:text-white"
      >
        <slot />
      </div>
      <CodeEnhancer />
      {
        tags && (
          <TagsPosts is-client tagsList={JSON.stringify(tags)} />
        )
      }

      <NextPrevLiks
        imageNext={imageNext}
        nextURL={urlNext}
        prevURL={urlPrev}
        imagePrev={imagePrev}
        textNext={textNext}
        textPrev={textPrev}
      />
    </main>
  </div>

  <div class="lg:block lg:col-span-3 h-full">
    <div class="sticky z-50 mr-3 h-[calc(100vh-8rem)]">
      <TableOfContents headings={headings} />
    </div>
  </div>
</Layout>
