---
import mounths from "./months.json";
import days from "./days.json";
import TagsPosts from "@components/TagsPosts.astro";
import Layout from "./Layout.astro";
const { content } = Astro.props;

const formatDatePost = (date) => {
  let fullDate = new Date(date);
  let day = days[fullDate.getDay()];
  let month = mounths[fullDate.getMonth()];
  let year = fullDate.getFullYear();
  let numday = fullDate.getUTCDate();
  return day + ", " + numday + " de " + month + " del " + year;
};
---

<Layout title={content.tittle}>
  <div class="max-w-6xl mx-auto mt-10 align-top items-center text-left">
    <div class="my-5 flex flex-shrink-0 justify-start w-auto">
      <img
        class="w-14 h-14 align-baseline text-right"
        aria-label={content.tittle}
        src={content.image}
      />

      <div class="block ml-4">
        <h1 class="text-xl font-bold text-gray-900 dark:text-white">
          {content.tittle}
        </h1>
        <p class="text-sm">{content.description}</p>
        <p
          class="text-base text-right font-extrabold bg-clip-text text-transparent bg-gradient-to-r from-sky-800 to-cyan-500"
        >
          {formatDatePost(content.date)}
        </p>
      </div>
    </div>
    <div
      class="text-ellipsis my-5 prose dark:text-white dark:prose-pre:text-white dark:prose-a:text-gray-300 dark:prose-h2:text-white dark:prose-h1:text-white dark:prose-code:text-white dark:prose-strong:text-white dark:prose-h3:text-white"
    >
      <slot />
    </div>
    {
      content.tags && (
        <TagsPosts is-client tagsList={JSON.stringify(content.tags)} />
      )
    }
    <p class="my-3">
      Publicado por: <strong class="dark:text-white">{content.author}</strong>
    </p>
  </div>
</Layout>
