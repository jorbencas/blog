export interface Props {
	title: string;
}

const { content } = Astro.props;
---

<Layout title={content.tittle}>
  <div class="content">
    <div>
      <h1>{content.tittle}</h1>
      <p>{content.description}</p>
      <img aria-label={content.tittle} src={content.image} />
    </div>
    <slot />
    <!-- <div class="prevnext">
      <a href={prev}>Previous</a>
      <a href={next}>Next</a>
    </div> -->
  </div>
  <div class="lateralbar">
    <Tags tagList={JSON.stringify(content.tags)}/>
    <Archive />
  </div>
</Layout>

<style>
  .prevnext {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		height: 100%;
	}
</style>