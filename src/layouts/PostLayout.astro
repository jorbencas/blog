---
import { formatDatePost, getSortedPosts } from "src/utils.js";
import TagsPosts from "@components/TagsPosts.astro";
import Layout from "./Layout.astro";
import NextPrevLiks from "@components/NextPrevLiks.astro";
import TableOfContents from "@components/TableOfContents.astro";
import CodeEnhancer from "@components/CodeEnhancer.astro";
import { getCollection } from 'astro:content';
import type { MarkdownHeading } from 'astro';

let bar = {
  prevElement: { url: undefined, title: undefined, image: "prev.svg" },
  nextElement: { url: undefined, title: undefined, image: "next.svg" },
};

interface Props {
  slug: string;
  title: string;
  description: string;
  tags: string | string[];
  author: string;
  image: string;
  pubDate: string;
  headings?: MarkdownHeading[];
  remarkPluginFrontmatter?: Record<string, any>;
}

const { slug, title, description, tags, author, image, pubDate, headings = [], remarkPluginFrontmatter } = Astro.props;

const allPosts = await getCollection('posts');
const sortedPosts = await getSortedPosts(allPosts);
const currentIndex = sortedPosts.findIndex(p => p.slug === slug);

if (currentIndex > -1) {
  if (currentIndex > 0) {
    const prev = sortedPosts[currentIndex - 1];
    bar.prevElement = {
      url: `/posts/${prev.id || prev.slug}/`,
      title: prev.data.title,
      image: prev.data.image || "prev.svg",
    };
  }
  if (currentIndex < sortedPosts.length - 1) {
    const next = sortedPosts[currentIndex + 1];
    bar.nextElement = {
      url: `/posts/${next.id || next.slug}/`,
      title: next.data.title,
      image: next.data.image || "next.svg",
    };
  }
}

const minutesRead = remarkPluginFrontmatter?.minutesRead;

// Corrección de tags para evitar el error .split
const tagsArray = Array.isArray(tags) 
  ? tags 
  : (typeof tags === 'string' ? tags.split(',').map(t => t.trim()) : []);

---

<Layout title={title} description={description} tags={tagsArray}>
  <div class="max-w-screen-xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 py-10 font-sans">
    
    <main class="lg:col-span-8 px-4 lg:px-0">
      
      <header class="relative mb-12 overflow-hidden border border-slate-200 dark:border-white/10 bg-white dark:bg-slate-950 shadow-2xl h-[400px] flex flex-col justify-end p-8 md:p-12">
        <div class="absolute inset-0 z-0">
          <img
            class="w-full h-full object-cover opacity-60 dark:opacity-40 grayscale-[30%]"
            src={image}
            alt={title}
          />
          <div class="absolute inset-0 bg-gradient-to-t from-white via-white/80 to-transparent dark:from-slate-950 dark:via-slate-950/80 dark:to-transparent"></div>
        </div>

        <div class="relative z-10 space-y-4">
          <h1 class="text-4xl md:text-6xl font-black uppercase italic tracking-tighter leading-none text-slate-900 dark:text-white drop-shadow-sm">
            {title}
          </h1>
          
          <p class="text-lg md:text-xl text-slate-700 dark:text-slate-300 font-medium leading-relaxed max-w-2xl">
            {description}
          </p>

          <div class="flex flex-wrap items-center gap-6 pt-6 border-t border-slate-900/10 dark:border-white/10 font-mono text-[10px] uppercase tracking-[0.2em]">
            <div class="flex items-center gap-2">
              <span class="text-cyan-600 dark:text-cyan-400 font-bold">FECHA:</span>
              <time class="text-slate-900 dark:text-white font-bold">{formatDatePost(pubDate)}</time>
            </div>
            
            <div class="flex items-center gap-2">
              <span class="text-cyan-600 dark:text-cyan-400 font-bold">AUTOR:</span>
              <span class="text-slate-900 dark:text-white font-bold">{author}</span>
            </div>

            {minutesRead && (
              <div class="flex items-center gap-2 text-slate-900 dark:text-white font-bold">
                <span class="text-cyan-600 dark:text-cyan-400 font-bold">LECTURA:</span>
                <span>{minutesRead.replace('min read', 'MIN')}</span>
              </div>
            )}
          </div>
        </div>
      </header>

      <article
        id="contenido"
        class="prose prose-lg md:prose-xl max-w-none
               prose-slate dark:prose-invert
               prose-headings:uppercase prose-headings:italic prose-headings:tracking-tighter prose-headings:font-black
               prose-a:text-cyan-600 dark:prose-a:text-cyan-400 prose-a:no-underline hover:prose-a:underline
               prose-strong:text-cyan-600 dark:prose-strong:text-cyan-400
               prose-img:border prose-img:border-slate-200 dark:prose-img:border-white/10 prose-img:shadow-lg"
      >
        <slot />
      </article>

      <div class="mt-16 pt-12 border-t border-slate-200 dark:border-white/10 space-y-12">
        
        {tagsArray.length > 0 && (
          <div class="space-y-4">
            <span class="font-mono text-[10px] uppercase tracking-[0.4em] text-slate-400">ETIQUETADO EN:</span>
            <div class="flex flex-wrap gap-2">
              {tagsArray.map(tag => (
                <div class="bg-gradient-to-r from-sky-800 to-cyan-600 px-3 py-1 text-[9px] font-black uppercase tracking-wider text-white shadow-[3px_3px_0px_0px_rgba(0,0,0,0.2)]">
                  {tag}
                </div>
              ))}
            </div>
          </div>
        )}

        <NextPrevLiks
          imageNext={bar.nextElement?.image}
          nextURL={bar.nextElement?.url}
          prevURL={bar.prevElement?.url}
          imagePrev={bar.prevElement?.image}
          textNext={bar.nextElement?.title}
          textPrev={bar.prevElement?.title}
        />
      </div>
    </main>

    <aside class="hidden lg:block lg:col-span-4 h-full">
      <div class="sticky top-24 pl-8 border-l border-slate-100 dark:border-white/5 h-fit">
        <TableOfContents headings={headings} />
      </div>
    </aside>
  </div>
  
  <CodeEnhancer />
</Layout>

<style is:global>
  /* Selección de texto en color cian */
  ::selection {
    background-color: rgba(6, 182, 212, 0.3);
    color: inherit;
  }
</style>