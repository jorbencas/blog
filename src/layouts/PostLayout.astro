---
import { formatDatePost, getSortedPosts } from "src/utils.js";
import TagsPosts from "@components/TagsPosts.astro";
import Layout from "./Layout.astro";
import NextPrevLiks from "@components/NextPrevLiks.astro";
import PostIndex from "@components/PostIndex.astro";
// import Archive from "@components/Archive.astro";

const { content } = Astro.props;
let bar = {
  prevElement: { url: "", tittle: "", image: "" },
  nextElement: { url: "", tittle: "", image: "" },
};
const allPosts = await Astro.glob("../pages/posts/*.md");
const sortedPosts = await getSortedPosts(allPosts);
for (let i = 0; i < sortedPosts.length; i++) {
  const { frontmatter } = sortedPosts[i];
  if (
    new Date(frontmatter.pubDate).valueOf() ===
    new Date(content.pubDate).valueOf()
  ) {
    bar["prevElement"] = {
      url:
        i - 1 >= 0
          ? "/posts/" + sortedPosts[i - 1].frontmatter.slug.replace(".md", "/")
          : undefined,
      tittle: i - 1 >= 0 ? sortedPosts[i - 1].frontmatter.title : undefined,
      image: i - 1 >= 0 ? sortedPosts[i - 1].frontmatter.image : "prev.svg",
    };
    bar["nextElement"] = {
      url:
        i + 1 < sortedPosts.length
          ? "/posts/" + sortedPosts[i + 1].frontmatter.slug.replace(".md", "")
          : undefined,
      tittle:
        i + 1 < sortedPosts.length
          ? sortedPosts[i + 1].frontmatter.title
          : undefined,
      image:
        i + 1 < sortedPosts.length
          ? sortedPosts[i + 1].frontmatter.image
          : "next.svg",
    };
  }
}
 let imagePrev = bar.prevElement.image;
 let urlPrev = bar.prevElement.url;
 let textPrev = bar.prevElement.tittle;

let imageNext = bar.nextElement.image;
let urlNext = bar.nextElement.url;
let textNext = bar.nextElement.tittle;
---

<Layout title={content.title}>
  <!-- <Archive /> -->
  <div class="max-w-8xl mx-auto px-4 sm:px-6 md:px-8">
    <div class="my-5 flex w-auto">
      <img
        class="inline-block w-14 h-14 align-middle items-center"
        aria-label={content.title}
        src={content.image}
      />

      <div class="block ml-4">
        <h1 class="text-4xl font-sans text-gray-900 dark:text-white">
          {content.title}
        </h1>
        <p class="text-sm">{content.description}</p>
        <p>
          <strong class="text-base font-extrabold text-cyan-400">
            {formatDatePost(content.pubDate)}
          </strong>
           Por: <strong class="dark:text-white">{content.author}</strong>
        </p>
      </div>
    </div>
    <div id="contenido"
      class="prose-xl my-5 dark:text-white dark:prose-pre:text-white prose-a:text-cyan-400 dark:prose-h2:text-white dark:prose-ul:text-white dark:prose-ol:text-white dark:prose-li:text-white dark:prose-h1:text-white dark:prose-code:text-white dark:prose-strong:text-white dark:prose-h3:text-white"
    >
      <slot />
    </div>
    {
      content.tags && (
        <TagsPosts is-client tagsList={JSON.stringify(content.tags)} />
      )
    }

    <NextPrevLiks
      imageNext={imageNext}
      nextURL={urlNext}
      prevURL={urlPrev}
      imagePrev={imagePrev}
      textNext={textNext}
      textPrev={textPrev}
    />
  </div>
  
  <PostIndex />
</Layout>
