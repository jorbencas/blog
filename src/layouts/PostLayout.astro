---
import { formatDatePost, getSortedPosts } from "src/utils.js";
import TagsPosts from "@components/TagsPosts.astro";
import Layout from "./Layout.astro";
import NextPrevLiks from "@components/NextPrevLiks.astro";
import TableOfContents from "@components/TableOfContents.astro";
import CodeEnhancer from "@components/CodeEnhancer.astro";
import { getCollection } from 'astro:content';
import type { MarkdownHeading } from 'astro';

let bar = {
  prevElement: { url: undefined, title: undefined, image: "prev.svg" },
  nextElement: { url: undefined, title: undefined, image: "next.svg" },
};

interface Props {
  slug:string;
  title: string;
  description: string;
  tags: string;
  author: string;
  image: string;
  pubDate: string;
  headings?: MarkdownHeading[];
  remarkPluginFrontmatter?: Record<string, any>;
}

const {slug, title, description, tags, author, image, pubDate, headings = [], remarkPluginFrontmatter } = Astro.props;

const allPosts = await getCollection('posts');
const sortedPosts = await getSortedPosts(allPosts);
const currentIndex = sortedPosts.findIndex(p => p.slug === slug);

if (currentIndex > -1) {
  if (currentIndex > 0) {
    const prev = sortedPosts[currentIndex - 1];
    bar.prevElement = {
      url: `/posts/${prev.id || prev.slug}/`,
      title: prev.data.title,
      image: prev.data.image || "prev.svg",
    };
  }
  if (currentIndex < sortedPosts.length - 1) {
    const next = sortedPosts[currentIndex + 1];
    bar.nextElement = {
      url: `/posts/${next.id || next.slug}/`,
      title: next.data.title,
      image: next.data.image || "next.svg",
    };
  }
}

const minutesRead = remarkPluginFrontmatter?.minutesRead;

const tagsArray = Array.isArray(tags) 
  ? tags 
  : (typeof tags === 'string' ? tags.split(',').map(t => t.trim()) : []);

---

<Layout title={title} description={description} tags={tagsArray}>
  <div class="max-w-screen-xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 py-10">
    
    <main class="lg:col-span-8 px-4 lg:px-0">
      
      <header class="mb-12 space-y-6">
        <div class="flex items-center gap-4">
          <img
            class="w-16 h-16 object-contain border border-slate-200 dark:border-white/10 p-2 bg-white dark:bg-slate-900"
            src={image}
            alt={title}
          />
          <div class="h-[2px] flex-grow bg-gradient-to-r from-cyan-500 to-transparent"></div>
        </div>

        <div class="space-y-4">
          <h1 class="text-4xl md:text-6xl font-black uppercase italic tracking-tighter leading-none text-slate-900 dark:text-white">
            {title}
          </h1>
          
          <p class="text-xl text-slate-500 dark:text-slate-400 font-medium leading-relaxed max-w-2xl">
            {description}
          </p>

          <div class="flex flex-wrap items-center gap-6 pt-4 border-t border-slate-100 dark:border-white/5 font-mono text-xs uppercase tracking-widest text-slate-500 dark:text-slate-400">
            <div class="flex items-center gap-2">
              <span class="text-cyan-500 font-bold">DATE:</span>
              <time class="text-slate-900 dark:text-white font-bold">{formatDatePost(pubDate)}</time>
            </div>
            
            <div class="flex items-center gap-2">
              <span class="text-cyan-500 font-bold">AUTHOR:</span>
              <span class="text-slate-900 dark:text-white font-bold">{author}</span>
            </div>

            {minutesRead && (
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4 text-cyan-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3" />
                </svg>
                <span>{minutesRead}</span>
              </div>
            )}
          </div>
        </div>
      </header>

      <article
        id="contenido"
        class="prose prose-lg md:prose-xl max-w-none
               prose-slate dark:prose-invert
               prose-headings:uppercase prose-headings:italic prose-headings:tracking-tighter prose-headings:font-black
               prose-a:text-cyan-500 prose-a:no-underline hover:prose-a:underline
               prose-strong:text-cyan-500 dark:prose-strong:text-cyan-400
               prose-img:border prose-img:border-slate-200 dark:prose-img:border-white/10"
      >
        <slot />
      </article>

      <div class="mt-16 pt-12 border-t border-slate-200 dark:border-white/10 space-y-12">
        <CodeEnhancer />
        
        {tags && (
          <div class="space-y-4">
            <span class="font-mono text-[10px] uppercase tracking-[0.4em] text-slate-400">Tagged in:</span>
            <TagsPosts tagsList={JSON.stringify(tags)} />
          </div>
        )}

        <NextPrevLiks
          imageNext={bar.nextElement?.image}
          nextURL={bar.nextElement?.url}
          prevURL={bar.prevElement?.url}
          imagePrev={bar.prevElement?.image}
          textNext={bar.nextElement?.title}
          textPrev={bar.prevElement?.title}
        />
      </div>
    </main>

    <aside class="hidden lg:block lg:col-span-4 h-full">
      <div class="sticky top-24 pl-8 border-l border-slate-100 dark:border-white/5">
        <TableOfContents headings={headings} />
      </div>
    </aside>
  </div>
</Layout>