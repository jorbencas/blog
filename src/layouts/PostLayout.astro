---
import TagsPosts from "@components/TagsPosts.astro";
import Layout from "./Layout.astro";
const { content } = Astro.props;
const mounths = [
  "Enero",
  "Febrero",
  "Marzo",
  "Abril",
  "Mayo",
  "Junio",
  "Julio",
  "Agosto",
  "Septiembre",
  "Octubre",
  "Noviembre",
  "Diciembre",
];

const days = [
  "Domingo",
  "Lunes",
  "Martes",
  "Miercoles",
  "Jueves",
  "Viernes",
  "Sabado",
];

const formatDatePost = (date) => {
  let fullDate = new Date(date);
  let day = days[fullDate.getDay()];
  let month = mounths[fullDate.getMonth()];
  let year = fullDate.getFullYear();
  let numday = fullDate.getUTCDate();
  return day + ", " + numday + " de " + month + " del " + year;
};
---

<Layout title={content.tittle}>
  <div class="w-full max-w-md">
    <div class="align-middle">
      <h1 class="text-2xl text-cyan-500 text-center">{content.tittle}</h1>
      <p class="text-base">{content.description}</p>
      <p class="text-cyan-700 mb-10">
        {formatDatePost(content.date)}
      </p>
      <img aria-label={content.tittle} src={content.image} />
    </div>
    <slot />
    {content.tags && <TagsPosts tagsList={JSON.stringify(content.tags)} />}

    <p>
      Publicado por: <strong class="text-cyan-500">{content.author}</strong>
    </p>
  </div>
</Layout>
