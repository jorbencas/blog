---
import { formatDatePost, getSortedPosts, resolveImagePath } from "src/utils.js";
import "@styles/solution.css";
import Layout from "@layouts/Layout.astro";
import NextPrevLinks from "@components/NextPrevLinks.astro";
import TableOfContents from "@components/TableOfContents.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import CodeEnhancer from "@components/CodeEnhancer.astro";
import ReadingProgress from "@components/ReadingProgress.astro";
import ResponsiveImage from "@components/ResponsiveImage.astro";
import { getCollection } from "astro:content";
import type { MarkdownHeading } from "astro";
import AudioPlayer from "@components/AudioPlayer.astro";
import CopyPost from "@components/CopyPost.astro";
const bar = {
  prevElement: { url: undefined, title: undefined, image: "prev.svg" },
  nextElement: { url: undefined, title: undefined, image: "next.svg" },
};

interface Props {
  id: number;
  title: string;
  description: string;
  tags: string | string[];
  author: string;
  image: string;
  pubDate: string | Date;
  headings?: MarkdownHeading[];
  remarkPluginFrontmatter?: Record<string, any>;
  audioSrc?: string;
  rawContent?: string;
  section?: string;
}

const {
  id,
  title,
  description,
  tags,
  author,
  image,
  pubDate,
  headings = [],
  remarkPluginFrontmatter,
  audioSrc,
  rawContent = "",
  section = "posts",
} = Astro.props;

const postUrl = Astro.url.href;
const imagenLimpia = resolveImagePath(image);

const allPosts = await getCollection("posts");
const sortedPosts = await getSortedPosts(allPosts);
const currentIndex = sortedPosts.findIndex((p) => p.id === id);

if (currentIndex > -1) {
  if (currentIndex > 0) {
    const prev = sortedPosts[currentIndex - 1];
    bar.prevElement = {
      url: `/posts/${prev.id}/`,
      title: prev.data.title,
      image: prev.data.image || "prev.svg",
    };
  }
  if (currentIndex < sortedPosts.length - 1) {
    const next = sortedPosts[currentIndex + 1];
    bar.nextElement = {
      url: `/posts/${next.id}/`,
      title: next.data.title,
      image: next.data.image || "next.svg",
    };
  }
}

const minutesRead = remarkPluginFrontmatter?.minutesRead;
const tagsArray = Array.isArray(tags)
  ? tags
  : typeof tags === "string"
  ? tags.split(",").map((t) => t.trim())
  : [];

const sectionColors = {
  weekly: {
    badge: "from-yellow-800 to-yellow-500 dark:from-yellow-700 dark:to-yellow-400",
    tag: "from-yellow-800 to-yellow-600 hover:shadow-[0_0_20px_rgba(234,179,8,0.4)]",
  },
  blog: {
    badge: "from-sky-900 to-cyan-500 dark:from-sky-800 dark:to-cyan-600",
    tag: "from-sky-800 to-cyan-600 hover:shadow-[0_0_20px_rgba(6,182,212,0.4)]",
  },
};
const sc = sectionColors[section] || sectionColors.blog;
---

<Layout
  title={title}
  description={description}
  tags={tagsArray}
  section={section}
  pubDate={pubDate}
  author={author}
>
  <ReadingProgress />
  <div
    class="max-w-screen-xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 py-10 px-4 lg:px-0 font-sans"
  >
    <main class="lg:col-span-8">
      <Breadcrumbs title={title} section={section} />
      <header class="mb-6 md:mb-12">
        <div
          class="relative w-full h-[120px] sm:h-[300px] md:h-[400px] overflow-hidden bg-slate-100 dark:bg-slate-900 mb-6 md:mb-10"
        >
          {
            imagenLimpia ? (
              <ResponsiveImage
                fallback={imagenLimpia}
                alt={title}
                fetchpriority="high"
                loading="eager"
                class="w-full h-full object-cover"
              />
            ) : (
              <div class="w-full h-full bg-slate-200 dark:bg-slate-800 flex items-center justify-center">
                <span class="text-slate-500 dark:text-slate-600 text-xs sm:text-sm">
                  SIN_IMAGEN
                </span>
              </div>
            )
          }
        </div>

        <div class="space-y-6">
          <h1
            class="text-2xl sm:text-3xl md:text-5xl font-black uppercase italic tracking-tighter leading-tight text-slate-900 dark:text-white"
          >
            {title}
          </h1>

          <p
            class={`text-base sm:text-xl leading-relaxed max-w-3xl px-5 sm:px-6 py-3 sm:py-4 bg-gradient-to-r text-white ${sc.badge}`}
          >
            {description}
          </p>

          <div
            class="flex flex-wrap items-center gap-8 pt-6 text-xs sm:text-sm uppercase tracking-[0.2em]"
          >
            <div class="flex items-center gap-2">
              <span class="text-slate-500 dark:text-slate-400">FECHA:</span>
              <time class="text-slate-900 dark:text-white font-bold"
                >{formatDatePost(pubDate)}</time
              >
            </div>
            <div class="flex items-center gap-2">
              <span class="text-slate-500 dark:text-slate-400">AUTOR:</span>
              <span class="text-slate-900 dark:text-white font-bold"
                >{author}</span
              >
            </div>
            {
              minutesRead && (
                <div class="flex items-center gap-2">
                  <span class="text-slate-500 dark:text-slate-400">
                    LECTURA:
                  </span>
                  <span class="text-slate-900 dark:text-white font-bold">
                    {minutesRead.toUpperCase()}
                  </span>
                </div>
              )
            }
          </div>
        </div>
        {audioSrc && <AudioPlayer src={audioSrc} />}
        <div class="flex flex-wrap gap-4 pt-6">
          <CopyPost
            rawContent={rawContent}
            title={title}
            description={description}
            pubDate={pubDate instanceof Date
              ? pubDate.toISOString()
              : String(pubDate)}
            author={author}
            url={postUrl}
            tags={Array.isArray(tags) ? tags : []}
          />
        </div>
      </header>

      <article
        id="contenido"
        class="prose sm:prose-lg lg:prose-xl max-w-4xl
 prose-slate dark:prose-invert
 dark:prose-p:text-slate-300 prose-p:leading-[1.8]
 prose-headings:uppercase prose-headings:italic prose-headings:tracking-tighter prose-headings:font-black
 prose-a:text-cyan-600 dark:prose-a:text-cyan-400 prose-a:no-underline hover:prose-a:underline
   prose-code:text-cyan-700 dark:prose-code:text-inherit
    prose-pre:border prose-pre:border-slate-200 dark:prose-pre:border-slate-800 prose-pre:bg-slate-50 dark:prose-pre:bg-transparent prose-pre:rounded-lg
    prose-img:shadow-2xl prose-img:rounded-sm prose-img:max-w-full prose-img:h-auto
    prose-table:block prose-table:overflow-x-auto"
      >
        <slot />
      </article>

      <div class="mt-20 pt-12 space-y-16">
        {
          tagsArray.length > 0 && (
            <div class="space-y-6">
              <span class="text-base font-bold uppercase tracking-[0.3em] text-slate-500 dark:text-slate-400 block  pb-2 w-fit">
                ETIQUETADO EN:
              </span>
              <div class="flex flex-wrap gap-4">
                {tagsArray.map((tag) => (
                  <a
                    href={`/tags/${tag}/1`}
                    class={`bg-gradient-to-r ${sc.tag} px-5 py-2 text-xs font-black uppercase tracking-widest text-white shadow-[4px_4px_0px_0px_rgba(0,0,0,0.1)] hover:-translate-y-1 hover:scale-105 active:scale-95 transition-all block no-underline`}
                  >
                    {tag}
                  </a>
                ))}
              </div>
            </div>
          )
        }

        <NextPrevLinks
          nextURL={bar.nextElement?.url}
          prevURL={bar.prevElement?.url}
          textNext={bar.nextElement?.title}
          textPrev={bar.prevElement?.title}
        />
      </div>
    </main>

    <!-- TableOfContents: lg:hidden mobile details + hidden lg:block sidebar -->
    <div class="lg:col-span-4">
      <div class="lg:sticky lg:top-24 lg:pl-8 h-fit">
        <TableOfContents headings={headings} section={section} />
      </div>
    </div>
  </div>

  <CodeEnhancer />
</Layout>
