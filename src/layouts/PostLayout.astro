---

<Layout title={title} description={description} tags={tagsArray}>
  <div class="max-w-screen-xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 py-10 font-sans">
    
    <main class="lg:col-span-8 px-4 lg:px-0">
      
      <header class="mb-12">
        <div class="relative w-full h-[300px] md:h-[400px] overflow-hidden border border-slate-200 dark:border-white/10 bg-slate-100 dark:bg-slate-900 shadow-xl mb-8 group/banner">
          <img
            class="w-full h-full object-cover opacity-90 dark:opacity-60 grayscale-[20%] transition-transform duration-[2s] ease-out group-hover/banner:scale-110"
            src={image}
            alt={title}
          />
          <div class="absolute inset-0 bg-gradient-to-t from-slate-900/40 to-transparent opacity-50"></div>
        </div>

        <div class="space-y-6">
          <div class="flex items-center gap-4">
             <div class="h-[2px] w-12 bg-cyan-500"></div>
             <span class="font-mono text-[10px] uppercase tracking-[0.3em] text-cyan-600 dark:text-cyan-400 font-bold">Post_Detail</span>
          </div>

          <h1 class="text-3xl md:text-5xl font-black uppercase italic tracking-tighter leading-[1.1] text-slate-900 dark:text-white">
            {title}
          </h1>
          
          <p class="text-xl text-slate-600 dark:text-slate-400 font-medium leading-relaxed max-w-3xl border-l-2 border-slate-200 dark:border-white/10 pl-6 italic">
            {description}
          </p>

          <div class="flex flex-wrap items-center gap-6 pt-6 border-t border-slate-100 dark:border-white/5 font-mono text-[10px] uppercase tracking-[0.2em]">
            <div class="flex items-center gap-2">
              <span class="text-slate-400">FECHA:</span>
              <time class="text-slate-900 dark:text-white font-bold">{formatDatePost(pubDate)}</time>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-slate-400">AUTOR:</span>
              <span class="text-slate-900 dark:text-white font-bold">{author}</span>
            </div>
            {minutesRead && (
              <div class="flex items-center gap-2">
                <span class="text-slate-400">LECTURA:</span>
                <span class="text-slate-900 dark:text-white font-bold">{minutesRead.replace('min read', 'MIN')}</span>
              </div>
            )}
          </div>
        </div>
      </header>

      <article
        id="contenido"
        class="prose prose-xl max-w-none
               prose-slate dark:prose-invert
               prose-p:text-slate-700 dark:prose-p:text-slate-300 prose-p:leading-relaxed
               prose-headings:uppercase prose-headings:italic prose-headings:tracking-tighter prose-headings:font-black
               prose-a:text-cyan-600 dark:prose-a:text-cyan-400 prose-a:no-underline hover:prose-a:underline
               prose-strong:text-cyan-600 dark:prose-strong:text-cyan-400
               prose-img:border prose-img:border-slate-200 dark:prose-img:border-white/10 prose-img:shadow-lg"
      >
        <slot />
      </article>

      <div class="mt-16 pt-12 border-t border-slate-200 dark:border-white/10 space-y-12">
        
        {tagsArray.length > 0 && (
          <div class="space-y-4">
            <span class="font-mono text-xs font-bold uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400 block">
              ETIQUETADO EN:
            </span>
            <div class="flex flex-wrap gap-3">
              {tagsArray.map(tag => (
                <div class="bg-gradient-to-r from-sky-800 to-cyan-600 px-4 py-1.5 text-[11px] font-black uppercase tracking-wider text-white shadow-[3px_3px_0px_0px_rgba(0,0,0,0.2)] hover:shadow-[0_0_15px_rgba(6,182,212,0.4)] hover:-translate-y-1 transition-all cursor-default">
                  {tag}
                </div>
              ))}
            </div>
          </div>
        )}

        <NextPrevLiks
          imageNext={bar.nextElement?.image}
          nextURL={bar.nextElement?.url}
          prevURL={bar.prevElement?.url}
          imagePrev={bar.prevElement?.image}
          textNext={bar.nextElement?.title}
          textPrev={bar.prevElement?.title}
        />
      </div>
    </main>

    <aside class="hidden lg:block lg:col-span-4">
      <div class="sticky top-24 pl-8 border-l border-slate-100 dark:border-white/5 h-fit">
        <TableOfContents headings={headings} />
      </div>
    </aside>
  </div>
  
  <CodeEnhancer />
</Layout>