---
import mounths from "./months.json";
import days from "./days.json";
import TagsPosts from "@components/TagsPosts.astro";
import Layout from "./Layout.astro";
import NextPrevLiks from "@components/NextPrevLiks.astro";
const { content } = Astro.props;
let bar = {
  prevElement:{url:'', tittle:'', image:''},
  nextElement:{url:'', tittle:'', image:''}
};
const allPosts = await Astro.glob("../pages/posts/*.md");
const sortedPosts = allPosts.filter( post => !post.frontmatter.draft).sort(
  (a, b) =>
    new Date(b.frontmatter.date).valueOf() -
    new Date(a.frontmatter.date).valueOf()
).forEach( (post, i) => {
  if(post.frontmatter.date === content.date) {
    bar['prevElement'] = {
      url: i + 1 <= allPosts.length ?  '/posts/'+allPosts[i+1].frontmatter.slug.replace('.md','') : bar.prevElement.url,
      tittle: i + 1 <= allPosts.length ?  allPosts[i+1].frontmatter.tittle : bar.prevElement.tittle,
      image: i + 1 <= allPosts.length ?  allPosts[i+1].frontmatter.image : bar.prevElement.image
    };
    bar['nextElement'] = {
      url: i - 1 >= 0 ? '/posts/'+allPosts[i - 1].frontmatter.slug.replace('.md','') : bar.nextElement.url,
      tittle: i - 1 >= 0 ? allPosts[i - 1].frontmatter.tittle : bar.nextElement.tittle,
      image: i - 1 >= 0 ? allPosts[i - 1].frontmatter.image : bar.nextElement.image
    };
  }
});

const formatDatePost = (date) => {
  let fullDate = new Date(date);
  let day = days[fullDate.getDay()];
  let month = mounths[fullDate.getMonth()];
  let year = fullDate.getFullYear();
  let numday = fullDate.getUTCDate();
  return day + ", " + numday + " de " + month + " del " + year;
};

const { nextElement, prevElement } = bar;
let urlPrev = prevElement.url;
let textPrev = prevElement.tittle;

let urlNext = nextElement.url;
let textNext = nextElement.tittle;

---

<Layout title={content.tittle}>
  <div class="max-w-6xl mx-auto mt-10 items-start text-left">
    <div class="my-5 flex w-auto">
      <img
        class="inline-block w-14 h-14 align-middle items-center"
        aria-label={content.tittle}
        src={content.image}
      />

      <div class="block ml-4">
        <h1 class="text-4xl font-sans text-gray-900 dark:text-white">
          {content.tittle}
        </h1>
        <p class="text-sm">{content.description}</p>
        <p>
          <strong class="text-base font-extrabold text-cyan-400">
            {formatDatePost(content.date)}
          </strong>
            Por: <strong class="dark:text-white"
            >{content.author}
          </strong>
        </p>
      </div>
    </div>
    <div
      class="prose-xl my-5 dark:text-white dark:prose-pre:text-white prose-a:text-cyan-400 dark:prose-h2:text-white dark:prose-ul:text-white dark:prose-ol:text-white dark:prose-li:text-white dark:prose-h1:text-white dark:prose-code:text-white dark:prose-strong:text-white dark:prose-h3:text-white"
    >
      <slot />
    </div>
    {
      content.tags && (
        <TagsPosts is-client tagsList={JSON.stringify(content.tags)} />
      )
    }

    
  <NextPrevLiks nextURL={urlNext} prevURL={urlPrev} textNext={textNext} textPrev={textPrev} />
  </div>
</Layout>
