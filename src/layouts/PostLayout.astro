---
import { formatDatePost, getSortedPosts } from "src/utils.js";
import Layout from "@layouts/Layout.astro";
import NextPrevLiks from "@components/NextPrevLiks.astro";
import TableOfContents from "@components/TableOfContents.astro";
import  CodeEnhancer from "@components/CodeEnhancer.astro";
import ReadingProgress from "@components/ReadingProgress.astro";
import ResponsiveImage from "@components/ResponsiveImage.astro";
import { getCollection } from "astro:content";
import type { MarkdownHeading } from "astro";
import AudioPlayer from "@components/AudioPlayer.astro";
let bar = {
  prevElement: { url: undefined, title: undefined, image: "prev.svg" },
  nextElement: { url: undefined, title: undefined, image: "next.svg" },
};

interface Props {
  id: number;
  title: string;
  description: string;
  tags: string | string[];
  author: string;
  image: string;
  pubDate: string | Date;
  headings?: MarkdownHeading[];
  remarkPluginFrontmatter?: Record<string, any>;
  audioSrc?: string;
}

const {
  id,
  title,
  description,
  tags,
  author,
  image,
  pubDate,
  headings = [],
  remarkPluginFrontmatter,
  audioSrc,
} = Astro.props;

const imagenLimpia = image
  ? image.startsWith("/") || image.startsWith("http")
    ? image
    : `/${image}`
  : null;

const allPosts = await getCollection("posts");
const sortedPosts = await getSortedPosts(allPosts);
const currentIndex = sortedPosts.findIndex((p) => p.id === id);

if (currentIndex > -1) {
  if (currentIndex > 0) {
    const prev = sortedPosts[currentIndex - 1];
    bar.prevElement = {
      url: `/posts/${prev.id}/`,
      title: prev.data.title,
      image: prev.data.image || "prev.svg",
    };
  }
  if (currentIndex < sortedPosts.length - 1) {
    const next = sortedPosts[currentIndex + 1];
    bar.nextElement = {
      url: `/posts/${next.id}/`,
      title: next.data.title,
      image: next.data.image || "next.svg",
    };
  }
}

const minutesRead = remarkPluginFrontmatter?.minutesRead;
const tagsArray = Array.isArray(tags)
  ? tags
  : typeof tags === "string"
  ? tags.split(",").map((t) => t.trim())
  : [];
---

<Layout
  title={title}
  description={description}
  tags={tagsArray}
  pubDate={pubDate}
  author={author}
>
  <ReadingProgress />
  <div
    class="max-w-screen-xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 py-10 font-sans"
  >
    <main class="lg:col-span-8 px-4 lg:px-0">
      <header class="mb-12">
        <div
          class="relative w-full h-[300px] md:h-[400px] overflow-hidden bg-slate-100 dark:bg-slate-900 mb-10"
        >
          {
            imagenLimpia ? (
              <ResponsiveImage
                fallback={imagenLimpia}
                alt={title}
                fetchpriority="high"
                loading="eager"
                class="w-full h-full object-cover"
              />
            ) : (
              <div class="w-full h-full bg-slate-200 dark:bg-slate-800 flex items-center justify-center">
                <span class="text-slate-500 dark:text-slate-600 text-xs sm:text-sm">
                  SIN_IMAGEN
                </span>
              </div>
            )
          }
        </div>

        <div class="space-y-6">
          <h1
            class="text-3xl md:text-5xl font-black uppercase italic tracking-tighter leading-tight text-slate-900 dark:text-white"
          >
            {title}
          </h1>

          <p
            class="text-xl text-white leading-relaxed max-w-3xl pl-6 from-sky-900 to-cyan-500 bg-gradient-to-r"
          >
            {description}
          </p>

          <div
            class="flex flex-wrap items-center gap-8 pt-6 text-xs sm:text-sm uppercase tracking-[0.2em]"
          >
            <div class="flex items-center gap-2">
              <span class="text-slate-500 dark:text-slate-400">FECHA:</span>
              <time class="text-slate-900 dark:text-white font-bold"
                >{formatDatePost(pubDate)}</time
              >
            </div>
            <div class="flex items-center gap-2">
              <span class="text-slate-500 dark:text-slate-400">AUTOR:</span>
              <span class="text-slate-900 dark:text-white font-bold"
                >{author}</span
              >
            </div>
            {
              minutesRead && (
                <div class="flex items-center gap-2">
                  <span class="text-slate-500 dark:text-slate-400">
                    LECTURA:
                  </span>
                  <span class="text-slate-900 dark:text-white font-bold">
                    {minutesRead.toUpperCase()}
                  </span>
                </div>
              )
            }
          </div>
        </div>
        {audioSrc && <AudioPlayer src={audioSrc} />}
      </header>

      <article
        id="contenido"
        class="prose prose-xl max-w-none
 prose-slate dark:prose-invert
 dark:prose-p:text-slate-300 prose-p:leading-[1.8]
 prose-headings:uppercase prose-headings:italic prose-headings:tracking-tighter prose-headings:font-black
 prose-a:text-cyan-600 dark:prose-a:text-cyan-400 prose-a:no-underline hover:prose-a:underline
 prose-strong:text-cyan-600 dark:prose-strong:text-cyan-400
 prose-code:text-cyan-600 dark:prose-code:text-cyan-300
   prose-img:shadow-2xl prose-img:rounded-sm"
      >
        <slot />
      </article>

      <div class="mt-20 pt-12 space-y-16">
        {
          tagsArray.length > 0 && (
            <div class="space-y-6">
              <span class="text-base font-bold uppercase tracking-[0.3em] text-slate-500 dark:text-slate-400 block  pb-2 w-fit">
                ETIQUETADO EN:
              </span>
              <div class="flex flex-wrap gap-4">
                {tagsArray.map((tag) => (
                  <a
                    href={`/tags/${tag}/1`}
                    class="bg-gradient-to-r from-sky-800 to-cyan-600 px-5 py-2 text-xs font-black uppercase tracking-widest text-white shadow-[4px_4px_0px_0px_rgba(0,0,0,0.1)] hover:shadow-[0_0_20px_rgba(6,182,212,0.4)] hover:-translate-y-1 hover:scale-105 active:scale-95 transition-all block no-underline"
                  >
                    {tag}
                  </a>
                ))}
              </div>
            </div>
          )
        }

        <NextPrevLiks
          imageNext={bar.nextElement?.image}
          nextURL={bar.nextElement?.url}
          prevURL={bar.prevElement?.url}
          imagePrev={bar.prevElement?.image}
          textNext={bar.nextElement?.title}
          textPrev={bar.prevElement?.title}
        />
      </div>
    </main>

    <aside class="hidden lg:block lg:col-span-4">
      <div class="sticky top-24 pl-8 h-fit">
        <TableOfContents headings={headings} />
      </div>
    </aside>
  </div>

  <CodeEnhancer />
</Layout>

<style is:global>
  /* Selección de texto personalizada */
  ::selection {
    background-color: rgba(6, 182, 212, 0.3);
    color: inherit;
  }

  /* Scroll suave para la página */
  html {
    scroll-behavior: smooth;
  }

  /* Animación para el bloque de solución */
  details .details-content {
    animation: slideDown 0.4s ease-out;
  }

  @keyframes slideDown {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Personalización del scrollbar dentro del código si es muy largo */
  .details-content pre::-webkit-scrollbar {
    height: 4px;
  }
  .details-content pre::-webkit-scrollbar-thumb {
    background: rgba(6, 182, 212, 0.3);
    border-radius: 10px;
  }

  /* --- Estenedor de Solución (Details) --- */
  details {
    padding: 1.5rem;
    padding-top: 0.5rem;
  }

  details[open] {
    box-shadow: 0 0 30px rgba(6,182,212,0.15), 0 0 0 1px rgba(6,182,212,0.2);
  }

  /* --- Cabecera del desplegable --- */
  summary {
    padding: 1.25rem;
    cursor: pointer;
    font-weight: 700;
    color: #334155;
    display: flex;
    align-items: center;
    justify-content: space-between;
    user-select: none;
    list-style: none;
    transition: background 0.2s ease;
  }

  :global(.dark) summary {
    color: #cbd5e1;
  }

  summary:hover {
    background-color: rgba(100,116,139,0.05);
  }

  /* Indicador de estado personalizado */
  summary::after {
    content: "DESCIFRAR";
    font-size: 0.75rem;
    font-weight: 900;
    letter-spacing: 0.2em;
    background-color: #e2e8f0;
    color: #475569;
    padding: 0.25rem 0.75rem;
    border-radius: 0.375rem;
    transition: all 0.15s ease;
  }

  :global(.dark) summary::after {
    background-color: rgba(255,255,255,0.1);
    color: #cbd5e1;
  }

  details[open] summary::after {
    content: "DESCIFRADO";
    background-color: #06b6d4;
    color: #fff;
    box-shadow: 0 0 10px rgba(6,182,212,0.5);
  }

  /* --- Contenedor Interno de la Solución --- */
  .details-content {
    padding: 1.5rem;
    padding-top: 0.5rem;
    animation: fadeInSlide 0.4s ease-out;
  }

  /* Estilos para los títulos dentro de la solución */
  .details-content h3 {
    color: #0891b2 !important;
    font-size: 0.875rem !important;
    font-weight: 900 !important;
    text-transform: uppercase !important;
    letter-spacing: 0.2em !important;
    margin-top: 1.5rem !important;
    margin-bottom: 0.5rem !important;
  }

  :global(.dark) .details-content h3 {
    color: #22d3ee !important;
  }

  /* Animación de apertura */
  @keyframes fadeInSlide {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* --- Scrollbar para bloques de código --- */
  .details-content pre::-webkit-scrollbar {
    height: 5px;
  }
  .details-content pre::-webkit-scrollbar-thumb {
    background-color: rgba(6,182,212,0.3);
    border-radius: 9999px;
  }
</style>
