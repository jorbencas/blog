---
import ContentLayout from "@layouts/ContentLayout.astro";
import type { MarkdownHeading } from "astro";

interface Props {
  id: number;
  title: string;
  description: string;
  tags: string | string[];
  author: string;
  image: string;
  pubDate: string | Date;
  updatedDate?: string | Date;
  headings?: MarkdownHeading[];
  remarkPluginFrontmatter?: Record<string, any>;
  audioSrc?: string;
  rawContent?: string;
  section?: string;
}

const {
  id,
  title,
  description,
  tags,
  author,
  image,
  pubDate,
  updatedDate,
  headings = [],
  remarkPluginFrontmatter,
  audioSrc,
  rawContent = "",
  section = "posts",
} = Astro.props;
---

<ContentLayout
  mode="posts"
  id={id}
  title={title}
  description={description}
  tags={tags}
  author={author}
  image={image}
  pubDate={pubDate}
  updatedDate={updatedDate}
  headings={headings}
  remarkPluginFrontmatter={remarkPluginFrontmatter}
  audioSrc={audioSrc}
  rawContent={rawContent}
  section={section}
>
  <slot />
</ContentLayout>
