---
import {
  formatDatePost,
  getSortedPosts,
  getRelatedPosts,
  resolveImagePath,
} from "src/utils.js";
import getReadingTime from "reading-time";
import "@styles/solution.css";
import Layout from "@layouts/Layout.astro";
import RelatedContent from "@components/RelatedContent.astro";
import NextPrevLinks from "@components/NextPrevLinks.astro";
import TableOfContents from "@components/TableOfContents.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import CodeEnhancer from "@components/CodeEnhancer.astro";
import ReadingProgress from "@components/ReadingProgress.astro";
import ResponsiveImage from "@components/ResponsiveImage.astro";
import { getCollection } from "astro:content";
import type { MarkdownHeading } from "astro";
import AudioPlayer from "@components/AudioPlayer.astro";
import CopyPost from "@components/CopyPost.astro";
import Disqus from "@components/Disqus.astro";

interface Props {
  mode: "posts" | "proyectos";
  title: string;
  description: string;
  tags: string | string[];
  author: string;
  image: string;
  pubDate: string | Date;
  updatedDate?: string | Date;
  section?: string;
  headings?: MarkdownHeading[];
  id?: number;
  remarkPluginFrontmatter?: Record<string, any>;
  audioSrc?: string;
  rawContent?: string;
  repository?: string;
  url?: string;
}

const {
  mode,
  title,
  description,
  tags,
  author,
  image,
  pubDate,
  updatedDate,
  section = mode === "posts" ? "posts" : "proyectos",
  headings = [],
  id,
  remarkPluginFrontmatter,
  audioSrc,
  rawContent = "",
  repository,
  url,
} = Astro.props;

const isPost = mode === "posts";
const imagenLimpia = resolveImagePath(image);
const currentSlug = Astro.url.pathname.replace(/\/$/, "").split("/").pop() ?? "";
const postUrl = Astro.url.href;

let resolvedAudioSrc = audioSrc;
if (audioSrc && audioSrc.startsWith("/audio/")) {
  try {
    const audioMap = await import("../../../data/audio-map.json");
    resolvedAudioSrc = audioMap.default[audioSrc] || audioSrc;
  } catch {
    // audio-map.json not found, use local path
  }
}

const tagsArray = Array.isArray(tags)
  ? tags
  : typeof tags === "string"
  ? tags.split(",").map((t) => t.trim())
  : [];

const collectionName = isPost ? "posts" : "myprojects";
const allItems = await getCollection(collectionName);
const sortedItems = await getSortedPosts(allItems);

const accentColor = isPost ? "cyan" : "purple";
const relatedHrefPrefix = isPost ? "/posts/" : "/proyectos/";

const sectionColors = {
  weekly: {
    badge: "from-yellow-800 to-yellow-500 dark:from-yellow-700 dark:to-yellow-400",
    tag: "from-yellow-800 to-yellow-600 hover:shadow-[0_0_20px_rgba(234,179,8,0.4)]",
  },
  blog: {
    badge: "from-sky-900 to-cyan-500 dark:from-sky-800 dark:to-cyan-600",
    tag: "from-sky-800 to-cyan-600 hover:shadow-[0_0_20px_rgba(6,182,212,0.4)]",
  },
  proyectos: {
    badge: "from-purple-900 to-purple-500 dark:from-purple-800 dark:to-purple-400",
    tag: "from-purple-800 to-purple-600 hover:shadow-[0_0_20px_rgba(168,85,247,0.4)]",
  },
};
const sc = sectionColors[section] || sectionColors.blog;

let relatedItems: typeof sortedItems = [];
if (isPost) {
  const currentPost = allItems.find((p) => p.id === id);
  relatedItems = currentPost ? getRelatedPosts(currentPost, allItems, 3) : [];
} else {
  relatedItems = sortedItems
    .filter((p) => p.id.replace(/\.[^/.]+$/, "") !== currentSlug)
    .slice(0, 5);
}

const bar = {
  prevElement: { url: undefined as string | undefined, title: undefined as string | undefined },
  nextElement: { url: undefined as string | undefined, title: undefined as string | undefined },
};

if (isPost) {
  const currentIndex = sortedItems.findIndex((p) => p.id === id);
  if (currentIndex > -1) {
    if (currentIndex > 0) {
      const prev = sortedItems[currentIndex - 1];
      bar.prevElement = { url: `/posts/${prev.id}/`, title: prev.data.title };
    }
    if (currentIndex < sortedItems.length - 1) {
      const next = sortedItems[currentIndex + 1];
      bar.nextElement = { url: `/posts/${next.id}/`, title: next.data.title };
    }
  }
}

const minutesRead =
  remarkPluginFrontmatter?.minutesRead ||
  (rawContent
    ? (() => {
        const { minutes } = getReadingTime(rawContent);
        const mins = Math.ceil(minutes);
        return `${mins} minuto${mins === 1 ? "" : "s"} de lectura`;
      })()
    : undefined);

const relatedTitle = isPost ? "ARTÍCULOS RELACIONADOS:" : "MÁS PROYECTOS:";
const relatedLayout = isPost ? "grid" : "list";
---

<Layout
  title={title}
  description={description}
  tags={tagsArray}
  section={section}
  pubDate={pubDate}
  author={author}
>
  {isPost && <ReadingProgress />}
  <div class="max-w-screen-xl mx-auto px-4 lg:px-0 py-10 font-sans">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12">
      <main class="lg:col-span-8">
        <Breadcrumbs title={title} section={section} />
        <header class="mb-6 md:mb-12">
          <div class="relative w-full h-[120px] sm:h-[300px] md:h-[400px] overflow-hidden bg-slate-100 dark:bg-slate-900 mb-6 md:mb-10">
            {
              imagenLimpia ? (
                <ResponsiveImage
                  fallback={imagenLimpia}
                  alt={title}
                  fetchpriority="high"
                  loading="eager"
                  class="w-full h-full object-cover"
                />
              ) : (
                <div class="w-full h-full bg-slate-200 dark:bg-slate-800 flex items-center justify-center">
                  <span class="text-slate-500 dark:text-slate-600 text-xs sm:text-sm">
                    SIN_IMAGEN
                  </span>
                </div>
              )
            }
          </div>

          <div class="space-y-4 sm:space-y-6">
            <h1 class="text-2xl sm:text-3xl md:text-5xl font-black uppercase italic tracking-tighter leading-tight text-slate-900 dark:text-white">
              {title}
            </h1>

            <p
              class:list={[
                "text-base sm:text-xl leading-relaxed max-w-3xl px-5 sm:px-6 py-3 sm:py-4 bg-gradient-to-r text-white",
                sc.badge,
              ]}
            >
              {description}
            </p>

            <div class="flex flex-wrap items-center gap-8 pt-6 text-xs sm:text-sm uppercase tracking-[0.2em]">
              <div class="flex items-center gap-2">
                <span class="text-slate-500 dark:text-slate-400">FECHA:</span>
                <time class="text-slate-900 dark:text-white font-bold">{formatDatePost(pubDate)}</time>
              </div>
              {
                updatedDate && (
                  <div class="flex items-center gap-2">
                    <span class="text-slate-500 dark:text-slate-400">ACTUALIZADO:</span>
                    <time class="text-slate-900 dark:text-white font-bold">{formatDatePost(updatedDate)}</time>
                  </div>
                )
              }
              <div class="flex items-center gap-2">
                <span class="text-slate-500 dark:text-slate-400">AUTOR:</span>
                <span class="text-slate-900 dark:text-white font-bold">{author}</span>
              </div>
              {
                isPost && minutesRead && (
                  <div class="flex items-center gap-2">
                    <span class="text-slate-500 dark:text-slate-400">LECTURA:</span>
                    <span class="text-slate-900 dark:text-white font-bold">{minutesRead.toUpperCase()}</span>
                  </div>
                )
              }
            </div>

            {isPost && resolvedAudioSrc && <AudioPlayer src={resolvedAudioSrc} />}

            {
              isPost && rawContent && (
                <div class="flex flex-wrap gap-4 pt-6">
                  <CopyPost
                    rawContent={rawContent}
                    title={title}
                    description={description}
                    pubDate={pubDate instanceof Date ? pubDate.toISOString() : String(pubDate)}
                    author={author}
                    url={postUrl}
                    tags={Array.isArray(tags) ? tags : []}
                  />
                </div>
              )
            }

            {
              !isPost && (repository || url) && (
                <div class="flex flex-wrap gap-4 pt-4">
                  {repository && (
                    <a
                      href={repository}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="group inline-flex items-center gap-2 border-2 border-slate-900 dark:border-white bg-white dark:bg-slate-900 px-6 py-3 text-xs font-black uppercase tracking-widest text-slate-900 dark:text-white transition-all hover:bg-cyan-500 hover:border-cyan-500 hover:text-white active:bg-cyan-500 active:border-cyan-500 active:text-white active:translate-y-1 active:shadow-none"
                    >
                      <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                      </svg>
                      REPOSITORIO
                    </a>
                  )}
                  {url && (
                    <a
                      href={url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="group inline-flex items-center gap-2 border-2 border-slate-900 dark:border-white bg-white dark:bg-slate-900 px-6 py-3 text-xs font-black uppercase tracking-widest text-slate-900 dark:text-white transition-all hover:bg-cyan-500 hover:border-cyan-500 hover:text-white active:bg-cyan-500 active:border-cyan-500 active:text-white active:translate-y-1 active:shadow-none"
                    >
                      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                      </svg>
                      LIVE_DEMO
                    </a>
                  )}
                </div>
              )
            }
          </div>
        </header>

        <article
          id="contenido"
          class:list={[
            "prose sm:prose-lg lg:prose-xl max-w-4xl",
            "prose-slate dark:prose-invert",
            "dark:prose-p:text-slate-300 prose-p:leading-[1.8]",
            "prose-headings:uppercase prose-headings:italic prose-headings:tracking-tighter prose-headings:font-black",
            "prose-a:text-cyan-600 dark:prose-a:text-cyan-400",
            isPost ? "prose-a:no-underline" : "prose-a:no-underline hover:prose-a:underline",
            "prose-code:text-cyan-700 dark:prose-code:text-inherit",
            "prose-pre:border prose-pre:border-slate-200 dark:prose-pre:border-slate-800 prose-pre:bg-slate-50 dark:prose-pre:bg-transparent prose-pre:rounded-lg",
            "prose-img:shadow-2xl prose-img:rounded-sm prose-img:max-w-full prose-img:h-auto",
            "prose-table:overflow-x-auto",
          ]}
        >
          <slot />
        </article>

        {
          isPost && (
            <div class="mt-20 pt-12 space-y-16">
              <div class="space-y-6">
                <span class="text-base font-bold uppercase tracking-[0.3em] text-slate-500 dark:text-slate-400 block pb-2 w-fit">
                  COMPARTIR:
                </span>
                <div class="flex flex-wrap gap-4" id="share-buttons">
                  <button
                    data-share-url={`https://twitter.com/intent/tweet?url=${encodeURIComponent(postUrl)}&text=${encodeURIComponent(title)}&via=jorgevenkas`}
                    class="inline-flex items-center gap-1.5 border border-[#1DA1F2]/40 hover:border-[#1DA1F2] bg-[#1DA1F2]/5 hover:bg-[#1DA1F2]/10 px-3 py-2 text-[11px] font-black uppercase tracking-widest text-[#1DA1F2] hover:text-[#1a8cd8] transition-all rounded-lg active:scale-95 cursor-pointer no-underline"
                  >
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path></svg>
                     X
                  </button>
                  <button
                    data-share-url={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(postUrl)}&quote=${encodeURIComponent(title)}&hashtag=${encodeURIComponent(tagsArray.slice(0, 3).map((t) => `#${t}`).join(","))}`}
                    class="inline-flex items-center gap-1.5 border border-[#1877F2]/40 hover:border-[#1877F2] bg-[#1877F2]/5 hover:bg-[#1877F2]/10 px-3 py-2 text-[11px] font-black uppercase tracking-widest text-[#1877F2] hover:text-[#166fe5] transition-all rounded-lg active:scale-95 cursor-pointer no-underline"
                  >
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"></path></svg>
                     Facebook
                  </button>
                  <button
                    data-share-url={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(postUrl)}`}
                    class="inline-flex items-center gap-1.5 border border-[#0A66C2]/40 hover:border-[#0A66C2] bg-[#0A66C2]/5 hover:bg-[#0A66C2]/10 px-3 py-2 text-[11px] font-black uppercase tracking-widest text-[#0A66C2] hover:text-[#004182] transition-all rounded-lg active:scale-95 cursor-pointer no-underline"
                  >
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path></svg>
                     LinkedIn
                  </button>
                  <button
                    data-share-url={`https://t.me/share/url?url=${encodeURIComponent(postUrl)}&text=${encodeURIComponent(title)}`}
                    class="inline-flex items-center gap-1.5 border border-[#0088cc]/40 hover:border-[#0088cc] bg-[#0088cc]/5 hover:bg-[#0088cc]/10 px-3 py-2 text-[11px] font-black uppercase tracking-widest text-[#0088cc] hover:text-[#006ba3] transition-all rounded-lg active:scale-95 cursor-pointer no-underline"
                  >
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.479.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"></path></svg>
                     Telegram
                  </button>
                  <button
                    data-share-url={`https://wa.me/?text=${encodeURIComponent(`${title} ${postUrl}`)}`}
                    class="inline-flex items-center gap-1.5 border border-[#25D366]/40 hover:border-[#25D366] bg-[#25D366]/5 hover:bg-[#25D366]/10 px-3 py-2 text-[11px] font-black uppercase tracking-widest text-[#25D366] hover:text-[#1ebe57] transition-all rounded-lg active:scale-95 cursor-pointer no-underline"
                  >
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"></path></svg>
                     WhatsApp
                  </button>
                </div>
                <script is:inline>
                  document.getElementById("share-buttons")?.addEventListener("click", (e) => {
                    const btn = e.target.closest("[data-share-url]");
                    if (!btn) return;
                    e.preventDefault();
                    const url = btn.dataset.shareUrl;
                    if (navigator.share) {
                      navigator.share({ title: document.title, url }).catch(() => {});
                    } else {
                      window.open(url, "_blank", "noopener,noreferrer");
                    }
                  });
                </script>
                <script is:inline>
                  (() => {
                    const slug = window.location.pathname.split("/").pop();
                    if (slug) {
                      fetch("/api/views", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({ slug }),
                      }).catch(() => {});
                    }
                  })();
                </script>
              </div>

              {tagsArray.length > 0 && (
                <div class="space-y-6">
                  <span class="text-base font-bold uppercase tracking-[0.3em] text-slate-500 dark:text-slate-400 block pb-2 w-fit">
                    ETIQUETADO EN:
                  </span>
                  <div class="flex flex-wrap gap-4">
                    {tagsArray.map((tag) => (
                      <a
                        href={`/tags/${tag}/1`}
                        class={`bg-gradient-to-r ${sc.tag} px-5 py-2 text-xs font-black uppercase tracking-widest text-white shadow-[4px_4px_0px_0px_rgba(0,0,0,0.1)] hover:-translate-y-1 hover:scale-105 active:scale-95 transition-all block no-underline`}
                      >
                        {tag}
                      </a>
                    ))}
                  </div>
                </div>
              )}
            </div>
          )
        }

        {
          relatedItems.length > 0 && (
            <div class:list={[isPost ? "mt-20 pt-12 space-y-16" : "mt-8"]}>
              <RelatedContent
                title={relatedTitle}
                items={relatedItems}
                currentSlug={isPost ? undefined : currentSlug}
                accentColor={accentColor}
                layout={relatedLayout}
                hrefPrefix={relatedHrefPrefix}
              />
            </div>
          )
        }

        {isPost && (
          <NextPrevLinks
            nextURL={bar.nextElement?.url}
            prevURL={bar.prevElement?.url}
            textNext={bar.nextElement?.title}
            textPrev={bar.prevElement?.title}
          />
        )}

        <Disqus
          url={isPost ? postUrl : (url || `https://blog-jorbencas.vercel.app${Astro.url.pathname}`)}
          identifier={isPost ? (id?.toString() || title) : (currentSlug || title)}
          title={title}
        />
      </main>

      <div class="lg:col-span-4">
        <div class="lg:sticky lg:top-24 lg:pl-8 h-fit">
          <TableOfContents headings={headings} section={section} />
        </div>
      </div>
    </div>
  </div>
  <CodeEnhancer />
</Layout>

<style>
  article.prose a:hover {
    text-decoration: underline;
  }
</style>
