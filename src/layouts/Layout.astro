---
import ScrollToTop from "@components/ScrollToTop.astro";
import Footer from "@components/Footer.astro";
import Header from "@components/header.astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import SEO from "@components/SEO.astro";
import "@styles/global.css";
import { SITE_NAME, SITE_DESCRIPTION, AUTHOR_NAME } from "src/consts.js";

export interface Props {
  title: string;
  description?: string;
  tags?: string[];
  section?: string;
  pubDate?: string | Date;
  author?: string;
}
const {
  title,
  description,
  tags = [],
  section,
  pubDate = new Date().toString(),
  author = AUTHOR_NAME,
} = Astro.props as Props;

const finalTitle = title || `Blog | ${SITE_NAME}`;
const finalDescription = description || SITE_DESCRIPTION;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <script is:inline>
      (() => {
        const stored = localStorage.getItem("color-theme");
        const isDark = stored === "dark" || (!stored && window.matchMedia("(prefers-color-scheme: dark)").matches);
        if (isDark) document.documentElement.classList.add("dark");
      })();
    </script>
    <style>
      html { background-color: #f1f5f9; }
      html.dark { background-color: #020617; }
    </style>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="jorbencas" />
    <link rel="manifest" href="/site.webmanifest" />

    <SEO
      title={finalTitle}
      description={finalDescription}
      tags={tags}
      section={section}
      pubDate={pubDate}
      author={author}
    />
  </head>
  <body
    class="bg-slate-100 dark:bg-slate-950 text-slate-800 dark:text-slate-100 min-h-screen flex flex-col font-['Space_Grotesk',sans-serif]"
  >
    <Header />

    <main
      class="flex-grow mt-10 max-w-screen-xl mx-auto w-full px-4"
      data-pagefind-body
      data-pagefind-filter={tags?.length > 0
        ? `tags:${tags.join(", ")}`
        : undefined}
    >
      <slot />
    </main>

    <ScrollToTop />
    <Footer />
    <SpeedInsights />

    <style is:global>
      /* Mejora de la scrollbar para modo tech */
      ::-webkit-scrollbar {
        width: 10px;
      }
      ::-webkit-scrollbar-track {
        background-color: #f8fafc;
      }
      :root.dark ::-webkit-scrollbar-track {
        background-color: #020617;
      }
      ::-webkit-scrollbar-thumb {
        background-color: #e2e8f0;
        border: 4px solid transparent;
        background-clip: content-box;
      }
      :root.dark ::-webkit-scrollbar-thumb {
        background-color: #1e293b;
      }
      ::-webkit-scrollbar-thumb:hover {
        background-color: #06b6d4;
      }
    </style>
  </body>
</html>
