---
import Footer from "@components/footer.astro";
import Header from "@components/header.astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import SEO from "@components/SEO.astro";
import "@styles/global.css";

export interface Props {
  title: string;
  description?: string;
  tags?: string[];
  pubDate?: string | Date;
  author?: string;
}
const {
  title,
  description,
  tags = [],
  pubDate = new Date().toString(),
  author = "Jorge Beneyto Castelló",
} = Astro.props as Props;

const finalTitle = title || "Blog | Problemas de un desarrollador web";
const finalDescription =
  description ||
  "Jorge Beneyto Castelló divulga sobre problemas, inquietudes e ideas de un desarollador web.";
---

<!doctype html>
<html lang="ew" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="jorbencas" />
    <link rel="manifest" href="/site.webmanifest" />

    <SEO
      title={finalTitle}
      description={finalDescription}
      tags={tags}
      pubDate={pubDate}
      author={author}
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300..700&family=Space+Mono:ital,wght@0,400;0,700;1,400;1,700&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      const theme = (() => {
        let storedThewmw = localStorage.getItem("color-theme");
        if (
          storedThewmw ??
          window.matchMedia("(prefers-color-scheme: dark)").matches
        ) {
          return "dark";
        } else {
          return "light";
        }
      })();

      document.documentElement.classList.toggle("dark",theme === "dark");
    </script>
  </head>
  <body
    class="bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 transition-colors duration-500 min-h-screen flex flex-col"
  >
    <Header />

    <main
      class="flex-grow mt-10 max-w-screen-xl mx-auto w-full px-4"
      data-pagefind-body
      data-pagefind-filter={tags?.length > 0
        ? `tags:${tags.join(", ")}`
        : undefined}
    >
      <slot />
    </main>

    <Footer />
    <SpeedInsights />

    <style is:global>
      :root {
        --font-main: "Space Grotesk", sans-serif;
      }

      html {
        font-family: var(--font-main);
      }

      /* Ajuste para que el footer siempre esté abajo si hay poco contenido */
      body {
        display: flex;
        flex-direction: column;
      }

      /* Mejora de la scrollbar para modo tech */
      ::-webkit-scrollbar {
        width: 10px;
      }
      ::-webkit-scrollbar-track {
        background-color: #f8fafc;
      }
      :root.dark ::-webkit-scrollbar-track {
        background-color: #020617;
      }
      ::-webkit-scrollbar-thumb {
        background-color: #e2e8f0;
        border: 4px solid transparent;
        background-clip: content-box;
      }
      :root.dark ::-webkit-scrollbar-thumb {
        background-color: #1e293b;
      }
      ::-webkit-scrollbar-thumb:hover {
        background-color: #06b6d4;
      }

      :root {
        --font-sans: "Inter", sans-serif;
      }
      body {
        font-family: var(--font-sans);
      }
    </style>
  </body>
</html>
