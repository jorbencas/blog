---
import { formatDatePost, resolveImagePath } from "src/utils.js";
import Layout from "@layouts/Layout.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import CodeEnhancer from "@components/CodeEnhancer.astro";
import ResponsiveImage from "@components/ResponsiveImage.astro";
import MoreProjects from "@components/MoreProjects.astro";
import "@styles/solution.css";

interface Props {
  title: string;
  description: string;
  tags: string | string[];
  author: string;
  image: string;
  pubDate: string | Date;
  repository?: string;
  url?: string;
  section?: string;
}

const {
  title,
  description,
  tags,
  author,
  image,
  pubDate,
  repository,
  url,
  section = "proyectos",
} = Astro.props;

const imagenLimpia = resolveImagePath(image);
const currentSlug = Astro.url.pathname.split("/").pop() ?? "";

const tagsArray = Array.isArray(tags)
  ? tags
  : typeof tags === "string"
  ? tags.split(",").map((t) => t.trim())
  : [];
---

<Layout
  title={title}
  description={description}
  tags={tagsArray}
  section={section}
  pubDate={pubDate}
  author={author}
>
  <div
    class="max-w-screen-xl mx-auto px-4 lg:px-0 py-10 font-sans"
  >
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
      <main class="lg:col-span-8 max-w-3xl">
        <Breadcrumbs title={title} section="proyectos" />
        <header class="mb-12">
          <div
            class="relative w-full h-[200px] sm:h-[300px] md:h-[400px] overflow-hidden bg-slate-100 dark:bg-slate-900 mb-8 sm:mb-10"
          >
            {
              imagenLimpia ? (
                <ResponsiveImage
                  fallback={imagenLimpia}
                  alt={title}
                  fetchpriority="high"
                  loading="eager"
                  class="w-full h-full object-cover"
                />
              ) : (
                <div class="w-full h-full bg-slate-200 dark:bg-slate-800 flex items-center justify-center">
                  <span class="text-slate-500 dark:text-slate-600 text-xs sm:text-sm">
                    SIN_IMAGEN
                  </span>
                </div>
              )
            }
          </div>

          <div class="space-y-4 sm:space-y-6">
            <h1
              class="text-2xl sm:text-3xl md:text-5xl font-black uppercase italic tracking-tighter leading-tight text-slate-900 dark:text-white"
            >
              {title}
            </h1>

            <p
              class="text-base sm:text-xl text-white leading-relaxed max-w-3xl pl-4 sm:pl-6 from-sky-900 to-cyan-500 bg-gradient-to-r"
            >
              {description}
            </p>

            <div
              class="flex flex-wrap items-center gap-8 pt-6 text-xs sm:text-sm uppercase tracking-[0.2em]"
            >
              <div class="flex items-center gap-2">
                <span class="text-slate-500 dark:text-slate-400">FECHA:</span>
                <time class="text-slate-900 dark:text-white font-bold"
                  >{formatDatePost(pubDate)}</time
                >
              </div>
              <div class="flex items-center gap-2">
                <span class="text-slate-500 dark:text-slate-400">AUTOR:</span>
                <span class="text-slate-900 dark:text-white font-bold"
                  >{author}</span
                >
              </div>
            </div>

            {
              (repository || url) && (
                <div class="flex flex-wrap gap-4 pt-4">
                  {repository && (
                    <a
                      href={repository}
                      target="_blank"
                      class="group inline-flex items-center gap-2 border-2 border-slate-900 dark:border-white bg-white dark:bg-slate-900 px-6 py-3 text-xs font-black uppercase tracking-widest text-slate-900 dark:text-white transition-all hover:bg-cyan-500 hover:border-cyan-500 hover:text-white active:bg-cyan-500 active:border-cyan-500 active:text-white active:translate-y-1 active:shadow-none"
                    >
                      <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                      </svg>
                      REPOSITORIO
                    </a>
                  )}
                  {url && (
                    <a
                      href={url}
                      target="_blank"
                      class="group inline-flex items-center gap-2 border-2 border-slate-900 dark:border-white bg-white dark:bg-slate-900 px-6 py-3 text-xs font-black uppercase tracking-widest text-slate-900 dark:text-white transition-all hover:bg-cyan-500 hover:border-cyan-500 hover:text-white active:bg-cyan-500 active:border-cyan-500 active:text-white active:translate-y-1 active:shadow-none"
                    >
                      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                      </svg>
                      LIVE_DEMO
                    </a>
                  )}
                </div>
              )
            }
          </div>
        </header>

        <article
        class="prose sm:prose-lg lg:prose-xl max-w-4xl
 prose-slate dark:prose-invert
 dark:prose-p:text-slate-300 prose-p:leading-[1.8]
 prose-headings:uppercase prose-headings:italic prose-headings:tracking-tighter prose-headings:font-black
 prose-a:text-cyan-600 dark:prose-a:text-cyan-400 prose-a:no-underline hover:prose-a:underline
    prose-code:text-cyan-700 dark:prose-code:text-inherit
      prose-pre:border prose-pre:border-slate-200 dark:prose-pre:border-slate-800 prose-pre:bg-slate-50 dark:prose-pre:bg-transparent prose-pre:rounded-lg
       prose-img:shadow-2xl prose-img:rounded-sm prose-img:max-w-full prose-img:h-auto
       prose-table:block prose-table:overflow-x-auto"
        >
          <slot />
        </article>
      </main>

      <MoreProjects currentSlug={currentSlug} />
    </div>
  </div>

  <CodeEnhancer />
</Layout>


