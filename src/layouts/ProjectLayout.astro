---
import ContentLayout from "@layouts/ContentLayout.astro";
import type { MarkdownHeading } from "astro";

interface Props {
  title: string;
  description: string;
  tags: string | string[];
  author: string;
  image: string;
  pubDate: string | Date;
  repository?: string;
  url?: string;
  section?: string;
  headings?: MarkdownHeading[];
}

const {
  title,
  description,
  tags,
  author,
  image,
  pubDate,
  repository,
  url,
  section = "proyectos",
  headings = [],
} = Astro.props;
---

<ContentLayout
  mode="proyectos"
  title={title}
  description={description}
  tags={tags}
  author={author}
  image={image}
  pubDate={pubDate}
  repository={repository}
  url={url}
  section={section}
  headings={headings}
>
  <slot />
</ContentLayout>
