---
import Layout from "./Layout.astro";
import { getCollection } from "astro:content";
import CodeEnhancer from "@components/CodeEnhancer.astro";

const { frontmatter, url } = Astro.props;
const allChallenges = await getCollection("challenges");

// Obtenemos 5 retos aleatorios o recientes para la barra lateral
const sidebarChallenges = allChallenges
  .filter((c) => c.slug !== url?.split("/").pop()) // Evitamos mostrar el reto actual
  .slice(0, 5);
---

<Layout title={frontmatter.title}>
  <div class="max-w-screen-xl mx-auto px-6 py-12">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
      <main class="lg:col-span-8 space-y-8">
        <header class="space-y-4 border-b pb-8">
          <div class="flex items-center gap-4">
            <span
              class="px-3 py-1 rounded bg-cyan-500/10 border text-cyan-500 text-[10px] font-black uppercase tracking-widest"
            >
              Challenge_Task
            </span>
            <span class="text-slate-500 font-mono text-[10px] uppercase"
              >{frontmatter.pubDate}</span
            >
          </div>
          <h1
            class="text-4xl md:text-6xl font-black italic uppercase tracking-tighter text-white"
          >
            {frontmatter.title}
          </h1>
        </header>

        <div
          class="prose prose-invert prose-cyan max-w-none
 prose-headings:italic prose-headings:font-black prose-headings:uppercase prose-headings:tracking-tighter
 prose-p:text-slate-300 prose-p:leading-relaxed
 prose-code:text-cyan-400 prose-code:bg-cyan-950/30 prose-code:px-1 prose-code:rounded"
        >
          <slot />
        </div>
      </main>

      <aside class="lg:col-span-4 space-y-8">
        <div class="sticky top-24 p-6 bg-slate-900/50">
          <h2
            class="text-xs font-black uppercase tracking-[0.3em] text-slate-500 mb-6 border-b pb-2"
          >
            Otras_Misiones
          </h2>

          <nav class="space-y-4">
            {
              sidebarChallenges.map((ch) => (
                <a
                  href={`/retos/${ch.id.replace(/\.[^/.]+$/, "")}`}
                  class="group block"
                >
                  <span class="text-[9px] font-mono text-cyan-500/50 block uppercase mb-1">
                    [{ch.data.difficulty}]
                  </span>
                  <p class="text-sm font-bold text-slate-300 group-hover:text-cyan-400 transition-colors line-clamp-2 italic uppercase tracking-tighter">
                    {ch.data.title}
                  </p>
                  <div class="h-[1px] w-0 group-hover:w-full bg-cyan-500/30 transition-all duration-500 mt-2" />
                </a>
              ))
            }
          </nav>

          <a
            href="/retos"
            class="block text-center mt-8 py-3 border rounded text-[10px] font-black uppercase tracking-widest text-cyan-500 hover:bg-cyan-500/10 transition-all"
          >
            Volver al laboratorio
          </a>
        </div>
      </aside>
    </div>
  </div>
  <CodeEnhancer />
</Layout>
