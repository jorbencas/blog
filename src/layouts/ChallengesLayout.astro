---
import { formatDatePost, resolveImagePath } from "src/utils.js";
import Layout from "@layouts/Layout.astro";
import { getCollection } from "astro:content";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import CodeEnhancer from "@components/CodeEnhancer.astro";
import ResponsiveImage from "@components/ResponsiveImage.astro";

interface Props {
  title: string;
  description: string;
  tags: string[];
  author: string;
  image: string;
  pubDate: string | Date;
  difficulty?: string;
  languages?: string[];
  section?: string;
}

const { title, description, tags, author, image, pubDate, difficulty, languages, section = "retos" } = Astro.props;

const imagenLimpia = resolveImagePath(image);

const allChallenges = await getCollection("auto-challenges");

const sidebarChallenges = allChallenges
  .filter((c) => c.id.replace(/\.[^/.]+$/, "") !== Astro.url.pathname.split("/").pop())
  .slice(0, 5);
---

<Layout
  title={title}
  description={description}
  tags={tags}
  section={section}
  pubDate={pubDate}
  author={author}
>
  <div
    class="max-w-screen-xl mx-auto px-4 lg:px-0 py-10 font-sans"
  >
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
      <main class="lg:col-span-8 space-y-8">
        <Breadcrumbs title={title} section="retos" />
        <header class="mb-12">
          <div
            class="relative w-full h-[200px] sm:h-[300px] md:h-[400px] overflow-hidden bg-slate-100 dark:bg-slate-900 mb-10"
          >
            {
              imagenLimpia ? (
                <ResponsiveImage
                  fallback={imagenLimpia}
                  alt={title}
                  fetchpriority="high"
                  loading="eager"
                  class="w-full h-full object-cover"
                />
              ) : (
                <div class="w-full h-full bg-slate-200 dark:bg-slate-800 flex items-center justify-center">
                  <span class="text-slate-500 dark:text-slate-600 text-xs sm:text-sm">
                    SIN_IMAGEN
                  </span>
                </div>
              )
            }
          </div>

          <div class="space-y-4 sm:space-y-6">
            <h1
              class="text-2xl sm:text-3xl md:text-5xl font-black uppercase italic tracking-tighter leading-tight text-slate-900 dark:text-white"
            >
              {title}
            </h1>

            <p
              class="text-base sm:text-xl text-white leading-relaxed max-w-3xl pl-4 sm:pl-6 from-amber-900 to-amber-500 bg-gradient-to-r"
            >
              {description}
            </p>

            <div
              class="flex flex-wrap items-center gap-8 pt-6 text-xs sm:text-sm uppercase tracking-[0.2em]"
            >
              <div class="flex items-center gap-2">
                <span class="text-slate-500 dark:text-slate-400">FECHA:</span>
                <time class="text-slate-900 dark:text-white font-bold"
                  >{formatDatePost(pubDate)}</time
                >
              </div>
              <div class="flex items-center gap-2">
                <span class="text-slate-500 dark:text-slate-400">AUTOR:</span>
                <span class="text-slate-900 dark:text-white font-bold"
                  >{author}</span
                >
              </div>
              {
                difficulty && (
                  <div class="flex items-center gap-2">
                    <span class="text-slate-500 dark:text-slate-400">DIFICULTAD:</span>
                    <span class="text-amber-600 dark:text-amber-400 font-bold uppercase">{difficulty}</span>
                  </div>
                )
              }
            </div>
          </div>
        </header>

        <div
          class="prose dark:prose-invert prose-cyan max-w-4xl
 prose-headings:italic prose-headings:font-black prose-headings:uppercase prose-headings:tracking-tighter
 prose-p:text-slate-600 dark:prose-p:text-slate-400 prose-p:leading-relaxed
  prose-code:text-cyan-700 dark:prose-code:text-inherit
   prose-pre:border prose-pre:border-slate-200 dark:prose-pre:border-slate-800 prose-pre:bg-slate-50 dark:prose-pre:bg-transparent prose-pre:rounded-lg
   prose-table:overflow-x-auto"
        >
          <slot />
        </div>
      </main>

      <aside class="lg:col-span-4 space-y-8">
        <div
          class="sticky top-24 p-6 bg-slate-100 dark:bg-slate-900/50 rounded-lg"
        >
          <h2
            class="text-xs font-black uppercase tracking-[0.3em] text-slate-600 dark:text-slate-500 mb-6 pb-2"
          >
            Otras_Misiones
          </h2>

          <nav class="space-y-4">
            {
              sidebarChallenges.map((ch) => (
                <a
                  href={`/retos/${ch.id.replace(/\.[^/.]+$/, "")}`}
                  class="group block"
                >
                  <span class="text-xs text-amber-700/60 dark:text-amber-500/50 block uppercase mb-1">
                    [{ch.data.difficulty}]
                  </span>
                  <p class="text-sm font-bold text-slate-700 dark:text-slate-300 group-hover:text-amber-500 dark:group-hover:text-amber-400 transition-colors line-clamp-2 italic uppercase tracking-tighter">
                    {ch.data.title}
                  </p>
                  <div class="h-[1px] w-0 group-hover:w-full bg-amber-500/30 transition-all duration-500 mt-2" />
                </a>
              ))
            }
          </nav>

          <a
            href="/retos/1"
            class="group w-fit inline-flex items-center gap-3 border-2 border-slate-900 dark:border-white bg-white dark:bg-slate-900 px-6 py-3 text-xs font-black uppercase tracking-widest text-slate-900 dark:text-white transition-all hover:bg-amber-500 hover:border-amber-500 hover:text-white active:bg-amber-500 active:border-amber-500 active:text-white active:translate-y-1 active:shadow-none"
          >
            ← Volver al laboratorio
          </a>
        </div>
      </aside>
    </div>
  </div>
  <CodeEnhancer />
</Layout>
