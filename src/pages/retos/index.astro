---
import Layout from "@layouts/Layout.astro";
import Card from "@components/Card.astro";
import Information from "@components/Information.astro";
import { getCollection } from "astro:content";

const allChallenges = await getCollection("auto-challenges");
const manualChallenges = allChallenges.filter(
  (c) => !c.id.includes("auto-challenges")
);
const sortedChallenges = manualChallenges.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const latestChallenges = sortedChallenges.slice(0, 6);
---

<Layout
  title="Laboratorio de Retos"
  description="Desafíos de programación, algoritmos y lógica de ingeniería."
  section="retos"
>
  <section class="max-w-6xl mx-auto space-y-12 py-8 md:py-16" data-pagefind-ignore>
      <!-- CABECERA -->
      <div class="text-center space-y-4 pb-4">
        <span class="text-xs text-cyan-500 uppercase tracking-[0.3em]">LABORATORIO</span>
        <h1 class="text-4xl md:text-5xl font-black italic uppercase tracking-tighter text-slate-900 dark:text-white">
          Retos
        </h1>
        <div class="h-1 w-24 bg-cyan-500 dark:bg-cyan-400 mx-auto rounded-full"></div>
        <p class="max-w-2xl mx-auto text-sm sm:text-base text-slate-500 dark:text-slate-400 leading-relaxed">
          Desafíos de programación, algoritmos y lógica de ingeniería.
        </p>
      </div>

      <!-- GRID DE RETOS -->
      <div class="flow-root">
        <ul role="list" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
          {
            latestChallenges.length > 0 ? (
              latestChallenges.map((ch) => (
                <li class="list-none">
                  <Card
                    {...ch.data}
                    href={`/retos/${ch.id.replace(/\.[^/.]+$/, "")}`}
                    accent="cyan"
                  />
                </li>
              ))
            ) : (
              <div class="col-span-full">
                <Information section="retos" />
              </div>
            )
          }
        </ul>
      </div>

      <!-- BOTÓN DE ACCESO COMPLETO -->
      {sortedChallenges.length > 6 && (
        <div class="flex justify-center pt-8">
          <a
            href="/retos/1"
            class="w-full sm:w-auto group relative inline-flex items-center justify-center gap-3 overflow-hidden px-6 md:px-10 py-3 md:py-4 text-xs font-black uppercase tracking-[0.2em] text-cyan-500 dark:text-cyan-400 transition-all hover:text-white dark:hover:text-gray-900 active:scale-95"
          >
            <span class="absolute inset-0 bg-cyan-500 dark:bg-cyan-400 transition-transform translate-y-full group-hover:translate-y-0 duration-300 ease-out -z-10"></span>
            Ver retos completos
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition-transform group-hover:translate-x-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
      )}
  </section>
</Layout>
