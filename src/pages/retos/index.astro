---
import Layout from "@layouts/Layout.astro";
import Card from "@components/Card.astro";
import Information from "@components/Information.astro";
import { getCollection } from "astro:content";

const allChallenges = await getCollection("auto-challenges");
const manualChallenges = allChallenges.filter(
  (c) => !c.id.includes("auto-challenges")
);
const sortedChallenges = manualChallenges.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// Extract unique difficulties and languages
const difficulties = [...new Set(sortedChallenges.map((c) => c.data.difficulty).filter(Boolean))];
const allLanguages = sortedChallenges.flatMap((c) => c.data.languages || []);
const languages = [...new Set(allLanguages)].sort();
---

<Layout
  title="Laboratorio de Retos"
  description="Desafíos de programación, algoritmos y lógica de ingeniería."
  section="retos"
>
  <section class="max-w-6xl mx-auto space-y-12 py-8 md:py-16" data-pagefind-ignore>
      <!-- CABECERA -->
      <div class="text-center space-y-4 pb-4">
        <span class="text-xs text-amber-500 uppercase tracking-[0.3em]">LABORATORIO</span>
        <h1 class="text-4xl md:text-5xl font-black italic uppercase tracking-tighter text-slate-900 dark:text-white">
          Retos
        </h1>
        <div class="h-1 w-24 bg-amber-500 dark:bg-amber-400 mx-auto rounded-full"></div>
        <p class="max-w-2xl mx-auto text-sm sm:text-base text-slate-500 dark:text-slate-400 leading-relaxed">
          Desafíos de programación, algoritmos y lógica de ingeniería.
        </p>
      </div>

      <!-- FILTROS -->
      <div class="space-y-4">
        <!-- Difficulty filters -->
        <div class="flex flex-wrap items-center gap-2">
          <span class="text-xs font-black uppercase tracking-wider text-slate-400 dark:text-slate-500 mr-2">Dificultad:</span>
          <button data-filter="all" class="filter-diff px-4 py-2 rounded-lg text-xs font-black uppercase tracking-wider border-2 border-amber-500 bg-amber-500 text-white transition-all">
            Todos
          </button>
          {difficulties.map((diff) => (
            <button data-filter={diff} class="filter-diff px-4 py-2 rounded-lg text-xs font-black uppercase tracking-wider border-2 border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-slate-600 dark:text-slate-400 hover:border-amber-500 hover:text-amber-500 transition-all">
              {diff}
            </button>
          ))}
        </div>

        <!-- Language filters -->
        {languages.length > 0 && (
          <div class="flex flex-wrap items-center gap-2">
            <span class="text-xs font-black uppercase tracking-wider text-slate-400 dark:text-slate-500 mr-2">Lenguaje:</span>
            <button data-lang="all" class="filter-lang px-4 py-2 rounded-lg text-xs font-black uppercase tracking-wider border-2 border-cyan-500 bg-cyan-500 text-white transition-all">
              Todos
            </button>
            {languages.map((lang) => (
              <button data-lang={lang} class="filter-lang px-4 py-2 rounded-lg text-xs font-black uppercase tracking-wider border-2 border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-slate-600 dark:text-slate-400 hover:border-cyan-500 hover:text-cyan-500 transition-all">
                {lang}
              </button>
            ))}
          </div>
        )}
      </div>

      <!-- GRID DE RETOS -->
      <div class="flow-root">
        <ul role="list" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
          {
            sortedChallenges.length > 0 ? (
              sortedChallenges.map((ch) => (
                <li
                  class="list-none retos-item"
                  data-difficulty={ch.data.difficulty || ""}
                  data-languages={(ch.data.languages || []).join(",")}
                >
                  <Card
                    {...ch.data}
                    href={`/retos/${ch.id.replace(/\.[^/.]+$/, "")}`}
                    accent="amber"
                  />
                </li>
              ))
            ) : (
              <div class="col-span-full">
                <Information section="retos" />
              </div>
            )
          }
        </ul>
      </div>

      <!-- BOTÓN DE ACCESO COMPLETO -->
      {sortedChallenges.length > 6 && (
        <div class="flex justify-center pt-8">
          <a
            href="/retos/1"
            class="group w-fit inline-flex items-center gap-3 border-2 border-slate-900 dark:border-white bg-white dark:bg-slate-900 px-6 sm:px-8 py-3 text-xs sm:text-sm font-black uppercase tracking-widest text-slate-900 dark:text-white transition-all hover:bg-amber-500 hover:border-amber-500 hover:text-white active:bg-amber-500 active:border-amber-500 active:text-white active:translate-y-1 active:shadow-none"
          >
            Ver retos completos
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
      )}
  </section>
</Layout>

<script is:inline>
  (() => {
    let activeDiff = "all";
    let activeLang = "all";

    function applyFilters() {
      document.querySelectorAll(".retos-item").forEach((li) => {
        const diff = li.dataset.difficulty;
        const langs = (li.dataset.languages || "").split(",").filter(Boolean);
        const matchDiff = activeDiff === "all" || diff === activeDiff;
        const matchLang = activeLang === "all" || langs.includes(activeLang);
        li.style.display = matchDiff && matchLang ? "" : "none";
      });
    }

    document.querySelectorAll(".filter-diff").forEach((btn) => {
      btn.addEventListener("click", () => {
        activeDiff = btn.dataset.filter;
        document.querySelectorAll(".filter-diff").forEach((b) => {
          b.classList.remove("border-amber-500", "bg-amber-500", "text-white");
          b.classList.add("border-slate-200", "dark:border-slate-800", "bg-white", "dark:bg-slate-900", "text-slate-600", "dark:text-slate-400");
        });
        btn.classList.remove("border-slate-200", "dark:border-slate-800", "bg-white", "dark:bg-slate-900", "text-slate-600", "dark:text-slate-400");
        btn.classList.add("border-amber-500", "bg-amber-500", "text-white");
        applyFilters();
      });
    });

    document.querySelectorAll(".filter-lang").forEach((btn) => {
      btn.addEventListener("click", () => {
        activeLang = btn.dataset.lang;
        document.querySelectorAll(".filter-lang").forEach((b) => {
          b.classList.remove("border-cyan-500", "bg-cyan-500", "text-white");
          b.classList.add("border-slate-200", "dark:border-slate-800", "bg-white", "dark:bg-slate-900", "text-slate-600", "dark:text-slate-400");
        });
        btn.classList.remove("border-slate-200", "dark:border-slate-800", "bg-white", "dark:bg-slate-900", "text-slate-600", "dark:text-slate-400");
        btn.classList.add("border-cyan-500", "bg-cyan-500", "text-white");
        applyFilters();
      });
    });
  })();
</script>
