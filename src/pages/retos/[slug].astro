---
import { getCollection, render } from "astro:content";
import ChallengesLayout from "@layouts/ChallengesLayout.astro";

// 1. ESTA FUNCIÓN ES OBLIGATORIA Y DEBE LLEVAR "export"
export async function getStaticPaths() {
  const challenges = await getCollection("challenges");

  return challenges.map((entry) => ({
    params: { slug: entry.id.replace(/\.[^/.]+$/, "") },
    props: { entry },
  }));
}

// 2. RECUPERAMOS EL RETO DESDE LAS PROPS
const { entry } = Astro.props;
const { Content } = await render(entry);
---

<ChallengesLayout frontmatter={entry.data} url={Astro.url.pathname}>
  <Content />
</ChallengesLayout>
