---
import Layout from "@layouts/Layout.astro";
import ProjectCard from "@components/ProjectCard.astro";
import { getCollection } from "astro:content";
import { getSortedPosts } from "src/utils";

// 1. Cargamos TODOS los proyectos y los ordenamos por fecha (recientes primero)
const allProjects = await getCollection("myprojects");
const sortedProjects = await getSortedPosts(allProjects);

// 2. Extraemos las categorías únicas (tags) por si quieres filtrar en el futuro
const tags = [...new Set(allProjects.flatMap((p) => p.data.tags))];
---

<Layout title="Portafolio de Proyectos | Fullstack Dev">
  <div class="max-w-6xl mx-auto mt-10 flex justify-around items-start">
    <section
      class="max-w-6xl mx-auto px-4 py-12 md:py-20 space-y-16"
      data-pagefind-ignore
    >
      <header class="space-y-6 pb-10">
        <div class="space-y-2">
          <span class="text-xs text-purple-500 uppercase tracking-[0.4em]">
            Deployment_Archive
          </span>
          <h1
            class="text-4xl md:text-7xl font-black italic uppercase tracking-tighter text-slate-900 dark:text-white transition-colors
          >
            Proyectos_ <span class="
            text-purple-600
            text-purple-500"
          >
            Ejecutados
          </h1>
        </div>
      </header>

      <p
        class="max-w-2xl text-slate-500 text-slate-400 text-sm leading-relaxed"
      >
        Selección de aplicaciones, herramientas de código abierto y experimentos
        técnicos desarrollados con un enfoque en rendimiento y escalabilidad.
      </p>

      <div class="flex flex-wrap gap-2 pt-4">
        {
          tags.map((tag) => (
            <span class="text-xs px-3 py-1 bg-slate-100 bg-white/5   text-slate-600 text-slate-500  rounded-full uppercase">
              {tag}
            </span>
          ))
        }
      </div>
    </section>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {
        sortedProjects.length > 0 ? (
          sortedProjects.map((project) => (
            <div class="project-entry">
              <ProjectCard
                {...project.data}
                id={project.id.replace(/\.[^/.]+$/, "")}
              />
            </div>
          ))
        ) : (
          <div class="col-span-full py-20 text-center border-2 border-dashed  rounded-3xl">
            <p class="text-slate-500 uppercase tracking-widest">
              No_se_encontraron_registros
            </p>
          </div>
        )
      }
    </div>

    <footer class="pt-20 text-center">
      <div
        class="p-10 rounded-3xl bg-gradient-to-br from-purple-600/10 to-transparent border border-purple-500/20"
      >
        <h3
          class="text-xl font-bold text-white mb-2 uppercase italic tracking-tighter"
        >
          ¿Tienes una idea en mente?
        </h3>
        <p class="text-slate-400 text-sm mb-6 max-w-md mx-auto">
          Siempre estoy abierto a colaborar en proyectos de código abierto o
          consultorías técnicas.
        </p>
        <a
          href="mailto:tu-email@ejemplo.com"
          class="inline-block px-8 py-3 bg-purple-600 text-white font-black uppercase text-xs tracking-widest hover:bg-purple-700 transition-all active:scale-95 rounded-lg"
        >
          Iniciar_Contacto
        </a>
      </div>
    </footer>
  </div>
</Layout>

<style>
  /* Animación de cascada para los proyectos */
  .project-entry {
    animation: fadeInUp 0.5s ease-out both;
  }

  /* Retraso progresivo para cada tarjeta (hasta 6) */
  .project-entry:nth-child(1) {
    animation-delay: 0.1s;
  }
  .project-entry:nth-child(2) {
    animation-delay: 0.2s;
  }
  .project-entry:nth-child(3) {
    animation-delay: 0.3s;
  }
  .project-entry:nth-child(4) {
    animation-delay: 0.4s;
  }
  .project-entry:nth-child(5) {
    animation-delay: 0.5s;
  }

  .project-entry:nth-child(6) {
    animation-delay: 0.6s;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
