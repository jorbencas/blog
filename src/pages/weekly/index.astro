---
import Layout from "@layouts/Layout.astro";
import Weekly from "@components/Weekly.astro";
import { getCollection } from "astro:content";

const allWeekly = await getCollection("weeklyPosts");
const sortedWeekly = allWeekly
  .filter((p) => !p.data.draft)
  .sort(
    (a, b) =>
      new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
  );

const featuredWeekly = sortedWeekly[0];
const historyWeekly = sortedWeekly.slice(1);
---

<Layout title="Weekly Tech Recaps | Archivo de Noticias" description="Resúmenes semanales con las noticias más relevantes del mundo tech." section="weekly">
  <section class="max-w-6xl mx-auto space-y-12 py-8 md:py-16" data-pagefind-ignore>
      <!-- CABECERA -->
      <div class="text-center space-y-4 pb-4">
        <span class="text-xs text-cyan-500 uppercase tracking-[0.3em]">SEMANARIO_TECNOLÓGICO</span>
        <h1 class="text-4xl md:text-5xl font-black italic uppercase tracking-tighter text-slate-900 dark:text-white">
          The_Weekly <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-500 to-purple-500">Archive</span>
        </h1>
        <div class="h-1 w-24 bg-cyan-500 mx-auto rounded-full"></div>
        <p class="max-w-2xl mx-auto text-sm sm:text-base text-slate-500 dark:text-slate-400 leading-relaxed">
          Resúmenes semanales con las noticias más relevantes del mundo tech.
        </p>
      </div>

      <!-- DESTACADO -->
      {
        featuredWeekly && (
          <section class="space-y-6">
            <div class="flex items-center gap-2">
              <span class="animate-pulse w-2 h-2 rounded-full bg-red-500" />
              <span class="text-xs font-bold uppercase tracking-widest text-slate-500">
                Última edición disponible
              </span>
            </div>
            <div class="transform scale-[1.02]">
              <Weekly post={featuredWeekly} />
            </div>
          </section>
        )
      }

      <!-- HISTÓRICO -->
      {
        historyWeekly.length > 0 && (
          <section class="space-y-8">
            <h2 class="text-sm font-black uppercase tracking-[0.3em] text-slate-400 border-l-4 border-cyan-500 pl-4">
              Ediciones_Anteriores
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
              {historyWeekly.map((post) => <Weekly post={post} />)}
            </div>
          </section>
        )
      }

      <!-- ESTADO VACÍO -->
      {
        sortedWeekly.length === 0 && (
          <div class="py-20 text-center border-2 border-dashed border-slate-200 dark:border-slate-800 rounded-xl">
            <p class="text-slate-500 dark:text-slate-400 uppercase tracking-widest">
              No hay reportes disponibles todavía...
            </p>
          </div>
        )
      }

      <!-- BOTÓN ARCHIVO COMPLETO -->
      {sortedWeekly.length > 6 && (
        <div class="flex justify-center pt-8">
          <a
            href="/weekly/1"
            class="w-full sm:w-auto group relative inline-flex items-center justify-center gap-3 overflow-hidden px-6 md:px-10 py-3 md:py-4 text-xs font-black uppercase tracking-[0.2em] text-cyan-500 dark:text-cyan-400 transition-all hover:text-white dark:hover:text-gray-900 active:scale-95"
          >
            <span class="absolute inset-0 bg-cyan-500 dark:bg-cyan-400 transition-transform translate-y-full group-hover:translate-y-0 duration-300 ease-out -z-10"></span>
            Ver archivo completo
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition-transform group-hover:translate-x-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
      )}
  </section>
</Layout>
