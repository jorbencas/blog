---
import Layout from "@layouts/Layout.astro";
import Weekly from "@components/Weekly.astro"; // Tu componente neón
import { getCollection } from "astro:content";

const allWeekly = await getCollection("weeklyPosts");
const sortedWeekly = allWeekly
  .filter((p) => !p.data.draft)
  .sort(
    (a, b) =>
      new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
  );

const featuredWeekly = sortedWeekly[0];
const historyWeekly = sortedWeekly.slice(1);
---

<Layout title="Weekly Tech Recaps | Archivo de Noticias">
  <main class="max-w-6xl mx-auto px-4 py-20 font-sans">
    <header class="mb-16 border-b-2 border-slate-100 border-white/5 pb-10">
      <div class="flex items-center gap-3 mb-4">
        <span class="w-12 h-[2px] bg-cyan-500"></span>
        <span
          class="text-xs font-black tracking-[0.3em] text-cyan-500 dark:text-cyan-400 uppercase"
          >Semanario_Tecnológico</span
        >
      </div>
      <h1
        class="text-5xl md:text-7xl font-black uppercase italic tracking-tighter text-slate-900 dark:text-white"
      >
        The_Weekly <span
          class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-500 to-purple-500"
          >Archive</span
        >
      </h1>
    </header>

    {
      featuredWeekly && (
        <section class="mb-20">
          <div class="flex items-center gap-2 mb-6">
            <span class="animate-pulse w-2 h-2 rounded-full bg-red-500" />
            <span class="text-xs font-bold uppercase tracking-widest text-slate-500">
              Última edición disponible
            </span>
          </div>
          <div class="transform scale-[1.02]">
            <Weekly post={featuredWeekly} />
          </div>
        </section>
      )
    }

    <section class="space-y-12">
      <h2
        class="text-xl font-black uppercase italic tracking-widest text-slate-400 border-l-4 border-slate-200 border-white/10 pl-4"
      >
        Ediciones_Anteriores
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {historyWeekly.map((post) => <Weekly post={post} />)}
      </div>
    </section>

    {
      sortedWeekly.length === 0 && (
        <div class="py-20 text-center border-2 border-dashed border-slate-200 border-white/5 rounded-xl">
          <p class="text-slate-500 uppercase tracking-widest">
            No hay reportes disponibles todavía...
          </p>
        </div>
      )
    }
  </main>
</Layout>
