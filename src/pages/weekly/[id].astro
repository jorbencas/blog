---
import { getCollection, render } from "astro:content";
import PostLayout from "@layouts/PostLayout.astro";

export async function getStaticPaths() {
  const weeklyEntries = await getCollection("weeklyPosts");
  return weeklyEntries.map((entry) => ({
    params: { id: entry.id },
    props: { entry, allWeekly: weeklyEntries },
  }));
}

const { entry, allWeekly } = Astro.props;
const { Content, headings, remarkPluginFrontmatter, audioSrc } =
  await render(entry);
---

<PostLayout
  id={0}
  title={entry.data.title}
  description={entry.data.description}
  pubDate={entry.data.pubDate}
  author={entry.data.author}
  image={entry.data.image}
  tags={entry.data.tags}
  headings={headings}
  remarkPluginFrontmatter={remarkPluginFrontmatter}
  audioSrc={audioSrc}
  section="weekly"
  allPosts={allWeekly}
>
  <Content />
</PostLayout>
