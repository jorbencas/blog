---
import Layout from "@layouts/Layout.astro";
import Archive from "@components/Archive.astro";
---

<Layout title="Archivo | Jorge Beneyto Castelló" description="Archivo completo de todos los artículos del blog." section="archive">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-20 space-y-12">

    <!-- HEADER -->
    <div class="text-center space-y-4">
      <span class="text-xs text-cyan-500 uppercase tracking-[0.3em]">ARCHIVO</span>
      <h1 class="text-4xl md:text-5xl font-black italic uppercase tracking-tighter text-slate-900 dark:text-white">
        Todos los artículos
      </h1>
      <div class="h-1 w-24 bg-cyan-500 dark:bg-cyan-400 mx-auto rounded-full"></div>
    </div>

    <!-- ARCHIVE -->
    <Archive />

  </div>
</Layout>
