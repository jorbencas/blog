---
import Layout from "@layouts/Layout.astro";
import VideoExtractor from "@components/toolsmini/VideoExtractor.svelte";
---

<Layout title="Extractor de Frames Online — Mi Blog">
  <div class="max-w-4xl mx-auto py-10 px-4">
    <header class="mb-8 text-center">
      <h1 class="text-3xl font-bold">Herramienta: Extractor de Frames</h1>
      <p class="text-gray-600">
        Sube un vídeo y exporta sus fotogramas en formato JPG o ZIP de forma
        100% local.
      </p>
    </header>

    <VideoExtractor client:load />
  </div>
</Layout>
