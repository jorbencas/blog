---
import Layout from "@layouts/Layout.astro";
import { SOCIAL_LINKS } from "src/consts";
---

<Layout title="Contacto | Jorge Beneyto Castelló" description="Ponte en contacto conmigo por email, redes sociales o el formulario de contacto." section="contact">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-20 space-y-16">

    <!-- HEADER -->
    <div class="text-center space-y-4">
      <span class="text-xs text-cyan-500 uppercase tracking-[0.3em]">CONTACTO</span>
      <h1 class="text-4xl md:text-5xl font-black italic uppercase tracking-tighter text-slate-900 dark:text-white">
        Hablemos
      </h1>
      <div class="h-1 w-24 bg-cyan-500 dark:bg-cyan-400 mx-auto rounded-full"></div>
      <p class="max-w-2xl mx-auto text-sm sm:text-base text-slate-500 dark:text-slate-400 leading-relaxed">
        ¿Tienes una pregunta, sugerencia o quieres colaborar en un proyecto? Escríbeme.
      </p>
    </div>

    <!-- EMAIL DIRECTO -->
    <section class="space-y-6">
      <h2 class="inline-flex items-center gap-2 bg-gradient-to-r from-sky-800 to-cyan-500 dark:from-sky-600 dark:to-cyan-400 px-5 py-2.5 text-xs sm:text-sm font-black uppercase tracking-[0.25em] text-white dark:text-slate-900 shadow-[4px_4px_0px_0px_rgba(6,182,212,0.3)]">
        📧 Email directo
      </h2>
      <a
        href="mailto:jorgebeneytocastello@gmail.com"
        class="flex items-center gap-4 p-5 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 hover:border-cyan-500/50 transition-colors no-underline group"
      >
        <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-sky-800 to-cyan-500 flex items-center justify-center shrink-0">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
            <polyline points="22,6 12,13 2,6"/>
          </svg>
        </div>
        <div>
          <p class="text-sm font-black uppercase tracking-wider text-slate-900 dark:text-white group-hover:text-cyan-600 dark:group-hover:text-cyan-400 transition-colors">jorgebeneytocastello@gmail.com</p>
          <p class="text-xs text-slate-400 dark:text-slate-500 mt-1">Respuesta en 24-48 horas</p>
        </div>
      </a>
    </section>

    <!-- REDES SOCIALES -->
    <section class="space-y-6">
      <h2 class="inline-flex items-center gap-2 bg-gradient-to-r from-purple-800 to-purple-500 dark:from-purple-600 dark:to-purple-400 px-5 py-2.5 text-xs sm:text-sm font-black uppercase tracking-[0.25em] text-white dark:text-slate-900 shadow-[4px_4px_0px_0px_rgba(168,85,247,0.3)]">
        🔗 Redes sociales
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {SOCIAL_LINKS.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-4 p-5 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 hover:border-[var(--brand)] transition-all no-underline group"
            style={`--brand: ${link.color}`}
          >
            <img src={link.icon} alt="" class="w-6 h-6" />
            <div>
              <p class="text-sm font-black uppercase tracking-wider text-slate-900 dark:text-white group-hover:text-[var(--brand)] transition-colors capitalize">{link.label}</p>
              <p class="text-xs text-slate-400 dark:text-slate-500 mt-1 truncate">{link.href.replace("mailto:", "")}</p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- FORMULARIO -->
    <section class="space-y-6">
      <h2 class="inline-flex items-center gap-2 bg-gradient-to-r from-emerald-800 to-emerald-500 dark:from-emerald-600 dark:to-emerald-400 px-5 py-2.5 text-xs sm:text-sm font-black uppercase tracking-[0.25em] text-white dark:text-slate-900 shadow-[4px_4px_0px_0px_rgba(16,185,129,0.3)]">
        ✉️ Mensaje rápido
      </h2>
      <form class="space-y-4 p-6 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900" onsubmit="event.preventDefault(); alert('Gracias por tu mensaje. Pronto te responderé.');">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="name" class="text-xs font-black uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-1 block">Nombre</label>
            <input type="text" id="name" required class="w-full px-4 py-3 rounded-lg border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-800 text-sm text-slate-900 dark:text-white focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500" placeholder="Tu nombre" />
          </div>
          <div>
            <label for="email" class="text-xs font-black uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-1 block">Email</label>
            <input type="email" id="email" required class="w-full px-4 py-3 rounded-lg border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-800 text-sm text-slate-900 dark:text-white focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500" placeholder="tu@email.com" />
          </div>
        </div>
        <div>
          <label for="message" class="text-xs font-black uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-1 block">Mensaje</label>
          <textarea id="message" rows="5" required class="w-full px-4 py-3 rounded-lg border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-800 text-sm text-slate-900 dark:text-white focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500 resize-none" placeholder="Escribe tu mensaje aquí..."></textarea>
        </div>
        <button type="submit" class="px-6 py-3 bg-gradient-to-r from-sky-800 to-cyan-600 text-white font-black uppercase tracking-wider text-sm rounded-lg hover:shadow-lg hover:-translate-y-0.5 active:scale-95 transition-all">
          Enviar mensaje →
        </button>
        <p class="text-xs text-slate-400 dark:text-slate-500">Este formulario es solo visual. Para contactarme, usa el email directo arriba.</p>
      </form>
    </section>

  </div>
</Layout>
