---
import Layout from "@layouts/Layout.astro";
import PreviewPost from "@components/PreviewPost.astro";
import HomeLayout from "@layouts/HomeLayout.astro";
import Information from "@components/Information.astro";
import Archive from "@components/Archive.astro";
import { getSortedPosts } from "src/utils";
import { getCollection } from "astro:content";

const allPosts = await getCollection("posts");
const manualPosts = allPosts.filter((p) => !p.id.includes("auto-news"));
const sortedPosts = await getSortedPosts(manualPosts);

// Limitamos a los 6 más recientes para la vista principal
const displayPosts = sortedPosts.slice(0, 6);
---

<Layout title="Problemas de un desarrollador Web | Bitácora">
 <HomeLayout>
 <section class="space-y-8 md:space-y-12 py-4 md:py-8" data-pagefind-ignore>
 
 <!-- CABECERA -->
 <div class="text-center space-y-2">
 <h2 class="text-2xl sm:text-3xl md:text-4xl font-black uppercase tracking-tighter text-gray-900 dark:text-white transition-colors">
 Últimos artículos
 </h2>
 <div class="h-1 w-16 md:w-20 bg-cyan-500 mx-auto rounded-full"></div>
 </div>

 <!-- GRID PRINCIPAL RESPONSIVE -->
 <!-- grid-cols-1 para móvil, lg:grid-cols-12 para escritorio -->
 <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 xl:gap-12 items-start">
 
 <!-- COLUMNA IZQUIERDA: POSTS (Ocupa todo en móvil, 8/12 en escritorio) -->
 <div class="order-1 lg:col-span-8 w-full">
 {
 displayPosts.length > 0 ? (
 /* 1 columna en móvil, 2 columnas desde tablets (md) */
 <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
 {displayPosts.map((p) => (
 <div class="w-full h-full">
 <PreviewPost post={p} />
 </div>
 ))}
 </div>
 ) : (
 <div class="py-10 md:py-20 text-center">
 <Information />
 </div>
 )
 }
 </div>

 <!-- COLUMNA DERECHA: ARCHIVO (Ocupa todo en móvil, 4/12 en escritorio) -->
 {sortedPosts.length > 0 && (
 <aside class="order-2 lg:col-span-4 mt-4 lg:mt-0 w-full">
 <!-- El 'sticky' solo se activa en pantallas grandes (lg) para no estorbar en móvil -->
 <div class="lg:sticky lg:top-28 space-y-6 md:space-y-8">
 <Archive />

 <!-- Widget de estado: Oculto en móviles pequeños para limpiar la vista -->
 <div class="hidden sm:block p-6 rounded-2xl border border-dashed dark: bg-slate-50/50 dark:bg-slate-900/20 transition-colors text-center">
 <div class="flex items-center justify-center gap-3 mb-2">
 <span class="relative flex h-2 w-2">
 <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-cyan-400 opacity-75"></span>
 <span class="relative inline-flex rounded-full h-2 w-2 bg-cyan-500"></span>
 </span>
 <span class="text-[10px] font-mono uppercase tracking-widest text-slate-500 dark:text-slate-400">
 Sincronización_OK
 </span>
 </div>
 <p class="text-[11px] leading-relaxed text-slate-400 dark:text-slate-500 font-mono italic">
 Base de datos de ingeniería actualizada.
 </p>
 </div>
 </div>
 </aside>
 )}
 </div>

 <!-- BOTÓN DE ACCESO COMPLETO -->
 {sortedPosts.length > 0 && (
 <div class="flex justify-center pt-8 md:pt-12 border-t dark: order-3">
 <a
 href="/posts/1"
 class="w-full sm:w-auto group relative inline-flex items-center justify-center gap-3 overflow-hidden border border-cyan-500 px-6 md:px-10 py-3 md:py-4 text-[10px] md:text-xs font-black uppercase tracking-[0.2em] text-cyan-500 transition-all hover:text-white active:scale-95 dark:border-cyan-400 dark:text-cyan-400 dark:hover:text-gray-900"
 >
 <span class="absolute inset-0 bg-cyan-500 transition-transform translate-y-full group-hover:translate-y-0 duration-300 ease-out dark:bg-cyan-400 -z-10"></span>
 Ver toda la bitácora
 <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition-transform group-hover:translate-x-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
 </svg>
 </a>
 </div>
 )}
 </section>
 </HomeLayout>
</Layout>

<style>
 /* Solo aplicamos la animación si la pantalla es mayor a móvil para evitar saltos visuales raros al cargar */
 @media (min-width: 1024px) {
 aside {
 animation: fadeInRight 0.6s cubic-bezier(0.16, 1, 0.3, 1);
 }
 }

 @keyframes fadeInRight {
 from { opacity: 0; transform: translateX(20px); }
 to { opacity: 1; transform: translateX(0); }
 }
</style>