---
import Layout from "@layouts/Layout.astro";
import PreviewPost from "@components/PreviewPost.astro";
import HomeLayout from "@layouts/HomeLayout.astro";
import Information from "@components/Information.astro";
import Archive from "@components/Archive.astro";
import { getSortedPosts } from "src/utils";
import { getCollection } from "astro:content";

// 1. OBTENCIÓN DE DATOS (Tu lógica original)
const allPosts = await getCollection("posts");
// Filtramos para ignorar las noticias automáticas
const manualPosts = allPosts.filter((p) => !p.id.includes("auto-news"));
// Ordenamos usando tu utilidad personalizada
const sortedPosts = await getSortedPosts(manualPosts);

// Limitamos a los 6 más recientes para la vista principal
const displayPosts = sortedPosts.slice(0, 6);
---

<Layout title="Problemas de un desarrollador Web | Bitácora">
  <HomeLayout>
    <section class="space-y-12 py-8">
      
      <!-- CABECERA DE SECCIÓN -->
      <div class="text-center space-y-2">
        <h2 class="text-3xl md:text-4xl font-black uppercase tracking-tighter text-gray-900 dark:text-white transition-colors">
          Últimos artículos
        </h2>
        <div class="h-1.5 w-20 bg-cyan-500 mx-auto rounded-full"></div>
      </div>

      <!-- GRID PRINCIPAL: 12 COLUMNAS -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 xl:gap-16 items-start">
        
        <!-- COLUMNA IZQUIERDA: LISTA DE POSTS (Ocupa 8/12) -->
        <div class={`${sortedPosts.length > 0 ? "lg:col-span-8" : "lg:col-span-12"} flow-root`}>
          {
            sortedPosts.length > 0 ? (
              <ul role="list" class="grid grid-cols-1 md:grid-cols-2 gap-y-12 gap-x-8">
                {displayPosts.map((p) => (
                  <li class="list-none">
                    <PreviewPost post={p} />
                  </li>
                ))}
              </ul>
            ) : (
              <div class="py-20">
                <Information />
              </div>
            )
          }
        </div>

        <!-- COLUMNA DERECHA: ARCHIVO Y NAVEGACIÓN (Ocupa 4/12) -->
        {sortedPosts.length > 0 && (
          <aside class="lg:col-span-4 mt-12 lg:mt-0">
            <div class="sticky top-28 space-y-8">
              <!-- El componente que acabamos de crear -->
              <Archive />

              <!-- Widget de estado opcional para rellenar el sidebar -->
              <div class="hidden lg:block p-6 rounded-2xl border border-dashed border-slate-200 dark:border-white/10 bg-slate-50/50 dark:bg-transparent transition-colors">
                <div class="flex items-center gap-3 mb-2">
                  <span class="relative flex h-2 w-2">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-cyan-400 opacity-75"></span>
                    <span class="relative inline-flex rounded-full h-2 w-2 bg-cyan-500"></span>
                  </span>
                  <span class="text-[10px] font-mono uppercase tracking-widest text-slate-500 dark:text-slate-400">
                    Sincronización_OK
                  </span>
                </div>
                <p class="text-[11px] leading-relaxed text-slate-400 dark:text-slate-500 font-mono">
                  Explora el histórico completo de protocolos y desafíos técnicos documentados.
                </p>
              </div>
            </div>
          </aside>
        )}
      </div>

      <!-- BOTÓN DE ACCESO A LA BITÁCORA COMPLETA -->
      {sortedPosts.length > 0 && (
        <div class="flex justify-center pt-12 border-t border-slate-100 dark:border-white/5">
          <a
            href="/posts/1"
            class="group relative inline-flex items-center gap-3 overflow-hidden border border-cyan-500 px-10 py-4 text-xs font-black uppercase tracking-[0.2em] text-cyan-500 transition-all hover:text-white active:scale-95 dark:border-cyan-400 dark:text-cyan-400 dark:hover:text-gray-900"
          >
            <!-- Efecto de fondo al hacer hover -->
            <span class="absolute inset-0 bg-cyan-500 transition-transform translate-y-full group-hover:translate-y-0 duration-300 ease-out dark:bg-cyan-400 -z-10"></span>
            
            Ver toda la bitácora
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition-transform group-hover:translate-x-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
      )}

    </section>
  </HomeLayout>
</Layout>

<style>
  /* Suavizado de la entrada del sidebar */
  aside {
    animation: fadeInRight 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes fadeInRight {
    from { opacity: 0; transform: translateX(20px); }
    to { opacity: 1; transform: translateX(0); }
  }
</style>