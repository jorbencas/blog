---
import Layout from "@layouts/Layout.astro";
import Card from "@components/Card.astro";
import Information from "@components/Information.astro";
import Archive from "@components/Archive.astro";
import { getSortedPosts } from "src/utils";
import { getCollection } from "astro:content";

const allPosts = await getCollection("posts");
const sortedPosts = await getSortedPosts(allPosts);
const displayPosts = sortedPosts.slice(0, 6);
---

<Layout title="Problemas de un desarrollador Web | Bitácora" description="Problemas, soluciones y reflexiones de un desarrollador web." section="blog">
  <section class="max-w-6xl mx-auto space-y-12 py-8 md:py-16" data-pagefind-ignore>
      <!-- CABECERA -->
      <div class="text-center space-y-4 pb-4">
        <span class="text-xs text-cyan-500 uppercase tracking-[0.3em]">BLOG</span>
        <h1 class="text-4xl md:text-5xl font-black italic uppercase tracking-tighter text-slate-900 dark:text-white">
          Bitácora
        </h1>
        <div class="h-1 w-20 bg-cyan-500 mx-auto rounded-full"></div>
        <p class="max-w-2xl mx-auto text-sm sm:text-base text-slate-500 dark:text-slate-400 leading-relaxed">
          Problemas, soluciones y reflexiones de un desarrollador web.
        </p>
      </div>

      <!-- GRID PRINCIPAL -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 xl:gap-12 items-start">
        <!-- COLUMNA IZQUIERDA: POSTS -->
        <div class="order-1 lg:col-span-8 w-full">
          {
            displayPosts.length > 0 ? (
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
                {displayPosts.map((p) => (
                  <div class="w-full h-full">
                    <Card href={`/posts/${p.id}`} {...p.data} accent="cyan" />
                  </div>
                ))}
              </div>
            ) : (
              <div class="py-10 md:py-20 text-center">
                <Information section="posts" />
              </div>
            )
          }
        </div>

        <!-- COLUMNA DERECHA: ARCHIVO -->
        {sortedPosts.length > 0 && (
          <aside class="order-2 lg:col-span-4 mt-4 lg:mt-0 w-full">
            <div class="lg:sticky lg:top-28 space-y-8">
              <Archive />
            </div>
          </aside>
        )}
      </div>

      <!-- BOTÓN DE ACCESO COMPLETO -->
      {sortedPosts.length > 0 && (
        <div class="flex justify-center pt-8 md:pt-12 order-3">
          <a
            href="/posts/1"
            class="group w-fit inline-flex items-center gap-3 border-2 border-slate-900 dark:border-white bg-white dark:bg-slate-900 px-6 sm:px-8 py-3 text-xs sm:text-sm font-black uppercase tracking-widest text-slate-900 dark:text-white transition-all hover:bg-cyan-500 hover:border-cyan-500 hover:text-white active:bg-cyan-500 active:border-cyan-500 active:text-white active:translate-y-1 active:shadow-none"
          >
            Ver toda la bitácora
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
      )}
  </section>
</Layout>

<style>
  @media (min-width: 1024px) {
    aside {
      animation: fadeInRight 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }
  }

  @keyframes fadeInRight {
    from { opacity: 0; transform: translateX(20px); }
    to { opacity: 1; transform: translateX(0); }
  }
</style>
