---
import Layout from '../../layouts/Layout.astro';
import PreviewPost from '../../components/PreviewPost.astro';

interface MarkdownFrontmatter {
  date: number;
}

const allPosts = await Astro.glob<MarkdownFrontmatter>('./*.md');
const sortedPosts = allPosts.sort((a, b) => new Date(b.frontmatter.date).valueOf() - new Date(a.frontmatter.date).valueOf()).reverse();

---

<Layout title="Problemas de un desarollador Web">
	<main>
        <h1>Problemas de un desarollador Web</h1>
		<ul role="list" class="link-card-grid">
			{
				sortedPosts.map( p => 
					<PreviewPost post={p} />
				)
			}
		</ul>
	</main>
</Layout>

<style>
	h2 {
		margin: 0;
		transition: color 0.6s cubic-bezier(0.22, 1, 0.36, 1);
	}

	h2 span {
		display: inline-block;
		transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.link-card-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(24ch, 1fr));
		gap: 1rem;
		padding: 0;
		max-width: 70vw;
	}

	code {
		font-size: 0.875em;
		border: 0.1em solid var(--color-border);
		border-radius: 4px;
		padding: 0.15em 0.25em;
	}

	main {
		margin: auto;
    	padding: 1em;
		max-width: 60vw;
		background: var(--independence);
	}

	.instructions {
		line-height: 1.8;
		margin-bottom: 2rem;
		color: var(--green-sheen);
		padding: 15px;
		border-radius: 25px;
		border :1px solid var(--green-sheen);
	}

	.heart {
		display: inline-block;
		color: #DA62C4;
		animation: heartbeat 3s ease-in-out infinite;
	}

	@keyframes heartbeat {
		0%,
		50%,
		100% {
			transform: scale(1);
		}
		5% {
			transform: scale(1.125);
		}
		10% {
			transform: scale(1.05);
		}
		15% {
			transform: scale(1.25);
		}
	}
</style>
