---
import { getCollection, render } from "astro:content";
import SEO from "@components/SEO.astro";
import PostLayout from "@layouts/PostLayout.astro";
export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;

// 1. Aquí es donde ocurre la magia: render() devuelve el contenido y los metadatos
const { Content, headings, remarkPluginFrontmatter } = await render(post);
const { title, description, tags, author, image, pubDate } = post.data;
---

<SEO title={title} description={description} url={Astro.url.href} />
<PostLayout
  id={post.id}
  title={title}
  description={description}
  tags={tags ?? []}
  author={author}
  image={image}
  pubDate={pubDate}
  headings={headings}
  remarkPluginFrontmatter={remarkPluginFrontmatter}
>
  <Content />
</PostLayout>
