---
import { getCollection, render } from "astro:content";
import SEO from "@components/SEO.astro";
import PostLayout from "@layouts/PostLayout.astro";
export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.[^/.]+$/, "") },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await render(post);
const { title, description, tags, author, image, pubDate, audioSrc } =
  post.data;

let imagenLimpia = image || "/img/default.jpg";
if (!imagenLimpia.startsWith("/") && !imagenLimpia.startsWith("http")) {
  imagenLimpia = `/${imagenLimpia}`;
}
---

<PostLayout
  id={post.id}
  title={title}
  description={description}
  tags={tags ?? []}
  author={author}
  image={imagenLimpia}
  pubDate={pubDate}
  headings={headings}
  remarkPluginFrontmatter={remarkPluginFrontmatter}
  audioSrc={audioSrc}
>
  <Content />
</PostLayout>
