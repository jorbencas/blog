---
import Layout from "@layouts/Layout.astro";
import PreviewPost from "@components/PreviewPost.astro";
import HomeLayout from "@layouts/HomeLayout.astro";
import NextPrevLiks from "@components/NextPrevLiks.astro";
import Information from "@components/Information.astro";

export async function getStaticPaths({ paginate }) {
  const allPosts = await Astro.glob("./*.md");
  const sortedPosts = allPosts.sort(
    (a, b) =>
      new Date(b.frontmatter.date).valueOf() -
      new Date(a.frontmatter.date).valueOf()
  );
  return paginate(sortedPosts, {
    pageSize: 12,
  });
}

const { data, url } = Astro.props.page;
const { prev, next } = url;
---

<Layout title="Problemas de un desarollador Web">
  <HomeLayout>
    <div class="flex justify-between items-start mb-4">
      <h5 class="text-xl font-bold leading-none text-gray-900 dark:text-white">
        Últimos artículos
      </h5>
      <NextPrevLiks next={next} prev={prev} />
    </div>
    <div class="flow-root">
      <ul role="list" class="divide-y divide-gray-700 dark:divide-grey-700">
       {data.length > 0 ? data.map((p) => <PreviewPost post={p} />) : <Information />}
      </ul>
    </div>
  </HomeLayout>
</Layout>
