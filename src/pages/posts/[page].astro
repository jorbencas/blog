---
import Layout from "@layouts/Layout.astro";
import PreviewPost from "@components/PreviewPost.astro";
import HomeLayout from "@layouts/HomeLayout.astro";
import NextPrevLiks from "@components/NextPrevLiks.astro";
import Information from "@components/Information.astro";
import { getSortedPosts } from "src/utils";
import { getCollection } from "astro:content"; // NUEVO IMPORT

export async function getStaticPaths({ paginate }) {
  const allPosts = await getCollection("posts");
  const sortedPosts = await getSortedPosts(allPosts);
  return paginate(sortedPosts, {
    pageSize: 12,
  });
}

const { page } = Astro.props;
const { data, url, currentPage } = page;
const { prev, next } = url;
---

<Layout
  title={`Blog de desarrollo web - Página ${currentPage}`}
  description="Artículos sobre desarrollo web y programación"
>
  <HomeLayout>
    <div class="flex justify-between items-start">
      <h5 class="text-xl font-bold leading-none text-gray-900 dark:text-white">
        Últimos artículos
      </h5>
      <NextPrevLiks
        nextURL={next}
        prevURL={prev}
        textNext="Ateriores"
        textPrev="Posteriores"
      />
    </div>
    <div class="flow-root">
      <ul role="list">
        {
          data.length > 0 ? (
            data.flatMap((p) => <PreviewPost post={p} />)
          ) : (
            <Information />
          )
        }
      </ul>
    </div>
  </HomeLayout>
</Layout>
