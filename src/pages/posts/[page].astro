---
import Layout from "@layouts/Layout.astro";
import PreviewPost from "@components/PreviewPost.astro";
import Tags from "@components/Tags.astro";
import Archive from "@components/Archive.astro";

export async function getStaticPaths({ paginate }) {
  const allPosts = await Astro.glob("./*.md");
  const sortedPosts = allPosts.sort(
    (a, b) =>
      new Date(b.frontmatter.date).valueOf() -
      new Date(a.frontmatter.date).valueOf()
  );
  return paginate(sortedPosts, {
    pageSize: 12,
  });
}

const { page } = Astro.props;
const posts = page.data;
let next = page.url.next;
let prev = page.url.prev;
---

<Layout title="Problemas de un desarollador Web">
  <div class="grid grid-cols-2 align-center items-start sm:mt-8">
    <div class="col-span-1 ml-4">
      <div class="sm:py-4 sm:px-4 w-full max-w-md sm:p-0 dark:bg-gray-800">
        <div class="flex justify-between items-center mb-4">
          <h5
            class="text-xl font-bold leading-none text-gray-900 dark:text-white"
          >
            Últimos artículos
          </h5>

          <ul class="flex justify-between items-center mb-4">
            {
              next && (
                <li class="mx-2">
                  <a
                    class="text-sm font-medium text-cyan-400 hover:underline dark:text-cyan-500"
                    href={next}
                  >
                    Posteriores
                  </a>
                </li>
              )
            }
            {
              prev && (
                <li class="mx-2">
                  <a
                    class="text-sm font-medium text-cyan-400 hover:underline dark:text-cyan-500"
                    href={prev}
                  >
                    Ateriores
                  </a>
                </li>
              )
            }
          </ul>
        </div>
        <div class="flow-root">
          <ul role="list" class="divide-y divide-gray-700 dark:divide-grey-700">
            {posts.map((p) => <PreviewPost post={p} />)}
          </ul>
        </div>
      </div>
    </div>
    <div class="col-span-1 mr-4">
      <Tags />
      <Archive />
    </div>
  </div>
</Layout>
