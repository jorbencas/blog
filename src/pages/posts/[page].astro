---
import Layout from "@layouts/Layout.astro";
import PreviewPost from "@components/PreviewPost.astro";
import HomeLayout from "@layouts/HomeLayout.astro";
import NextPrevLiks from "@components/NextPrevLiks.astro";
import Information from "@components/Information.astro";
import { getSortedPosts } from "src/utils";

export async function getStaticPaths({ paginate }) {
  const allPosts = await Astro.glob("./*.md");
  const sortedPosts = await getSortedPosts(allPosts);
  return paginate(sortedPosts, {
    pageSize: 3,
  });
}

const { data, url } = Astro.props.page;
const { prev, next } = url;
---

<Layout title="Problemas de un desarollador Web">
  <HomeLayout>
    <div class="flex justify-between items-start">
      <h5 class="text-xl font-bold leading-none text-gray-900 dark:text-white">
        Últimos artículos
      </h5>
      <NextPrevLiks nextURL={next} prevURL={prev} textNext='Ateriores' textPrev='Posteriores' />
    </div>
    <div class="flow-root">
      <ul role="list">
        {
          data.length > 0 ? (
            data.map((p) => <PreviewPost post={p} />)
          ) : (
            <Information />
          )
        }
      </ul>
    </div>
  </HomeLayout>
</Layout>
