---
import Layout from "@layouts/Layout.astro";
import Card from "@components/Card.astro";
import NextPrevLinks from "@components/NextPrevLinks.astro";
import Information from "@components/Information.astro";
import { getSortedPosts } from "src/utils";
import { getCollection } from "astro:content";

export async function getStaticPaths({ paginate }) {
  const allPosts = await getCollection("posts");
  const sortedPosts = await getSortedPosts(allPosts);
  return paginate(sortedPosts, {
    pageSize: 12, // Mantenemos tus 12 posts por página
  });
}

const { page } = Astro.props;
const { data, url, currentPage } = page;
const { prev, next } = url;
---

<Layout
  title={`Blog de desarrollo web - Página ${currentPage}`}
  description="Artículos sobre desarrollo web y programación"
  section="blog"
>
  <section class="max-w-6xl mx-auto space-y-12 py-8 md:py-16" data-pagefind-ignore>
      <!-- CABECERA -->
      <div class="text-center space-y-2">
        <h1
          class="text-3xl md:text-4xl font-black uppercase tracking-tighter text-slate-900 dark:text-white transition-colors"
        >
          Bitácora <span
            class="text-cyan-500 dark:text-cyan-400 text-xl md:text-2xl align-top italic"
            >Pg.{currentPage}</span
          >
        </h1>
        <div class="h-1.5 w-20 bg-cyan-500 mx-auto rounded-full"></div>
      </div>

      <!-- GRID DE POSTS -->
      <div class="flow-root">
        <ul role="list" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
          {
            data.length > 0 ? (
              data.map((p) => (
                <li class="list-none h-full">
                  <Card href={`/posts/${p.id}`} {...p.data} accent="cyan" />
                </li>
              ))
            ) : (
              <div class="col-span-full py-20 text-center">
                <Information section="posts" />
              </div>
            )
          }
        </ul>
      </div>

      <!-- NAVEGACIÓN (Next/Prev) -->
      <div class="pt-12 order-3">
        <NextPrevLinks
          nextURL={next}
          prevURL={prev}
          textNext="Anteriores"
          textPrev="Posteriores"
        />
      </div>
  </section>
</Layout>


