---
import Layout from "@layouts/Layout.astro";
import HomeLayout from "@layouts/HomeLayout.astro";
import PreviewPost from "@components/PreviewPost.astro";
import ChallengeCard from "@components/ChallengeCard.astro";
import { getSortedPosts } from "../utils";
import { getCollection } from "astro:content";

// 1. Cargamos Posts y filtramos los automáticos
const allPosts = await getCollection("posts");
const manualPosts = allPosts.filter((p) => !p.id.includes("auto-news"));
const sortedPosts = await getSortedPosts(manualPosts);
const latestPosts = sortedPosts.slice(0, 6);

// 2. Cargamos Retos y filtramos (opcionalmente) los automáticos
const allChallenges = await getCollection("challenges");
// Filtro de seguridad: solo retos que no estén en carpetas de auto-generación si así lo deseas
const manualChallenges = allChallenges.filter(
  (c) => !c.id.includes("auto-challenges")
);

const sortedChallenges = manualChallenges.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const latestChallenges = sortedChallenges.slice(0, 3);
---

<Layout title="Code_Nexus | Desafíos y Bitácora">
  <HomeLayout>
    <section
      class="relative py-12 md:py-20 text-center space-y-8 overflow-hidden bg-grid-cyber rounded-3xl border border-white/5 mb-16"
    >
      <div class="absolute inset-0 hero-glow -z-10"></div>

      <div class="space-y-4 relative z-10">
        <h1
          class="text-6xl md:text-8xl font-black italic uppercase tracking-tighter text-white"
        >
          Code<span class="text-cyan-500">_Nexus</span>
        </h1>
        <p class="text-slate-400 font-mono text-sm uppercase tracking-[0.4em]">
          Desafíos de ingeniería & Bitácora de desarrollo
        </p>
      </div>

      <div class="max-w-2xl mx-auto relative group px-6">
        <div
          class="absolute -inset-1 bg-gradient-to-r from-cyan-500 to-sky-800 rounded-lg blur opacity-25 group-hover:opacity-50 transition duration-1000"
        >
        </div>
        <div
          class="relative bg-slate-900 rounded-lg border border-white/10 p-2 flex items-center gap-4"
        >
          <span class="pl-4 text-cyan-500 font-mono text-lg font-bold">>></span>
          <input
            id="main-search"
            type="text"
            placeholder="Buscar protocolos, retos o tags..."
            class="bg-transparent border-none focus:ring-0 text-white font-mono text-sm w-full placeholder:text-slate-600 outline-none"
          />
        </div>
      </div>
    </section>

    <div class="space-y-24">
      <section class="space-y-8">
        <div
          class="flex items-end justify-between border-b border-white/10 pb-4"
        >
          <div>
            <span
              class="text-[10px] font-mono text-cyan-500 uppercase tracking-[0.3em]"
              >Nuevas Misiones</span
            >
            <h2
              class="text-3xl font-black italic uppercase tracking-tighter text-white"
            >
              Challenge_Laboratory
            </h2>
          </div>
          <a
            href="/retos"
            class="text-xs font-bold uppercase tracking-widest text-slate-500 hover:text-cyan-400 transition-colors"
          >
            Ver todos los retos →
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {
            latestChallenges.length > 0 ? (
              latestChallenges.map((ch) => (
                <div class="card-searchable h-full">
                  <ChallengeCard
                    href={`/retos/${ch.slug}`}
                    title={ch.data.title}
                    description={ch.data.description}
                    image={ch.data.image}
                    difficulty={ch.data.difficulty}
                  />
                </div>
              ))
            ) : (
              <p class="text-slate-500 italic font-mono col-span-full text-center py-10">
                No hay retos disponibles.
              </p>
            )
          }
        </div>
      </section>

      <section class="space-y-8">
        <div
          class="flex items-end justify-between border-b border-white/10 pb-4"
        >
          <div>
            <span
              class="text-[10px] font-mono text-slate-500 uppercase tracking-[0.3em]"
              >Últimas Entradas</span
            >
            <h2
              class="text-3xl font-black italic uppercase tracking-tighter text-white"
            >
              Dev_Log / Blog
            </h2>
          </div>
          <a
            href="/posts"
            class="text-xs font-bold uppercase tracking-widest text-slate-500 hover:text-white transition-colors"
          >
            Ir a la bitácora →
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {
            latestPosts.map((p) => (
              <div class="card-searchable h-full">
                <PreviewPost post={p} />
              </div>
            ))
          }
        </div>
      </section>
    </div>
  </HomeLayout>
</Layout>

<style>
  /* Animación sutil de fondo */
  .bg-grid-cyber {
    background-size: 40px 40px;
    background-image: linear-gradient(
        to right,
        rgba(6, 182, 212, 0.05) 1px,
        transparent 1px
      ),
      linear-gradient(to bottom, rgba(6, 182, 212, 0.05) 1px, transparent 1px);
  }

  .hero-glow {
    background: radial-gradient(
      circle at center,
      rgba(6, 182, 212, 0.15) 0%,
      transparent 70%
    );
  }
</style>

<script>
  // Selección precisa para evitar bugs
  const searchInput = document.getElementById(
    "main-search"
  ) as HTMLInputElement;
  const cards = document.querySelectorAll(".card-searchable");

  searchInput?.addEventListener("input", (e) => {
    const searchTerm = (e.target as HTMLInputElement).value.toLowerCase();

    cards.forEach((card) => {
      // Buscamos dentro de los h3 y p de cada tarjeta
      const title = card.querySelector("h3")?.textContent?.toLowerCase() || "";
      const description =
        card.querySelector("p")?.textContent?.toLowerCase() || "";

      if (title.includes(searchTerm) || description.includes(searchTerm)) {
        (card as HTMLElement).style.display = "block";
      } else {
        (card as HTMLElement).style.display = "none";
      }
    });
  });
</script>
