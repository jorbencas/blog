---
import Layout from "@layouts/Layout.astro";
import Card from "@components/Card.astro";
import { getSortedPosts } from "src/utils";
import { getCollection } from "astro:content";
import Weekly from "@components/Weekly.astro";
import { SOCIAL_LINKS, SITE_DESCRIPTION } from "src/consts";

const allPosts = await getCollection("posts");
const sortedPosts = await getSortedPosts(allPosts);
const latestPosts = sortedPosts.slice(0, 7);
const featuredPost = sortedPosts.length > 0 ? sortedPosts[0] : null;
const remainingPosts = latestPosts.slice(1);

const allChallenges = await getCollection("auto-challenges");
const challengesPosts = await getSortedPosts(allChallenges);
const latestChallenges = challengesPosts.slice(0, 6);

const firstPostDate =
  sortedPosts.length > 0
    ? sortedPosts[sortedPosts.length - 1].data.pubDate
    : new Date();
const daysSinceFirstPost = Math.floor(
  (Date.now() - new Date(firstPostDate).getTime()) / (1000 * 60 * 60 * 24)
);

const allProjects = await getCollection("myprojects");
const listProjects = await getSortedPosts(allProjects);
const latestProjects = listProjects.slice(0, 6);

const allTools = await getCollection("tools");
const listTools = await getSortedPosts(allTools);
const latestTools = listTools.slice(0, 6);

const allWeeklyPosts = await getCollection("weeklyPosts");
const listWeeklyPosts = await getSortedPosts(allWeeklyPosts);
const latest6Weekly = listWeeklyPosts.slice(0, 6);

const linkBase =
  "group relative text-xs font-black uppercase tracking-[0.2em] italic transition-colors w-fit";

const sectionBadge =
  "inline-flex items-center gap-2 bg-gradient-to-r from-sky-800 to-cyan-500 dark:from-sky-600 dark:to-cyan-400 px-5 py-2.5 text-xs sm:text-sm font-black uppercase tracking-[0.25em] text-white dark:text-slate-900 shadow-[4px_4px_0px_0px_rgba(6,182,212,0.3)]";

const badgeProyectos =
  "inline-flex items-center gap-2 bg-gradient-to-r from-purple-800 to-purple-500 dark:from-purple-600 dark:to-purple-400 px-5 py-2.5 text-xs sm:text-sm font-black uppercase tracking-[0.25em] text-white dark:text-slate-900 shadow-[4px_4px_0px_0px_rgba(168,85,247,0.3)]";

const badgeHerramientas =
  "inline-flex items-center gap-2 bg-gradient-to-r from-emerald-800 to-emerald-500 dark:from-emerald-600 dark:to-emerald-400 px-5 py-2.5 text-xs sm:text-sm font-black uppercase tracking-[0.25em] text-white dark:text-slate-900 shadow-[4px_4px_0px_0px_rgba(16,185,129,0.3)]";

const badgeAmber =
  "inline-flex items-center gap-2 bg-gradient-to-r from-amber-800 to-amber-500 dark:from-amber-600 dark:to-amber-400 px-5 py-2.5 text-xs sm:text-sm font-black uppercase tracking-[0.25em] text-white dark:text-slate-900 shadow-[4px_4px_0px_0px_rgba(245,158,11,0.3)]";

const badgeYellow =
  "inline-flex items-center gap-2 bg-gradient-to-r from-yellow-600 to-yellow-400 dark:from-yellow-600 dark:to-yellow-400 px-5 py-2.5 text-xs sm:text-sm font-black uppercase tracking-[0.25em] text-white dark:text-slate-900 shadow-[4px_4px_0px_0px_rgba(234,179,8,0.3)]";

const stickers = [
  {
    name: "html",
    pos: "top: 0%; right: 10px;",
    rot: "5deg",
    c: "#06b6d4",
    d: "0s",
  },
  {
    name: "python",
    pos: "top: 8%; right: 120px;",
    rot: "-4deg",
    c: "#10b981",
    d: "0.3s",
  },
  {
    name: "js",
    pos: "top: 22%; right: 55px;",
    rot: "-6deg",
    c: "#f59e0b",
    d: "0.6s",
  },
  {
    name: "git",
    pos: "top: 34%; right: 150px;",
    rot: "3deg",
    c: "#a855f7",
    d: "0.9s",
  },
  {
    name: "ts",
    pos: "top: 44%; right: 20px;",
    rot: "7deg",
    c: "#22d3ee",
    d: "1.2s",
  },
  {
    name: "docker",
    pos: "top: 56%; right: 75px;",
    rot: "-2deg",
    c: "#34d399",
    d: "1.5s",
  },
];
---

<Layout title="Blog | Jorge Beneyto Castelló" section="home">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 mt-10 sm:mt-20">
    <!-- HERO -->
    <section class="relative mb-20 md:mb-32">
      <!-- Circuit board background -->
      <div
        class="absolute inset-0 z-0 pointer-events-none select-none circuit-bg"
        aria-hidden="true"
      >
        <div
          class="absolute inset-0"
          style="background: radial-gradient(ellipse at 20% 30%, rgba(6,182,212,0.18) 0%, transparent 50%), radial-gradient(ellipse at 75% 25%, rgba(168,85,247,0.12) 0%, transparent 45%), radial-gradient(ellipse at 55% 80%, rgba(245,158,11,0.08) 0%, transparent 40%);"
        >
        </div>
      </div>
      <!-- Desktop sticker cloud -->
      <div
        class="hidden md:block absolute inset-0 pointer-events-none select-none z-10"
      >
        {
          stickers.map((s) => (
            <div
              class="sticker-float absolute flex items-center justify-center w-[88px] h-[88px] xl:w-[100px] xl:h-[100px] rounded-2xl bg-white dark:bg-slate-900 border-2 shadow-lg"
              style={`${s.pos} border-color: ${s.c}; --r: ${s.rot}; --gc: ${s.c}40; animation: float 4s ease-in-out ${s.d} infinite;`}
            >
              <img
                src={`/icons/${s.name}.svg`}
                alt={s.name}
                class="w-10 h-10 xl:w-12 xl:h-12"
              />
            </div>
          ))
        }
      </div>

      <div class="flex flex-col gap-6 relative z-10 lg:max-w-xl xl:max-w-2xl">
        <h1
          class="text-3xl sm:text-5xl md:text-5xl font-black uppercase italic tracking-tighter leading-[1.1]"
        >
          <span
            class="bg-clip-text text-transparent bg-gradient-to-r from-sky-800 to-cyan-500 dark:from-sky-400 dark:to-cyan-300"
            >Problemas de un<br />desarrollador Web</span
          >
        </h1>
        <p
          class="text-lg sm:text-xl text-slate-500 dark:text-slate-400 max-w-2xl leading-relaxed font-medium"
        >
          {SITE_DESCRIPTION}
        </p>
        <p
          class="flex items-center gap-1.5 text-sm text-slate-400 dark:text-slate-500 font-medium"
        >
          Llevo <strong
            class="streak-number text-slate-600 dark:text-slate-300 tabular-nums"
            >{daysSinceFirstPost}</strong
          > días escribiendo
        </p>
        <div class="flex flex-wrap gap-3 items-center mt-2">
          {
            SOCIAL_LINKS.slice(0, 5).map((link) => (
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-2 px-4 py-2 rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-xs font-black uppercase tracking-wider text-slate-600 dark:text-slate-400 hover:border-[var(--brand)] hover:text-[var(--brand)] dark:hover:text-[var(--brand)] transition-all no-underline"
                style={`--brand: ${link.color}`}
              >
                <img src={link.icon} alt="" class="w-4 h-4" />
                {link.label}
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- STATS BAR -->
    <div
      class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4 mb-20 md:mb-32"
    >
      {
        [
          {
            label: "Proyectos",
            count: allProjects.length,
            accent: "text-purple-600 dark:text-purple-500",
          },
          {
            label: "Artículos",
            count: allPosts.length,
            accent: "text-cyan-600 dark:text-cyan-500",
          },
          {
            label: "Retos",
            count: allChallenges.length,
            accent: "text-amber-600 dark:text-amber-500",
          },
          {
            label: "Herramientas",
            count: allTools.length,
            accent: "text-emerald-600 dark:text-emerald-400",
          },
          {
            label: "Semanales",
            count: allWeeklyPosts.length,
            accent: "text-yellow-600 dark:text-yellow-500",
          },
        ].map((stat) => (
          <div class="flex flex-col items-center justify-center p-6 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900">
            <span
              class={`text-3xl sm:text-4xl font-black ${stat.accent}`}
            >
              {stat.count}
            </span>
            <span class="text-xs font-black uppercase tracking-widest text-slate-400 dark:text-slate-500 mt-1">
              {stat.label}
            </span>
          </div>
        ))
      }
    </div>

    <div class="space-y-24 md:space-y-32 mb-20">
      <!-- SECCIÓN: PROYECTOS -->
      <section class="space-y-10">
        <div
          class="flex flex-col sm:flex-row items-start sm:items-end justify-between gap-3 sm:gap-0"
        >
          <h2 class={badgeProyectos}>💻 Proyectos</h2>
          <a
            href="/proyectos"
            class={`${linkBase} text-slate-400 hover:text-purple-500`}
          >
            Ver portafolio <span
              class="inline-block transition-transform group-hover:translate-x-1"
              >→</span
            >
            <span
              class="absolute bottom-0 left-0 w-0 h-0.5 bg-purple-500 transition-all duration-300 group-hover:w-full"
            ></span>
          </a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {
            latestProjects.map((project) => (
              <Card
                {...project.data}
                href={`/proyectos/${project.id.replace(/\.[^/.]+$/, "")}`}
                accent="purple"
                aspectRatio="video"
                overlay="white"
              />
            ))
          }
        </div>
      </section>

      <!-- SECCIÓN: HERRAMIENTAS -->
      {
        latestTools.length > 0 && (
          <section class="space-y-10">
            <div class="flex flex-col sm:flex-row items-start sm:items-end justify-between gap-3 sm:gap-0">
              <h2 class={badgeHerramientas}>🛠️ Mini Herramientas</h2>
              <a
                href="/herramientas"
                class={`${linkBase} text-slate-400 hover:text-emerald-500`}
              >
                Ver herramientas{" "}
                <span class="inline-block transition-transform group-hover:translate-x-1">
                  →
                </span>
                <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-emerald-500 transition-all duration-300 group-hover:w-full" />
              </a>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
              {latestTools.map((tool) => (
                <Card
                  {...tool.data}
                  href={`/herramientas/${tool.id.replace(/\.[^/.]+$/, "")}`}
                  accent="emerald"
                  aspectRatio="video"
                  overlay="white"
                />
              ))}
            </div>
          </section>
        )
      }

      <!-- SECCIÓN: RETOS -->
      <section class="space-y-10">
        <div
          class="flex flex-col sm:flex-row items-start sm:items-end justify-between gap-3 sm:gap-0"
        >
          <h2 class={badgeAmber}>🏆 Retos</h2>
          <a
            href="/retos"
            class={`${linkBase} text-slate-400 hover:text-amber-500`}
          >
            Ver retos <span
              class="inline-block transition-transform group-hover:translate-x-1"
              >→</span
            >
            <span
              class="absolute bottom-0 left-0 w-0 h-0.5 bg-amber-500 transition-all duration-300 group-hover:w-full"
            ></span>
          </a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {
            latestChallenges.map((ch) => (
              <Card
                {...ch.data}
                href={`/retos/${ch.id.replace(/\.[^/.]+$/, "")}`}
                accent="amber"
              />
            ))
          }
        </div>
      </section>

      <!-- SECCIÓN: BLOG -->
      <section class="space-y-10">
        <div
          class="flex flex-col sm:flex-row items-start sm:items-end justify-between gap-3 sm:gap-0"
        >
          <h2 class={sectionBadge}>📝 Últimos Posts</h2>
          <a
            href="/posts"
            class={`${linkBase} text-slate-400 hover:text-cyan-500`}
          >
            Ir a la bitácora <span
              class="inline-block transition-transform group-hover:translate-x-1"
              >→</span
            >
            <span
              class="absolute bottom-0 left-0 w-0 h-0.5 bg-cyan-500 transition-all duration-300 group-hover:w-full"
            ></span>
          </a>
        </div>

        <!-- Featured post -->
        {
          featuredPost && (
            <div class="mb-8">
              <Card
                href={`/posts/${featuredPost.id}`}
                {...featuredPost.data}
                accent="cyan"
              />
            </div>
          )
        }

        <!-- Rest of latest posts -->
        {
          remainingPosts.length > 0 && (
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
              {remainingPosts.map((p) => (
                <Card href={`/posts/${p.id}`} {...p.data} accent="cyan" />
              ))}
            </div>
          )
        }
      </section>

      <!--SECCIÓN WEEKLY-->
      {
        latest6Weekly.length > 0 && (
          <section class="space-y-10">
            <div class="flex flex-col sm:flex-row items-start sm:items-end justify-between gap-3 sm:gap-0">
              <h2 class={badgeYellow}>📰 Resúmenes Semanales</h2>
              <a
                href="/weekly"
                class={`${linkBase} text-slate-400 hover:text-yellow-500`}
              >
                Ver todo el archivo{" "}
                <span class="inline-block transition-transform group-hover:translate-x-1">
                  →
                </span>
                <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-yellow-500 transition-all duration-300 group-hover:w-full" />
              </a>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
              {latest6Weekly.map((weekly, index) => (
                <div class={index === 0 ? "md:col-span-2 lg:col-span-2" : ""}>
                  <Weekly post={weekly} />
                </div>
              ))}
            </div>
          </section>
        )
      }
    </div>
  </div>
</Layout>

<style is:global>
  @keyframes float {
    0%,
    100% {
      transform: translateY(0px) rotate(var(--r, 0deg));
    }
    50% {
      transform: translateY(-12px) rotate(var(--r, 0deg));
    }
  }
  .sticker-float {
    transition: all 0.3s ease;
    will-change: transform;
  }
  .sticker-float:hover {
    box-shadow: 0 20px 25px -5px var(--gc, rgba(0, 0, 0, 0.1));
    filter: brightness(1.1);
  }
  .streak-number {
    animation: pulse-streak 3s ease-in-out infinite;
  }
  @keyframes pulse-streak {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.08);
    }
  }
  .circuit-bg {
    background-image: url("/img/circuit-bg.svg");
    background-size: 304px 304px;
    background-repeat: repeat;
    background-position: 0 0;
  }
</style>
