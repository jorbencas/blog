---
import Layout from "@layouts/Layout.astro";
import PreviewPost from "@components/PreviewPost.astro";
import HomeLayout from "@layouts/HomeLayout.astro";
import Information from "@components/Information.astro";
import { getSortedPosts } from "src/utils";
import { getCollection } from 'astro:content'; // NUEVO IMPORT

const allPosts = await getCollection('posts');
const manualPosts = allPosts.filter(p => !p.file.includes('auto-news'));
const sortedPosts = await getSortedPosts(manualPosts);
---

<Layout title="Problemas de un desarollador Web">
  <HomeLayout>
    <div class="flex justify-between items-start">
      <h5 class="text-xl font-bold text-gray-900 dark:text-white">
        Últimos artículos
      </h5>
      <a
        href="/posts/1"
        class="text-sm font-medium text-cyan-400 hover:underline dark:text-cyan-500"
      >
        ver todos
      </a>
    </div>
    <div class="flow-root">
      <ul role="list">
        {
          sortedPosts.length > 0 ? (
            sortedPosts.slice(0, 5).map((p) => <PreviewPost post={p.data} />)
          ) : (
            <Information />
          )
        }
      </ul>
    </div>
  </HomeLayout>
</Layout>
