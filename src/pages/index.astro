---
import Layout from "@layouts/Layout.astro";
import PreviewPost from "@components/PreviewPost.astro";
import ChallengeCard from "@components/ChallengeCard.astro";
import { getSortedPosts } from "src/utils";
import { getCollection } from "astro:content";

// Lógica de carga (se mantiene igual)
const allPosts = await getCollection("posts");
const manualPosts = allPosts.filter((p) => !p.id.includes("auto-news"));
const sortedPosts = await getSortedPosts(manualPosts);
const latestPosts = sortedPosts.slice(0, 6);

const allChallenges = await getCollection("challenges");
const manualChallenges = allChallenges.filter(
  (c) => !c.id.includes("auto-challenges")
);
const sortedChallenges = manualChallenges.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const latestChallenges = sortedChallenges.slice(0, 3);
---

<Layout title="Code_Nexus | Inicio">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 mt-10">
    <section
      class="relative py-12 md:py-24 text-center overflow-hidden bg-grid-cyber rounded-2xl md:rounded-3xl border border-slate-200 dark:border-white/5 mb-12 md:mb-20 px-4 flex flex-col items-center justify-center w-full transition-colors duration-300"
    >
      <div class="absolute inset-0 hero-glow -z-10"></div>

      <div class="relative z-10 w-full max-w-4xl mx-auto">
        <h1
          class="flex flex-col md:block font-black italic uppercase tracking-tighter leading-[0.85] mb-6 transition-transform duration-500"
        >
          <span
            class="text-[16vw] md:text-8xl lg:text-9xl text-slate-900 dark:text-white"
          >
            Code
          </span>
          <span
            class="text-[16vw] md:text-8xl lg:text-9xl text-cyan-600 dark:text-cyan-500 inline-block md:inline"
          >
            _Nexus
          </span>
        </h1>

        <p
          class="text-slate-500 dark:text-slate-400 font-mono text-[9px] xs:text-[11px] md:text-sm uppercase tracking-[0.2em] md:tracking-[0.4em] max-w-[280px] sm:max-w-none mx-auto mb-10"
        >
          Desafíos de ingeniería <span class="hidden sm:inline">/</span>
          <br class="sm:hidden" />
           Bitácora de desarrollo
        </p>

        <div class="max-w-xl mx-auto relative group w-full px-2">
          <div
            class="absolute -inset-1 bg-gradient-to-r from-cyan-500 to-sky-800 rounded-lg blur opacity-10 dark:opacity-20 group-hover:opacity-30 dark:group-hover:opacity-40 transition duration-1000"
          >
          </div>

          <div
            class="relative bg-white/90 dark:bg-slate-900/90 rounded-lg border border-slate-200 dark:border-white/10 p-2.5 flex items-center gap-3 backdrop-blur-sm transition-all duration-300"
          >
            <span
              class="pl-3 text-cyan-600 dark:text-cyan-500 font-mono font-bold text-lg"
              >>></span
            >

            <input
              id="main-search"
              type="text"
              autofocus
              placeholder="BUSCAR_PROTOCOLO..."
              class="bg-transparent border-none focus:ring-0 text-slate-900 dark:text-white font-mono text-sm w-full placeholder:text-slate-400 dark:placeholder:text-slate-700 outline-none uppercase tracking-widest"
            />
          </div>
        </div>
      </div>
    </section>

    <div class="space-y-16 md:space-y-28">
      <section class="space-y-6 md:space-y-10 px-2 md:px-0">
        <div
          class="flex flex-col md:flex-row md:items-end justify-between gap-4 border-b border-white/10 pb-4 md:pb-6"
        >
          <div class="space-y-1">
            <span
              class="text-[9px] md:text-[10px] font-mono text-cyan-500 uppercase tracking-[0.2em]"
              >Nuevas Misiones</span
            >
            <h2
              class="text-2xl md:text-4xl font-black italic uppercase tracking-tighter text-white"
            >
              Challenge_Laboratory
            </h2>
          </div>
          <a
            href="/retos"
            class="text-[10px] md:text-xs font-bold uppercase tracking-widest text-slate-500 hover:text-cyan-400 transition-colors self-start md:self-auto"
          >
            Ver todos los retos →
          </a>
        </div>

        <div
          class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-10"
        >
          {
            latestChallenges.map((ch) => (
              <div class="card-searchable">
                <ChallengeCard {...ch.data} href={`/retos/${ch.slug}`} />
              </div>
            ))
          }
        </div>
      </section>

      <section class="space-y-6 md:space-y-10 px-2 md:px-0">
        <div
          class="flex flex-col md:flex-row md:items-end justify-between gap-4 border-b border-white/10 pb-4 md:pb-6"
        >
          <div class="space-y-1">
            <span
              class="text-[9px] md:text-[10px] font-mono text-slate-500 uppercase tracking-[0.2em]"
              >Últimas Entradas</span
            >
            <h2
              class="text-2xl md:text-4xl font-black italic uppercase tracking-tighter text-white"
            >
              Dev_Log / Blog
            </h2>
          </div>
          <a
            href="/posts"
            class="text-[10px] md:text-xs font-bold uppercase tracking-widest text-slate-500 hover:text-white transition-colors self-start md:self-auto"
          >
            Ir a la bitácora →
          </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {
            latestPosts.map((p) => (
              <div class="card-searchable">
                <PreviewPost post={p} />
              </div>
            ))
          }
        </div>
      </section>
    </div>
  </div>
</Layout>

<style>
  .bg-grid-cyber {
    background-size: 30px 30px;
    background-image: linear-gradient(
        to right,
        rgba(6, 182, 212, 0.04) 1px,
        transparent 1px
      ),
      linear-gradient(to bottom, rgba(6, 182, 212, 0.04) 1px, transparent 1px);
  }
  @media (min-width: 768px) {
    .bg-grid-cyber {
      background-size: 50px 50px;
    }
  }
  .hero-glow {
    background: radial-gradient(
      circle at center,
      rgba(6, 182, 212, 0.12) 0%,
      transparent 80%
    );
  }

  /* Configuración de la rejilla según el tema */
  .bg-grid-cyber {
    background-size: 30px 30px;
    background-image: linear-gradient(
        to right,
        rgba(6, 182, 212, 0.05) 1px,
        transparent 1px
      ),
      linear-gradient(to bottom, rgba(6, 182, 212, 0.05) 1px, transparent 1px);
  }

  /* El resplandor cambia según el modo para no quemar la vista */
  .hero-glow {
    background: radial-gradient(
      circle at center,
      rgba(6, 182, 212, 0.1) 0%,
      transparent 80%
    );
  }

  /* En pantallas grandes, rejilla más definida */
  @media (min-width: 768px) {
    .bg-grid-cyber {
      background-size: 50px 50px;
    }
  }

  /* Animación suave para la entrada del título */
  h1 {
    animation: reveal 0.8s cubic-bezier(0.77, 0, 0.175, 1);
  }

  @keyframes reveal {
    0% {
      transform: translateY(20px);
      opacity: 0;
    }
    100% {
      transform: translateY(0);
      opacity: 1;
    }
  }
</style>

<script>
  const searchInput = document.getElementById(
    "main-search"
  ) as HTMLInputElement;
  const cards = document.querySelectorAll(".card-searchable");

  searchInput?.addEventListener("input", (e) => {
    const searchTerm = (e.target as HTMLInputElement).value.toLowerCase();
    cards.forEach((card) => {
      const title = card.querySelector("h3")?.textContent?.toLowerCase() || "";
      const description =
        card.querySelector("p")?.textContent?.toLowerCase() || "";
      (card as HTMLElement).style.display =
        title.includes(searchTerm) || description.includes(searchTerm)
          ? "block"
          : "none";
    });
  });
</script>
