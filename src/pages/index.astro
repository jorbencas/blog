---
import Layout from "@layouts/Layout.astro";
import PreviewPost from "@components/PreviewPost.astro";
import HomeLayout from "@layouts/HomeLayout.astro";
import Information from "@components/Information.astro";
import { getSortedPosts } from "src/utils";
import { getCollection } from "astro:content";

const allPosts = await getCollection("posts");
const manualPosts = allPosts.filter((p) => !p.id.includes("auto-news"));
const sortedPosts = await getSortedPosts(manualPosts);
---

<Layout title="Problemas de un desarollador Web">
  <HomeLayout>
    <div class="flex justify-between items-start">
      <h5 class="text-xl font-bold text-gray-900 dark:text-white">
        Últimos artículos
      </h5>
      <a
        href="/posts/1"
        class="inline-block rounded-lg bg-cyan-600 px-5 py-2.5 text-center text-sm font-medium text-white transition-all hover:bg-cyan-700 focus:outline-none focus:ring-4 focus:ring-cyan-300 dark:bg-cyan-500 dark:hover:bg-cyan-600 dark:focus:ring-cyan-800"
      >
        ver todos
      </a>
    </div>
    <div class="flow-root">
      <ul role="list">
        {
          sortedPosts.length > 0 ? (
            sortedPosts.slice(0, 5).flatMap((p) => <PreviewPost post={p} />)
          ) : (
            <Information />
          )
        }
      </ul>
    </div>
  </HomeLayout>
</Layout>
