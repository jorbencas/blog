---
import Layout from "@layouts/Layout.astro";
import Card from "@components/Card.astro";
import { getSortedPosts } from "src/utils";
import { getCollection } from "astro:content";
import Weekly from "@components/Weekly.astro";
const allPosts = await getCollection("posts");
const sortedPosts = await getSortedPosts(allPosts);
const latestPosts = sortedPosts.slice(0, 6);

const allChallenges = await getCollection("auto-challenges");
const challengesPosts = await getSortedPosts(allChallenges);
const latestChallenges = challengesPosts.slice(0, 6);

const allProjects = await getCollection("myprojects");
const listProjects = await getSortedPosts(allProjects);
const latestProjects = listProjects.slice(0, 6);

const allTools = await getCollection("tools");
const listTools = await getSortedPosts(allTools);
const latestTools = listTools.slice(0, 6);

const allWeeklyPosts = await getCollection("weeklyPosts");
const listWeeklyPosts = await getSortedPosts(allWeeklyPosts);
const latest6Weekly = listWeeklyPosts.slice(0, 6);

// Clase base para los enlaces "Ver más"
const linkBase =
  "group relative text-xs font-black uppercase tracking-[0.2em] italic transition-colors sm:pb-1 sm:bg-transparent sm:dark:bg-transparent px-3 py-2.5 sm:px-0 sm:py-0 rounded-lg bg-slate-200 dark:bg-slate-800 w-fit sm:border-0 border border-slate-300 dark:border-slate-700 shadow-sm sm:shadow-none";
---

<Layout title="Blog | Jorge Beneyto Castelló">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 mt-20">
    <div class="space-y-24 md:space-y-32 mb-20">
      <!-- SECCIÓN: PROYECTOS -->
      <section class="space-y-10">
        <div class="flex flex-col sm:flex-row items-start sm:items-end justify-between gap-3 sm:gap-0 pb-6">
          <h2
            class="text-3xl md:text-4xl font-black italic uppercase tracking-tighter text-slate-900 dark:text-white"
          >
            Mis_Proyectos
          </h2>
          <a
            href="/proyectos/1"
            class={`${linkBase} text-slate-400 hover:text-purple-500`}
          >
            Ver portafolio <span
              class="inline-block transition-transform group-hover:translate-x-1"
              >→</span
            >
            <span
              class="absolute bottom-0 left-0 w-0 h-0.5 bg-purple-500 transition-all duration-300 group-hover:w-full"
            ></span>
          </a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {
            latestProjects.map((project) => (
              <Card
                {...project.data}
                href={`/proyectos/${project.id.replace(/\.[^/.]+$/, "")}`}
                accent="purple"
                aspectRatio="video"
                overlay="white"
              />
            ))
          }
        </div>
      </section>

      <!-- SECCIÓN: HERRAMIENTAS -->
      {latestTools.length > 0 && (
        <section class="space-y-10">
          <div class="flex flex-col sm:flex-row items-start sm:items-end justify-between gap-3 sm:gap-0 pb-6">
            <h2
              class="text-3xl md:text-4xl font-black italic uppercase tracking-tighter text-slate-900 dark:text-white"
            >
              Mini_Herramientas
            </h2>
            <a
              href="/herramientas/1"
              class={`${linkBase} text-slate-400 hover:text-emerald-500`}
            >
              Ver herramientas <span
                class="inline-block transition-transform group-hover:translate-x-1"
                >→</span
              >
              <span
                class="absolute bottom-0 left-0 w-0 h-0.5 bg-emerald-500 transition-all duration-300 group-hover:w-full"
              ></span>
            </a>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {
              latestTools.map((tool) => (
                <Card
                  {...tool.data}
                  href={`/herramientas/${tool.id.replace(/\.[^/.]+$/, "")}`}
                  accent="emerald"
                  aspectRatio="video"
                  overlay="white"
                />
              ))
            }
          </div>
        </section>
      )}

      <!-- SECCIÓN: RETOS -->
      <section class="space-y-10">
        <div class="flex flex-col sm:flex-row items-start sm:items-end justify-between gap-3 sm:gap-0 pb-6">
          <h2
            class="text-3xl md:text-4xl font-black italic uppercase tracking-tighter text-slate-900 dark:text-white"
          >
            Retos
          </h2>
          <a
            href="/retos/1"
            class={`${linkBase} text-slate-400 hover:text-cyan-500`}
          >
            Ver retos <span
              class="inline-block transition-transform group-hover:translate-x-1"
              >→</span
            >
            <span
              class="absolute bottom-0 left-0 w-0 h-0.5 bg-cyan-500 transition-all duration-300 group-hover:w-full"
            ></span>
          </a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {
            latestChallenges.map((ch) => (
              <Card
                {...ch.data}
                href={`/retos/${ch.id.replace(/\.[^/.]+$/, "")}`}
                accent="cyan"
              />
            ))
          }
        </div>
      </section>

      <!-- SECCIÓN: BLOG -->
      <section class="space-y-10">
        <div class="flex flex-col sm:flex-row items-start sm:items-end justify-between gap-3 sm:gap-0 pb-6">
          <h2
            class="text-3xl md:text-4xl font-black italic uppercase tracking-tighter text-slate-900 dark:text-white"
          >
            Últimos_Posts
          </h2>
          <a
            href="/posts/1"
            class={`${linkBase} text-slate-400 hover:text-slate-900 dark:hover:text-white`}
          >
            Ir a la bitácora <span
              class="inline-block transition-transform group-hover:translate-x-1"
              >→</span
            >
            <span
              class="absolute bottom-0 left-0 w-0 h-0.5 bg-slate-900 dark:bg-white transition-all duration-300 group-hover:w-full"
            ></span>
          </a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {latestPosts.map((p) => <Card href={`/posts/${p.id}`} {...p.data} accent="cyan" />)}
        </div>
      </section>

      <!--SECCIÓN WEEKLY-->
      {latest6Weekly.length > 0 && (
        <section class="space-y-10">
          <div class="flex flex-col sm:flex-row items-start sm:items-end justify-between gap-3 sm:gap-0 pb-6 border-b border-slate-100 dark:border-white/5">
            <h2 class="text-3xl md:text-4xl font-black italic uppercase tracking-tighter text-slate-900 dark:text-white">
              Resúmenes_Semanales
            </h2>
            <a
              href="/weekly/1"
              class={`${linkBase} text-slate-400 hover:text-cyan-500`}
            >
              Ver todo el archivo <span
                class="inline-block transition-transform group-hover:translate-x-1"
                >→</span
              >
              <span
                class="absolute bottom-0 left-0 w-0 h-0.5 bg-cyan-500 transition-all duration-300 group-hover:w-full"
              ></span>
            </a>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {latest6Weekly.map((weekly, index) => (
              <div class={index === 0 ? "md:col-span-2 lg:col-span-2" : ""}>
                <Weekly post={weekly} />
              </div>
            ))}
          </div>
        </section>
      )}
    </div>
  </div>
</Layout>
