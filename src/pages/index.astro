---
import Layout from "@layouts/Layout.astro";
import PreviewPost from "@components/PreviewPost.astro";
import ChallengeCard from "@components/ChallengeCard.astro";
import ProjectCard from "@components/ProjectCard.astro"; 
import { getSortedPosts } from "src/utils";
import { getCollection } from "astro:content";

const allPosts = await getCollection("posts");
const manualPosts = allPosts.filter((p) => !p.id.includes("auto-news"));
const sortedPosts = await getSortedPosts(manualPosts);
const latestPosts = sortedPosts.slice(0, 3);

const allChallenges = await getCollection("challenges");
const manualChallenges = allChallenges.filter((c) => !c.id.includes("auto-challenges"));
const latestChallenges = manualChallenges
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const allProjects = await getCollection("myprojects");
const latestProjects = allProjects
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<Layout title="Inicio | Portfolio">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 mt-20">
    <div class="space-y-24 md:space-y-32 mb-20">
      
      <section class="space-y-10">
        <div class="flex items-end justify-between border-b border-slate-200 dark:border-white/10 pb-6">
          <h2 class="text-3xl md:text-4xl font-black italic uppercase tracking-tighter text-slate-900 dark:text-white">
            My_Projects
          </h2>
          <a href="/proyectos/1" class="text-xs font-bold uppercase tracking-widest text-slate-400 hover:text-purple-500 transition-colors">
            Ver portafolio →
          </a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {latestProjects.map((project) => (
             <ProjectCard {...project.data} id={project.id.replace(/\.[^/.]+$/, "")} />
          ))}
        </div>
      </section>

      <section class="space-y-10">
        <div class="flex items-end justify-between border-b border-slate-200 dark:border-white/10 pb-6">
          <h2 class="text-3xl md:text-4xl font-black italic uppercase tracking-tighter text-slate-900 dark:text-white">
            Challenges
          </h2>
          <a href="/retos/1" class="text-xs font-bold uppercase tracking-widest text-slate-400 hover:text-cyan-500 transition-colors">
            Ver retos →
          </a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {latestChallenges.map((ch) => (
            <ChallengeCard {...ch.data} href={`/retos/${ch.id.replace(/\.[^/.]+$/, "")}`} />
          ))}
        </div>
      </section>

      <section class="space-y-10">
        <div class="flex items-end justify-between border-b border-slate-200 dark:border-white/10 pb-6">
          <h2 class="text-3xl md:text-4xl font-black italic uppercase tracking-tighter text-slate-900 dark:text-white">
            Latest_Posts
          </h2>
          <a href="/posts/1" class="text-xs font-bold uppercase tracking-widest text-slate-400 hover:text-slate-900 dark:hover:text-white transition-colors">
            Ir a la bitácora →
          </a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {latestPosts.map((p) => (
            <PreviewPost post={p} />
          ))}
        </div>
      </section>
    </div>
  </div>
</Layout>