---
import Layout from "@layouts/Layout.astro";
import PreviewPost from "@components/PreviewPost.astro";
import HomeLayout from "@layouts/HomeLayout.astro";
import Information from "@components/Information.astro";
import { getSortedPosts } from "src/utils";
import { getCollection } from "astro:content";

const allPosts = await getCollection("posts");
const manualPosts = allPosts.filter((p) => !p.id.includes("auto-news"));
const sortedPosts = await getSortedPosts(manualPosts);
---

<Layout title="Problemas de un desarollador Web">
  <HomeLayout>
    <div class="flex justify-between items-start">
      <h5 class="text-xl font-bold text-gray-900 dark:text-white">
        Últimos artículos
      </h5>
      <a
        href="/posts/1"
        class="inline-block rounded-lg border border-cyan-500 px-5 py-2 text-sm font-medium text-cyan-500 transition-all hover:bg-cyan-500 hover:text-white active:scale-95 dark:border-cyan-400 dark:text-cyan-400 dark:hover:bg-cyan-400 dark:hover:text-gray-900"
      >
        ver todos
      </a>
    </div>
    <div class="flow-root">
      <ul role="list" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {
          sortedPosts.length > 0 ? (
            sortedPosts.slice(0, 5).flatMap((p) => <PreviewPost post={p} />)
          ) : (
            <Information />
          )
        }
      </ul>
    </div>
  </HomeLayout>
</Layout>
