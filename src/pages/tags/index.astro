---
import Layout from "@layouts/Layout.astro";
import { getCollection } from "astro:content";

const allPosts = await getCollection("posts");
const allChallenges = await getCollection("auto-challenges");

const allTags = [
  ...new Set([
    ...allPosts.flatMap((p) => p.data.tags),
    ...allChallenges.flatMap((c) => c.data.tags),
  ]),
].sort();

const tagCounts = {};
for (const tag of allTags) {
  const posts = allPosts.filter((p) => p.data.tags.includes(tag)).length;
  const challenges = allChallenges.filter((c) => c.data.tags.includes(tag)).length;
  tagCounts[tag] = { posts, challenges };
}
---

<Layout title="Todas las etiquetas" description={`${allTags.length} etiquetas categorizando el contenido del blog`} section="tags">
  <section class="max-w-6xl mx-auto space-y-12 py-8 md:py-16" data-pagefind-ignore>
      <!-- CABECERA -->
      <div class="text-center space-y-4 pb-4">
        <span class="text-xs text-cyan-500 uppercase tracking-[0.3em]">ETIQUETAS</span>
        <h1 class="text-4xl md:text-5xl font-black italic uppercase tracking-tighter text-slate-900 dark:text-white">
          Todas las etiquetas
        </h1>
        <div class="h-1 w-24 bg-cyan-500 mx-auto rounded-full"></div>
        <p class="max-w-2xl mx-auto text-sm sm:text-base text-slate-500 dark:text-slate-400 leading-relaxed">
          {allTags.length} etiquetas en total
        </p>
      </div>

      <!-- NUBE DE ETIQUETAS -->
      <div class="flex flex-wrap gap-4 justify-center">
        {allTags.map((tag) => {
          const total = tagCounts[tag].posts + tagCounts[tag].challenges;
          return (
            <a
              href={`/tags/${encodeURIComponent(tag)}/1`}
              class="group relative bg-gradient-to-r from-sky-800 to-cyan-600 px-5 py-3 text-xs font-black uppercase tracking-widest text-white shadow-[4px_4px_0px_0px_rgba(0,0,0,0.1)] hover:shadow-[0_0_20px_rgba(6,182,212,0.4)] hover:-translate-y-1 hover:scale-105 active:scale-95 transition-all block no-underline"
            >
              {tag}
              <span class="ml-2 text-white/60 font-normal tracking-normal text-[10px]">
                ({total})
              </span>
            </a>
          );
        })}
      </div>
  </section>
</Layout>
