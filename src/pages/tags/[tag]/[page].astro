---
import Layout from '@layouts/Layout.astro';
import PreviewPost from '@components/PreviewPost.astro';
import Tags from '@components/Tags.astro';
import Archive from '@components/Archive.astro';

export async function getStaticPaths({paginate}) {
	const allTags = ['web', 'sistemas', 'react'];
	const allPosts = await Astro.glob('../../posts/*.md');
	const sortedPosts = allPosts.sort((a, b) => new Date(b.frontmatter.date).valueOf() - new Date(a.frontmatter.date).valueOf()).reverse();
	return allTags.map((tag) => {
		const filteredPosts = sortedPosts.filter((post) => post.frontmatter.tags.includes(tag));
		return paginate(filteredPosts, {
		params: { tag },
		pageSize: 12
		});
	});
}
const { page } = Astro.props;
const params = Astro.params;
const { tag } = params;
const posts = page.data;
let next = page.url.next;
let prev = page.url.prev;
---

<Layout title={'Articulos con '+tag}>
	<div class="content">
		<h1>Articulos con: {tag}</h1>
		<ul role="list" class="link-card-grid">
			{
				posts.length > 0 ? posts.map( p => 
					<PreviewPost post={p} />
				) : <p>No hay articulos con ese tag</p>
			}
		</ul>

		<ul class="paginator">
			{
				next && <li><a href={next}>Articulos Posteriores</a></li>
			}
			{
				prev && <li><a href={prev}>Articulos Ateriores</a></li>
			}
		</ul>
	</div>
	<div class="lateralbar">
		<Tags />
		<Archive />
	</div>
</Layout>

<style>

	.link-card-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(24ch, 1fr));
		gap: 1rem;
		padding: 0;
		max-width: 70vw;
	}

	.paginator {
		display: flex;
		justify-content: space-between;
		margin: 1em 0;
	}

	.paginator a {
		color: var(--color-text);
		text-decoration: none;
		transition: color 0.3s cubic-bezier(0.22, 1, 0.36, 1);
	}
	.paginator a:hover {
		color: var(--color-primary);
	}
	.paginator li {
		display: flex;
		align-items: center;
		list-style: none;
	}
	
	.paginator a {
		color: var(--color-text);
		text-decoration: none;
	}
	
</style>
