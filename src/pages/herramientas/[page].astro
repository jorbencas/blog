---
import Layout from "@layouts/Layout.astro";
import Card from "@components/Card.astro";
import NextPrevLinks from "@components/NextPrevLinks.astro";
import Information from "@components/Information.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths({ paginate }) {
  const allTools = await getCollection("tools");
  const sortedTools = allTools.sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  );

  return paginate(sortedTools, {
    pageSize: 12,
  });
}

const { page } = Astro.props;
const { data, url, currentPage } = page;
const { prev, next } = url;
---

<Layout
  title={`Mini Herramientas - Página ${currentPage}`}
  description="Utilidades ligeras del lado del cliente, sin servidor."
>
  <div class="max-w-6xl mx-auto mt-10 flex justify-around items-start">
    <section class="space-y-12" data-pagefind-ignore>
      <div class="text-center space-y-2">
        <h1
          class="text-3xl sm:text-4xl font-black uppercase tracking-tighter text-slate-900 dark:text-white transition-colors"
        >
          Mini Herramientas <span class="text-emerald-500 text-xl sm:text-2xl align-top"
            >Pg.{currentPage}</span
          >
        </h1>
        <div class="h-1 w-24 bg-emerald-500 mx-auto"></div>
      </div>

      <div class="flow-root">
        <ul
          role="list"
          class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"
        >
          {
            data.length > 0 ? (
              data.map((tool) => (
                <li class="list-none">
<Card
                      {...tool.data}
                      href={`/herramientas/${tool.id.replace(/\.[^/.]+$/, "")}`}
                      accent="emerald"
                      aspectRatio="video"
                      overlay="white"
                    />
                </li>
              ))
            ) : (
              <div class="col-span-full">
                <Information section="herramientas" />
              </div>
            )
          }
        </ul>
      </div>

      <div class="pt-12">
        <NextPrevLinks
          nextURL={next}
          prevURL={prev}
          textNext="Herramientas antiguas"
          textPrev="Herramientas recientes"
        />
      </div>
    </section>
  </div>
</Layout>
