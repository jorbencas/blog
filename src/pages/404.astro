---
import Layout from "@layouts/Layout.astro";
---

<Layout
 title="404: RECURSO_NO_ENCONTRADO"
 description="La página que buscas ha sido movida o no existe."
>
 <main data-pagefind-ignore
 class="flex min-h-[70vh] flex-col items-center justify-center px-6 font-sans"
 >
 <div
 class="w-full max-w-2xl border border-slate-200 dark:border-white/10border-white/10 bg-white dark:bg-slate-950 p-8 shadow-[8px_8px_0px_0px_rgba(6,182,212,0.2)]"
 >
 {/* Cabecera de Error */}
 <div
 class="mb-8 flex items-center justify-between border-b dark:border-white/10 pb-4"
 >
 <div class="flex items-center gap-2">
 <div class="h-3 w-3 rounded-full bg-red-500"></div>
 <span
 class="font-mono text-[10px] font-bold uppercase tracking-widest text-slate-400"
 >
 System_Error_v2.0
 </span>
 </div>
 <span class="font-mono text-[10px] text-slate-500">ESTADO: 404</span>
 </div>

 {/* Contenido Principal */}
 <h1
 class="mb-4 text-6xl font-black italic tracking-tighter text-slate-900 dark:text-white underline decoration-cyan-500 decoration-4 underline-offset-8"
 >
 ¡Vaya! 404_
 </h1>

 <p
 class="mb-8 text-lg leading-relaxed text-slate-600 dark:text-slate-400"
 >
 Parece que el recurso que intentas localizar ha sido <span
 class="text-cyan-500 font-bold uppercase font-mono text-sm tracking-wider"
 >[ Eliminado ]</span
 > o nunca existió en esta base de datos.
 </p>

 {/* Detalle Técnico (JetBrains Mono) */}
 <div
 class="mb-10 bg-slate-50 dark:bg-white/5 p-4 font-mono text-xs text-slate-500 dark:text-slate-400 border-l-2 border-cyan-500"
 >
 <p>> UBICACIÓN: {Astro.url.pathname}</p>
 <p>> ESTADO: ERROR_NOT_FOUND</p>
 <p>> ACCIÓN: RE-DIRECCIONAR_USUARIO</p>
 </div>

 {/* Botón de Retorno en Castellano */}
 <a
 href="/"
 class="inline-flex items-center gap-3 border-2 dark:border-white bg-slate-900 dark:bg-white px-8 py-3 text-sm font-black uppercase tracking-widest text-white dark:text-slate-900 transition-all hover:bg-cyan-500 hover:border-cyan-500 hover:text-white dark:hover:bg-cyan-500 dark:hover:border-cyan-500 active:translate-y-1 active:shadow-none"
 >
 <svg
 xmlns="http://www.w3.org/2000/svg"
 class="h-4 w-4"
 fill="none"
 viewBox="0 0 24 24"
 stroke="currentColor"
 >
 <path
 stroke-linecap="round"
 stroke-linejoin="round"
 stroke-width="2"
 d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
 </svg>
 VOLVER_AL_INICIO
 </a>
 </div>
 </main>
</Layout>
